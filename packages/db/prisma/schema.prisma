  CONFIRMED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
}

// Canal desde el que entró la reserva. GIFT_REDEMPTION (canje de bono) es
// contrato para B5; WEB para la reserva online embebible (B6).
enum ReservationSource {
  PRESENCIAL
  WEB
  PHONE
  GIFT_REDEMPTION
}

// Familia de recurso ocupado por un assignment. TABLE reservado para mesa.
enum ReservableType {
  STAFF
  RESOURCE
  TABLE
}

// Alcance de un bloqueo estructural (cierre VIP, formación, vacaciones).
