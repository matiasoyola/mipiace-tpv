  STAFF
  RESOURCE
  TABLE
}

// ── residencia-1 · cimientos de la residencia de mayores ──────────────
//
// Vertical nueva (D-37, D-48): residencias de mayores sobre el núcleo de
// mipiacetpv, encendida por tenant con `Tenant.residenciaEnabled`. Estos
// cuatro tipos son listas CERRADAS —las fija la Ley de Dependencia o el
// propio concierto con la JCCM, no el centro— y de ahí que sean enums y
// no catálogo de datos. Lo que SÍ es catálogo de datos son los roles de
// cuidado: ver `CareRole`.

// Cuánta ayuda necesita un residente para la vida diaria. Es la
// clasificación con la que una residencia organiza el trabajo: de ella
// sale el plan de cuidados por defecto (residencia-2, D-53).
enum DependencyLevel {
  VALIDO
  SEMIASISTIDO
  DEPENDIENTE
}

// Grado reconocido de la Ley 39/2006 (Ley de Dependencia). OPCIONAL: hay
// residentes privados sin valoración, y un grado que no se tiene no se
// inventa. No es lo mismo que `DependencyLevel` —aquél lo decide el
// centro para organizar el cuidado, éste lo reconoce la administración— y
// por eso son dos columnas y no una.
enum DependencyGrade {
  I
  II
  III
}

// Qué clase de plaza ocupa. Los pagadores y la vigencia de la plaza son
// Fase 3 (facturación de concertadas): aquí sólo se guarda de qué tipo es,
// que es lo que la dirección necesita ver en la lista.
enum PlaceType {
  PRIVADA
  CONCERTADA
  TEMPORAL
}

// Categoría de un rol de cuidado (D-29 a D-31). NO es el rol de negocio
// (`UserRole`), que no se toca en este bloque: una persona puede ser
// auxiliar y nada más en el TPV, o dirección y además OWNER.
//
// De la categoría cuelgan los permisos de residencia que vienen después:
// cerrar una incidencia es de categoría directiva (D-27), y N3/N4 exige
// además una persona distinta de quien registró (D-28).
enum CareRoleCategory {
  OPERATIVO
  SUPERVISOR
  DIRECTIVO
}

// ── residencia-2 · el catálogo de controles y el plan de cuidados ──────
//
// El catálogo de controles es DATO y no código (D-11): dar de alta un
// control nuevo en 2028 tiene que ser rellenar una fila, no desplegar un
// `switch`. Lo que SÍ son enums son estas cinco listas, y la frontera es
// la misma de siempre: es enum lo que, si cambiara, cambiaría el código
// que lo lee.
//
//   · `ControlLayer`     — qué SIGNIFICA el dato. Cada capa se pinta y se
//     valida distinto, así que añadir una capa es desarrollo.
//   · `ControlNature`    — si se cumple, si sólo se cuenta o si la genera
//     el sistema. De aquí sale si un incumplimiento es un incumplimiento.
//   · `ControlValueDomain` — de qué tipo es el valor. Lo lee el teclado de
//     la pantalla y el validador del registro.
//   · `ControlScope`     — del producto o del centro. Es la frontera de
//     quién puede tocar qué (rama de controles §10).
//   · `CareFrequencyKind` — cómo se reparte en el tiempo. Cada valor es
//     una rama de `queToca`, o sea código.
//
// Lo que NO es enum y es a propósito: el CÓDIGO del control
// (`HIGIENE_PERSONAL`, `TEMPERATURA`…), el indicador ISO al que alimenta y
// las opciones de una escala ordinal. Los tres son dato — el primero
// porque un centro crea los suyos (`ControlScope.CENTER`), el segundo
// porque los indicadores de AENOR cambian con la revisión de la norma y no
// con un despliegue, y el tercero porque el vocabulario de ánimo y
// cognición es editable por decisión expresa (D-59).

// residencia-2 (rama de controles §2) · LA CAPA de un control: qué clase
// de pregunta es.
//
// Las cuatro capas más la subcapa de escalas, en el orden en que cuesta
// contestarlas:
//
//   · `EXEC`    — ¿se hizo? Un sí/no o un «cuánto comió». Es el 80 % de lo
//     que una auxiliar registra en un turno.
//   · `OBS`     — ¿cómo está hoy? Una dimensión con vocabulario ordinal
//     corto. Se pregunta POR RESIDENTE y no por dimensión (D-16): un
//     «como siempre» da por buenas todas las dimensiones activas.
//   · `MEASURE` — una constante: cuánto. Lleva unidad, rango de entrada y
//     rango de referencia.
//   · `SCALE`   — una escala validada (Barthel, Lobo, Tinetti, Norton).
//     Existe en el tipo y **no se siembra en este bloque**: es Fase 2
//     (D-40, D-55), y se pasará con `ClinicalAssessment`.
//   · `EVENT`   — lo que genera el sistema por umbral o por ausencia
//     (D-20). Existe en el tipo y se siembra en residencia-4.
//
// El bloque residencia-2 siembra `EXEC`, `OBS` y `MEASURE`. Los otros dos
// están en el enum desde ya porque el día que se siembren no tiene que
// haber migración de tipo: añadir un valor de enum en Postgres obliga a
// partir la migración en dos (lección pagada cuatro veces en este repo).
enum ControlLayer {
  EXEC
  OBS
  MEASURE
  SCALE
  EVENT
}

// residencia-2 (decisión de producto 3) · LA NATURALEZA de un control: qué
// significa que no esté registrado.
//
//   · `SCHEDULED` — tiene agenda: se CUMPLE o se INCUMPLE. Un cambio
//     postural que tocaba a las 02:00 y no está es un incumplimiento, y en
//     residencia-4 un evento por ausencia.
//   · `ON_DEMAND` — no tiene agenda: sólo se CUENTA. La higiene extra
//     porque se ha manchado, una deposición. Que no haya ninguno no es un
//     fallo de nadie; que no haya ninguno en tres días sí es un evento
//     (D-20), pero eso lo decide el umbral y no la naturaleza.
//   · `DERIVED`   — la genera el sistema, no una persona. Nada la registra
//     a mano. Se siembra en residencia-4.
//
// La diferencia entre las dos primeras es la razón de que esto no sea un
// booleano `tieneAgenda`: `queToca` devuelve ocurrencias de las
// `SCHEDULED` y **ninguna** de las `ON_DEMAND` —el botón está en la
// pantalla, pero nada «toca»— y un tercer valor sin registro manual no
// cabría en un booleano.
enum ControlNature {
  SCHEDULED
  ON_DEMAND
  DERIVED
}

// residencia-2 · EL DOMINIO DEL VALOR de un control. Lo lee el teclado de
// la pantalla de la puerta (residencia-3) y el validador del registro.
//
//   · `BOOL`       — hecho / no hecho. Un botón.
//   · `ORDINAL`    — una de las opciones de `ControlTypeOption`, ordenadas
//     de mejor a peor. «Todo / la mitad / poco / nada».
//   · `NUMERIC`    — un número con unidad, rango de entrada y rango de
//     referencia. Las constantes.
//   · `SCORE`      — la puntuación total de una escala validada. Fase 2.
//   · `TEXT_SHORT` — texto libre corto. Es lo que lleva el botón «algo no
//     va bien» (D-46: texto corto opcional, nunca voz en la v1).
//
// `ORDINAL` y `SCORE` no son lo mismo aunque los dos sean «un número»: un
// ordinal tiene cuatro opciones con nombre y un orden, y un `SCORE` tiene
// un rango continuo y un algoritmo detrás.
enum ControlValueDomain {
  BOOL
  ORDINAL
  NUMERIC
  SCORE
  TEXT_SHORT
}

// residencia-2 (rama de controles §10, D-21, D-57) · DE QUIÉN ES ESTE
// CONTROL.
//
//   · `STANDARD` — **del producto**. Global (`tenantId` NULL), versionado,
//     lo mantiene Mi Piace y lo valida la médica del cliente cero (D-57).
//     Cuando cambia una guía se actualiza aquí y BAJA A TODOS LOS CENTROS
//     a la vez. El centro no puede tocar ni la capa, ni la naturaleza, ni
//     el dominio, ni la unidad, ni los rangos, ni el indicador, ni la
//     lista de frecuencias permitidas.
//   · `CENTER`   — **del centro** (`tenantId` NOT NULL). Un centro puede
//     inventarse los suyos; no se mezclan con los de serie y **no bajan a
//     ningún otro centro**.
//
// La correspondencia `scope ⇔ tenantId` la garantiza el CHECK
// `control_types_scope_exige_tenant` de la migración, no una costumbre:
// un control de serie con tenant sería un control que una residencia cree
// que es del producto y que nadie actualiza, y un control de centro sin
// tenant lo verían los quince clientes de hoy.
//
// Es justo al revés que `CareRole`, que residencia-1 sembró POR TENANT
// (`tenantId` NOT NULL, §4 de su done). La diferencia es quién tiene que
// poder cambiarlo: que un centro llame «gerocultora» a la auxiliar es
// suyo y no le interesa a nadie más; que la guía de prevención de úlceras
// pase de tres horas a dos tiene que llegar a los cinco centros sin un
// backfill.
enum ControlScope {
  STANDARD
  CENTER
}

// residencia-2 (alcance §4) · CÓMO SE REPARTE UN CONTROL EN EL TIEMPO.
//
// Cada valor es una rama de `queToca` (`packages/residencia-plan`), o sea
// código, y de ahí que sea un enum y no una tabla. Los parámetros de cada
// uno van en columnas aparte, y qué columnas exige cada `kind` lo
// garantiza un CHECK en el motor (`…_frecuencia_coherente`) y no la ruta
// que escribe: un `EVERY_N_HOURS` sin horas es una línea de plan que la
// puerta leería y no sabría cuándo pedir.
//
//   · `EVERY_SHIFT`   — en cada uno de los turnos indicados. Transferencias.
//   · `DAILY`         — una vez al día, en UN turno. Hidratación cutánea.
//   · `MOMENTS`       — en los momentos del día del centro (desayuno,
//     comida, merienda, cena, noche), con la hora que el centro les ponga
//     (`CenterMoment`). Las comidas y la medicación.
//   · `EVERY_N_HOURS` — cada N horas, **también de noche**: los cambios
//     posturales cada 2–3 h, que es la única frecuencia del catálogo que
//     no se deja describir con turnos.
//   · `WEEKDAYS`      — días concretos de la semana, en un turno. La
//     gimnasia de mantenimiento, lunes-miércoles-viernes.
//   · `EVERY_N_DAYS`  — cada N días. Una analítica semestral.
//   · `MONTHLY`       — un día del mes. La visita médica.
//   · `ON_DEMAND`     — **sin agenda**: el botón está en la pantalla y
//     nada «toca». `queToca` no devuelve ni una ocurrencia.
enum CareFrequencyKind {
  EVERY_SHIFT
  DAILY
  MOMENTS
  EVERY_N_HOURS
  WEEKDAYS
  EVERY_N_DAYS
  MONTHLY
  ON_DEMAND
}

// residencia-2 (alcance §5) · DE DÓNDE SALIÓ UNA LÍNEA DEL PLAN.
//
//   · `PROFILE_TEMPLATE` — la puso la plantilla del nivel de dependencia
//     del residente al darle de alta o al cambiarle el nivel.
//   · `MANUAL`           — la puso una persona para este residente.
//
// La diferencia es la que sostiene el cambio de nivel: al pasar a un nivel
// nuevo se cierran las líneas de plantilla del nivel ANTERIOR que no estén
// en la nueva, se abren las que falten y **las manuales no se tocan**. Sin
// esta columna, cambiar el nivel de dependencia borraría el ajuste que la
// DUE hizo a mano, que es justo el trabajo que nadie quiere repetir.
enum CarePlanItemSource {
  PROFILE_TEMPLATE
  MANUAL
}

// ── residencia-4 · gravedad, incidencias y el aviso ───────────────────
//
// Cinco listas más, y la frontera sigue siendo la misma: es enum lo que,
// si cambiara, cambiaría el código que lo lee. Lo que NO es enum y es a
// propósito es **el tipo de incidencia** (`FIEBRE`, `CAIDA`, `AVERIA`…):
// es un CÓDIGO de texto que vive en el fichero de datos de la plantilla
// de gravedad, porque D-11 llevado a la capa 4 dice que un tipo nuevo en
// 2028 tiene que ser una fila y no una migración.

/// residencia-4 (D-26) · LOS CINCO NIVELES, por CONSECUENCIA y no por
/// causa (rama de controles §6.1). Así valen igual para una caída, una
/// fiebre o una queja, y la plantilla sólo tiene que decir en cuál cae
/// cada cosa.
///
///   · `N0` — queda constancia. **No abre incidencia** (D-27).
///   · `N1` — lo tiene que saber el turno siguiente (relevo,
///     residencia-5).
///   · `N2` — alguien tiene que verlo AHORA: suena el móvil de guardia.
///   · `N3` — hay que tomar una decisión clínica: suenan los dos canales.
///   · `N4` — emergencia: los dos canales y la puerta pinta «Llama al
///     112».
enum SeverityLevel {
  N0
  N1
  N2
  N3
  N4
}

/// residencia-4 · cómo compara una regla de umbral. Los cuatro que la
/// tabla del §3 usa literalmente («≥ 37,5», «< 92», «≤ 90», «> 300»).
/// Traducir un `LTE 90` a un `LT 91` habría metido una decisión de
/// redondeo donde hoy se miden enteros y mañana puede que no.
enum SeverityComparator {
  GTE
  GT
  LTE
  LT
}

/// residencia-4 (D-35, D-38) · EL SUJETO DEL LIBRO ÚNICO.
///
/// Lo único que cambia entre una caída, una queja y una avería es ESTO
/// (rama §6.3). Es enum y no código de texto —al revés que el tipo—
/// porque de cada sujeto cuelga una pantalla distinta y un formulario
/// distinto: añadir `PROVEEDOR` (fuera de la v1 por D-38) es desarrollo.
enum IncidentSubject {
  RESIDENT
  COMPLAINT
  MAINTENANCE
}

/// residencia-4 (D-20) · DE DÓNDE SALIÓ LA INCIDENCIA.
///
///   · `DECLARED`          — alguien la declaró en la puerta o en el
///     admin.
///   · `DERIVED_THRESHOLD` — la derivó una constante que cruzó umbral.
///   · `DERIVED_ABSENCE`   — la derivó la pasada programada por lo que
///     NO hay (sin deposición > 3 días, «nada» en dos comidas).
///
/// La distinción no es decorativa: es la mitad de D-20 y es lo que la
/// auditoría mira para saber cuántas incidencias se cazan solas.
enum IncidentOrigin {
  DECLARED
  DERIVED_THRESHOLD
  DERIVED_ABSENCE
}

/// residencia-4 · QUÉ CLASE DE ACCIÓN es una línea del histórico de una
/// incidencia. Append-only, como las anotaciones clínicas.
///
///   · `NOTE`      — «qué se hizo», texto libre cifrado.
///   · `EVIDENCE`  — se adjuntó otra medida a esta incidencia (la segunda
///     toma de fiebre del turno).
///   · `SEVERITY`  — cambió el nivel, con el de antes y el de después.
///   · `ALERT`     — salió un aviso, o lo acusó alguien.
///   · `CALL`      — se llamó (o se decidió no llamar) al servicio
///     sanitario de guardia. D-33: la llamada la hace la persona.
///   · `CLOSE`     — se cerró.
enum IncidentActionKind {
  NOTE
  EVIDENCE
  SEVERITY
  ALERT
  CALL
  CLOSE
}

/// residencia-4 (D-66) · LOS DOS CANALES DEL MÓVIL DE GUARDIA.
///
/// `ENFERMERIA` es quien coge el móvil de enfermería al empezar el turno;
/// `RESPONSABLE` es la dirección o el responsable de guardia, que puede
/// ser su teléfono personal con la APK en modo guardia. Puede haber
/// VARIOS dispositivos por canal.
enum GuardChannel {
  ENFERMERIA
  RESPONSABLE
}

/// residencia-4 · EN QUÉ ESTÁ UN AVISO.
///
///   · `PENDING`    — creado, todavía sin entregar a ningún móvil vivo.
///   · `DELIVERED`  — un móvil de ese canal lo tiene delante.
///   · `ACKED`      — alguien pulsó «Voy» con su PIN.
///   · `ESCALATED`  — se agotaron los minutos sin acuse y se abrió el del
///     canal siguiente. **No se cancela**: el de enfermería sigue sonando.
///   · `CANCELLED`  — la incidencia se cerró antes de que nadie acusara.
enum GuardAlertState {
  PENDING
  DELIVERED
  ACKED
  ESCALATED
  CANCELLED
}

/// residencia-4 (D-32 a D-34) · LAS DOS CONSTANCIAS DE FAMILIA.
///
/// Es una DIMENSIÓN APARTE del nivel (rama §9): una caída sin
/// consecuencias es N1 y la familia quiere saberlo el mismo día; un
/// hallazgo N3 puede convenir no comunicarlo hasta tener diagnóstico.
///
/// Y las dos son constancia: «no comunicado» con autor y motivo es un
/// registro tan válido como «comunicado», por la misma lógica de
/// denominador que el «como siempre» (D-15). Una incidencia de residente
/// **no se cierra sin una de las dos**.
enum FamilyCommunicationKind {
  COMUNICADO
  NO_COMUNICADO
}

/// residencia-4 · por qué vía se habló con la familia. `OTRA` existe
/// porque una lista cerrada de canales se queda corta el día que alguien
/// viene a recoger ropa y se le cuenta en el pasillo.
enum FamilyCommunicationChannel {
  TELEFONO
  PRESENCIAL
  EMAIL
  OTRA
}

// ── Multi-tenant raíz ─────────────────────────────────────────────────

// ══ residencia-5 · el relevo, el panel y las obligaciones ══════════════
//
// Tres cosas que hoy no existen en papel, y la razón de cada una:
//
//   1. **El parte de relevo** (D-18, D-58, D-67). Hoy el cambio de turno
//      se hace de palabra; lo que no se dice se pierde y nadie puede
//      demostrar que se dijo. El parte lo genera el sistema con lo que ya
//      está registrado —nadie lo escribe—, se CONGELA al acabar el turno
//      y el turno que entra lo confirma con su PIN en la tablet de la
//      sala. La confirmación es la evidencia de que la información pasó.
//   2. **Las obligaciones de dirección** (D-42). Las nóminas, los
//      extintores y el certificado de PCI que falta desde 2026 viven en
//      la cabeza de Carmen. Aquí son filas con periodicidad, y sus
//      ocurrencias se generan solas.
//   3. **El umbral objetivo de cada indicador** (rama de controles §10).
//      La fórmula es del producto; el umbral, del centro.
//
// Los tipos de aquí; las tablas, al final del fichero.

/// residencia-5 (D-42, bloque C §3) · LAS CINCO FAMILIAS de obligación.
///
/// Son las del catálogo del bloque C y no una invención: personal,
/// dinero, compras, cumplimiento y calidad. Es un enum y no un catálogo
/// de datos —al revés que `CareRole` o `ControlType`— porque de la
/// familia no cuelga ningún comportamiento: es cómo se agrupa la lista en
/// la pantalla. Una familia nueva sería un cambio de producto, no un
/// ajuste de centro.
enum DutyFamily {
  PERSONAL
  DINERO
  COMPRAS
  CUMPLIMIENTO
  CALIDAD
}

/// residencia-5 (D-42) · CADA CUÁNTO TOCA una obligación.
///
/// Las siete del prompt, y cada una dice qué columnas de
/// `management_duties` tiene que llevar (CHECK
/// `management_duties_periodicidad_coherente`): una periodicidad mensual
/// sin día del mes no sabe cuándo toca, y una semanal CON día del mes es
/// una fila que alguien rellenó a medias.
///
/// ── Por qué `VALIDITY` no es una periodicidad más ─────────────────
///
/// Las seis primeras se repiten solas para siempre: el 25 de cada mes, el
/// primer lunes, el 20 de julio. `VALIDITY` no se repite: **caduca**. El
/// certificado del mantenedor de PCI vence el 5 de noviembre de 2029 y lo
/// que hay que hacer es renovarlo antes, no «hacerlo otra vez el año que
/// viene». De ahí que su ocurrencia sea UNA —la de su caducidad— y que
/// el panel la avise con 60 días de antelación (bloque C §2).
enum DutyPeriodicity {
  /// Diaria. El registro de jornada, los registros APPCC.
  DAILY
  /// Semanal, con día de la semana (1 = lunes, 7 = domingo).
  WEEKLY
  /// Mensual, con día del mes. **31 significa «el último del mes»**: ver
  /// la cabecera de `monthDay`.
  MONTHLY
  /// Trimestral, con mes de anclaje (1–3) y día. Los informes de
  /// extintores.
  QUARTERLY
  /// Anual, con mes y día. El certificado del mantenedor, la revisión por
  /// la dirección, la auditoría interna.
  ANNUAL
  /// Quinquenal, con mes, día y año de anclaje. La inspección OCA de baja
  /// tensión, vigente hasta el 05-11-2029.
  FIVE_YEARLY
  /// Por vigencia: una fecha de caducidad y nada más. La formación
  /// obligatoria de cada trabajador, el certificado de un equipo.
  VALIDITY
}

/// residencia-5 (D-42, bloque C §3) · QUÉ PASA SI NO SE HACE.
///
/// `LEGAL` es una sanción o un incumplimiento normativo; `ISO`, una no
/// conformidad en la auditoría de AENOR; `INTERNO`, coste o desorden.
/// Ordena el panel: lo legal vencido va arriba.
enum DutyConsequence {
  LEGAL
  ISO
  INTERNO
}

/// residencia-5 · CÓMO SE MIDE un indicador contra su umbral.
///
/// La fórmula es del producto y el umbral del centro (rama de controles
/// §10), pero falta una tercera cosa para decir «dentro» o «fuera»: para
/// qué lado. El 73,5 % de la gimnasia es un MÍNIMO y el 10 % de averías
/// que pasan de 24 h es un MÁXIMO, y sin esto el panel pintaría en verde
/// justo la mitad de los indicadores al revés.
enum IndicatorComparison {
  /// El valor tiene que ser **mayor o igual** que el umbral.
  AT_LEAST
  /// El valor tiene que ser **menor o igual** que el umbral.
  AT_MOST
}

/// residencia-5 (decisión de producto 2) · QUÉ LLEGÓ DESPUÉS DEL RELEVO.
///
/// Lo que sube una puerta sin red a las 15:20 de algo que pasó a las
/// 14:50, cuando el parte de la mañana ya está congelado. No se reescribe
/// lo congelado: se añade a la vista, con su hora y diciendo de qué es.
enum HandoverLateKind {
  /// Un registro de cuidados que llegó tarde.
  CARE_RECORD
  /// Una incidencia que se declaró o se derivó después.
  INCIDENT
  /// Un aviso que no salió a tiempo.
  GUARD_ALERT
}

model Tenant {
  id                             String            @id @default(uuid()) @db.Uuid
  name                           String
  holdedAccountId                String?           @map("holded_account_id")
  holdedAuthMode                 HoldedAuthMode    @default(API_KEY) @map("holded_auth_mode")
  // Tokens y API keys siempre cifrados con AES-GCM antes de persistir.
  holdedApiKeyCiphertext         String?           @map("holded_api_key_ciphertext")
  holdedOauthAccess              String?           @map("holded_oauth_access")
  holdedOauthRefresh             String?           @map("holded_oauth_refresh")
  holdedOauthExpiresAt           DateTime?         @map("holded_oauth_expires_at") @db.Timestamptz()
  // Datos fiscales agregados (NIF, razón social, dirección) extraídos
  // del almacén default o introducidos por el propietario. Van al pie
  // de cada ticket impreso.
  fiscalProfile                  Json?             @map("fiscal_profile")
  // Estado del sync inicial post-onboarding. El admin pollea
  // GET /onboarding/sync-status para mostrar la barra de progreso.
  initialSyncStatus              InitialSyncStatus @default(PENDING) @map("initial_sync_status")
  initialSyncStartedAt           DateTime?         @map("initial_sync_started_at") @db.Timestamptz()
  initialSyncCompletedAt         DateTime?         @map("initial_sync_completed_at") @db.Timestamptz()
  // Stats acumulados: productsCount, servicesCount, warehousesCount,
  // taxesCount, autoSkuFixed, autoSkuNeedsReview, wildcardsCreated,
  // wildcardsReused, errors[]. Estructura libre; el admin la pinta.
  initialSyncStats               Json?             @map("initial_sync_stats")
  // Última vez que el sync incremental (B2 §2) corrió con éxito sobre
  // este tenant. El cron de 15 min lo actualiza; el admin lo muestra
  // como "última sincronización hace X min".
  lastIncrementalSyncAt          DateTime?         @map("last_incremental_sync_at") @db.Timestamptz()
  // Última vez que el catálogo de contactos se refrescó (B7 §8). Se
  // actualiza al final del sync incremental tras descargar todos los
  // contactos de Holded. Sirve para que el admin distinga entre un
  // sync "completo" y uno parcial.
  lastContactsSyncAt             DateTime?         @map("last_contacts_sync_at") @db.Timestamptz()
  // Stats del último sync incremental: { productsSeen, productsUpdated,
  // orphansMarked, autoSkuFixed, autoSkuNeedsReview, durationMs,
  // errors[] }. Mismo enfoque que `initialSyncStats` — estructura
  // libre, el admin la renderiza.
  lastIncrementalSyncStats       Json?             @map("last_incremental_sync_stats")
  // Minutos sin actividad antes de que la PWA cierre la sesión del cajero
  // (§17.2). El turno sigue abierto; sólo se cae la sesión. Rango sensato
  // 5–60 min.
  cashierAutoLogoutMinutes       Int               @default(10) @map("cashier_auto_logout_minutes")
  // v1.0-pilotos · Lote 4 (#18): TTL del JWT de sesión del cajero.
  // Independiente del auto-logout por inactividad: la sesión vive el
  // turno entero (default 720 min = 12 h) y la PWA la corta antes si el
  // cajero deja la tablet quieta `cashierAutoLogoutMinutes` minutos.
  // Antes el JWT se firmaba con el TTL de inactividad (10 min) y el
  // cajero re-logueaba varias veces al día aunque estuviera trabajando.
  cashierSessionTtlMinutes       Int               @default(720) @map("cashier_session_ttl_minutes")
  // Si true, el cierre forzado de un turno colgado de otro cajero exige
  // PIN de encargado cuando el cajero actual no lo es. Default true.
  requireManagerPinForForceClose Boolean           @default(true) @map("require_manager_pin_for_force_close")
  // v1.4-Bugs-Operativos Lote 1 · capa extra de control para tenants
  // que quieren mantener la antigua política "sólo OWNER/MANAGER cierra
  // caja". Default false → la operativa normal acepta el PIN del cajero
  // autenticado para los cierres que requieran autenticación adicional
  // (sync_failed, force_close cuando el flag de force_close está on).
  requireOwnerPinForCashClose    Boolean           @default(false) @map("require_owner_pin_for_cash_close")
  // v1.11-cierre-de-dia · hora LOCAL (Europe/Madrid) del corte de día. A
  // esa hora el job `shift-day-cut` cierra los turnos abiertos que vienen
  // del día anterior y genera su Z con los datos del server. Default 05:00
  // — después del cierre de un bar de noche y antes de que abra nadie.
  dayCutHour                     Int               @default(5) @map("day_cut_hour")
  // v1.11-cierre-de-dia · si true, cerrar turno EXIGE contar el efectivo
  // por denominaciones (comportamiento histórico). Default FALSE a
  // propósito: el cierre normal pasa a ser resumen + "Confirmar", y
  // cuadrar caja es un enlace opcional. Es el único flag de este bloque
  // cuyo default cambia la operativa de quien no toque nada — decisión de
  // producto (Matías, 2026-08-20) tras ver que Peluquería Sole hacía el
  // arqueo de ayer de pie antes de su primera clienta. Convive con
  // `requireOwnerPinForCashClose`: uno dice SI hay que contar, el otro
  // QUIÉN puede autorizar el cierre.
  requireCashCountOnClose        Boolean           @default(false) @map("require_cash_count_on_close")
  // Si true, se envía email al propietario cuando un device nuevo se
  // empareja o cuando un device conocido aparece desde un país distinto
  // (§17.4). Default true.
  deviceNewLoginAlertEnabled     Boolean           @default(true) @map("device_new_login_alert_enabled")
  // Umbral de descuento (%) que el cajero puede aplicar sin autorización
  // del encargado (B6 §2). Si supera este porcentaje, el TPV pide PIN
  // encargado y el backend exige `authorizationToken` en POST /tickets.
  discountThresholdPct           Decimal           @default(10) @map("discount_threshold_pct") @db.Decimal(5, 2)
  // Si true, el cajero puede buscar contactos Holded desde el TPV. Si
  // false, sólo OWNER/MANAGER puede asociar contacto a un ticket. Por
  // defecto true para no romper el flujo actual.
  cashierSearchableContacts      Boolean           @default(true) @map("cashier_searchable_contacts")
  // v1.8-Fiado · habilita la venta a crédito (fiado) en el TPV. Default
  // OFF: el botón "Fiado" del checkout y la pantalla "Deudas" sólo
  // aparecen si está ON, y la ruta de cobro rechaza método CREDIT con
  // 400 si está OFF. Se activa por tenant desde el admin.
  creditSalesEnabled             Boolean           @default(false) @map("credit_sales_enabled")
  // B-SuperAdmin: bloqueo global del tenant. NULL = activo. NOT NULL =
  // bloqueado por super-admin. El middleware `requireTenantNotBlocked`
  // corta TODAS las requests per-tenant con 423 Locked cuando esto está
  // set, independientemente del rol del solicitante.
  blockedAt                      DateTime?         @map("blocked_at") @db.Timestamptz()
  blockedReason                  String?           @map("blocked_reason")
  // Plan operativo (gestionado manualmente por el super-admin). String
  // libre — no enum — para no requerir migración al añadir tiers.
  plan                           String?
  // B-OnboardingV2: estado del onboarding supervisado. DRAFT al crear
  // sólo con API key Holded (sin OWNER user todavía). ACTIVE tras pasar
  // por POST /super-admin/tenants/:id/activate (crea OWNER, manda email,
  // purga datos de prueba). El backfill de la migración pone ACTIVE en
  // todos los tenants existentes para no romper el flujo legacy.
  onboardingState                OnboardingState   @default(DRAFT) @map("onboarding_state")
  // puesta-en-marcha (ADR-021) · DESDE CUÁNDO esta cuenta factura.
  //
  // No es lo mismo que `onboardingState`, y confundirlos es lo que hizo
  // falta este bloque. Aquella columna contesta «¿hay propietario?»; ésta
  // contesta «¿lo que cobra este TPV son facturas?». Hasta hoy las dos
  // preguntas tenían una sola respuesta, y eso dejaba a un comercio recién
  // activado sin ninguna forma de probar su propio TPV en su propio
  // aparato: el primer cobro de ensayo era ya la factura `C1/1` de la
  // titular, y una factura emitida no se borra.
  //
  //   · `null`     → EN ENSAYO. Se vende con normalidad desde cualquier
  //     terminal y con cualquier cajero (mesas, comanda, cobro, devolución,
  //     arqueo, cierre), pero todo ticket nace `TEST`, no sube a Holded, no
  //     manda email y NO LLEVA REGISTRO FISCAL: `/tpv/fiscal/head` contesta
  //     `emite: false` y el servidor descarta cualquier registro que llegue.
  //   · con fecha  → FACTURANDO. Exactamente lo de siempre.
  //
  // Lo que esta columna garantiza por construcción: antes de la puesta en
  // marcha no hay ningún registro fiscal que borrar, así que resetear el
  // ensayo NUNCA toca `fiscal_records` y el append-only sigue sin puertas.
  // Lo que la Ley Antifraude prohíbe —borrar facturas y seguir facturando
  // en la misma serie— no puede pasar aquí porque la factura no existía.
  //
  // La pone el super-admin UNA VEZ, en la visita y con el cliente delante,
  // y no se quita: ver `fiscal/puesta-en-marcha.ts`.
  facturaDesde                   DateTime?         @map("fiscal_go_live_at") @db.Timestamptz()
  // puesta-en-marcha (ADR-021) · ¿es una cuenta NUESTRA de pruebas?
  //
  // PRUEBAS MIPIACE no es un cliente: es el banco de pruebas del equipo. Una
  // cuenta así NO PUEDE arrancar (se queda en ensayo para siempre) y se
  // resetea cuantas veces haga falta, que es justo lo que no se podía hacer
  // antes de este bloque.
  //
  // La cuenta de ensayo de La Maestranza estuvo en esta lista hasta el 18-10
  // y salió: tiene 11 registros fiscales, o sea que llegó a emitir. Una
  // cuenta que ha facturado no es una cuenta de pruebas por mucho que la
  // llamemos así — y el CHECK de abajo lo dice antes que nosotros.
  //
  // Su invariante vive en la BASE (`tenants_pruebas_no_facturan_ck`): una
  // cuenta de pruebas no puede tener fecha de arranque. No se puede estar
  // «a medias de ser un cliente».
  esDePruebas                    Boolean           @default(false) @map("es_de_pruebas")
  // B-Multi-Vertical: vertical operativo del tenant. Default RETAIL
  // para no asumir hostelería en tenants nuevos (el piloto inicial es
  // librería). Editable desde la consola super-admin.
  businessType                   BusinessType      @default(RETAIL) @map("business_type")
  // B-reservas-1 (CRM) · capability flag de la ficha de cliente / CRM
  // (ADR-R6). OFF por defecto: la sección "Clientes" del TPV y sus
  // endpoints sólo se activan cuando el tenant lo enciende. Independiente
  // del businessType — un RETAIL o SERVICES puede encenderlo; Thalia lo
  // deja apagado. Los futuros flags del módulo (bonos, reservaOnline) se
  // añadirán como columnas hermanas cuando lleguen B5/B6.
  crmEnabled                     Boolean           @default(false) @map("crm_enabled")
  // B-reservas-2 (Catálogo extendido) · capability flag de la agenda
  // (ADR-R6). OFF por defecto: la extensión de scheduling de servicios,
  // los recursos y la duración por línea en el TPV sólo se activan cuando
  // el tenant lo enciende. Independiente del businessType — un RETAIL o
  // SERVICES puede encenderlo; Thalia lo deja apagado. Este bloque es el
  // OWNER de esta columna (hermana de `crmEnabled`; vendrán `bonosEnabled`
  // y `reservaOnlineEnabled` con B5/B6).
  agendaEnabled                  Boolean           @default(false) @map("agenda_enabled")
  // H1 (ADR-016) · capability flag de la CAJA: venta, turno, catalogo del
  // TPV, cajeros, dispositivos e impresion. Hermana de `crmEnabled` y
  // `agendaEnabled` en forma (columna booleana por tenant, ADR-R6), pero
  // distinta en gobierno: la caja se enciende y se apaga SOLO desde el
  // super-admin, porque es una decision comercial, no un ajuste del
  // negocio. Por eso no aparece en el POST de /admin/tenant/settings.
  //
  // `@default(true)` y NO false: el backfill de la migracion deja a todos
  // los tenants de hoy exactamente como estaban. Un `false` explicito es
  // la unica forma de apagar la caja.
  cajaEnabled                    Boolean           @default(true) @map("caja_enabled")
  // F1 (ADR-018) · capability del CONTROL HORARIO: empleados, móviles
  // emparejados, fichajes, correcciones y el registro que se le enseña a
  // la Inspección. Hermana de `cajaEnabled` en forma (columna booleana por
  // tenant, ADR-R6) Y en gobierno: la mueve SÓLO el super-admin, porque
  // encenderla es vender un producto. Por eso tampoco aparece en el POST
  // de /admin/tenant/settings.
  //
  // `@default(false)` y NO true: al revés que `cajaEnabled`, y por la
  // MISMA razón. El default de una capability es "deja a los tenants de
  // hoy exactamente como estaban": todos tienen caja, así que la caja nace
  // encendida; el control horario no lo tiene nadie, así que nace apagado.
  //
  // Se lee `=== true`, nunca `!== false` — el espejo exacto del criterio
  // de `cajaEnabled`: sólo el valor explícito CONTRARIO al default cambia
  // el comportamiento de nadie.
  fichajeEnabled                 Boolean           @default(false) @map("fichaje_enabled")
  // hotfix-fichaje-medianoche · CUÁNTAS HORAS puede llevar abierto un tramo
  // antes de ser una «salida olvidada». NO es el calendario: un turno que
  // empieza a las 22:00 y termina a las 08:00 se cierra con un toque normal
  // como cualquier otro, aunque pase de medianoche.
  //
  // 16 de serie — cubre el turno de noche de una residencia, una jornada
  // partida larga y el cierre de un bar, y deja fuera «entré ayer a las 9 y
  // no salí». Hermana de `agendaSlotMinutes` en forma (entero por tenant
  // con default que no cambia a nadie) y de `fichajeEnabled` en gobierno:
  // la mueve SÓLO el super-admin, porque no hay pantalla para esto y
  // tocarla es afinar un caso raro, no un ajuste del negocio.
  //
  // El rango 8–24 vive además en un CHECK de la base
  // (`tenants_fichaje_max_open_hours_check`).
  fichajeMaxOpenHours            Int               @default(16) @map("fichaje_max_open_hours")
  // personal-1 · EL MARGEN SOBRE EL FIN DEL TURNO PLANIFICADO.
  //
  // #45 dejó la salida olvidada decidida por duración, con el máximo de
  // arriba. Lo que personal-1 añade es que, CUANDO la persona tiene turno
  // en el cuadrante, el límite sea además «el fin de su turno más este
  // margen»: la auxiliar de noche sale a las 08:00, y si a las 13:00 sigue
  // dentro nadie tenía por qué esperar a las 16 h para enterarse.
  //
  // Hermana de `fichajeMaxOpenHours` en TODO: entero por tenant, default
  // que no cambia a nadie (sin cuadrante no se usa), rango en un CHECK de
  // la base (`tenants_fichaje_shift_margin_hours_check`, 1–12) y en el
  // schema de la ruta, y la mueve SÓLO el super-admin porque no hay
  // pantalla para esto.
  //
  // El límite que decide es el MENOR de los dos (ver `limiteDeSalidaOlvidada`
  // en `@mipiacetpv/cuadrante`): el turno planificado aprieta, nunca
  // afloja.
  fichajeShiftMarginHours        Int               @default(4) @map("fichaje_shift_margin_hours")
  // catalogo-local (addendum 3, ADR-017) · ¿está PREVISTO que esta
  // empresa use Holded? No confundir con `holdedApiKeyCiphertext != null`,
  // que responde a otra pregunta: ¿lo tiene conectado YA?
  //
  // Hasta este bloque `!hasHoldedKey` significaba las dos cosas a la vez y
  // el código no podía distinguirlas:
  //
  //   · "todavía no lo ha conectado" → está a mitad del onboarding y el
  //     muro de /onboarding es correcto.
  //   · "no lo va a conectar nunca"  → es el comercio de catálogo local, y
  //     el muro lo deja fuera de su propio panel para siempre.
  //
  // El interruptor no se deduce: deducirlo del catálogo sería circular
  // (para crear productos hay que entrar, y para entrar habría que tener
  // productos). Por eso es una columna explícita.
  //
  // Gobierno: lo apaga SÓLO el super-admin, y sólo mientras el tenant no
  // tenga clave de Holded conectada (si la tiene, 409 — apagarlo dejaría
  // documentos a medias y ventas sin subir sin que nadie se enterara). El
  // propietario no tiene ninguna salida de "trabajar sin Holded" en su
  // pantalla de onboarding: la implantación de Holded es una decisión de
  // venta de Mi Piace, no una casilla que el cliente se marca solo.
  //
  // `@default(true)` y se lee `holdedEnabled !== false`, nunca
  // `!holdedEnabled`: mismo criterio exacto que `cajaEnabled` arriba. Todo
  // lo que existe hoy nace encendido y se comporta igual que antes.
  holdedEnabled                  Boolean           @default(true) @map("holded_enabled")
  // holded-desconectar (ADR-020) · CUÁNDO este comercio dejó Holded
  // teniéndolo conectado y vendiendo. NULL en todos los demás: en el que
  // nunca lo tuvo, en el que lo tiene, y en el que lo tendrá.
  //
  // No es redundante con `holdedEnabled = false`. Esa columna responde
  // «¿está previsto que use Holded?» y la contestan igual DOS comercios
  // que no se parecen en nada:
  //
  //   · el que nació sin él (catalogo-local, ADR-017): su catálogo nunca
  //     estuvo en ningún ERP y no hay histórico que respetar.
  //   · el que lo DEJÓ (este bloque): tiene 270 facturas emitidas por
  //     Holded, 86 fichas con `holded_product_id` vivo y un asesor que
  //     necesita saber dónde está la frontera.
  //
  // Tres cosas la necesitan y ninguna se puede deducir de las otras dos
  // columnas:
  //
  //   1. **La frontera del abono.** Una devolución de después del corte
  //      puede ser de una factura de Holded (antes) o de una factura
  //      simplificada nuestra (después). El asesor las trata distinto y
  //      el listado se construye comparando con esta fecha.
  //   2. **La reanudación.** La acción es una transacción y un vaciado de
  //      colas que NO es transaccional. Si el proceso muere entre los
  //      dos, relanzarla ve esto puesto, no repite la parte hecha y
  //      termina la que falta.
  //   3. **La puerta de la vuelta.** Reencender Holded en un comercio que
  //      lo dejó NO es «volver al camino de siempre» (ADR-017 §4.1): sus
  //      fichas conservan `holded_product_id`, así que el upsert del sync
  //      —que casa por `(tenant_id, holded_product_id)`— entraría por la
  //      rama `update` y pisaría el catálogo local. Eso es otro bloque, y
  //      hasta que exista esta columna es lo que lo impide.
  //
  // Su invariante vive en la BASE (`tenants_holded_desconectado_ck`): si
  // está poblada, `holded_enabled = false` Y no hay clave. No se puede
  // estar «a medio dejar».
  holdedDisconnectedAt           DateTime?         @map("holded_disconnected_at") @db.Timestamptz()
  // B-reservas-7a · la RETÍCULA del centro: cada cuántos minutos empieza una
  // cita. 15 (el valor histórico de B4, `agenda/time.ts::SLOT_MINUTES`) o 30.
  // Peluquería Sole trabaja en franjas de 30 y hasta ahora le ofrecíamos
  // inicios a y cuarto (6a §4.6). El CHECK de valores permitidos vive en la
  // BASE DE DATOS, no sólo en el schema de la ruta. Default 15: un tenant
  // que no la toque se comporta exactamente como antes de este bloque.
  agendaSlotMinutes              Int               @default(15) @map("agenda_slot_minutes")
  // clinica-1 · capability de la HISTORIA CLÍNICA. Hermana de
  // `agendaEnabled` en forma (columna booleana por tenant, ADR-R6) y de
  // `cajaEnabled` / `fichajeEnabled` en gobierno: la mueve SÓLO el
  // super-admin, porque encenderla es vender un producto y aceptar un
  // marco legal (Ley 41/2002, art. 9 RGPD). Por eso no aparece en el POST
  // de /admin/tenant/settings.
  //
  // `@default(false)`: el default de una capability es "deja a los tenants
  // de hoy como estaban". Ninguno lleva historias clínicas.
  //
  // Apagada, las rutas clínicas responden **404 y no 403**: un bar no
  // tiene por qué enterarse de que este módulo existe. Es la única
  // capability de la casa que se esconde en lugar de explicarse, y la
  // razón es el dato que protege.
  clinicalRecordsEnabled         Boolean           @default(false) @map("clinical_records_enabled")
  // kds-1-cocina (decisión 10) · capability del módulo «COCINA»: pantalla
  // de comandas, órdenes de salida, semáforo, aviso de «Listo» y los datos
  // de los que saldrán sus estadísticas. Hermana de `agendaEnabled` en
  // forma (columna booleana por tenant, ADR-R6) y de `cajaEnabled` /
  // `fichajeEnabled` / `clinicalRecordsEnabled` en gobierno: la mueve SÓLO
  // el super-admin, porque **se cobra por pantalla** (cocina + barra = dos).
  // Por eso no aparece en el POST de /admin/tenant/settings.
  //
  // `@default(false)`: apagada, la hostelería se comporta exactamente como
  // antes de este bloque — ni pantalla, ni banda «LISTO», ni eventos
  // nuevos. Lo único que cambia con el módulo apagado es que el envío a la
  // impresora deja de reimprimir la mesa entera, y eso es un arreglo.
  //
  // Lo que NO va detrás de esta capability: los **alérgenos del producto**
  // y las **alergias por silla**, que la decisión 10 pone de serie en todo
  // TPV de hostelería (obligación legal de informar). Sin pantalla, la
  // alergia sale en el papel de la comanda.
  kitchenDisplayEnabled          Boolean           @default(false) @map("kitchen_display_enabled")
  // residencia-1 (D-48) · capability de la RESIDENCIA DE MAYORES.
  // Hermana de `clinicalRecordsEnabled` en forma (columna booleana por
  // tenant, ADR-R6) y en gobierno: la mueve SÓLO el super-admin, porque
  // encenderla es vender un producto —y el producto trae datos de salud
  // detrás, igual que la clínica.
  //
  // `@default(false)`: ninguno de los quince tenants de hoy es una
  // residencia, y con la columna apagada **todo este bloque no existe**
  // para ellos. Las rutas de residencia responden **404 y no 403**, por lo
  // mismo que las clínicas: a un bar no se le cuenta que este módulo
  // existe (ver `residencia/gate.ts`).
  //
  // Y no se puede encender sin la clínica: el residente es un `Client` con
  // historia (D-49), así que `residencia_enabled` sin
  // `clinical_records_enabled` sería un módulo cuyo dato central no se
  // puede ni leer. Lo garantiza el CHECK
  // `tenants_residencia_exige_clinica` de la migración, no sólo el 409 de
  // la ruta del super-admin.
  residenciaEnabled              Boolean           @default(false) @map("residencia_enabled")
  // B-reservas-8 · capability de los BONOS DE SESIONES (ADR-R6, ADR-R9).
  // Hermana de `crmEnabled` y `agendaEnabled` en forma (columna booleana
  // por tenant) y de `cajaEnabled` / `clinicalRecordsEnabled` en gobierno:
  // la mueve SÓLO el super-admin, porque encenderla es vender un módulo.
  //
  // `@default(false)`: ninguno de los tenants de hoy vende bonos en el TPV
  // y con la columna apagada **este bloque no existe** para ellos (404 en
  // todas sus rutas, igual que la clínica).
  //
  // Y NO se puede encender con Holded conectado. La decisión es de
  // Dirección (18-10) y la razón es que un ticket de canje a 0 € subido a
  // Holded es terreno desconocido: nadie lo necesita hoy (Sole sale de
  // Holded, la clínica y el spa no lo tienen). El 409 vive en la ruta del
  // super-admin y el CHECK `tenants_bonos_sin_holded` en la BASE —las dos,
  // porque hay cuatro puertas de escritura a esta tabla y sólo el motor
  // cubre las cuatro (misma lección que `products_exencion_sin_iva`).
  bonosEnabled                   Boolean           @default(false) @map("bonos_enabled")
  // B-reservas-8 · qué hace el centro con la sesión apartada de una cita
  // marcada como NO-SHOW. `consumir` (el default, que es lo que hace el
  // spa) o `liberar`. Texto con CHECK y no enum, por la razón de siempre
  // en esta casa: un enum de Postgres sólo crece y parte la migración en
  // dos (`tenants_bono_no_show_valido`).
  bonoNoShow                     String            @default("consumir") @map("bono_no_show")
  // B-reservas-8 · LA PALABRA que ve el centro. En el código es `Voucher`
  // / «bono» y no se discute más (`07` §1); de cara al mostrador el spa
  // dirá «programa» y la clínica «bono». Es un ajuste del negocio, así que
  // sí entra en el POST de /admin/tenant/settings.
  bonoEtiqueta                   String            @default("bono") @map("bono_etiqueta") @db.VarChar(20)
  // B-reservas-8 · el importe de la línea del servicio al CONSUMIR una
  // sesión. `LINEA_CERO` (default) o `PRORRATEO`. Es el frente **P5** de
  // la asesoría (ADR-R9 §6): el bloque lo deja parametrizado y con test
  // por los dos lados, y `bonosEnabled` no se enciende en ninguna cuenta
  // real hasta que la respuesta esté escrita en el ADR.
  bonoModoCanje                  String            @default("LINEA_CERO") @map("bono_modo_canje")
  // B-reservas-8 · caducidad POR DEFECTO de un bono nuevo, en MESES DE
  // CALENDARIO. NULL = sin caducidad, que es el default del bloque (los
  // programas de Raquel Torres no caducan, decisión suya). La plantilla
  // del producto puede fijar la suya y manda sobre ésta.
  bonoCaducidadMeses             Int?              @map("bono_caducidad_meses")
  // v1.3-Thalia Lote 6 · pie de ticket personalizado. NULL = no se
  // pinta nada extra (comportamiento previo). Si está set, el renderer
  // del ticket lo pinta arriba del QR/CIF tras el "Gracias por tu
  // visita". Limitado a 200 caracteres en el endpoint admin para no
  // descuajeringar el layout (~5 líneas en 80mm).
  receiptFooter                  String?           @map("receipt_footer")
  // v1.3-hotfix6 · subvertical del tenant para elegir el icono
  // placeholder de la grid del TPV cuando un producto/servicio no
  // tiene imagen. NULL = icono genérico del businessType. Valores
  // soportados: "haircut", "medical", "auto_repair", "beauty",
  // "fitness", "education" (texto libre, el TPV mapea a icono lucide).
  tpvIconPreset                  String?           @map("tpv_icon_preset")
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                      DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  users                         User[]
  stores                        Store[]
  devices                       Device[]
  pairingCodes                  PairingCode[]
  products                      Product[]
  contacts                      Contact[]
  warehouses                    Warehouse[]
  taxes                         TenantTax[]
  tickets                       Ticket[]
  refunds                       Refund[]
  syncOutbox                    SyncOutbox[]
  holdedUploads                 HoldedUpload[]
  modifierGroups                ModifierGroup[]
  tagAliases                    TagAlias[]
  tagSections                   TagSection[]
  tagVisitTypes                 TagVisitType[]
  reconciliationRuns            ReconciliationRun[]
  clients                       Client[]
  serviceSchedulings            ServiceScheduling[]
  resources                     Resource[]
  staffProfiles                 StaffProfile[]
  staffSkills                   StaffSkill[]
  staffShifts                   StaffShift[]
  appointments                  Appointment[]
  bookingBlocks                 BookingBlock[]
  bookingPolicies               BookingPolicy[]
  centerHours                   CenterHours[]
  centerDays                    CenterDay[]
  // B-reservas-8 · los bonos de sesiones, su libro, sus plantillas y el
  // contador de su numeración. `vouchers` y `voucherMovements` cuelgan con
  // Cascade: el libro es del tenant y se va con él —el candado de ADR-021
  // §6 («Eliminar cuenta» es la única puerta) lo pone el trigger
  // append-only, no la clave ajena.
  voucherTemplates              VoucherTemplate[]
  vouchers                      Voucher[]
  voucherMovements              VoucherMovement[]
  voucherSequence               VoucherSequence?
  // F1 (ADR-018) · el registro de jornada.
  employees                     Employee[]
  // V1-verifactu (ADR-019) · los registros de facturación de sus cajas.
  fiscalRecords                 FiscalRecord[]
  // clinica-1 · la historia clínica. Las cuatro cuelgan con RESTRICT, no
  // con Cascade: un tenant con historia NO SE BORRA. Ver el comentario de
  // cada modelo.
  clinicalAccesses              ClinicalAccess[]
  clinicalAccessLogs            ClinicalAccessLog[]
  clinicalEntries               ClinicalEntry[]
  clinicalAddenda               ClinicalAddendum[]
  // clinica-2 · las valoraciones iniciales y las correcciones del sanitario.
  // RESTRICT al otro lado, como todo lo clínico: un tenant con historia no
  // se borra.
  clinicalAssessments           ClinicalAssessment[]
  clinicalAssessmentCorrections ClinicalAssessmentCorrection[]
  // clinica-4 · los consentimientos firmados, las fotos clínicas y las
  // entregas de informes. Las tres con RESTRICT al otro lado: un tenant
  // con historia no se borra. `consents` lo gana en este bloque — antes
  // la tabla no tenía ni FK al tenant.
  consents                      ClientConsent[]
  clinicalPhotos                ClinicalPhoto[]
  reportDeliveries              ClinicalReportDelivery[]
  // enlaces-publicos · todos los enlaces públicos del negocio, de cualquier
  // `purpose`. RESTRICT al otro lado: un tenant con enlaces no se borra.
  publicLinks                   PublicLink[]
  // clinica-7 · el contrato de encargado que la dueña aceptó (y sus
  // revocaciones), y LA CLAVE de esta clínica. Las dos con RESTRICT: un
  // tenant con contrato aceptado o con clave no se borra — y la clave es
  // además lo único que hace legible su historia.
  processorAgreements           ClinicalProcessorAgreement[]
  clinicalKey                   ClinicalTenantKey?
  KitchenDispatch               KitchenDispatch[]
  // residencia-1 · los cimientos de la residencia. `residentProfiles`,
  // `bedAssignments` y `careRoleAssignments` cuelgan con RESTRICT (un
  // centro con residentes dentro no se borra, igual que uno con historia);
  // el edificio y los turnos con Cascade, que es configuración y se va con
  // el centro. Ver el comentario de cada modelo.
  residentProfiles              ResidentProfile[]
  floors                        Floor[]
  rooms                         Room[]
  beds                          Bed[]
  bedAssignments                BedAssignment[]
  careRoles                     CareRole[]
  careRoleAssignments           CareRoleAssignment[]
  // residencia-2 · el catálogo propio del centro (los `STANDARD` no
  // cuelgan de ningún tenant), sus ajustes de cada control, sus momentos
  // del día, sus plantillas por nivel y el plan de sus residentes.
  controlTypes                  ControlType[]
  centerControlSettings         CenterControlSetting[]
  centerMoments                 CenterMoment[]
  carePlanTemplateItems         CarePlanTemplateItem[]
  carePlanItems                 CarePlanItem[]
  careZoneAssignments           CareZoneAssignment[]
  centerShifts                  CenterShift[]
  // residencia-3 · el registro de cuidados y los PIN de la puerta.
  careRecords                   CareRecord[]
  carePins                      CarePin[]
  // pin-1 · los cambios de PIN de este comercio (quién, a quién,
  // provisional o propio). Sin el PIN.
  pinChanges                    PinChange[]
  // residencia-4 · el libro de incidencias con sus acciones, enlaces y
  // comunicaciones a familia; los avisos y los turnos de guardia; las
  // excepciones de umbral de sus residentes y su configuración de
  // guardia.
  //
  // **La plantilla de gravedad NO está aquí**: es del producto (D-65), no
  // tiene `tenant_id` y la ven todos los centros, igual que los
  // `ControlType` de `scope STANDARD`.
  incidents                     Incident[]
  incidentLinks                 IncidentLink[]
  incidentActions               IncidentAction[]
  familyCommunications          FamilyCommunication[]
  guardAlerts                   GuardAlert[]
  guardShiftSessions            GuardShiftSession[]
  guardSetting                  CenterGuardSetting?
  thresholdOverrides            ResidentThresholdOverride[]
  // residencia-5 · el parte de relevo de cada turno con sus zonas, sus
  // confirmaciones y lo que llegó tarde; las obligaciones de dirección
  // con sus ocurrencias; y los umbrales objetivo de los indicadores.
  //
  // El relevo cuelga con `Restrict` por lo mismo que el libro: es la
  // evidencia de que la información pasó de un turno a otro, y se
  // conserva. Las obligaciones, con `Cascade`: son la agenda de la
  // dirección del centro, no un dato de salud, y se van con el centro.
  handovers                     Handover[]
  handoverZones                 HandoverZone[]
  handoverAcks                  HandoverAck[]
  handoverAckZones              HandoverAckZone[]
  handoverLateAdditions         HandoverLateAddition[]
  managementDuties              ManagementDuty[]
  dutyOccurrences               DutyOccurrence[]
  indicatorTargets              IndicatorTarget[]

  // calidad-1 (D-70 a D-73) · el mapa de procesos y lo que cuelga de él.
  // El mapa, los riesgos, los objetivos y de qué proceso cuelga cada
  // indicador se van con el centro (`Cascade`): son su configuración de
  // calidad, no evidencia clínica. Las **no conformidades** y todo su
  // expediente, no (`Restrict`): son la evidencia de la mejora ante una
  // certificadora y una inspección, y se conservan como el libro.
  processes                     Process[]
  indicatorProcesses            IndicatorProcess[]
  risks                         RiskOpportunity[]
  qualityObjectives             QualityObjective[]
  nonConformities               NonConformity[]
  correctiveActions             CorrectiveAction[]
  correctiveActionEvidences     CorrectiveActionEvidence[]
  effectivenessVerifications    EffectivenessVerification[]

  // personal-1 · el catálogo de categorías profesionales, el cuadrante
  // mensual con sus celdas y su registro de cambios, y los parámetros de
  // las reglas.
  //
  // El catálogo y los ajustes se van con el centro (`Cascade`): son su
  // configuración. El cuadrante también, y es deliberado: lo que se
  // conserva cuatro años es el REGISTRO de jornada (`time_entries`, que
  // cuelga con su propio trigger de no-borrado), no lo que estaba
  // previsto. Un cuadrante publicado no se borra —lo impide
  // `staff_schedules_delete_guard`— salvo que el tenant entero se vaya,
  // que es la única escapatoria que el trigger admite.
  employeeCategories            EmployeeCategory[]
  staffSchedules                StaffSchedule[]
  staffScheduleCells            StaffScheduleCell[]
  staffScheduleChanges          StaffScheduleChange[]
  staffRuleSettings             StaffRuleSettings?

  // v1.3-SuperAdmin-Hub Lote 3 · el backfill y el hub buscan/listan
  // tenants por `holded_account_id`. Sin índice eran scans completos
  // de tabla; con 1 tenant es invisible, pero ya documentamos el
  // patrón de acceso por si crecemos.
  @@index([holdedAccountId])
  @@map("tenants")
}

// v1.3-Operativa-Extra Lote 1 · mapeo "slug Holded → label TPV" editable
// por OWNER/MANAGER. El TPV consulta este mapa al renderizar los chips
// de categoría: si encuentra una entrada para el tag (en lowercase
// como llega de Holded) usa el `label`, si no cae al `capitalizeTag`
// del hotfix5. Permite que el cliente renombre "01cortesypeinados" →
// "Cortes y peinados" sin tocar los productos en Holded.
model TagAlias {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  slug      String   @db.VarChar(60)
  label     String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@map("tag_aliases")
}

// v1.4-Bar-Operativa-MVP Lote 2 · mapeo `tag → KitchenSection` por
// tenant. Cuando el cajero pulsa "Enviar comanda" en una mesa abierta,
// el endpoint busca los tags de cada producto, los cruza con este
// mapa y agrupa las líneas en BARRA / COCINA / SALON. Una línea
// cuyos tags no estén mapeados cae a SALON (default razonable: el
// camarero la sirve directamente). El OWNER/MANAGER mantiene este
// mapa desde el admin.
model TagSection {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  slug      String         @db.VarChar(60)
  section   KitchenSection
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@map("tag_sections")
}

// clinica-5 · mapeo `tag → tipo de visita` por tenant. EL MISMO PATRÓN que
// `TagSection` de arriba, y no es una coincidencia: S5 («Agrupar
// servicios», decidido el 07-10) eligió este patrón precisamente porque ya
// existía y resuelve lo mismo —un grupo que el centro crea apuntando a un
// comportamiento de una lista cerrada en código.
//
// Rosario marca «Podología → Quiropodia» una vez y todos los servicios de
// esa categoría lo heredan. De ahí sale qué tarjeta abre la sesión y de
// qué tipo se cobra cada línea.
//
// ── Por qué el tipo es TEXTO con CHECK y no un enum de Postgres ───────
//
// La misma razón que `products.exemption_cause` (iva-exento-sanitario), y
// la factura ya está pagada tres veces: un `enum` de Postgres sólo crece
// (`ALTER TYPE … DROP VALUE` no existe) y **no se puede usar un valor
// nuevo en la misma transacción en la que se añade**, así que cada valor
// nuevo obliga a partir la migración en dos. clinica-1, -2 y -3 lo
// pagaron. Con los cinco códigos escritos en el CHECK, admitir un tipo
// nuevo es desplegar y migrar una sola vez.
//
// El CHECK vive en la migración (`tag_visit_types_tipo_valido`) y no es
// expresable en Prisma 5. CONSECUENCIA A VIGILAR: `prisma migrate dev` lo
// verá como deriva y ofrecerá borrarlo. NO aceptar — el guardia es
// `apps/api/test/clinica-tipos-migracion.test.ts`.
//
// ── Por qué no cuelga del producto ───────────────────────────────────
//
// Porque sería el cuarto agrupador. S5 lo dejó dicho: un producto puede
// tener varias etiquetas y el agrupador único del TPV es la categoría.
// Poner el tipo en cada servicio habría obligado a Rosario a marcarlo
// ciento veinte veces y a que el catálogo de la caja y el de la agenda
// pudieran discrepar.
model TagVisitType {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  slug      String   @db.VarChar(60)
  // QUIROPODIA | PIE_RIESGO | CIRUGIA | BIOMECANICA | GENERAL. La lista
  // cerrada vive en `@mipiacetpv/clinica-sesion` (`TIPOS_DE_VISITA`) y el
  // CHECK de la migración la repite: es el único sitio que cubre las
  // cuatro puertas de escritura a esta tabla (ADR-015 §1).
  visitType String   @map("visit_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug])
  @@map("tag_visit_types")
}

// Tipos de IVA del catálogo Holded del tenant. Spike §03.A: array de 103
// elementos en sandbox, indexamos por holded_tax_id (string tipo
// "s_iva_21") y por rate numérico. Permite mapeo bidireccional al
// construir el payload de líneas.
model TenantTax {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  holdedTaxId String   @map("holded_tax_id")
  rate        Decimal? @db.Decimal(5, 2)
  name        String?
  raw         Json?
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, holdedTaxId])
  @@index([tenantId, rate])
  @@map("tenant_taxes")
}

model User {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  email                  String        @unique
  // v1.7-alias-cajeros: nombre visible del cajero ("María"). Sustituye
  // al email en todos los puntos de display (TPV, ticket, comandas,
  // informe Z, admin); el email queda como credencial y canal.
  // Nullable en BD por filas legacy de otros roles — la API lo exige
  // al crear cajeros y hace fallback a la local-part del email al
  // mostrar. Unicidad por tenant entre cajeros activos validada en la
  // API (case-insensitive), no como constraint: "María" puede existir
  // en dos tenants distintos.
  alias                  String?       @map("alias")
  passwordHash           String?       @map("password_hash")
  // PIN sólo lo tienen cajeros/encargados que tocan el TPV físico.
  pinHash                String?       @map("pin_hash")
  // pin-1 · **EL PIN QUE HAY PUESTO NO ES SUYO TODAVÍA.**
  //
  // `NULL` = el PIN es propio: lo eligió la persona. Con valor = es
  // PROVISIONAL, lo puso alguien por ella (la propietaria desde Cajeros,
  // o Mi Piace como último recurso), y no sirve más que para entrar UNA
  // vez al TPV y elegir el suyo.
  //
  // Un PIN provisional **no abre nada**: no emite sesión de cajero (el
  // login contesta `mustChoosePin`), no autoriza un descuento ni un
  // cierre con incidencia, y no viaja en el roster offline. Las cinco
  // puertas que verifican un `pin_hash` lo filtran, y hay un test por
  // cada una: que falte en una sola es un PIN prestado que sí cobra.
  //
  // Nullable y SIN default a propósito: las filas de hoy se quedan en
  // `NULL`, o sea con PIN PROPIO. Nadie se queda fuera al desplegar —
  // los quince terminales en producción siguen entrando con el PIN que
  // tienen teclado desde hace meses.
  //
  // El CHECK `users_pin_provisional_exige_pin` impide la fila sin
  // sentido (marca de provisional sin PIN). Por eso revocar a un cajero
  // y purgar el cajero técnico, que ponen `pin_hash = NULL`, limpian
  // esto en la misma escritura.
  pinProvisionalAt       DateTime?     @map("pin_provisional_at") @db.Timestamptz()
  role                   UserRole
  // Incrementa con `POST /auth/logout-everywhere` (B2 §4.3). Los
  // refresh tokens llevan este `tv` en su payload; si no coincide con
  // el de BD, el refresh se rechaza. Permite invalidación masiva sin
  // mantener una blacklist por jti.
  tokenVersion           Int           @default(0) @map("token_version")
  // 2FA TOTP (§17.3). Secret AES-GCM versionado (`v1:` prefix) con la
  // misma clave que la API key Holded. `twoFactorEnabledAt` actúa como
  // flag y timestamp: NULL → 2FA off; valor → on.
  twoFactorSecret        String?       @map("two_factor_secret")
  twoFactorEnabledAt     DateTime?     @map("two_factor_enabled_at") @db.Timestamptz()
  // Array JSON de objetos `{ hash: <argon2id>, usedAt: ISO|null }`.
  // Códigos de un solo uso; cuando se usa uno se marca `usedAt` (no se
  // borra para que el contador del admin pueda mostrar "X/10 sin
  // usar").
  twoFactorRecoveryCodes Json?         @map("two_factor_recovery_codes")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  lastLoginAt            DateTime?     @map("last_login_at") @db.Timestamptz()
  // B-SuperAdmin: cuando un super-admin crea un OWNER, su password
  // temporal viene marcada con must_change_password_at = now(). El
  // siguiente login redirige obligatoriamente a /change-password-initial.
  // Al cambiarla se pone a NULL y se incrementa tokenVersion.
  mustChangePasswordAt   DateTime?     @map("must_change_password_at") @db.Timestamptz()
  // B-OnboardingV2: marca el cajero técnico que el equipo mipiacetpv usa
  // para probar el TPV antes de que el cliente toque nada. El worker
  // `ticket-upload-worker` mira este flag (a través de `ticket.user`)
  // para NO subir el ticket a Holded; el worker de email lo skipea para
  // no mandar correos a clientes reales. Al activar el tenant
  // (POST /super-admin/tenants/:id/activate), los tickets TEST se
  // borran y este user queda soft-deleted (deletedAt poblado abajo).
  isTestCashier          Boolean       @default(false) @map("is_test_cashier")
  // B-OnboardingV2: soft-delete del cajero técnico tras activar el
  // tenant. Permite conservar histórico ligero sin que la UI lo liste.
  // Sólo se aplica a usuarios `isTestCashier=true`; los OWNER/MANAGER/
  // CASHIER reales se bloquean vía `Tenant.blockedAt` o
  // `User.tokenVersion`. No se reutiliza para borrado de usuarios reales.
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz()
  // clinica-2 · EL ACTOR DE SISTEMA. Hoy hay uno y sólo uno: «Paciente (por
  // enlace)», el autor de las respuestas que el paciente teclea desde el
  // enlace del email o desde la tablet.
  //
  // Por qué existe: `ClinicalEntry.authorUserId` y
  // `ClinicalAccessLog.userId` son NOT NULL con RESTRICT, y eso no es un
  // descuido de clinica-1 — es la garantía legal de que ninguna línea de
  // historia es anónima. El paciente no es un `User`, pero SÍ es un actor
  // que escribe en su historia. Así que se le da una fila: la autoría sigue
  // siendo NOT NULL, el registro de accesos no necesita un caso especial, y
  // la pantalla puede escribir «Respondió el paciente» leyendo un `alias`
  // como para cualquier otro autor.
  //
  // La alternativa era relajar esos NOT NULL con una columna
  // discriminadora. Se descarta: convertir «ninguna línea sin autor» en
  // «ninguna línea sin autor, salvo estas» es perder la invariante entera
  // para ahorrar una fila.
  //
  // **No puede autenticarse NUNCA**, y no por omisión: el CHECK
  // `users_system_actor_no_credentials` prohíbe que tenga `passwordHash` o
  // `pinHash`. Sin hash no hay login de panel (exige password) ni de TPV
  // (exige PIN), y la prohibición vive en el motor y no en la confianza de
  // que nadie le ponga uno.
  //
  // Tampoco sale en ninguna lista de personas (`GET /cashiers`,
  // `GET /staff`, candidatos a PIN, colisión de alias): es un actor, no
  // alguien a quien dar de alta o quitar.
  isSystemActor          Boolean       @default(false) @map("is_system_actor")
  // clinica-1 · LA MARCA SANITARIA, separada del rol de negocio.
  //
  // Decisión de producto (Matías, 05-10-2026): en pantalla se ven tres
  // nombres —cajero, cajero-sanitario, sanitario— pero por dentro el rol
  // y la marca son dos columnas. Así mañana cabe otro rol de negocio sin
  // rehacer permisos, y una dueña o un encargado pueden ser sanitarios sin
  // dejar de ser dueña o encargado. Una dueña NO sanitaria administra el
  // negocio y no ve historias.
  //
  // `role = CLINICIAN` implica esto en true, garantizado por el CHECK
  // `users_clinician_implies_flag` (migración `clinica_1_historia`).
  isClinician            Boolean       @default(false) @map("is_clinician")
  // Nº de colegiado. Opcional EN LA BASE y **exigido por la API** al
  // marcar a alguien como sanitario de un tenant con la clínica
  // encendida: la condición cruza `users` y `tenants`, así que no cabe en
  // un CHECK. Lo que sí hay en la base es que no se guarde en blanco
  // (`users_clinician_license_not_blank`) — un colegiado " " convierte
  // "tiene colegiado" en una comprobación que miente.
  clinicianLicense       String?       @map("clinician_license")
  // A cuántos pacientes alcanza. Sólo significa algo si `isClinician`.
  // Default `SELECTION` a propósito: lo seguro es lo restrictivo.
  clinicalScope          ClinicalScope @default(SELECTION) @map("clinical_scope")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shifts              Shift[]              @relation("ShiftOpenedBy")
  closedShifts        Shift[]              @relation("ShiftClosedBy")
  tickets             Ticket[]
  voidedTickets       Ticket[]             @relation("TicketVoidedBy")
  pairingCodes        PairingCode[]
  resetTokens         PasswordResetToken[]
  refunds             Refund[]
  emailJobsAsked      TicketEmailJob[]
  printIntents        PrintIntent[]
  // B-reservas-3 · el `user` ES el profesional (ADR-R1: no tabla Staff
  // paralela). Perfil de agenda 1:1, matriz de skills y turnos.
  staffProfile        StaffProfile?
  staffSkills         StaffSkill[]
  staffShifts         StaffShift[]
  // kds-1-cocina · quién envió cada comanda, quién marchó cada tiempo,
  // quién anuló unidades ya enviadas y quién marcó «Servido». Las cuatro
  // son RESTRICT: el registro de quién anuló lo enviado es, sin PIN, la
  // única protección contra anular para quedarse con el dinero
  // (decisión 6), así que no puede quedarse huérfano.
  kitchenDispatches   KitchenDispatch[]
  firedCourses        TicketCourse[]
  voidedKitchenLines  KitchenOrderLine[]   @relation("KitchenOrderLineVoidedBy")
  servedKitchenOrders KitchenOrder[]       @relation("KitchenOrderServedBy")

  // F1 (ADR-018) · si este usuario es además un empleado que ficha. La
  // relación es opcional y en un solo sentido: un profesor que sólo ficha
  // no tiene `User`, y un propietario que no ficha no tiene `Employee`.
  // NO hay enlace a `StaffProfile`: eso es la agenda (quién atiende qué
  // servicio), y fichar no es atender.
  //
  // Lista por exigencia de Prisma, no porque pueda haber varios: la
  // unicidad de verdad es `@@unique([tenantId, userId])` en `Employee`, y
  // un `User` pertenece a un solo tenant, así que como mucho hay uno.
  employees Employee[]

  // personal-1 · los cuatro papeles de este usuario en el cuadrante: quién
  // lo creó, quién lo publicó, quién firmó un cambio y quién cambió los
  // parámetros de las reglas. Los cuatro con `SetNull` al otro lado: borrar
  // a quien publicó un cuadrante no puede borrar el cuadrante, y el nombre
  // queda congelado en `publishedBy` / `author` para que la firma no
  // enmudezca.
  staffSchedulesCreated   StaffSchedule[]       @relation("StaffScheduleCreatedBy")
  staffSchedulesPublished StaffSchedule[]       @relation("StaffSchedulePublishedBy")
  staffScheduleChanges    StaffScheduleChange[] @relation("StaffScheduleChangeAuthor")
  staffRuleSettingsSet    StaffRuleSettings[]   @relation("StaffRuleSettingsUpdatedBy")

  // clinica-1 · los cuatro papeles que un usuario puede tener en la
  // historia clínica. Listas por exigencia de Prisma; lo que importa de
  // ellas es el `onDelete` que llevan las FKs al otro lado (ver cada
  // modelo): RESTRICT en lo que es autoría o acceso, SET NULL en el
  // "por quién" de una concesión.
  clinicalAccesses        ClinicalAccess[]               @relation("ClinicalAccessClinician")
  clinicalAccessesGiven   ClinicalAccess[]               @relation("ClinicalAccessGrantedBy")
  clinicalAccessesTaken   ClinicalAccess[]               @relation("ClinicalAccessRevokedBy")
  clinicalAccessLogs      ClinicalAccessLog[]
  clinicalEntries         ClinicalEntry[]
  clinicalAddenda         ClinicalAddendum[]
  // clinica-2 · los tres papeles en una valoración: quién mandó el test,
  // quién la validó y quién firmó cada corrección. Los dos primeros son del
  // personal; el tercero también (el paciente no corrige: contesta).
  assessmentsRequested    ClinicalAssessment[]           @relation("AssessmentRequestedBy")
  assessmentsValidated    ClinicalAssessment[]           @relation("AssessmentValidatedBy")
  assessmentCorrections   ClinicalAssessmentCorrection[]
  // clinica-4 · los cuatro papeles de este bloque: quién informó un
  // consentimiento, quién hizo una foto, quién la retiró y quién entregó
  // un informe. Los cuatro con RESTRICT al otro lado: es autoría.
  consentsInformed        ClientConsent[]                @relation("ClientConsentInformer")
  clinicalPhotos          ClinicalPhoto[]                @relation("ClinicalPhotoAuthor")
  clinicalPhotosWithdrawn ClinicalPhoto[]                @relation("ClinicalPhotoWithdrawnBy")
  reportDeliveries        ClinicalReportDelivery[]       @relation("ClinicalReportDeliveryUser")
  // enlaces-publicos · los enlaces públicos que esta persona creó (mandar el
  // test, reenviar «mi cita»). RESTRICT: quién creó un enlace es parte de lo
  // que el registro puede contestar.
  publicLinksCreated      PublicLink[]                   @relation("PublicLinkCreatedBy")
  // residencia-1 (D-50, D-51) · el rol de CUIDADO y la ZONA, que no son
  // el rol de negocio. `UserRole` no se toca en este bloque: una auxiliar
  // es `CASHIER` o `CLINICIAN` en el TPV y «auxiliar de planta 1» en la
  // residencia, y las dos cosas viven en columnas distintas.
  //
  // Son LISTAS y no columnas porque las dos son muchos-a-muchos CON
  // VIGENCIA: una persona puede ser TO y Calidad a la vez (decisión de
  // producto 3) y puede cubrir dos plantas. Y no se borran: revocar
  // rellena `revokedAt` y volver a dar crea otra fila, mismo criterio que
  // `ClinicalAccess`.
  careRoleAssignments     CareRoleAssignment[]           @relation("CareRoleAssignmentUser")
  careRolesGranted        CareRoleAssignment[]           @relation("CareRoleAssignmentGrantedBy")
  careRolesRevoked        CareRoleAssignment[]           @relation("CareRoleAssignmentRevokedBy")
  careZoneAssignments     CareZoneAssignment[]           @relation("CareZoneAssignmentUser")
  careZonesGranted        CareZoneAssignment[]           @relation("CareZoneAssignmentGrantedBy")
  bedAssignmentsCreated   BedAssignment[]                @relation("BedAssignmentCreatedBy")
  // residencia-2 · quién abrió y quién cerró una línea del plan. `SetNull`
  // a los dos lados: dar de baja a la DUE no borra que ajustó el plan.
  carePlanItemsCreated    CarePlanItem[]                 @relation("CarePlanItemCreatedBy")
  carePlanItemsClosed     CarePlanItem[]                 @relation("CarePlanItemClosedBy")

  // residencia-3 · lo que esta persona FIRMÓ en la puerta, y lo que
  // anuló. `Restrict` al otro lado: es la evidencia de quién hizo el
  // cuidado, así que esta persona ya no se puede borrar en duro — igual
  // que `ClinicalEntry.authorUserId`.
  careRecords            CareRecord[]                 @relation("CareRecordRecordedBy")
  careRecordsVoided      CareRecord[]                 @relation("CareRecordVoidedBy")
  // Y su PIN de la puerta, que es una credencial y sí se va con ella.
  carePin                CarePin?                     @relation("CarePinUser")
  carePinsSet            CarePin[]                    @relation("CarePinSetBy")
  // residencia-3 (D-64) · las fotos de residente que subió. `SetNull`.
  residentPhotosUploaded ResidentProfile[]            @relation("ResidentPhotoUploadedBy")
  // clinica-7 · las aceptaciones y revocaciones del contrato de encargado
  // que esta persona firmó. RESTRICT al otro lado: un usuario que aceptó
  // el contrato de tratamiento de datos de salud no se borra.
  processorAgreements    ClinicalProcessorAgreement[] @relation("ClinicalProcessorAgreementUser")

  // residencia-4 · lo que esta persona abrió, cerró, hizo, comunicó,
  // acusó y pautó en el libro de incidencias. Todo `Restrict`: es la
  // firma (D-31), y una firma no se queda huérfana.
  incidentsOpened           Incident[]                  @relation("IncidentOpenedBy")
  incidentsClosed           Incident[]                  @relation("IncidentClosedBy")
  incidentActions           IncidentAction[]            @relation("IncidentActionBy")
  familyCommunications      FamilyCommunication[]       @relation("FamilyCommunicationBy")
  guardAlertsAcked          GuardAlert[]                @relation("GuardAlertAckedBy")
  guardShiftSessions        GuardShiftSession[]         @relation("GuardShiftSessionUser")
  guardShiftSessionsEnded   GuardShiftSession[]         @relation("GuardShiftSessionEndedBy")
  thresholdOverridesSigned  ResidentThresholdOverride[] @relation("ThresholdOverrideSignedBy")
  thresholdOverridesRevoked ResidentThresholdOverride[] @relation("ThresholdOverrideRevokedBy")

  // residencia-5 · lo que esta persona confirmó del relevo y lo que marcó
  // hecho de las obligaciones. `Restrict` en las dos firmas, por lo mismo
  // que las de arriba: «lo recibió Ana Isabel, como auxiliar» es la
  // evidencia del bloque y no se queda huérfana.
  //
  // Y ser RESPONSABLE de una obligación es `Restrict` también, no
  // `SetNull`: ver la razón en `ManagementDuty.responsibleUser`.
  handoverAcks             HandoverAck[]     @relation("HandoverAckUser")
  dutyOccurrencesDone      DutyOccurrence[]  @relation("DutyOccurrenceDoneBy")
  dutyOccurrencesCorrected DutyOccurrence[]  @relation("DutyOccurrenceCorrectedBy")
  managementDutiesOwned    ManagementDuty[]  @relation("ManagementDutyResponsible")
  managementDutiesCreated  ManagementDuty[]  @relation("ManagementDutyCreatedBy")
  indicatorTargets         IndicatorTarget[]

  // pin-1 · los dos papeles en un cambio de PIN: a quién se le cambió y
  // quién lo cambió. `Cascade` en el primero (el registro es de esa
  // credencial: si la persona se borra en duro, se va con ella) y
  // `SetNull` en el segundo (dar de baja a la encargada que puso un PIN
  // provisional no puede borrar que se puso).
  pinChanges        PinChange[] @relation("PinChangeTarget")
  pinChangesByMe    PinChange[] @relation("PinChangeActor")

  // calidad-1 · lo de calidad que lleva firma. `Restrict` en todo lo que
  // ES la firma (quién abrió, cerró o verificó) y `SetNull` en lo que
  // sólo dice quién configuró (quién creó un proceso o un riesgo): ser
  // responsable de una acción es `Restrict` por lo mismo que en
  // `ManagementDuty.responsibleUser` — un `SetNull` dejaría la fila sin
  // responsable y su CHECK la rechazaría al ejecutarse.
  processesCreated         Process[]                   @relation("ProcessCreatedBy")
  indicatorProcessesSet    IndicatorProcess[]          @relation("IndicatorProcessUpdatedBy")
  risksCreated             RiskOpportunity[]           @relation("RiskCreatedBy")
  risksReviewed            RiskOpportunity[]           @relation("RiskReviewedBy")
  objectivesCreated        QualityObjective[]          @relation("ObjectiveCreatedBy")
  ncOpened                 NonConformity[]             @relation("NonConformityOpenedBy")
  ncClosed                 NonConformity[]             @relation("NonConformityClosedBy")
  actionsOwned             CorrectiveAction[]          @relation("CorrectiveActionResponsibleUser")
  actionsOpened            CorrectiveAction[]          @relation("CorrectiveActionOpenedBy")
  actionsClosed            CorrectiveAction[]          @relation("CorrectiveActionClosedBy")
  evidencesAdded           CorrectiveActionEvidence[]  @relation("EvidenceBy")
  verificationsSigned      EffectivenessVerification[] @relation("VerificationBy")

  @@index([tenantId])
  @@map("users")
}

/// pin-1 · **EL REGISTRO DE LOS CAMBIOS DE PIN.**
///
/// Punto 7 del bloque: cada cambio queda registrado —quién, a quién,
/// provisional o propio, y por dónde— **sin el PIN**. Ni entero, ni
/// parcial, ni su hash: lo que se guarda es que pasó.
///
/// ── Por qué una tabla y no una línea de log ─────────────────────────
///
/// Porque la pregunta que hay que poder contestar es «¿quién le cambió
/// el PIN a Marta el martes?», y esa se contesta mirando, no buscando en
/// los logs de hace tres semanas. El 27-10 se perdió el PIN de la
/// propietaria dos veces en la misma mañana y lo único que quedó de las
/// dos regeneraciones fue un `request.log.info` que nadie leyó.
///
/// No hay pantalla que lo pinte todavía, y es deliberado: lo que este
/// bloque necesita es que el dato EXISTA desde el primer cambio. Una
/// pantalla sobre una tabla vacía no sirve de nada.
model PinChange {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// A quién se le cambió el PIN.
  targetUserId String @map("target_user_id") @db.Uuid
  /// Quién lo cambió. `NULL` sólo si esa persona se borró en duro
  /// después (ver el `SetNull` de abajo); en el momento de escribirlo
  /// siempre hay alguien.
  actorUserId  String? @map("actor_user_id") @db.Uuid

  /// Qué quedó puesto: un PIN que la persona eligió (`PROPIO`) o uno
  /// prestado que sólo sirve para entrar a elegir el suyo
  /// (`PROVISIONAL`). Es la columna que convierte el registro en algo
  /// que se puede leer: «se lo pusieron» y «lo eligió» no son el mismo
  /// hecho.
  kind   PinChangeKind
  /// Por dónde se hizo. Separa el camino normal (la propia persona desde
  /// el panel o el TPV) del de soporte, que es el que hay que poder
  /// auditar.
  source PinChangeSource

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `Cascade`: el registro es de una CREDENCIAL, igual que `care_pins`.
  /// Lo que no se borra con la persona es lo que firmó, y eso lo impiden
  /// los `Restrict` de autoría.
  target User   @relation("PinChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  /// `SetNull`: dar de baja a la encargada que puso un PIN provisional no
  /// puede borrar que se puso.
  actor  User?  @relation("PinChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("pin_changes")
}

enum PinChangeKind {
  /// Lo eligió la propia persona. Vale para entrar y para autorizar.
  PROPIO
  /// Se lo pusieron. Sólo sirve para entrar una vez a elegir el suyo.
  PROVISIONAL
}

enum PinChangeSource {
  /// Mi cuenta, con la sesión del panel.
  PANEL
  /// El TPV, con la sesión de cajero (o la pantalla que obliga a elegir
  /// tras un PIN provisional).
  TPV
  /// Cajeros / Personal: la propietaria o el encargado se lo ponen a
  /// alguien del personal.
  PERSONAL
  /// Mi Piace, por «Configurar como OWNER» → «Regenerar PIN». El último
  /// recurso, y el que más falta hace poder mirar después.
  SOPORTE
}

model Store {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  name               String
  fiscalAddress      Json?             @map("fiscal_address")
  warehouseHoldedId  String?           @map("warehouse_holded_id")
  // Config de entrega del ticket digital (B-Print fase 1):
  //   {
  //     emailAutoIfCustomerHasEmail: boolean,
  //     showQrButton: boolean,
  //     showDownloadButton: boolean,
  //     showViewButton: boolean,
  //     emailSubject: string,
  //     emailBody: string,
  //     qrCaption: string
  //   }
  // Defaults sensatos al crear (todo true, plantillas ES). El TPV lo
  // lee al cobrar para mostrar los botones correctos en post-cobro.
  ticketDelivery     Json?             @map("ticket_delivery")
  // ── kds-1-cocina · ajustes de cocina POR RESTAURANTE ────────────────
  //
  // Viven en la TIENDA y no en el tenant porque lo que cambia de un local a
  // otro es configuración, no desarrollo (regla de alcance de Matías,
  // 08-10): una cadena con un bar y un restaurante a la carta necesita los
  // dos modos a la vez. Columnas explícitas y no un `Json?` como
  // `ticketDelivery`: el semáforo lo lee la pantalla de cocina en cada
  // repintado y los umbrales tienen que poder llevar CHECK en la base
  // (verde < ámbar, los dos > 0), que un JSON no puede.
  //
  // Los defaults son los de la decisión 3: verde < 10 min, ámbar 10–20,
  // rojo > 20. Una tienda que no los toque se comporta como La Maestranza.
  kitchenGreenMaxMin Int               @default(10) @map("kitchen_green_max_min")
  kitchenAmberMaxMin Int               @default(20) @map("kitchen_amber_max_min")
  kitchenCourseMode  KitchenCourseMode @default(ESPERA) @map("kitchen_course_mode")
  kitchenSeatMode    KitchenSeatMode   @default(ALERGIA) @map("kitchen_seat_mode")
  // Decisión 8: el pitido del «LISTO» del TPV queda como ajuste, APAGADO
  // de serie, por coherencia con «sin sonidos; avisa el parpadeo».
  kitchenReadyBeep   Boolean           @default(false) @map("kitchen_ready_beep")
  /// kds-2-wifi · LA CLAVE DE LA TIENDA del camino directo por la wifi.
  ///
  /// 32 bytes en base64url. Con ella van cifrados y autenticados todos los
  /// mensajes que el TPV manda a la tablet de cocina por la red local
  /// (AES-256-GCM; ver `packages/kitchen-lan`).
  ///
  /// NULL = no hay camino directo en esta tienda. Nace la primera vez que
  /// una pantalla de cocina la pide y **se borra sola al revocar cualquier
  /// aparato de la tienda** — lo hace el trigger `stores_rotate_lan_key`
  /// de la migración, no el código de ninguna ruta.
  ///
  /// Vive en la TIENDA: una cadena con dos bares tiene dos wifis, y la
  /// clave de un local no puede abrir la cocina del otro.
  kitchenLanKey      String?           @map("kitchen_lan_key")
  kitchenLanKeyAt    DateTime?         @map("kitchen_lan_key_at") @db.Timestamptz()
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  // Soft-delete (B4 §0.2). Las FKs a Register/Shift/Ticket son Restrict
  // — borrar duro rompería histórico fiscal. `deletedAt != null` saca la
  // tienda del listado pero preserva todo lo demás.
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registers       Register[]
  tables          Table[]
  kitchenOrders   KitchenOrder[]
  kitchenLanMarks KitchenLanMark[]

  @@index([tenantId])
  @@map("stores")
}

// Mesa lógica del vertical bar/hostelería (B7). El estado (libre /
// ocupada / cobrando) NO se persiste — se deriva en runtime de la
// presencia de un `Ticket` con `status=DRAFT` apuntando a esta mesa.
model Table {
  id                 String    @id @default(uuid()) @db.Uuid
  storeId            String    @map("store_id") @db.Uuid
  name               String
  capacity           Int       @default(2)
  zone               TableZone @default(SALON)
  // Posición opcional en el canvas del admin. Si todas son NULL, el
  // TPV renderiza la zona en grid auto. El canvas drag-and-drop se
  // difiere a un evolutivo; el schema queda preparado.
  positionX          Int?      @map("position_x")
  positionY          Int?      @map("position_y")
  width              Int?
  height             Int?
  // Para zona BARRA: orden del puesto dentro de la barra (B1=1,
  // B2=2, ...). Permite renderizar la barra como array de mini-mesas.
  // NULL fuera de la zona BARRA.
  barSeatIndex       Int?      @map("bar_seat_index")
  // Si esta mesa ha sido absorbida por otra dentro de un grupo (§5.2
  // del prompt B7), apunta a la mesa principal. NULL = mesa autónoma.
  // Se limpia automáticamente al cobrar el ticket principal del grupo.
  groupedIntoTableId String?   @map("grouped_into_table_id") @db.Uuid
  /// auditoria-sirope (#14) · DESDE CUÁNDO ESTÁ PAGADA Y SIN RECOGER.
  ///
  /// El 18-10 se cobró la T6 y la mesa pasó a Libre en el mismo
  /// instante: en el mapa figuraba disponible con el servicio todavía
  /// puesto encima. El camarero que mira la sala desde la barra no sabe
  /// si puede sentar a nadie ahí.
  ///
  /// `NULL` = la mesa no está esperando a que la recojan. Lo pone el
  /// cobro y lo quita «Dejar libre», abrir cuenta nueva o el corte de
  /// día. Vive en el SERVIDOR y no en el navegador porque lo tienen que
  /// ver todas las cajas: el que cobra y el que recoge no son el mismo.
  porRecogerDesde    DateTime? @map("por_recoger_desde") @db.Timestamptz()
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  groupedInto    Table?         @relation("TableGrouping", fields: [groupedIntoTableId], references: [id])
  absorbedTables Table[]        @relation("TableGrouping")
  kitchenOrders  KitchenOrder[]

  @@unique([storeId, name])
  @@index([storeId, zone])
  @@index([groupedIntoTableId])
  @@map("tables")
}

// Caja LÓGICA. Un punto de venta dentro de una tienda. No es un
// dispositivo: para vender necesita además uno o más `device`
// emparejados (§3.2).
model Register {
  id                   String    @id @default(uuid()) @db.Uuid
  storeId              String    @map("store_id") @db.Uuid
  name                 String
  // Serie Holded para los salesreceipt de esta caja. Permite numeración
  // fiscal separada por caja. Nullable: puede crearse sin asignarla y
  // configurarla después.
  numSerieHolded       String?   @map("num_serie_holded")
  // V1-verifactu (ADR-019) · la identidad de esta caja COMO SIF.
  //
  // Cada caja es una instalación de sistema informático de facturación con
  // su serie, su numeración y su cadena de registros. La identidad cuelga de
  // la CAJA y no del dispositivo: si colgara del aparato, cambiar de tablet
  // partiría el SIF en dos y la cadena tendría que empezar de cero.
  //
  // `fiscalSeries` es la serie de la FACTURA SIMPLIFICADA que emite
  // mipiacetpv — `C1`, `C2`… NO es `numSerieHolded`, que es la serie de
  // Holded: mezclarlas es el error exacto que este bloque existe para no
  // cometer. Dos cajas del mismo comercio no pueden compartir serie (lo
  // hace cumplir el trigger `registers_fiscal_series_unique`).
  //
  // `fiscalInstallationId` es el `NumeroInstalacion` del diseño de registro
  // de la AEAT. Se genera UNA vez y es único global: «no puede repetirse
  // nunca», ni siquiera reinstalando el mismo software en el mismo aparato.
  //
  // Las dos son NULL mientras la caja no emita, y se congelan en cuanto hay
  // un registro en su cadena (trigger `registers_fiscal_identity_guard`).
  fiscalSeries         String?   @map("fiscal_series")
  fiscalInstallationId String?   @unique @map("fiscal_installation_id")
  ticketCounter        Int       @default(0) @map("ticket_counter")
  printerConfig        Json?     @map("printer_config")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // Soft-delete (B4 §0.2). Igual que Store.
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  devices        Device[]
  pairingCodes   PairingCode[]
  shifts         Shift[]
  tickets        Ticket[]
  refunds        Refund[]
  printerConfigs PrinterConfig[]
  // V1-verifactu · la cadena de registros de facturación de esta caja.
  fiscalRecords  FiscalRecord[]

  @@index([storeId])
  @@map("registers")
}

// v1.4-Impresoras-Fase-1 Lote 1 · una impresora térmica configurada
// por register. Puede ser USB (la enchufa el cajero a la tablet) o
// WIFI (el backend manda TCP a ip:port). Cada register puede tener
// varias: típico HOSPITALITY → BARRA + COCINA + caja; típico SERVICES
// → un único PrinterConfig USB sin sección.
model PrinterConfig {
  id            String          @id @default(uuid()) @db.Uuid
  registerId    String          @map("register_id") @db.Uuid
  // Etiqueta para el implantador: "Ticket caja", "Comanda BARRA", etc.
  name          String
  mode          PrinterMode
  // WIFI only:
  ipAddress     String?         @map("ip_address")
  port          Int?            @default(9100)
  // Si WIFI: timeout TCP en ms. Default 5s.
  timeoutMs     Int             @default(5000) @map("timeout_ms")
  // Sección lógica para comanderas. NULL = impresora de ticket de
  // cobro (no comandera, no se filtra por sección).
  section       KitchenSection?
  // Si false, no se intenta imprimir (mantenimiento sin borrar).
  active        Boolean         @default(true)
  // Última vez que imprimió OK. Útil para "impresora silenciosa hace 3d".
  lastPrintOkAt DateTime?       @map("last_print_ok_at") @db.Timestamptz()
  // Último error registrado. NULL si último intento OK.
  lastErrorAt   DateTime?       @map("last_error_at") @db.Timestamptz()
  lastErrorMsg  String?         @map("last_error_msg")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  register Register @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId])
  @@index([section])
  @@map("printer_configs")
}

// Navegador físico emparejado a una caja. El token de larga duración
// vive en localStorage del navegador; aquí guardamos sólo su hash.
model Device {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  // residencia-1 · **NULLABLE desde este bloque**, y es el único cambio
  // de este bloque sobre una columna que ya existía.
  //
  // Hasta aquí todo dispositivo colgaba de una caja: el terminal, el del
  // modo prueba y la pantalla de cocina. La puerta de una habitación
  // (`kind = ROOM`) no cuelga de ninguna, porque un tenant de residencia
  // tiene la caja APAGADA y puede no tener ni una `Register` en la base
  // —el alta de tenant no crea ninguna (`superadmin/tenants.ts`).
  //
  // La alternativa era colgar la puerta de una caja técnica, como la
  // tablet de cocina cuelga de la de su bar. Se descartó: habría que
  // inventarse una caja (con su nombre, su serie y su identidad fiscal de
  // SIF) para un centro que no factura, y el día que alguien listara las
  // cajas de Jardín de Gredos vería 49 cajas falsas.
  //
  // Lo que NO cambia al hacerla nullable, y se comprobó una por una:
  //
  //   · El índice parcial `devices_one_active_per_register_key` filtra
  //     `kind = 'TERMINAL'`, así que ninguna fila `ROOM` entra en él.
  //   · El trigger `devices_revoke_previous` sale por la puerta de atrás
  //     con `NEW.kind <> 'TERMINAL'`, así que una puerta nueva no releva
  //     al terminal de nadie. (Lo que SÍ se le añadió es la rama de la
  //     habitación: una puerta nueva releva a la anterior DE SU
  //     HABITACIÓN.)
  //   · Verifactu encadena por `register_id` de `fiscal_records`, que es
  //     otra tabla y sigue NOT NULL. Un `ROOM` no emite registros.
  //
  // Y lo que la sostiene no es la costumbre: el CHECK
  // `devices_register_o_habitacion` exige **caja y no habitación** en todo
  // lo que no es `ROOM`, y **habitación y no caja** en un `ROOM`.
  registerId         String?              @map("register_id") @db.Uuid
  // residencia-1 (D-52) · QUÉ PUERTA ES ESTA TABLET. Sólo puede tener
  // valor en un `kind = ROOM`, y en un `ROOM` es obligatorio: mismo CHECK
  // que la columna de arriba.
  roomId             String?              @map("room_id") @db.Uuid
  name               String?
  pairedAt           DateTime             @default(now()) @map("paired_at") @db.Timestamptz()
  lastSeenAt         DateTime?            @map("last_seen_at") @db.Timestamptz()
  userAgent          String?              @map("user_agent")
  // V1-verifactu addendum 1b · terminal de caja o dispositivo técnico del
  // modo prueba. Ver `DeviceKind`. Default TERMINAL: todo lo emparejado con
  // un código lo es, y el modo prueba lo pone explícito al crearlo.
  kind               DeviceKind           @default(TERMINAL)
  deviceTokenHash    String               @unique @map("device_token_hash")
  // Si está revocado, la PWA detecta el rechazo y vuelve a la pantalla
  // de emparejamiento.
  revokedAt          DateTime?            @map("revoked_at") @db.Timestamptz()
  // V1-verifactu (ADR-019) · POR QUÉ se revocó, y a favor de quién.
  //
  // Desde este bloque una caja tiene UN TERMINAL activo, garantizado por
  // el índice parcial `devices_one_active_per_register_key` (no expresable
  // en Prisma; vive en la migración, y filtra `kind = 'TERMINAL'` — el
  // dispositivo del modo prueba no compite por la cadena de la caja).
  // Emparejar uno nuevo revoca el
  // anterior en la misma transacción, y estas dos columnas dejan la traza:
  // un laboratorio emparejado por error a la caja de un cliente se ve el
  // mismo día en el super-admin, en vez de descubrirse cuando la cadena de
  // esa caja ya está rota.
  //
  // NULL en todo lo revocado antes de este bloque: no sabemos por qué se
  // hizo y no se inventa.
  revokedReason      DeviceRevokedReason? @map("revoked_reason")
  revokedByDeviceId  String?              @map("revoked_by_device_id") @db.Uuid
  // ISO 3166-1 alfa-2 del país de la última IP vista (geoip-lite). Se
  // usa para detectar saltos de país y disparar alerta email (§17.4).
  lastKnownIpCountry String?              @map("last_known_ip_country")
  // Timestamp del último email de alerta enviado para este device. Sirve
  // de antispam — si la IP fluctúa de provincia no se reenvía. Sólo se
  // dispara primer login, cambio de país y re-aparición tras 30d.
  lastEmailAlertAt   DateTime?            @map("last_email_alert_at") @db.Timestamptz()
  // kds-1-cocina (decisión 2) · qué secciones muestra esta pantalla.
  // Vacío en todo `kind != KITCHEN` y obligatoriamente no vacío en una
  // pantalla de cocina (CHECK `devices_kitchen_sections` en la migración):
  // una pantalla sin secciones no enseñaría nada y el fallo se vería en el
  // servicio, no al emparejar.
  //
  // Es una LISTA y no una columna: «COCINA, BARRA o las dos» (y mañana
  // SALON, si un pase lo pide). La sección vive por LÍNEA, así que la misma
  // mesa sale en la pantalla de barra con las cañas y en la de cocina con
  // las bravas.
  kitchenSections    KitchenSection[]     @default([]) @map("kitchen_sections")
  // kds-2-wifi · DÓNDE ESCUCHA ESTA PANTALLA en la red local.
  //
  // La tablet lo anuncia en su latido (`POST /kitchen/latido`) y el TPV lo
  // lee de `GET /kitchen/estado`. Si el router le cambia la IP sin
  // internet, el TPV la redescubre por NSD; esto es la última conocida,
  // que es con la que se reintenta antes de redescubrir.
  //
  // **Las tres sólo pueden tener valor en un `KITCHEN`**, y eso no es una
  // costumbre: es el CHECK `devices_kitchen_lan_solo_cocina` de la
  // migración. Un terminal de caja no escucha en ningún puerto y aquí no se
  // puede ni apuntar que lo haya hecho (lección A5).
  kitchenLanIp       String?              @map("kitchen_lan_ip")
  kitchenLanPort     Int?                 @map("kitchen_lan_port")
  kitchenLanAt       DateTime?            @map("kitchen_lan_at") @db.Timestamptz()
  // residencia-4 (D-66) · EN QUÉ CANAL SUENA ESTE MÓVIL.
  //
  // Sólo puede tener valor en un `kind = GUARD`, y en un `GUARD` es
  // obligatorio (CHECK `devices_guard_canal`): un móvil de guardia sin
  // canal no recibiría ningún aviso y el fallo se vería la noche que
  // alguien tenga 38,6, no al emparejarlo. Misma forma exacta que
  // `devices_kitchen_sections` en kds-1.
  guardChannel       GuardChannel?        @map("guard_channel")

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register            Register?                    @relation(fields: [registerId], references: [id], onDelete: Cascade)
  // residencia-1 · la habitación de la que esta tablet es la puerta.
  // `Restrict` al otro lado: borrar una habitación con su tablet
  // emparejada dejaría un aparato autenticado apuntando a nada. Primero
  // se revoca la tablet, después se retira la habitación.
  room                Room?                        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  consumedPairings    PairingCode[]                @relation("PairingCodeConsumedBy")
  // V1-verifactu · a favor de qué dispositivo se revocó éste, y a cuáles
  // revocó él. La FK es DEFERRABLE INITIALLY DEFERRED en la migración: hay
  // que revocar el anterior ANTES de insertar el nuevo (índice único), y en
  // ese momento el nuevo todavía no existe.
  revokedBy           Device?                      @relation("DeviceRevokedBy", fields: [revokedByDeviceId], references: [id], onDelete: SetNull)
  revoked             Device[]                     @relation("DeviceRevokedBy")
  // Registros de facturación que generó este dispositivo.
  fiscalRecords       FiscalRecord[]
  // A5 · última instantánea que el terminal publicó por su canal de
  // soporte. 1:1, se sobreescribe en cada heartbeat.
  heartbeat           DeviceHeartbeat?
  // A5 · capturas de pantalla vivas de este terminal (24 h como mucho).
  screenshots         DeviceScreenshot[]
  // clinica-1 · desde qué terminal se abrió una historia. SET NULL al
  // otro lado: revocar un aparato no borra la línea del registro.
  clinicalAccessLogs  ClinicalAccessLog[]
  // kds-1-cocina · lo que esta pantalla de cocina ha marcado. `SetNull` al
  // otro lado: revocar o reemparejar la tablet no borra la traza de qué
  // plato se tachó y cuándo —de ahí salen las estadísticas del dueño— pero
  // tampoco impide borrar el dispositivo.
  kitchenOrdersReady  KitchenOrder[]               @relation("KitchenOrderReadyBy")
  kitchenOrdersUrgent KitchenOrder[]               @relation("KitchenOrderUrgentBy")
  kitchenLinesDone    KitchenOrderLine[]           @relation("KitchenOrderLineDoneBy")
  // kds-2-wifi · las marcas que esta pantalla hizo SIN INTERNET y subió
  // después. CASCADE: el libro de marcas no tiene sentido sin su aparato.
  kitchenLanMarks     KitchenLanMark[]
  // clinica-7 · las aceptaciones del contrato de encargado hechas desde
  // este aparato. RESTRICT (no SET NULL) porque la tabla es de solo
  // inserción: un SET NULL sería una promesa que el trigger rechazaría al
  // ejecutarse. Un aparato se revoca, no se borra.
  processorAgreements ClinicalProcessorAgreement[] @relation("ClinicalProcessorAgreementDevice")
  // residencia-3 · lo que se registró desde esta puerta. `Restrict`, por
  // lo mismo que los contratos de encargado: la tabla es evidencia y un
  // aparato se revoca, no se borra.
  careRecords         CareRecord[]
  // residencia-4 · desde qué puerta se declaró una incidencia, qué turnos
  // de guardia se abrieron en este móvil y qué avisos acusó. Los tres con
  // `Restrict` o `SetNull` por lo mismo: un aparato se revoca.
  incidents           Incident[]                   @relation("IncidentDevice")
  guardShiftSessions  GuardShiftSession[]
  guardAlertsAcked    GuardAlert[]                 @relation("GuardAlertAckedByDevice")
  // residencia-5 (D-67) · las confirmaciones de relevo dadas en esta
  // tablet de sala. `Restrict`, por lo mismo que los registros de la
  // puerta: la confirmación es evidencia y un aparato se revoca, no se
  // borra.
  handoverAcks        HandoverAck[]                @relation("HandoverAckDevice")

  @@index([tenantId])
  @@index([registerId])
  @@index([revokedByDeviceId])
  /// residencia-1 · «¿qué tablet es la puerta de esta habitación?», que es
  /// la pregunta de la pantalla de Edificio. La unicidad de la puerta VIVA
  /// no está aquí: la hace el índice PARCIAL
  /// `devices_one_active_per_room_key` de la migración, que Prisma no sabe
  /// declarar — una habitación puede tener muchas tablets revocadas y como
  /// mucho una viva.
  @@index([roomId])
  @@map("devices")
}

// A5 · acceso remoto · la última instantánea de un terminal.
//
// UNA fila por device, sobreescrita en cada heartbeat. No es un histórico:
// nadie iba a leer una tabla con quince terminales × un latido cada 30 s, y
// mantenerla obligaría a purgarla. Lo único que hace falta del pasado —«¿desde
// cuándo lleva la cola atascada?»— se guarda como `outboxStuckSince`, que el
// servidor arrastra de una instantánea a la siguiente mientras la cola no se
// vacíe.
//
// Todo lo que reporta el terminal es NULLABLE: un terminal viejo, o uno cuyo
// plugin nativo no responde, tiene que poder anunciarse igual. Una columna
// vacía se pinta como «—» en el panel; un heartbeat rechazado por falta de un
// dato nos deja sin ver el terminal, que es justo lo contrario del bloque.
model DeviceHeartbeat {
  deviceId String @id @map("device_id") @db.Uuid
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Hora del SERVIDOR al recibir el latido. La del terminal va aparte, en
  // `deviceTime`, precisamente porque puede estar desviada.
  reportedAt DateTime @map("reported_at") @db.Timestamptz()

  // ── Qué está ejecutando ────────────────────────────────────────────────
  // Hash del bundle EN EJECUCIÓN (VITE_BUILD_HASH del chunk que corre), no
  // el de la imagen del servidor. La lección de A4.
  bundleBuildHash String? @map("bundle_build_hash")
  // "android" si el bundle salió del build de la APK, "" o null si es el de
  // la web. Con `platform` = android y esto != android → bundle ajeno.
  bundleTarget    String? @map("bundle_target")
  platform        String?
  // versionName/versionCode del APK instalado (Gradle). Null fuera de la APK.
  appVersionName  String? @map("app_version_name")
  appVersionCode  Int?    @map("app_version_code")

  // ── Estado de la caja ──────────────────────────────────────────────────
  shiftOpen        Boolean   @default(false) @map("shift_open")
  shiftOpenedAt    DateTime? @map("shift_opened_at") @db.Timestamptz()
  outboxPending    Int       @default(0) @map("outbox_pending")
  outboxRejected   Int       @default(0) @map("outbox_rejected")
  // Desde cuándo la cola no está vacía. Lo calcula el SERVIDOR: se pone al
  // recibir el primer latido con cola > 0, se arrastra mientras siga > 0, y
  // se borra en cuanto llega uno con cola vacía. No lo manda el terminal —
  // su reloj puede estar desviado y su memoria se va con cada arranque.
  outboxStuckSince DateTime? @map("outbox_stuck_since") @db.Timestamptz()

  // ── Dónde está ─────────────────────────────────────────────────────────
  // "wifi" | "cellular" | "ethernet" | "none" | "unknown".
  network          String?
  localIp          String?   @map("local_ip")
  // Hora que dice el terminal, y su desvío contra la del servidor. Una hora
  // desviada explica errores raros (tokens que caducan antes de tiempo,
  // tickets con hora imposible), así que se guarda ya calculada.
  deviceTime       DateTime? @map("device_time") @db.Timestamptz()
  clockSkewSeconds Int?      @map("clock_skew_seconds")
  bootedAt         DateTime? @map("booted_at") @db.Timestamptz()

  @@map("device_heartbeats")
}

// A5 · Frente 4 · metadatos de una captura de pantalla de un terminal.
//
// El PNG NO vive aquí: vive en disco, bajo DEVICE_SCREENSHOT_DIR, igual que los
// informes Z. Esta tabla guarda quién la pidió, por qué, y hasta cuándo existe.
//
// **Una captura de la pantalla de un TPV contiene datos de clientes.** De ahí
// las tres reglas que esta tabla hace cumplir: retención corta y declarada
// (`expiresAt`, 24 h), motivo obligatorio, y nada de capturas anónimas — cada
// una cuelga del super-admin que la pidió.
//
// El barrido lo hace el worker (`device-screenshot-sweeper`): borra el fichero
// y la fila. Si el worker no corriera, las capturas seguirían en disco: por eso
// el barrido tiene su propio test y entra en la tabla de sabotaje.
model DeviceScreenshot {
  id       String @id @default(uuid()) @db.Uuid
  deviceId String @map("device_id") @db.Uuid
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Se copia el tenant en vez de leerlo por el device: si el device se borra,
  // la traza de auditoría todavía tiene que poder decir de quién era.
  tenantId String @map("tenant_id") @db.Uuid

  requestedBySuperAdminId String @map("requested_by_super_admin_id") @db.Uuid
  commandId               String @map("command_id") @db.Uuid
  /// Por qué se pidió. Obligatorio, como en el comando.
  reason                  String

  /// Nombre del fichero dentro de DEVICE_SCREENSHOT_DIR. Nunca una ruta.
  fileName  String   @map("file_name")
  bytes     Int
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  @@index([deviceId, createdAt])
  @@index([expiresAt])
  @@map("device_screenshots")
}

// Código efímero que el propietario/encargado entrega al dispositivo
// nuevo. 6 dígitos; vida útil típica 1h. Unique compound (tenantId,
// code) para evitar colisiones del RNG dentro del mismo tenant.
model PairingCode {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  // residencia-1 · nullable, por lo mismo que `devices.register_id`: el
  // código que empareja la puerta de una habitación no nombra ninguna
  // caja. CHECK `pairing_codes_register_o_habitacion`, hermano del de
  // `devices`.
  registerId         String?          @map("register_id") @db.Uuid
  // residencia-1 · la habitación que este código va a emparejar. Lo
  // decide quien lo genera (propietario o encargado, autenticado) y NO el
  // aparato, exactamente por lo mismo que `kind` y `kitchenSections`: si
  // `POST /devices/pair` aceptase la habitación del cuerpo, cualquiera con
  // un código se emparejaría como la puerta de la 112.
  roomId             String?          @map("room_id") @db.Uuid
  code               String
  createdByUserId    String           @map("created_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt          DateTime         @map("expires_at") @db.Timestamptz()
  consumedAt         DateTime?        @map("consumed_at") @db.Timestamptz()
  consumedByDeviceId String?          @map("consumed_by_device_id") @db.Uuid
  // kds-1-cocina · QUÉ se empareja con este código, decidido por quien lo
  // genera (propietario o encargado desde el panel) y NO por el aparato.
  //
  // Lo contrario —que `POST /devices/pair` aceptase `kind: "KITCHEN"` del
  // cuerpo— dejaría que cualquiera con un código de caja se emparejase como
  // pantalla de cocina, y una pantalla de cocina no releva al terminal: el
  // resultado sería una caja con dos aparatos vivos donde el segundo no
  // factura y nadie se enteró. La intención vive en el código, que lo crea
  // alguien autenticado.
  kind               DeviceKind       @default(TERMINAL)
  // Las secciones de la pantalla, copiadas al dispositivo al consumir el
  // código. Vacío salvo en `kind = KITCHEN`.
  kitchenSections    KitchenSection[] @default([]) @map("kitchen_sections")
  // residencia-4 (D-66) · el canal del móvil de guardia, copiado al
  // dispositivo al consumir el código. NULL salvo en `kind = GUARD`
  // (CHECK `pairing_codes_guard_canal`), y por la misma razón que
  // `kitchenSections` y `roomId`: lo decide quien genera el código desde
  // el panel, no el aparato que lo teclea. Si `POST /devices/pair`
  // aceptara el canal del cuerpo, cualquiera con un código se emparejaría
  // como el móvil de enfermería y recibiría los avisos del centro.
  guardChannel       GuardChannel?    @map("guard_channel")

  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  register         Register? @relation(fields: [registerId], references: [id], onDelete: Cascade)
  // residencia-1 · Cascade y no Restrict, al revés que en `devices`: un
  // código de emparejamiento caduca en una hora y no es traza de nada.
  // Retirar una habitación se puede llevar un código sin consumir.
  room             Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy        User      @relation(fields: [createdByUserId], references: [id])
  consumedByDevice Device?   @relation("PairingCodeConsumedBy", fields: [consumedByDeviceId], references: [id])

  @@unique([tenantId, code])
  @@index([registerId])
  @@index([roomId])
  @@index([expiresAt])
  @@map("pairing_codes")
}

// ── Catálogo (cache local de Holded) ──────────────────────────────────

model Product {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  // catalogo-local · NULLABLE desde el escalón 2. Deja de ser la
  // IDENTIDAD del producto y pasa a ser sólo el ENLACE con Holded: un
  // producto `source = LOCAL` no tiene ninguno y nunca lo tendrá en este
  // bloque (el casamiento por SKU al conectar Holded es otro).
  //
  // El `@@unique([tenantId, holdedProductId])` de abajo NO se rediseña y
  // sigue siendo la clave del sync: en Postgres un índice único trata los
  // NULL como distintos entre sí, así que N productos locales conviven
  // bajo la misma constraint sin chocar.
  holdedProductId      String?       @map("holded_product_id")
  // catalogo-local · quién manda sobre esta ficha. Ver `enum ProductSource`.
  source               ProductSource @default(HOLDED)
  name                 String
  sku                  String?
  barcode              String?
  basePrice            Decimal       @map("base_price") @db.Decimal(12, 4)
  taxRate              Decimal       @map("tax_rate") @db.Decimal(5, 2)
  // iva-exento-sanitario · la CAUSA DE EXENCIÓN del art. 20 y compañía,
  // con el código de la lista L10 del diseño de registro de la AEAT
  // (`DsRegistroVeriFactu.xlsx`, hoja `6)Listas`): E1 «Exenta por el
  // artículo 20» … E6 «Exenta por otros». NULL = operación SUJETA.
  //
  // NULL y no `""`: «sin causa» tiene que ser un valor que no se pueda
  // confundir con una causa vacía, porque un `taxRate = 0` SIN causa es un
  // 0 % SUJETO, que ante la AEAT es otra operación (`CalificacionOperacion
  // = "S1"` con `TipoImpositivo = 0`, en vez de `OperacionExenta` sin tipo
  // ni cuota).
  //
  // Texto validado por CHECK y no `enum` a propósito: con los seis códigos
  // escritos en el CHECK desde hoy, admitir una causa nueva es desplegar y
  // no migrar. Un `enum` de Postgres sólo crece —`ALTER TYPE … DROP VALUE`
  // no existe— y cada valor nuevo obliga a partir la migración en dos
  // (clinica-1, -2 y -3 lo pagaron tres veces).
  //
  // DOS CHECK en la migración `20261007020000_iva_exento_sanitario`, y
  // ninguno de los dos es expresable en Prisma 5:
  //
  //   · `products_exencion_en_l10`  — el código está en la lista L10.
  //   · `products_exencion_sin_iva` — causa no nula ⇒ `tax_rate = 0`.
  //     Validaciones VERI*FACTU §15.5: con `OperacionExenta` no se puede
  //     informar `TipoImpositivo` ni `CuotaRepercutida`. Un producto exento
  //     al 21 % es un registro imposible y un papel que cobra un IVA que
  //     no existe. Hay cuatro puertas de escritura a esta tabla (panel,
  //     fichero del super-admin, sync de Holded y el psql de una
  //     implantación) y sólo el motor cubre las cuatro.
  //
  // CONSECUENCIA A VIGILAR, la misma que el índice parcial de SKU de
  // catalogo-local: `prisma migrate dev` verá los CHECK como deriva y
  // ofrecerá borrarlos. NO aceptar. `apps/api/test/iva-exento-migracion.test.ts`
  // guarda el contrato del SQL para que la pérdida salga en rojo.
  exemptionCause       String?       @map("exemption_cause")
  kind                 ProductKind   @default(PRODUCT)
  active               Boolean       @default(true)
  // True si el SKU lo asignó el script auto-SKU (patrón AUTO-<8>).
  // Permite distinguirlos del SKU manual del propietario.
  skuAutoAssignedAt    DateTime?     @map("sku_auto_assigned_at") @db.Timestamptz()
  // True si el auto-SKU envió el PUT pero el GET-back demostró que
  // Holded silenció el cambio (ADR-010). Sale en la bandeja de
  // revisión del admin. El producto NO es vendible hasta resolverlo.
  needsSkuReview       Boolean       @default(false) @map("needs_sku_review")
  // Contador de intentos de asignar SKU vía la bandeja (POST
  // /catalog/sku-review/:id/assign). Se incrementa tanto en éxito como
  // en silent reject — sirve para mostrar el contador "ha fallado N
  // veces" en el admin y para escalar a soporte (badge ámbar ≥3).
  skuReviewAttempts    Int           @default(0) @map("sku_review_attempts")
  // True si el TPV puede vender este ítem (sku no vacío y bajos
  // demás filtros). Spike §07.B: producto sin sku → línea inválida.
  sellableViaTpv       Boolean       @default(true) @map("sellable_via_tpv")
  // B-ProductImages: URL canónica de la imagen del producto tal como la
  // expone Holded (campo identificado en spike §13). NULL si el producto
  // no tiene imagen en Holded → el TPV cae al placeholder embebido. El
  // worker `image-cache-worker` descarga la imagen y la sirve cacheada
  // desde Caddy en `/product-images/<tenantId>/<productId>.<ext>`.
  imageUrl             String?       @map("image_url")
  // MIME del binario una vez descargado y validado por el worker
  // (`image/jpeg`, `image/png`, `image/webp`). NULL hasta que el worker
  // confirme una descarga válida; el TPV usa este campo como gate para
  // renderizar `<img>` vs. placeholder.
  imageMime            String?       @map("image_mime")
  // Cuándo el worker guardó por última vez el archivo en disco. Si la
  // URL cambia en un sync (Holded la rota), el sync pone `imageCachedAt
  // = null` para forzar re-descarga; el worker la detecta como pendiente.
  imageCachedAt        DateTime?     @map("image_cached_at") @db.Timestamptz()
  // B-Categorias-via-Tags: tags libres que el propietario asigna a
  // sus productos en Holded (campo `tags: string[]` en el payload de
  // /products). El TPV los usa como pseudo-categorías para construir
  // los chips de filtro arriba de la grid de productos. Si Holded no
  // envía tags, queda como array vacío. Tiene índice GIN
  // (products_tags_idx) para futuros filtros server-side @> y &&.
  tags                 String[]      @default([])
  // kds-1-cocina (decisión 3, capa 3) · los alérgenos de este plato, de la
  // lista cerrada de los 14 del Reglamento (UE) 1169/2011.
  //
  // Editable en la ficha del producto e importable por CSV. Para La
  // Maestranza se importan del generador de sus cartas, que ya los lleva
  // por plato (`maestranza_carta.py`). Sirve a tres cosas: el cruce que
  // hace que la pantalla grite «¡LLEVA GLUTEN!» cuando un plato asignado a
  // la silla alérgica lleva su alérgeno, el aviso del TPV al asignarlo, y
  // mañana la carta digital.
  //
  // `@default([])` y vacío NO significa «sin alérgenos»: significa «no
  // informado». La capa 3 se apaga sola para los productos vacíos y las
  // capas 1 y 2 (la alergia de la mesa y la silla del plato) siguen
  // funcionando igual. Un producto vacío no puede hacer que la pantalla
  // calle una alergia que el camarero SÍ declaró.
  allergens            Allergen[]    @default([])
  // v1.9-sync-borrados: cuándo la conciliación (o un 404 de detalle)
  // detectó que la ficha ya no existe en Holded y la soft-archivó
  // (active=false + sellableViaTpv=false). Distingue "borrado en
  // Holded" de otras causas de inactividad (forSale=0, tax sin
  // resolver). NULL mientras el producto viva en Holded; el upsert
  // del sync lo limpia si la ficha reaparece (des-archivado).
  archivedFromHoldedAt DateTime?     @map("archived_from_holded_at") @db.Timestamptz()
  lastSyncedAt         DateTime      @default(now()) @map("last_synced_at") @db.Timestamptz()
  raw                  Json?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  lines           TicketLine[]
  modifierGroups  ProductModifierGroup[]
  // B-reservas-2 · capa de extensión local de agenda sobre el producto de
  // Holded (ADR-R1). NO duplica el catálogo: precio/IVA siguen en Holded.
  // Sólo aplica a kind=SERVICE; un producto sin fila `scheduling` no es
  // reservable ni tiene duración → la agenda lo ignora.
  scheduling      ServiceScheduling?
  resourceNeeds   ServiceResourceNeed[]
  // B-reservas-3 · qué profesionales pueden dar este servicio (matriz
  // profesional × servicio). Sólo tiene sentido para kind=SERVICE.
  staffSkills     StaffSkill[]
  // B-reservas-8 · la PLANTILLA DE BONO de este producto, si lo es (1:1).
  // Un bono del catálogo es un producto normal —precio, IVA, categoría,
  // exención— con esta fila colgando: cuántas sesiones da, qué cubre y a
  // cuántos meses caduca. Venderlo es añadir el producto al ticket, así
  // que el precio y el IVA van por el camino de siempre y no hay un
  // segundo sitio donde se fije el precio de un bono (decisión de
  // Dirección, 18-10).
  voucherTemplate VoucherTemplate?

  @@unique([tenantId, holdedProductId])
  @@index([tenantId, barcode])
  @@index([tenantId, sku])
  @@index([tenantId, needsSkuReview])
  // catalogo-local · ÍNDICE QUE PRISMA NO PUEDE DECLARAR.
  //
  // La unicidad de SKU entre los productos locales de un tenant es un
  // índice único PARCIAL:
  //
  //   CREATE UNIQUE INDEX "products_tenant_id_sku_local_key"
  //     ON "products" ("tenant_id", "sku") WHERE "source" = 'LOCAL';
  //
  // Prisma 5 no tiene sintaxis para el `WHERE`, así que vive SÓLO en el
  // SQL de la migración `20260913000000_catalogo_local`. Un `@@unique`
  // a secas aquí sería otra cosa y peor: haría chocar los SKU que vienen
  // de Holded, que llegan como llegan y no son asunto nuestro.
  //
  // CONSECUENCIA A VIGILAR: `prisma migrate dev` compara el schema con la
  // base y verá este índice como deriva, ofreciendo borrarlo. NO
  // aceptar. El test `catalogo-local-migracion.test.ts` guarda el
  // contrato del SQL para que la pérdida salga en rojo.
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  holdedVariantId String?  @map("holded_variant_id")
  name            String
  sku             String?
  barcode         String?
  priceOverride   Decimal? @map("price_override") @db.Decimal(12, 4)
  stock           Int      @default(0)

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   TicketLine[]

  @@index([productId])
  @@index([barcode])
  @@map("product_variants")
}

model Warehouse {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  holdedWarehouseId String @map("holded_warehouse_id")
  name              String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, holdedWarehouseId])
  @@map("warehouses")
}

// Cache local de contactos de Holded. A diferencia de Product, NO hay
// sync inicial completo (B2 §3): los contactos del tenant pueden ser
// miles. El endpoint `GET /contacts/search` busca primero aquí; si no
// encuentra resultados, llama a Holded en vivo y upserta. El endpoint
// `POST /contacts` crea contacto on-the-fly desde el TPV con GET-back.
model Contact {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  holdedContactId  String       @map("holded_contact_id")
  name             String
  nif              String?
  email            String?
  phone            String?
  raw              Json?
  // v1.4-Buscador-Contactos · clasificación heredada de Holded
  // (`client | supplier | lead | debtor | creditor`). Permite que el
  // buscador del TPV liste sólo clientes y no proveedores. Nullable
  // mientras el backfill no ha corrido sobre los Contact preexistentes
  // a la migración b29; tras el backfill todos quedan poblados.
  type             ContactType? @map("type")
  // Si false, el contacto fue marcado como huérfano en el último sync
  // incremental (B7 §8): ya no existe en Holded. Lo conservamos por si
  // hay tickets históricos que apuntan a él. La UI del TPV lo oculta.
  active           Boolean      @default(true)
  // Marca temporal del último sync que vio este contacto en Holded.
  // El cron incremental marca `active=false` cuando NOT seen >24h.
  lastSeenInSyncAt DateTime?    @map("last_seen_in_sync_at") @db.Timestamptz()
  lastSyncedAt     DateTime     @default(now()) @map("last_synced_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, holdedContactId])
  @@index([tenantId, email])
  @@index([tenantId, nif])
  @@index([tenantId, name])
  @@index([tenantId, type])
  @@map("contacts")
}

// ── Operativa de ventas ───────────────────────────────────────────────

model Shift {
  id             String           @id @default(uuid()) @db.Uuid
  registerId     String           @map("register_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  openedAt       DateTime         @default(now()) @map("opened_at") @db.Timestamptz()
  closedAt       DateTime?        @map("closed_at") @db.Timestamptz()
  // Última actividad observada en el turno. Se actualiza a `now()` en
  // cada cobro y al hacer cashier-login con `reanudar`. Sirve para
  // diferenciar "turno reanudable" (mismo día) de "turno colgado" (día
  // anterior) en la lógica de login (§4 nucleus).
  lastActivityAt DateTime         @default(now()) @map("last_activity_at") @db.Timestamptz()
  cashOpening    Decimal          @map("cash_opening") @db.Decimal(12, 4)
  cashCounted    Decimal?         @map("cash_counted") @db.Decimal(12, 4)
  // Quién ejecutó el cierre. Puede ser distinto al `userId` cuando un
  // cajero cierra un turno colgado de un compañero (§3.5 del prompt).
  closedByUserId String?          @map("closed_by_user_id") @db.Uuid
  zReportPdfPath String?          @map("z_report_pdf_path")
  // v1.11-cierre-de-dia · quién/qué cerró el turno. `closedByUserId` dice
  // QUIÉN (null cuando cierra el job); esto dice POR QUÉ.
  closeReason    ShiftCloseReason @default(MANUAL) @map("close_reason")
  // v1.11-cierre-de-dia · cuándo el cajero confirmó el resumen del día de
  // este turno cerrado. NULL = el resumen sigue pendiente de enseñarse (la
  // tarjeta aparece al abrir por la mañana). Evita que la tarjeta reaparezca
  // para siempre sin necesitar estado en el cliente.
  summaryAckAt   DateTime?        @map("summary_ack_at") @db.Timestamptz()
  // v1.11-cierre-de-dia · el Z de este turno se generó y DESPUÉS entraron
  // ventas (tickets de un outbox offline imputados aquí por su timestamp,
  // ver `shift/impute.ts`). El PDF archivado ya no cuadra con la BD; el
  // resumen lo dice en vez de callarlo.
  //
  // S1-sello · el boolean deja de significar "el PDF puede estar caducado"
  // y pasa a significar **"existe un Z posterior que corrige a este"**: la
  // venta tardía emite un `ShiftZReport` nuevo y marca el anterior como
  // superado, en vez de dejar el cierre en un limbo sin sustituto.
  zReportStale   Boolean          @default(false) @map("z_report_stale")

  register   Register         @relation(fields: [registerId], references: [id], onDelete: Restrict)
  user       User             @relation("ShiftOpenedBy", fields: [userId], references: [id], onDelete: Restrict)
  closedBy   User?            @relation("ShiftClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  tickets    Ticket[]
  refunds    Refund[]
  cashCounts ShiftCashCount[]
  zReports   ShiftZReport[]

  @@index([registerId, openedAt])
  @@index([registerId, closedAt])
  @@map("shifts")
}

// v1.3-Thalia Lote 4 · arqueo por denominaciones. Cada fila representa
// un conteo puntual de caja: X (intermedio, no cierra) o Z (cierre del
// turno). El backend es el único que calcula `cashTotal` desde el JSON
// de denominaciones — el cliente no se cree (auditoría fiscal). El JSON
// usa strings como llave ("500", "0.01") por compatibilidad JSON; el
// backend interpreta cada llave como euros.
model ShiftCashCount {
  id              String             @id @default(uuid()) @db.Uuid
  shiftId         String             @map("shift_id") @db.Uuid
  shift           Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  kind            ShiftCashCountKind
  // {"500":0,"200":0,...,"0.01":5} — el server vuelve a calcular el total.
  denominations   Json
  cashTotal       Decimal            @map("cash_total") @db.Decimal(12, 4)
  // Quién hizo el arqueo. Distinto al `userId` del shift cuando un
  // encargado pasa por la caja a hacer un X de control.
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  @@index([shiftId, createdAt])
  @@map("shift_cash_counts")
}

// S1-sello · pieza 4 del bloque. El Z dejaba de ser un documento en el
// momento en que vivía SÓLO como PDF en disco: un fichero sustituible
// sin que nada lo detecte, y con `zReportStale` admitiendo que el
// contenido podía haber caducado.
//
// Aquí el desglose queda CONGELADO en base de datos, con su huella. Y
// cuando entra una venta tardía en un turno ya cerrado no se pisa el Z
// anterior: se emite uno nuevo (`sequence` +1) y el anterior queda
// marcado como corregido (`supersededAt` / `supersededById`), conservado.
// Eso es lo que pasa a significar `Shift.zReportStale`: "existe un Z
// posterior que corrige a este".
//
// Append-only por trigger: sólo se permite el UPDATE que marca una fila
// como superada, y una sola vez.
model ShiftZReport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shiftId    String   @map("shift_id") @db.Uuid
  // 1 = el Z del cierre. 2, 3… = los correctivos por ventas tardías.
  sequence   Int
  // El desglose entero (`ZBreakdown` + recuentos + fondo/contado) tal
  // como se calculó. Es lo que el PDF pinta; ahora también es dato.
  breakdown  Json
  // SHA-256 (hex) del desglose canonicalizado. Ver `shift/z-seal.ts`.
  sealedHash String   @map("sealed_hash")
  sealedAt   DateTime @default(now()) @map("sealed_at") @db.Timestamptz()
  // Ruta del PDF archivado, si lo hubo. Los correctivos nacen sin PDF:
  // el documento emitido es el del cierre; este congela el número.
  pdfPath    String?  @map("pdf_path")
  // CLOSE = cierre del turno (manual o corte de día). LATE_SALE = venta
  // que entró después de cerrar. CHECK en la migración.
  reason     String

  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz()
  supersededById String?   @map("superseded_by_id") @db.Uuid

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, sequence])
  @@index([shiftId, sealedAt])
  @@map("shift_z_reports")
}

// S1-sello · ADR-015 §4.3. La ÚNICA vía por la que una columna sellada
// puede cambiar de valor.
//
// No es una tabla de log que alguien rellena por educación: el trigger
// de Postgres exige que exista una fila de aquí, con el mismo
// `txid_current()`, para la tabla/fila/columna que se está tocando. Sin
// motivo no hay fila (CHECK), y sin fila no hay UPDATE. Si la
// transacción revienta, se van las dos cosas a la vez.
//
// Se escribe SIEMPRE llamando a `record_ticket_correction(...)`, que lee
// el valor anterior del propio motor, inserta aquí y hace el UPDATE. El
// código de la aplicación no escribe una columna sellada a mano nunca.
//
// Append-only por trigger: UPDATE y DELETE denegados.
model TicketCorrection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  // tickets | ticket_lines | ticket_payments
  tableName String   @map("table_name")
  rowId     String   @map("row_id") @db.Uuid
  field     String
  // Representación textual (la de `to_jsonb(fila)->>columna`) del valor
  // antes y después. Texto y no el tipo nativo: una sola tabla sirve
  // para tres tablas y para columnas de tipos distintos.
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  // Obligatorio y en texto libre. CHECK `btrim(reason) <> ''`.
  reason    String
  // Quién. `userId` cuando hay usuario del tenant detrás; `author` es la
  // etiqueta legible SIEMPRE, incluido lo que no es una persona
  // ("script:backfill-vuelta").
  author    String
  userId    String?  @map("user_id") @db.Uuid
  // Transacción en la que se escribió. Es lo que el trigger compara.
  txid      BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([tenantId, createdAt])
  // Por aquí busca el trigger en CADA update de columna sellada. Va
  // declarado aunque lo cree la migración a mano: si no, el siguiente
  // `prisma migrate dev` lo daría por sobrante y lo borraría.
  @@index([txid, tableName, rowId, field])
  @@map("ticket_corrections")
}

model Ticket {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  registerId           String            @map("register_id") @db.Uuid
  shiftId              String            @map("shift_id") @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  internalNumber       String            @map("internal_number")
  // UUID v4 generado en el front al cobrar. Llave de idempotencia hacia
  // Holded. Nunca se regenera.
  externalId           String            @unique @map("external_id") @db.Uuid
  // v1.0-mesas-frontend · Lote 2: idempotencia del checkout de mesa.
  // UUID v4 generado en el front al abrir el overlay de cobro. Un
  // reintento de red del POST /tickets/:id/checkout con el mismo valor
  // devuelve el ticket ya cobrado (GET-back) en vez de 409. Nullable:
  // venta rápida y clientes viejos no lo mandan.
  checkoutExternalId   String?           @unique @map("checkout_external_id") @db.Uuid
  // Capability slug público (16 hex = 8 bytes random ≈ 96 bits) que
  // alimenta el QR, el email y el botón "Ver ticket". Permite al
  // cliente final descargar el PDF sin auth — la entropía es el secreto.
  // B-Print fase 1.
  publicSlug           String            @unique @map("public_slug")
  // Timestamp del último fallo persistente del email auto-enviado.
  // El bandeja admin lo muestra para que el propietario sepa que el
  // cliente no recibió su ticket pese a que la sync con Holded fue OK.
  emailFailedAt        DateTime?         @map("email_failed_at") @db.Timestamptz()
  contactHoldedId      String?           @map("contact_holded_id")
  // B-reservas-8 · LA FICHA DEL CRM de esta venta. Nueva en este bloque,
  // y hacía falta: hasta hoy un ticket sólo sabía de `contactHoldedId`, el
  // contacto de HOLDED, y este módulo vive exactamente en las cuentas que
  // NO tienen Holded (Sole, la clínica, el spa). Sin esta columna no hay
  // forma de saber a quién se le vende un bono ni de proponer el bono de
  // una clienta en un ticket suelto (el canje sin cita de la peluquería
  // sin agenda).
  //
  // Nullable y `SetNull`: la venta de siempre no lleva ficha y sigue sin
  // llevarla, y si mañana se borra la ficha el ticket no se va con ella —
  // una venta cobrada no desaparece porque alguien limpie el CRM. Lo que
  // sí impide borrar la ficha es tener un BONO vivo (`Voucher.client` es
  // `Restrict`), que es otra cosa y está donde tiene que estar.
  clientId             String?           @map("client_id") @db.Uuid
  status               TicketStatus      @default(DRAFT)
  // v1.8-Fiado (variante B) · deuda viva de un ticket vendido a crédito.
  //   NULL  = venta normal (no fiado).
  //   > 0   = deuda pendiente de cobro (status ON_CREDIT).
  //   0     = fiado ya saldado (histórico "fue fiado"; NO se vuelve a NULL).
  // Se decrementa en cada cobro (POST /tickets/:id/credit-payments). Al
  // llegar a 0 el ticket pasa a PAID y se encola la subida a Holded.
  creditPending        Decimal?          @map("credit_pending") @db.Decimal(12, 4)
  total                Decimal           @db.Decimal(12, 4)
  totalTax             Decimal           @map("total_tax") @db.Decimal(12, 4)
  totalDiscount        Decimal           @map("total_discount") @db.Decimal(12, 4)
  // Texto libre de la venta. Se imprime en el ticket y se concatena a
  // las `notes` Holded después del marcador `TPV-uuid:` (§1.3).
  notes                String?
  // Efectivo recibido (para cálculo de cambio en histórico). Nullable
  // si no hubo efectivo en el cobro.
  cashAmount           Decimal?          @map("cash_amount") @db.Decimal(12, 4)
  holdedDocumentId     String?           @map("holded_document_id")
  // Numeración fiscal asignada por Holded tras el `approveDoc:true`.
  // Cara visible al cliente; se imprime en el ticket cuando llega.
  holdedDocNumber      String?           @map("holded_doc_number")
  holdedPdfUrl         String?           @map("holded_pdf_url")
  // Intents post-cobro. La impresión real es B5; en B4 sólo persistimos
  // la decisión del cajero.
  printIntent          Boolean           @default(true) @map("print_intent")
  emailIntent          String?           @map("email_intent")
  // Timestamp del momento en que el cajero pulsa "Imprimir ticket
  // regalo" (§5.2). Nullable; sólo se rellena si se solicitó.
  giftReceiptIntentAt  DateTime?         @map("gift_receipt_intent_at") @db.Timestamptz()
  // Email del MANAGER que autorizó este ticket con descuento superior
  // al umbral (B6 §2). Sólo se rellena si el descuento efectivo del
  // ticket supera `tenant.discountThresholdPct`. NULL en el caso normal.
  discountAuthorizedBy String?           @map("discount_authorized_by")
  // Mesa abierta a la que pertenece este ticket (B7). NULL para tickets
  // de venta rápida (retail). El estado de la mesa se deriva: si existe
  // un ticket con `tableId=X, status=DRAFT` la mesa X está ocupada.
  tableId              String?           @map("table_id") @db.Uuid
  table                Table?            @relation(fields: [tableId], references: [id])
  // Si este ticket nació como absorción de otra mesa en un grupo (§5),
  // se conserva el origen para histórico.
  originalTableId      String?           @map("original_table_id") @db.Uuid
  // Nº de comensales introducido al abrir la mesa. Informativo (no
  // bloquea capacidad).
  diners               Int?
  /// auditoria-sirope (#25) · EL Nº DE LA VENTA DE MOSTRADOR.
  ///
  /// Lo que la cocina lee en la tarjeta: «Mostrador nº 3». Correlativo
  /// POR DÍA Y POR CAJA, y por eso no sirve `internalNumber` (que es la
  /// serie fiscal, se asigna al cobrar y llega a cinco cifras) ni
  /// `lastSentRevision` (que es la 1ª/2ª comanda de ESTE ticket).
  ///
  /// NULL en todo ticket que no sea una venta de mostrador con comanda:
  /// las mesas se titulan con el nombre de la mesa y una venta rápida que
  /// nunca va a cocina no gasta número. Se asigna al crear el borrador de
  /// mostrador (`POST /mostrador/draft`) y no se reutiliza: dos ventas
  /// seguidas son nº 3 y nº 4 aunque la primera se cobre antes.
  ///
  /// El día es el mismo «hoy» que la pantalla de cocina (medianoche
  /// local, `inicioDelDia`): si la cocina no ve la tarjeta de ayer,
  /// tampoco puede confundirla con la de hoy.
  counterNumber        Int?              @map("counter_number")
  // v1.3-Servicios-Pinta · Lote 3: nombre del profesional que atendió
  // (peluquería/clínica/taller). Texto libre opcional introducido en
  // checkout. Vacío en RETAIL/HOSPITALITY. Se imprime en el ticket
  // entre cabecera y líneas si el tenant es SERVICES.
  attendedBy           String?           @map("attended_by") @db.VarChar(60)
  // v1.4-Bar-Operativa-MVP Lote 2 · cuándo se imprimió la última
  // comanda (kitchen ticket) para esta mesa. NULL = nunca enviada.
  // El TPV pinta "Enviar comanda" cuando hay líneas más nuevas que
  // este timestamp y "Reenviar comanda" cuando coinciden con
  // lastSentRevision. Se borra al cobrar/cancelar para no arrastrar
  // estado a mesas reusadas (la columna sólo existe en DRAFT efectivos).
  lastSentAt           DateTime?         @map("last_sent_at") @db.Timestamptz()
  // Revisión del envío: cuántas comandas (1ª, 2ª, 3ª) se han enviado
  // al ticket. Se imprime en la cabecera del PDF como "Comanda nº N".
  // Útil cuando una mesa pide más en mitad del servicio y la cocina
  // recibe un segundo papel: el cocinero ve "Comanda nº 2 · mesa 7".
  lastSentRevision     Int               @default(0) @map("last_sent_revision")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz()
  syncedAt             DateTime?         @map("synced_at") @db.Timestamptz()
  syncError            Json?             @map("sync_error")
  // v1.12-mesas-abandonadas · auditoría de la anulación de un DRAFT.
  // NULL en todo ticket que no esté VOIDED. `voidedByUserId` NULL con
  // `voidReason = AUTO_ABANDONED_EMPTY` es el barrido del corte de día:
  // lo anuló SISTEMA. Los VOIDED anteriores a v1.12 quedan MANUAL con
  // `voidedAt` NULL — los anuló una persona, pero no sabemos cuándo.
  voidReason           TicketVoidReason? @map("void_reason")
  /// auditoria-sirope (#18) · qué pasó en la sala. Obligatorio al vaciar
  /// una mesa CON consumo desde el TPV; NULL en todo lo demás (una mesa
  /// vacía, el barrido del corte de día, un ticket que no está VOIDED).
  voidMotivo           MotivoVaciado?    @map("void_motivo")
  voidedAt             DateTime?         @map("voided_at") @db.Timestamptz()
  voidedByUserId       String?           @map("voided_by_user_id") @db.Uuid
  // S1-sello · ADR-015 §4.1. SHA-256 (hex) del conjunto económico de la
  // venta —totales, líneas en orden determinista y pagos— calculado EN EL
  // SERVIDOR al persistir el cobro, nunca en el terminal. `sealedAt` es
  // el interruptor que mira el trigger de Postgres: con él no nulo, las
  // columnas económicas de esta fila (y toda TicketLine / TicketPayment
  // que cuelgue) dejan de poder modificarse salvo por la vía de
  // corrección (`TicketCorrection`).
  //
  // NULL = ticket pre-sello. No se sella retroactivamente (ADR-015 §5.2):
  // el histórico anterior al despliegue queda así para siempre y todo
  // informe que agregue ventas tiene que tolerar las dos poblaciones.
  sealedHash           String?           @map("sealed_hash")
  sealedAt             DateTime?         @map("sealed_at") @db.Timestamptz()

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // B-reservas-8 · ver `clientId` arriba.
  client            Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  register          Register               @relation(fields: [registerId], references: [id], onDelete: Restrict)
  shift             Shift                  @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  voidedBy          User?                  @relation("TicketVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  lines             TicketLine[]
  payments          TicketPayment[]
  partialPayments   TicketPartialPayment[]
  refunds           Refund[]
  emailJobs         TicketEmailJob[]
  printIntents      PrintIntent[]
  corrections       TicketCorrection[]
  // V1-verifactu (ADR-019) · el registro de facturación de esta venta, y el
  // de su anulación si la hubo. Lista y no 1:0..1 porque los dos cuelgan de
  // la misma venta.
  fiscalRecords     FiscalRecord[]
  // B-reservas-4 · cita → caja: el ticket pre-poblado que abre "Cobrar en
  // caja". Como mucho una cita apunta a un ticket (puente 1:0..1).
  appointment       Appointment?
  // B-reservas-8 · los bonos que NACIERON en esta venta. Lista y no 1:0..1
  // porque en un ticket caben dos bonos. `Cascade` al otro lado, y es la
  // pieza que hace funcionar el reseteo del ensayo: el bono vendido en un
  // ticket `TEST` se va con su ticket, sin una línea de código que lo
  // busque (ADR-021 §5.1).
  vouchersSold      Voucher[]
  // kds-1-cocina · todo lo de cocina de esta mesa cuelga del TICKET y se va
  // con él (`Cascade`): las alergias de la decisión 3 **no se cuelgan de
  // `Client` ni de nadie**, viven en la mesa de ESTE servicio y mueren con
  // ella. Es la garantía de privacidad de la decisión 3, escrita como una
  // clave ajena y no como una costumbre.
  kitchenDispatches KitchenDispatch[]
  kitchenOrders     KitchenOrder[]
  allergies         TicketAllergy[]
  courses           TicketCourse[]

  @@unique([registerId, internalNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([registerId, createdAt])
  @@index([shiftId])
  @@index([externalId])
  @@index([tableId, status])
  // B-reservas-8 · «las ventas de esta clienta», la consulta de la ficha.
  @@index([tenantId, clientId])
  // S1-sello · separar sellados de pre-sello en los listados del admin.
  @@index([tenantId, sealedAt])
  // v1.8-Fiado · el listado de deudas por cliente (GET /credits) filtra
  // tickets con deuda viva por contacto. El índice PARCIAL real
  //   (tenant_id, contact_holded_id) WHERE credit_pending > 0
  // se crea vía SQL manual en la migración v1_8_fiado (Prisma no expresa
  // índices parciales en el schema). Este @@index no-parcial NO se añade
  // para no duplicar; ver migration.sql.
  @@map("tickets")
}

model TicketLine {
  id                String   @id @default(uuid()) @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  variantId         String?  @map("variant_id") @db.Uuid
  // Snapshot del `holdedProductId` del catálogo en el momento del cobro.
  // El worker NO toca `Product` para construir el payload: lee el
  // snapshot de aquí, así si Holded ha borrado el producto entre cobro
  // y envío al menos sabemos qué intentó vender. Nullable para líneas
  // libres (TPV-OTROS-*).
  holdedProductId   String?  @map("holded_product_id")
  // SKU canónico que se envía a Holded en el item. Spike §05.B: es la
  // llave de resolución del producto. NUNCA enviar productId aquí.
  sku               String
  // Copia del nombre en el momento del cobro: cambiar el producto en
  // Holded no debe alterar tickets históricos.
  nameSnapshot      String   @map("name_snapshot")
  units             Decimal  @db.Decimal(10, 3)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 4)
  // v1.2-Lite Lote 4.B · T-5: si el cajero modifica el precio puntualmente
  // (libro descatalogado, ajuste rápido) se guarda aquí. NULL = sin
  // override, se cobra el `unitPrice` base. Cuando hay override, los
  // cálculos de subtotal/total usan este valor; el `unitPrice` queda
  // como histórico del catálogo para que la auditoría pueda mostrar
  // "modificado de X€ a Y€". Holded recibe el override (acepta precios
  // unitarios distintos del producto base).
  unitPriceOverride Decimal? @map("unit_price_override") @db.Decimal(12, 4)
  discountPct       Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRate           Decimal  @map("tax_rate") @db.Decimal(5, 2)
  // iva-exento-sanitario · SNAPSHOT de la causa de exención del producto
  // en el momento del cobro, con el mismo criterio que `nameSnapshot`,
  // `holdedProductId`, `unitPrice` y `taxRate`: lo que se cobró no cambia
  // si mañana se edita el producto.
  //
  // Si Rosario desmarca «Exento · sanitario» el mes que viene, sus
  // facturas de este mes siguen diciendo lo que dijeron — y su registro de
  // facturación ya declaró el `OperacionExenta` el día del cobro, así que
  // una reimpresión que leyera el catálogo de hoy no coincidiría ni con el
  // papel que el cliente tiene en la mano ni con lo que la AEAT recibió.
  //
  // Mismos dos CHECK que en `Product` (`ticket_lines_exencion_en_l10` y
  // `ticket_lines_exencion_sin_iva`), y aquí el segundo trabaja de verdad:
  // `POST /tickets` recibe `taxRate` y `exemptionCause` del dispositivo, y
  // un terminal con catálogo cacheado viejo puede mandar la pareja
  // incoherente.
  exemptionCause    String?  @map("exemption_cause")
  subtotal          Decimal  @db.Decimal(12, 4)
  total             Decimal  @db.Decimal(12, 4)
  // Snapshot inmutable de modificadores aplicados al cobrar
  // (B-Bar-Modifiers). Dos shapes históricos soportados por el
  // renderer del TPV — ambos viven en este Json?:
  //   1. Legacy (pre-B-Bar-Modifiers): `string[]` ad-hoc tipeado por
  //      el cajero ("Sin azúcar", "Sin postre"). No tiene precio ni
  //      grupo. Se conserva por compatibilidad de tickets históricos
  //      y porque el "modificador rápido tipeado" sigue siendo útil
  //      en barras pequeñas.
  //   2. Estructurado (post-B-Bar-Modifiers): array de objetos
  //      `{ groupId, groupName, modifierId, label, priceDeltaCents }`.
  //      Producido por el modal <ModifierSelector> a partir de los
  //      ModifierGroup/Modifier del catálogo. Desnormalizado a propósito:
  //      cambios futuros en el catálogo no alteran el ticket histórico
  //      (auditoría fiscal inmutable).
  //
  // El cálculo del subtotal de la línea ya incluye los priceDeltas
  // antes de persistir — `unitPrice` no se modifica, los deltas viven
  // sólo en este snapshot. Lo que se envía a Holded es el precio
  // rolled-up + el desglose textual en `description`/`notes` del item.
  modifiers         Json?
  // Si esta línea proviene de otra mesa (mover líneas o agrupar),
  // queda registrado el origen. Permite desagrupar reversiblemente
  // (B7 §5.3).
  originalTableId   String?  @map("original_table_id") @db.Uuid
  // ── kds-1-cocina · LO QUE COCINA YA TIENE DE ESTA LÍNEA ──────────────
  //
  // **La invariante central del bloque**: cuántas unidades de esta línea ha
  // recibido ya la cocina. El envío manda la DIFERENCIA (`units -
  // sentUnits`), no la mesa entera.
  //
  // Es exactamente el agujero que v2-H1 documentó y no pudo tapar
  // (`apps/tpv-web/src/lib/kitchenSentLines.ts`): `lastSentAt` vive en el
  // TICKET, así que el servidor sabía CUÁNDO se envió pero no QUÉ. El front
  // lo esquivaba con un conjunto de ids en `localStorage` sembrado con
  // `lastSentAt`, y ese apaño se equivoca —por el lado prudente, pero se
  // equivoca— en cuanto hay dos terminales. Una pantalla de cocina no puede
  // apoyarse en eso.
  //
  // Decimal y no Int por la misma razón que `units`: hay catálogos que
  // venden 0,5 raciones.
  //
  // Dos CHECK en la migración, ninguno expresable en Prisma:
  //   · `ticket_lines_sent_units_range`  — 0 ≤ sentUnits ≤ units.
  //   · `ticket_lines_course_positive`   — course ≥ 1.
  // El primero es el que importa: un `sentUnits > units` haría que el
  // siguiente envío mandase una diferencia NEGATIVA, o sea nada, y la
  // cocina no vería un plato que el cliente ya pidió.
  sentUnits         Decimal  @default(0) @map("sent_units") @db.Decimal(10, 3)
  // kds-1-cocina (decisión 3) · el TIEMPO de salida de esta línea: 1, 2,
  // 3… El 1 marcha al enviar; los demás esperan a su «Marchar». Un solo
  // modelo para los dos modos del restaurante (ver `KitchenCourseMode`):
  // el botón «Espera» del modo bar es, por debajo, «course = 2».
  course            Int      @default(1)
  // kds-1-cocina (decisión 3, capa 2) · la SILLA a la que va este plato.
  //
  // Es un dato de la LÍNEA y no algo propio de las alergias: el mismo
  // campo sirve al bar que sólo lo usa cuando hay un celíaco y al
  // restaurante a la carta que lo pone siempre (`KitchenSeatMode`), y
  // mañana a partir la cuenta por silla. Mismo dato, otro ajuste.
  //
  // NULL = «para la mesa», que es el caso normal. Numerada desde 1 y
  // acotada por `Ticket.diners` en la API, no en la base: una mesa puede
  // cambiar de comensales a mitad de servicio y no queremos que eso
  // invalide filas ya escritas.
  seat              Int?
  // B-reservas-8 · CON QUÉ BONO se paga esta línea. Puesto = la línea se
  // canjea con ese bono y su importe es 0 € (o el prorrateo, según
  // `Tenant.bonoModoCanje` — frente P5).
  //
  // Escalar SIN relación Prisma y SIN clave ajena en SQL, y es una
  // decisión: el guardián del sello vigila la FILA ENTERA de una línea
  // cobrada, así que un `ON DELETE SET NULL` sobre ella levantaría
  // `SELLO_VIOLADO` el día que el reseteo del ensayo borre un bono que se
  // consumió en otro ticket. Un puntero de una venta sellada tiene que
  // sobrevivir a lo que apunta. Ver la nota de la migración.
  voucherId         String?  @map("voucher_id") @db.Uuid

  ticket            Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id])
  variant           ProductVariant?    @relation(fields: [variantId], references: [id])
  refundLines       RefundLine[]
  // kds-1-cocina · las copias que viajaron a cocina. `SetNull`: borrar la
  // línea de la venta no borra lo que la cocina ya vio.
  kitchenOrderLines KitchenOrderLine[]

  @@index([ticketId])
  // B-reservas-8 · «¿qué líneas se cobraron con este bono?», la traza.
  @@index([voucherId])
  @@map("ticket_lines")
}

model TicketPayment {
  id                 String        @id @default(uuid()) @db.Uuid
  ticketId           String        @map("ticket_id") @db.Uuid
  method             PaymentMethod
  amount             Decimal       @db.Decimal(12, 4)
  meta               Json?
  // v1.8-Fiado · idempotencia del cobro de deuda (patrón outbox). El
  // front genera un UUID v4 por cobro; el POST /credit-payments lo
  // persiste aquí (UNIQUE global). Un reintento de red con el mismo
  // valor devuelve el estado actual en vez de duplicar el cobro. NULL
  // en los pagos de una venta normal (no lo necesitan).
  externalId         String?       @unique @map("external_id") @db.Uuid
  // v1.8-Fiado · turno en el que se COBRÓ este pago. Sólo se rellena en
  // los cobros de deuda (POST /credit-payments): un fiado se vende en el
  // turno del día 1 pero se cobra en el turno del día N, y el arqueo Z
  // debe imputar el ingreso al turno del cobro. NULL en pagos de venta
  // normal → el arqueo los imputa por `ticket.shiftId` como siempre.
  // Escalar sin relación Prisma a propósito (evita back-relation ruidosa
  // en Shift); integridad no crítica (los turnos no se borran).
  collectedInShiftId String?       @map("collected_in_shift_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([collectedInShiftId])
  @@map("ticket_payments")
}

// v1.4-Bar-Operativa-MVP Lote 4 · cobros parciales (split bill,
// Modo A). El cliente quiere pagar 30 € de un total de 80 €. Cada
// cobro parcial se registra aquí; los siguientes /checkout y los
// helpers de remaining suman estos importes para decidir cuándo el
// ticket queda saldado. Al cobrar el resto (o si la suma de
// partials llega al total), el ticket pasa a PAID por la ruta
// normal de /checkout que ya conoce y sincroniza con Holded.
//
// No están en TicketPayment para no contaminar el contrato fiscal:
// el upload a Holded usa los TicketPayment finales del cobro
// (Holded recibe 1 salesreceipt con N payments), así los partials
// se acumulan en este modelo sin tocar el flujo de sync existente.
model TicketPartialPayment {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  amount     Decimal       @db.Decimal(12, 4)
  method     PaymentMethod
  // Cajero que tomó el cobro parcial. Nullable porque puede
  // haberse eliminado el user (poco probable en piloto).
  cashierId  String?       @map("cashier_id") @db.Uuid
  // Importe efectivo recibido cuando el método es CASH — para
  // mostrar cambio en el TPV. Nullable en CARD/BIZUM.
  cashAmount Decimal?      @map("cash_amount") @db.Decimal(12, 4)
  // Metadata libre del pago (refMov BIZUM, last4 tarjeta, …).
  meta       Json?
  paidAt     DateTime      @default(now()) @map("paid_at") @db.Timestamptz()

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_partial_payments")
}

model Refund {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  originalTicketId String         @map("original_ticket_id") @db.Uuid
  userId           String?        @map("user_id") @db.Uuid
  registerId       String?        @map("register_id") @db.Uuid
  shiftId          String?        @map("shift_id") @db.Uuid
  internalNumber   String         @map("internal_number")
  externalId       String         @unique @map("external_id") @db.Uuid
  status           TicketStatus   @default(DRAFT)
  reason           String?
  // Método de reembolso (por defecto, el mismo del cobro original).
  method           PaymentMethod?
  // Snapshot del total devuelto (con IVA). Se calcula sumando las
  // refund_lines. Se persiste explícito para que el worker no necesite
  // re-calcular ni el front re-pedir las líneas para listar.
  total            Decimal        @db.Decimal(12, 4)
  totalTax         Decimal        @map("total_tax") @db.Decimal(12, 4)
  holdedDocumentId String?        @map("holded_document_id")
  holdedDocNumber  String?        @map("holded_doc_number")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  syncedAt         DateTime?      @map("synced_at") @db.Timestamptz()
  syncError        Json?          @map("sync_error")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originalTicket Ticket       @relation(fields: [originalTicketId], references: [id], onDelete: Restrict)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  register       Register?    @relation(fields: [registerId], references: [id], onDelete: Restrict)
  shift          Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  lines          RefundLine[]

  @@index([originalTicketId])
  @@index([tenantId, status])
  @@map("refunds")
}

model RefundLine {
  id           String  @id @default(uuid()) @db.Uuid
  refundId     String  @map("refund_id") @db.Uuid
  ticketLineId String  @map("ticket_line_id") @db.Uuid
  // Snapshot del nombre/sku/precio de la línea original. El worker
  // construye el payload con estos valores; si la línea original
  // cambia o el producto desaparece de Holded, la devolución
  // sigue siendo reproducible.
  nameSnapshot String  @map("name_snapshot")
  sku          String
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 4)
  taxRate      Decimal @map("tax_rate") @db.Decimal(5, 2)
  discountPct  Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  units        Decimal @db.Decimal(10, 3)
  total        Decimal @db.Decimal(12, 4)

  refund     Refund     @relation(fields: [refundId], references: [id], onDelete: Cascade)
  ticketLine TicketLine @relation(fields: [ticketLineId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@map("refund_lines")
}

// ── Cola de sync (espejo en BD por si Redis se cae) ───────────────────

model SyncOutbox {
  id            BigInt           @id @default(autoincrement())
  tenantId      String           @map("tenant_id") @db.Uuid
  kind          SyncOutboxKind
  payload       Json
  attempts      Int              @default(0)
  nextAttemptAt DateTime         @default(now()) @map("next_attempt_at") @db.Timestamptz()
  lastError     Json?            @map("last_error")
  status        SyncOutboxStatus @default(PENDING)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([tenantId, status])
  @@map("sync_outbox")
}

// Idempotencia de subidas a Holded (spike §04.F). Holded NO deduplica
// por contenido de `notes` y NO expone búsqueda por externalId — toda
// la idempotencia vive aquí. Antes de POSTear el doc, el worker
// consulta esta tabla por externalId; si ya hay holded_document_id,
// no reintenta.
model HoldedUpload {
  externalId       String             @id @map("external_id") @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  kind             HoldedUploadKind
  holdedDocumentId String?            @map("holded_document_id")
  attempts         Int                @default(0)
  lastAttemptAt    DateTime?          @map("last_attempt_at") @db.Timestamptz()
  status           HoldedUploadStatus @default(PENDING)
  lastError        Json?              @map("last_error")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  // holded-desconectar (ADR-020) · TRIGGER QUE PRISMA NO PUEDE DECLARAR.
  //
  //   holded_uploads_no_tras_el_corte  BEFORE INSERT
  //
  // Si el tenant tiene `holded_disconnected_at` poblado, la fila NACE
  // `SKIPPED` con `last_error = {"skipped":"holded_desconectado"}` en vez
  // de `PENDING`. Vive en la migración `20260926000000_holded_desconectar`.
  //
  // Por qué reescribe y NO lanza: esta tabla se escribe DENTRO de la
  // transacción que cobra. Un `RAISE` aquí tumbaría una venta con el
  // cliente delante por una invariante nuestra, y cobrar siempre se puede
  // (misma razón por la que `comprobarGateFiscal` descarta el registro del
  // modo prueba en vez de devolver 409). `SKIPPED` ya existe desde
  // v1.5-consistencia-B §3.a y significa exactamente esto: terminal, el
  // sweeper no lo recoge, nadie lo sube nunca.
  //
  // Es la SEGUNDA puerta, no la primera. La primera es
  // `shouldEnqueueHoldedUpload` / `shouldEnqueueHoldedRefundUpload`, que
  // no crean la fila. Cada una tiene su test y su sabotaje: quitar el gate
  // deja una fila que no debería existir, quitar el trigger la deja
  // PENDING y el sweeper la persigue.
  @@map("holded_uploads")
}

// Conciliación diaria TPV ↔ Holded (v1.5-consistencia-B · Lote 4).
// Un run por tenant y pasada del cron: para cada ticket SYNCED de las
// últimas 48h, GET del documento en Holded y comparación de existencia,
// total y estado de cobro. `mismatches` es un array JSON
// [{ticket, field, expected, actual}] — vacío en run limpio.
model ReconciliationRun {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  runAt          DateTime @default(now()) @map("run_at") @db.Timestamptz()
  ticketsChecked Int      @map("tickets_checked")
  mismatches     Json

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, runAt])
  @@map("reconciliation_runs")
}

// Cola de envío del PDF del ticket por email (§4 del prompt B4).
// El endpoint `POST /tickets/:id/resend-email` crea una fila y encola
// un job BullMQ; el worker descarga el PDF de Holded (cuando el ticket
// esté `SYNCED`), lo manda al `to_email` y marca `sent_at`. Reintento
// exponencial; ante fallo persistente, queda `status=FAILED` con
// `last_error` poblado.
model TicketEmailJob {
  id                String    @id @default(uuid()) @db.Uuid
  ticketId          String    @map("ticket_id") @db.Uuid
  toEmail           String    @map("to_email")
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  attempts          Int       @default(0)
  lastError         Json?     @map("last_error")
  // PENDING | DONE | FAILED. String libre — sin enum porque va a la cola
  // BullMQ y se desacopla del ciclo de Prisma migrate.
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  sentAt            DateTime? @map("sent_at") @db.Timestamptz()

  ticket          Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedByUser User   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([status])
  @@map("ticket_email_jobs")
}

// primer-acceso · DOS CLASES DE ENLACE, UNA SOLA MAQUINARIA.
//
// `RESET` es el de siempre: «olvidé mi contraseña», 1 hora.
// `INVITE` es el primer acceso: lo manda el correo de bienvenida cuando
// un super-admin activa la cuenta, y dura 7 días porque el día del alta
// la persona del centro puede estar de visita con la inspección.
//
// Son la MISMA tabla y el mismo mecanismo (hash argon2id, un solo uso,
// `usedAt`) por decisión 1 del bloque: inventar un segundo mecanismo
// habría duplicado el sitio donde se decide si un enlace sigue vivo, y
// entonces una de las dos copias se quedaría sin el `usedAt` o sin el
// throttle. Lo que los separa es el tipo, y el tipo lo mira cada ruta:
// un token de reset NO vale como invitación ni al revés.
enum PasswordResetTokenType {
  RESET
  INVITE
}

// Token de recuperación de contraseña del propietario (§17.6). El token
// plano se envía sólo por email; en BD guardamos sólo su hash argon2id.
// TTL 1h para `RESET` y 7 días para `INVITE`, un solo uso. La revocación
// masiva al confirmar el reset se hace vía `user.tokenVersion += 1`.
model PasswordResetToken {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @map("user_id") @db.Uuid
  tokenHash String                 @map("token_hash")
  // `RESET` por defecto: las filas que ya existían son todas de reset, y
  // el default hace que la migración no tenga que reescribirlas.
  type      PasswordResetTokenType @default(RESET)
  expiresAt DateTime               @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?              @map("used_at") @db.Timestamptz()
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  // El candidato de una invitación se busca por tipo + vivos: sin este
  // índice, cada aceptación recorre también los resets de la casa.
  @@index([type, usedAt])
  @@map("password_reset_tokens")
}

// ── Modificadores de producto (B-Bar-Modifiers) ────────────────────────
//
// Caso B confirmado (spike §14): Holded no expone modificadores
// nativamente. El CRUD vive entera en mipiacetpv y es per-tenant. El
// cajero los selecciona en el modal <ModifierSelector> al añadir una
// línea del producto; el snapshot inmutable acaba en `TicketLine.modifiers`.
// A Holded llega un precio "rolled up" + desglose textual en la
// description del item — Holded sólo ve el precio total y la nota.

model ModifierGroup {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Nombre del grupo visible al cajero ("Tipo de leche", "Tamaño").
  name      String
  // Si true, sólo se puede seleccionar 1 modifier del grupo (radio).
  // Si false, se pueden seleccionar varios (checkbox). Default true.
  exclusive Boolean   @default(true)
  // Si true, es obligatorio seleccionar al menos un modifier antes
  // de añadir la línea. Útil para "Tamaño" donde no hay default.
  required  Boolean   @default(false)
  // Orden de presentación en el modal del TPV (asc).
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // Soft-delete para preservar histórico de TicketLine.modifiers que
  // referencian este groupId tras quitar la variante del menú.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()

  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([tenantId, deletedAt])
  @@map("modifier_groups")
}

model Modifier {
  id              String        @id @default(uuid()) @db.Uuid
  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  // Etiqueta visible ("Sin leche", "Con leche desnatada", "Grande").
  label           String
  // Suplemento o descuento al precio del producto. Puede ser
  // negativo (descuento) o cero (sin coste). En céntimos para evitar
  // floats, igual que el resto del modelo (Decimal del producto se
  // convierte a céntimos en runtime).
  priceDeltaCents Int           @default(0) @map("price_delta_cents")
  sortOrder       Int           @default(0) @map("sort_order")
  // Si true, este modifier está pre-seleccionado al abrir el grupo.
  // Sólo tiene efecto en grupos exclusive=true.
  isDefault       Boolean       @default(false) @map("is_default")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  // Soft-delete (mismo motivo que ModifierGroup.deletedAt).
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz()

  @@index([modifierGroupId, deletedAt])
  @@map("modifiers")
}

// Tabla puente N:N entre productos y grupos de modificadores. Un grupo
// puede aplicar a varios productos ("Tipo de leche" sirve para café,
// té, chocolate) y un producto puede tener varios grupos ("Café" tiene
// "Tipo de leche" + "Tamaño" + "Azúcar"). El borrado del producto o
// del grupo elimina la fila puente sin tocar al otro lado.
model ProductModifierGroup {
  productId       String        @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId String        @map("modifier_group_id") @db.Uuid
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0) @map("sort_order")

  @@id([productId, modifierGroupId])
  @@index([modifierGroupId])
  @@map("product_modifier_groups")
}

// ── Super-admin (B-SuperAdmin) ────────────────────────────────────────
//
// Identidad ortogonal a `User` (per-tenant). Razón: que un User
// escalable nunca pueda derivar en permisos super. Aislamiento limpio.
// El alta se hace exclusivamente vía CLI seed
// (`apps/api/src/scripts/create-super-admin.ts`) — no hay UI para
// invitar nuevos super-admins. Decisión defensiva.

model SuperAdminUser {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  // B-Multi-Vertical SB4: nombre legible mostrado en el panel de
  // gestión multi-admin. Nullable porque el super-admin original
  // (Matías, creado vía CLI seed) no tenía nombre — backfill rellena
  // con split_part(email, '@', 1).
  name               String?   @db.VarChar(100)
  passwordHash       String    @map("password_hash")
  // Igual que User.tokenVersion: logout-everywhere lo bumpea, los
  // refresh tokens viejos pasan a ser inválidos sin tabla blacklist.
  tokenVersion       Int       @default(0) @map("token_version")
  // 2FA TOTP. Mismo patrón cifrado AES-GCM (`v1:`) que User.
  totpSecret         String?   @map("totp_secret")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz()
  // Array de `{ hash, usedAt }` (mismo shape que User.twoFactorRecoveryCodes).
  recoveryCodes      Json?     @map("recovery_codes")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  // B-Multi-Vertical SB4: super-admin invitado por otro super-admin
  // empieza con password temporal. true → al primer login el front le
  // pide cambiarla. Se pone false en cuanto se cambia.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  // Lote 3 v1.1 Thalia: sólo el "root" puede invitar/eliminar a otros
  // super-admins. El resto opera tenants y nada más. El middleware
  // requireRootSuperAdmin re-lee este flag de BD en cada request — el
  // claim JWT NO es autoritativo (revoca-root tras emisión de token
  // funciona en la siguiente request).
  isRoot             Boolean   @default(false) @map("is_root")
  // B-Multi-Vertical SB4: soft-delete. Preservamos el row para que la
  // tabla `super_admin_audits` (que tiene FK Restrict sobre este
  // modelo) mantenga el histórico aunque se "borre" al super-admin.
  // El listado y la auth filtran por deletedAt IS NULL.
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  audits SuperAdminAudit[]

  @@map("super_admin_users")
}

// v1.3-Thalia Lote 3 · cola de intents de impresión. Cada fila
// representa una orden que el bridge B5 (PWA del navegador o servicio
// nativo) consume para mandar al hardware. El renderer del PDF puede
// pintar marcas distintas según `kind` (p.ej. "COPIA — no fiscal"
// para REPRINT) — la lógica vive en `ticket-pdf`, este modelo sólo
// guarda el intent.
model PrintIntent {
  id                String          @id @default(uuid()) @db.Uuid
  ticketId          String          @map("ticket_id") @db.Uuid
  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind              PrintIntentKind
  // PENDING al crear; el bridge lo marca DONE tras imprimir o FAILED
  // si la impresora rechazó. String libre — sin enum porque viaja a
  // BullMQ y se desacopla del ciclo Prisma migrate.
  status            String          @default("PENDING")
  // Quién lo solicitó. NEW lo crea el handler de cobro (es el cajero
  // del shift); REPRINT lo crea el cajero que abre el historial; GIFT
  // lo crea el cajero del cobro original. Útil para auditoría.
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  requestedBy       User            @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  pickedAt          DateTime?       @map("picked_at") @db.Timestamptz()
  doneAt            DateTime?       @map("done_at") @db.Timestamptz()
  lastError         String?         @map("last_error")

  @@index([status, createdAt])
  @@index([ticketId, kind, createdAt])
  @@map("print_intents")
}

// Auditoría inmutable de toda acción super-admin. Sin retención
// automática — se conserva indefinidamente para histórico.
model SuperAdminAudit {
  id           String         @id @default(uuid()) @db.Uuid
  superAdminId String         @map("super_admin_id") @db.Uuid
  superAdmin   SuperAdminUser @relation(fields: [superAdminId], references: [id], onDelete: Restrict)
  // "create_tenant" | "update_tenant" | "block_tenant" | "unblock_tenant"
  // | "force_logout" | "resync" | "impersonate". Validado con zod en la
  // capa de servicio antes de persistir.
  action       String
  tenantId     String?        @map("tenant_id") @db.Uuid
  // Shape estricto por acción (ver docs/blocks/B-SuperAdmin-done.md).
  // Siempre incluye `ipAddress` y `userAgent`.
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  @@index([superAdminId, createdAt])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("super_admin_audits")
}

// ── CRM / ficha de cliente (B-reservas-1) ───────────────────────────────
//
// Capa LOCAL, fuente de verdad propia (ADR-R2). El contacto de Holded se
// usa sólo para lo fiscal, enlazado perezosamente por `holdedContactId`
// (nullable) — al crear/editar un cliente NO se crea contacto en Holded;
// ese enlace lo rellena el camino de cobro existente cuando hace falta
// factura. No se vuelca historial / ficha técnica / RGPD a Holded.
//
// El cliente es único y compartido entre agenda (B4), TPV (carrito) y
// bonos (B5). Todo lleva `tenantId` con índice (aislamiento por fila).

model Client {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  // UUID v4 generado en el front al dar de alta. Llave de idempotencia
  // para el alta offline que pasa por el outbox (mismo patrón que
  // Ticket.externalId): un reintento del POST /clients con el mismo
  // valor devuelve el cliente ya creado en vez de duplicarlo. Nullable
  // por si el alta se hace server-side sin pasar por la cola.
  externalId      String?   @unique @map("external_id") @db.Uuid
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  email           String?
  birthdate       DateTime? @db.Date
  // Enlace fiscal perezoso al contacto de Holded (ADR-R2). NULL hasta
  // que el camino de cobro lo rellena al necesitar factura. Aquí sólo se
  // persiste el id; el CRM nunca crea el contacto en Holded.
  holdedContactId String?   @map("holded_contact_id")
  marketingOptIn  Boolean   @default(false) @map("marketing_opt_in")
  notes           String?
  /// clinica-7 · la nota de la ficha, cifrada en los tenants clínicos.
  /// Mismo caso que `Appointment.notesCifradas`.
  notesCifradas   String?   @map("notes_cifradas")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant                Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // clinica-4 · `consents` pasó a RESTRICT (S3, condición 1): un paciente
  // con un consentimiento firmado NO se borra, y ya no es «lo que se
  // puede perder con la ficha». `technicalNotes` sigue en Cascade: es
  // ficha técnica, no historia.
  consents              ClientConsent[]
  technicalNotes        ClientTechnicalNote[]
  appointments          Appointment[]
  // B-reservas-8 · sus bonos de sesiones. `Restrict` al otro lado: una
  // ficha con un bono vivo NO se borra. El bono es una deuda del centro
  // con ESA persona (el bono es de una ficha, S6) y borrar la ficha sería
  // perder a quién se le deben las sesiones.
  vouchers              Voucher[]
  // B-reservas-8 · las ventas a nombre de esta ficha. `SetNull` al otro
  // lado: borrar la ficha no borra la venta.
  tickets               Ticket[]
  // clinica-1 · la historia del paciente, sus accesos y el registro de
  // quién la ha abierto. Las tres con RESTRICT al otro lado (y no Cascade
  // como `technicalNotes`): **un cliente con historia no se borra.** Esa
  // es la diferencia de fondo entre una ficha de peluquería y una
  // historia clínica.
  clinicalAccesses      ClinicalAccess[]
  clinicalAccessLogs    ClinicalAccessLog[]
  clinicalEntries       ClinicalEntry[]
  // clinica-2 · sus valoraciones iniciales. Puede haber varias: la
  // valoración se repasa creando una NUEVA, sin sobrescribir la anterior
  // (decisión de producto 7).
  clinicalAssessments   ClinicalAssessment[]
  // clinica-4 · sus fotos clínicas y las entregas de sus informes. Las
  // dos con RESTRICT, por lo mismo: son historia.
  clinicalPhotos        ClinicalPhoto[]
  reportDeliveries      ClinicalReportDelivery[]
  // residencia-1 (D-49) · EL RESIDENTE ES UN `Client` con un perfil 1:1,
  // igual que `StaffProfile` amplía a `User`. De ahí hereda gratis la
  // historia, los accesos, el registro de accesos, los consentimientos,
  // las fotos y los informes — sin duplicar una sola tabla de la clínica.
  //
  // Las dos con RESTRICT al otro lado: **un residente no se borra, se le
  // da de alta** (`ResidentProfile.dischargeDate`). Es la misma decisión
  // que lo clínico y por la misma ley.
  residentProfile       ResidentProfile?
  bedAssignments        BedAssignment[]
  // residencia-2 · su plan de cuidados. `Restrict`: un residente con plan
  // no se borra.
  carePlanItems         CarePlanItem[]
  /// residencia-3 · lo que se le ha registrado en la puerta. `Restrict`
  /// al otro lado: un residente con registros de cuidado no se borra.
  careRecords           CareRecord[]
  /// residencia-4 · sus incidencias y las excepciones de umbral que le
  /// pautó la médica. `Restrict` a los dos lados, por lo mismo: son
  /// historia clínica suya.
  incidents             Incident[]
  thresholdOverrides    ResidentThresholdOverride[]
  /// residencia-5 · lo suyo que llegó después de un relevo congelado.
  /// `Restrict`, por lo mismo.
  handoverLateAdditions HandoverLateAddition[]

  // Búsqueda por teléfono/email y orden alfabético (A–Z) por tenant.
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, holdedContactId])
  @@map("clients")
}

// Consentimientos del cliente. Nació en B1 para el RGPD (campos + alta
// manual) y **desde clinica-4 es LA tabla del consentimiento informado**,
// la misma para el spa y para la clínica (solape S3, decidido el 07-10).
// `tenantId` redundante con el del cliente pero presente por la regla de
// aislamiento por fila.
//
// ── Lo que clinica-4 le añadió, y por qué ─────────────────────────────
//
// Cinco condiciones de S3, y las cinco están en la migración
// `20261008010000_clinica_4_consentimientos_fotos_informe`:
//
//   1. **No se borra**: `client_id` pasó de CASCADE a **RESTRICT** y la
//      tabla es de **solo inserción** (trigger `client_consents_append_only`).
//   2. **Revocar sin editar**: `revokesConsentId` apunta a la fila que
//      esta revoca. Vale igual para `DATA` (RGPD) que para `TREATMENT`.
//   3. **Qué se firmó exactamente**: plantilla + versión + huella del
//      texto + huella SHA-256 del PDF.
//   4. **Quién firma y quién informa**: firmante (paciente o
//      representante con su relación) e informante (`User`).
//   5. **Lo clínico se ve como historia**: `clinical` copia la marca de
//      la plantilla, y con ella el PDF pasa por `conHistoria`.
//
// Las filas que ya existían se quedan como **alta manual sin plantilla**:
// `templateId` NULL, sin versión y sin huella. No se les inventa nada.
model ClientConsent {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  clientId  String            @map("client_id") @db.Uuid
  kind      ClientConsentKind
  grantedAt DateTime          @default(now()) @map("granted_at") @db.Timestamptz()
  // Referencia opcional al documento firmado (URL / id externo). Con
  // plantilla clínica es el id del PDF que sirve la API; en el alta
  // manual del spa sigue siendo lo que la dueña escriba.
  docRef    String?           @map("doc_ref")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  // ── clinica-4 · la plantilla congelada ──────────────────────────────
  // Id y versión de `@mipiacetpv/consentimientos`, y la huella del texto
  // canónico que se leyó. Los tres juntos o los tres NULL (CHECK
  // `client_consents_plantilla_completa`): media plantilla es una fila
  // que dice que se informó de un texto que no se sabe cuál fue.
  templateId          String? @map("template_id") @db.VarChar(40)
  templateVersion     Int?    @map("template_version")
  textSha256          String? @map("text_sha256") @db.Char(64)
  // El PDF firmado: su huella y su fichero en el volumen clínico. Se
  // vuelve a calcular sobre el fichero para comprobar que nadie lo tocó.
  pdfSha256           String? @map("pdf_sha256") @db.Char(64)
  pdfFileName         String? @map("pdf_file_name") @db.VarChar(100)
  // Copia de la marca «clínica» de la plantilla. Copiada y no consultada:
  // si mañana una plantilla deja de ser clínica, lo firmado ayer siguió
  // siendo contenido de una historia clínica.
  clinical            Boolean @default(false)
  // PACIENTE | REPRESENTANTE, con nombre y relación sólo en el segundo
  // caso (CHECK `client_consents_firmante_valido`).
  signer              String? @db.VarChar(20)
  signerName          String? @map("signer_name") @db.VarChar(120)
  signerRelation      String? @map("signer_relation") @db.VarChar(60)
  // Quién informó. Obligatorio si `clinical` (CHECK); que ADEMÁS sea
  // sanitario lo exige la API, porque cruza dos tablas.
  informerUserId      String? @map("informer_user_id") @db.Uuid
  // La fila que esta revoca. Una fila con esto puesto NO concede nada.
  revokesConsentId    String? @map("revokes_consent_id") @db.Uuid
  revokeReason        String? @map("revoke_reason") @db.VarChar(200)
  /// clinica-7 · el motivo de la revocación, cifrado. Se cifra SIEMPRE, no
  /// solo cuando `clinical` — la columna es la misma para el spa y para la
  /// clínica, y un `if` por fila sería un sitio donde equivocarse.
  revokeReasonCifrado String? @map("revoke_reason_cifrado")
  createdByUserId     String? @map("created_by_user_id") @db.Uuid

  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  informer    User?           @relation("ClientConsentInformer", fields: [informerUserId], references: [id], onDelete: Restrict)
  revoca      ClientConsent?  @relation("ClientConsentRevocacion", fields: [revokesConsentId], references: [id], onDelete: Restrict)
  revocadoPor ClientConsent[] @relation("ClientConsentRevocacion")

  @@index([tenantId, clientId])
  @@map("client_consents")
}

// clinica-4 · LAS FOTOS CLÍNICAS.
//
// El JPEG vive en el volumen de ficheros clínicos (`CLINICAL_FILES_DIR`),
// **no en Postgres y no en nada que se sirva en estático** (decisión 11):
// se sirve sólo por la API, por `conHistoria`, y cada apertura deja su
// línea en `ClinicalAccessLog`. El mismo reparto que las capturas de
// terminal de A5 (`device_screenshots`), con una diferencia de fondo: una
// captura caduca a las 24 h y **una foto de la historia no caduca nunca**.
//
// Y no se borra: se **retira** con autor y motivo (decisión 13). Deja de
// verse en el comparador y sigue en la historia. El trigger
// `clinical_photos_guard` deja pasar esa única transición y nada más.
model ClinicalPhoto {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  // La cita de la que salió. SET NULL como en `ClinicalEntry`: si la cita
  // desapareciera, la foto sigue en la historia y pierde el enlace, no el
  // contenido. (En la práctica el guard lo convierte en «una cita con
  // fotos no se borra», que es la garantía más fuerte que clinica-3 §6.1
  // descubrió con el mismo patrón.)
  appointmentId String?  @map("appointment_id") @db.Uuid
  // `"L:h"` y la versión del mapa con la que se eligió la zona.
  zona          String   @db.VarChar(40)
  /// clinica-7 · la zona, cifrada. La zona dice DÓNDE tiene el problema el
  /// paciente, y eso es un dato de salud aunque quepa en cuatro
  /// caracteres. Se puede cifrar porque el comparador ya agrupa por zona
  /// en memoria: ninguna consulta filtra por zona en SQL.
  zonaCifrada   String?  @map("zona_cifrada")
  mapaVersion   Int      @map("mapa_version")
  fileName      String   @map("file_name") @db.VarChar(100)
  sha256        String   @db.Char(64)
  bytes         Int
  mimeType      String   @map("mime_type") @db.VarChar(40)
  authorUserId  String   @map("author_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  withdrawnAt           DateTime? @map("withdrawn_at") @db.Timestamptz()
  withdrawnByUserId     String?   @map("withdrawn_by_user_id") @db.Uuid
  withdrawReason        String?   @map("withdraw_reason") @db.VarChar(200)
  /// clinica-7 · el motivo de la retirada, cifrado. «Se retiró porque la
  /// paciente pidió que no se le hicieran más fotos del pie diabético» es
  /// un dato de salud escrito por una persona con prisa.
  withdrawReasonCifrado String?   @map("withdraw_reason_cifrado")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  author      User         @relation("ClinicalPhotoAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  withdrawnBy User?        @relation("ClinicalPhotoWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: Restrict)

  @@unique([fileName])
  @@index([tenantId, clientId, createdAt])
  @@map("clinical_photos")
}

// clinica-4 · LAS ENTREGAS DEL INFORME. Solo inserciones.
//
// Contesta «¿qué se le entregó a quién?»: el informe, el canal, el
// destinatario, la huella del PDF, quién y cuándo. La otra mitad —«¿quién
// ha abierto esta historia?»— la contesta `ClinicalAccessLog`, que recibe
// su línea con `action = EXPORT` porque la ruta pasa por `conHistoria`.
// Las dos, porque ninguna puede contestar la pregunta de la otra: el
// registro de accesos no tiene sitio para el canal ni el destinatario, y
// clinica-1 lo dejó estrecho a propósito.
//
// **Ni un dato de salud**: no se guarda el PDF, ni su contenido, ni el
// motivo de la derivación.
model ClinicalReportDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  // RESUMEN | SESIONES | DERIVACION | COMPLETA (CHECK en la migración).
  report         String   @db.VarChar(20)
  // PRINT | EMAIL.
  channel        String   @db.VarChar(20)
  // PACIENTE | PROFESIONAL.
  recipient      String   @db.VarChar(20)
  // Sólo con canal EMAIL (CHECK `..._email_segun_canal`).
  recipientEmail String?  @map("recipient_email") @db.VarChar(200)
  pdfSha256      String   @map("pdf_sha256") @db.Char(64)
  // ── clinica-7 · el PDF de las entregas POR ENLACE sí se guarda ─────
  //
  // Divergencia declarada con clinica-4 §3, que decidió que el PDF del
  // informe NO se guarda. Eso vale para imprimir y para el adjunto: en los
  // dos el documento se lo lleva alguien en el mismo acto. **Con un enlace
  // no se lo lleva nadie** — tiene que existir cuando el destinatario lo
  // abra, tres días después. Y no se puede volver a armar entonces:
  // `armarInforme` lee la historia VIVA, así que una visita nueva cambiaría
  // el documento y el `pdfSha256` de esta fila dejaría de cuadrar.
  //
  // `null` en las entregas por impresión. El CHECK
  // `..._enlace_completo` ata las dos columnas: van juntas o ninguna.
  pdfFileName    String?  @map("pdf_file_name") @db.VarChar(100)
  // El enlace por el que salió. Sin FK dura a propósito: si un día se
  // purgaran los enlaces caducados, una FK lo impediría.
  publicLinkId   String?  @map("public_link_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User   @relation("ClinicalReportDeliveryUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, clientId, at])
  @@map("clinical_report_deliveries")
}

// Ficha técnica mínima: notas por servicio. Vale igual para peluquería
// (fórmula de color) que para clínica (parámetros de tratamiento). El
// `serviceId` es el id de servicio de Holded — NO una FK dura (el
// catálogo es espejo, no se acopla). `createdByUserId` guarda el autor
// como Uuid plano (auditoría) sin relación dura para no acoplar a User.
model ClientTechnicalNote {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  serviceId       String?  @map("service_id")
  body            String
  /// clinica-7 · cifrada en los tenants clínicos. En peluquería esto es la
  /// fórmula del color; en una clínica son «los parámetros del
  /// tratamiento», que es exactamente un dato de salud. **No estaba en la
  /// lista del prompt**: entra por la regla «si dudas, se cifra», y figura
  /// así en el inventario del `-done`.
  bodyCifrado     String?  @map("body_cifrado")
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
  @@index([clientId, serviceId])
  @@map("client_technical_notes")
}

// ─── Catálogo de servicios extendido (B-reservas-2) ────────────────────
//
// Capa de EXTENSIÓN local sobre el `product` de Holded (ADR-R1). NO es
// una tabla `Service` paralela: el precio, el IVA y el alta del servicio
// siguen en Holded (product.kind=SERVICE, holdedProductId). Aquí sólo
// vive lo que la agenda necesita y Holded no modela: duración, pausas,
// nº de profesionales, familia y flags de canal. Un servicio sin fila
// aquí simplemente no es reservable ni tiene duración → la agenda (B4)
// lo ignora. Multi-tenant por fila; migración aditiva con backfill vacío.
model ServiceScheduling {
  // PK = FK al producto (relación 1:1 con product.kind=SERVICE). No hay
  // id propio: la extensión ES el producto. `Unsupported`/soft: Prisma no
  // puede exigir kind=SERVICE a nivel de BD; lo valida el endpoint.
  productId         String   @id @map("product_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  durationMin       Int      @map("duration_min")
  bufferBeforeMin   Int      @default(0) @map("buffer_before_min")
  bufferAfterMin    Int      @default(0) @map("buffer_after_min")
  // Nº de profesionales simultáneos que requiere el servicio (Sinfonía a
  // 4 manos = 2, a 8 = 4). El motor de disponibilidad (B4) lo usa.
  staffRequired     Int      @default(1) @map("staff_required")
  // Contrato para B4/B6: un servicio con onlineBookable=false queda
  // marcado como NO ofrecible en reserva online.
  onlineBookable    Boolean  @default(false) @map("online_bookable")
  // Familia/agrupación libre del servicio (p.ej. "Faciales", "Corte").
  family            String?
  // Flags de canal: en qué superficies aparece el servicio. Forma
  // estable `{caja,ticket,agenda,online}` (jsonb). El front la lee tal
  // cual; `online` debe ir de la mano de `onlineBookable`.
  channels          Json     @default("{\"caja\":true,\"ticket\":true,\"agenda\":true,\"online\":false}")
  // clinica-2 · «este servicio es la primera valoración».
  //
  // Al dar una cita de un servicio marcado así a un paciente que no tiene
  // valoración, el alta crea la valoración PENDIENTE_PACIENTE y manda el
  // email con el enlace. Es la marca que convierte «dar la cita» en «el
  // paciente recibe el test», sin que nadie tenga que acordarse.
  //
  // Vive aquí y no en el producto de Holded porque es agenda, no catálogo
  // (ADR-R1): Holded no modela esto y el precio/IVA del servicio siguen
  // siendo suyos. Nace en `false` para los quince tenants de hoy, así que
  // ningún alta de cita existente cambia de comportamiento.
  primeraValoracion Boolean  @default(false) @map("primera_valoracion")
  // clinica-3 · «este servicio es un tratamiento de la sesión».
  //
  // QUÉ BOTONES SALEN EN LA SESIÓN LO DECIDE EL CATÁLOGO. Es la misma
  // forma y el mismo sitio que `primeraValoracion`, a propósito: la
  // podóloga mantiene UNA pantalla (Catálogo de agenda) y no dos.
  //
  // El precio y el IVA de cada botón siguen saliendo del catálogo y no de
  // la historia (prompt §1): la sesión guarda el NOMBRE del tratamiento
  // —para que la historia se lea— y nunca su importe.
  //
  // Nace en `false`, así que ningún servicio de los tenants de hoy se
  // convierte en un tratamiento de sesión.
  tratamientoSesion Boolean  @default(false) @map("tratamiento_sesion")
  // clinica-5 · «este servicio ES el nivel N de la quiropodia».
  //
  // 1 básica · 2 completa · 3 extra. NULL = no es ninguno de los tres (lo
  // normal: una cura, un papiloma, una exploración biomecánica).
  //
  // ── Por qué hace falta una columna y no basta la categoría ───────────
  //
  // Decisión 4: «el nivel elegido decide QUÉ PRODUCTO del catálogo pasa a
  // caja (los tres niveles son tres productos)». La categoría dice que los
  // tres son de quiropodia; no dice cuál de ellos es «extra». Sin esto, la
  // sesión propondría un nivel y no sabría qué línea cobrar.
  //
  // Lo que NO se hizo es deducirlo del nombre del producto («…extra»):
  // sería una regla de negocio escrita en una cadena de texto que la
  // dueña puede renombrar desde Holded sin enterarse.
  //
  // Vive aquí, junto a `primeraValoracion` y `tratamientoSesion`, por la
  // misma razón que ellas: la podóloga mantiene UNA pantalla (Catálogo de
  // agenda) y no dos. Nace en NULL, así que ningún servicio de los quince
  // tenants de hoy es el nivel de nada.
  //
  // DOS garantías en la migración, ninguna expresable en Prisma 5:
  //
  //   · `service_scheduling_nivel_quiropodia_valido` — CHECK 1..3.
  //   · `service_scheduling_un_servicio_por_nivel` — índice ÚNICO PARCIAL
  //     por (tenant, nivel). Dos servicios que digan ser «quiropodia
  //     extra» es una sesión que no sabe cuál cobrar, y es mejor que
  //     falle al configurarlo que con la paciente delante.
  nivelQuiropodia   Int?     @map("nivel_quiropodia")
  // clinica-4 · QUÉ CONSENTIMIENTOS PIDE ESTE SERVICIO.
  //
  // Decisión 4 del prompt: la dueña los marca en el servicio, en el sitio
  // donde hoy se configura el servicio — aquí, junto a las tres marcas de
  // arriba, porque la podóloga mantiene UNA pantalla y no dos.
  //
  // Ids de plantilla de `@mipiacetpv/consentimientos`. Un array y no una
  // tabla de cruce: son como mucho tres ids de una lista CERRADA EN
  // CÓDIGO, y una tabla de cruce habría pedido una FK a una tabla de
  // plantillas que no existe (decisión 3: versionadas en código).
  //
  // «Fotos clínicas» NO se puede marcar aquí y la ruta lo rechaza: no se
  // ata a ningún servicio, la pide la primera foto. Atarla habría dejado
  // sin consentimiento a la paciente a la que se le hace una foto en una
  // quiropodia normal.
  //
  // Nace en `{}`: ningún servicio de los quince tenants de hoy pide nada.
  consentimientos   String[] @default([]) @map("consentimientos") @db.VarChar(40)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_scheduling")
}

// Recurso reservable genérico (ADR-R6, vocabulario neutro): cabina de
// spa, box/sala de clínica, aparato. Un servicio requiere N recursos de
// un TIPO (no uno concreto) vía `ServiceResourceNeed`. Local, sin espejo
// en Holded.
model Resource {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  name      String
  kind      ResourceKind
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, kind])
  @@map("resources")
}

// Necesidad de recurso de un servicio: "este servicio requiere `qty`
// recursos de tipo `resourceKind`". No apunta a un recurso concreto — el
// motor de disponibilidad (B4) elige uno libre del tipo. `serviceId` es
// el productId del servicio (kind=SERVICE). PK compuesta: un servicio
// tiene como mucho una fila por tipo de recurso.
model ServiceResourceNeed {
  serviceId    String       @map("service_id") @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  resourceKind ResourceKind @map("resource_kind")
  qty          Int          @default(1)

  service Product @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceKind])
  @@index([tenantId])
  @@map("service_resource_needs")
}

// ─── Personal / horarios (B-reservas-3) ────────────────────────────────
//
// El personal NO es una entidad nueva: es el `user` existente extendido
// (ADR-R1, restricción del bloque — no tabla `Staff` paralela). Estas
// tres tablas cuelgan del `user` y son la base de la agenda multi-
// profesional (B4). Gate por `Tenant.agendaEnabled` (ADR-R6, columna
// propiedad de B-reservas-2). Multi-tenant por fila; migración aditiva.

// Perfil de agenda de un profesional. Relación 1:1 con `user`: la PK es
// el propio `userId` (no hay id propio — el perfil ES el usuario visto
// como profesional). `displayName` permite un nombre de agenda distinto
// del alias de caja; `color` pinta su columna en la agenda; `active`
// saca al profesional de la agenda sin borrar su histórico.
model StaffProfile {
  userId      String   @id @map("user_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String   @map("display_name")
  active      Boolean  @default(true)
  color       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("staff_profiles")
}

// Matriz profesional × servicio: qué servicios sabe dar cada profesional.
// `serviceId` = `product.id` (kind=SERVICE) — se alinea con la convención
// de B-reservas-2 (`ServiceScheduling.productId`, `ServiceResourceNeed`),
// FK dura al catálogo local para que el motor de B4 cruce skill ∩ servicio
// por integridad referencial. PK compuesta `(userId, serviceId)`: un
// profesional tiene como mucho una fila por servicio. `tenantId` presente
// por la regla de aislamiento por fila.
model StaffSkill {
  userId    String   @map("user_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Product @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  // "¿qué profesionales pueden dar el servicio X?" (contrato para B4).
  @@index([tenantId, serviceId])
  @@index([tenantId, userId])
  @@map("staff_skills")
}

// Turno de un profesional como PLANTILLA recurrente + ventana de validez.
// `rrule` es RFC 5545 estándar (p.ej. `FREQ=WEEKLY;BYDAY=MO,TU`) — se
// expande con rrule.js, no hay formato propio. `startTime`/`endTime` son
// horas de pared "HH:MM" (la recurrencia da los días; la hora la ponen
// estos campos). `validFrom`/`validUntil` acotan desde/hasta cuándo rige
// la plantilla (una semana tipo puede cambiar por temporada). El motor de
// B4 cruza la expansión de estos turnos con skill y sin-solape.
model StaffShift {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  rrule      String
  startTime  String         @map("start_time")
  endTime    String         @map("end_time")
  validFrom  DateTime       @map("valid_from") @db.Date
  validUntil DateTime?      @map("valid_until") @db.Date
  kind       StaffShiftKind @default(REGULAR)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId])
  @@map("staff_shifts")
}

// ─── Motor de reservas: núcleo agnóstico (B-reservas-4, ADR-R8) ─────────
//
// Núcleo compartido cita/mesa. B4 implementa el modo CITA; el bloque de
// mesa (hostelería) cae encima SIN migrar el núcleo. Las columnas/valores
// específicos de mesa (`partySize`, valores TABLE de los enums) existen ya
// pero B4 no los usa; la columna `table_id` y el EXCLUDE `no_table_overlap`
// se DIFIEREN al bloque de mesa (ADR-R8 §7). Vocabulario neutro
// (cliente/profesional/servicio/recurso), cero `if(businessType)`.
//
// Las columnas de rango temporal (`timeslot`, `slot`) son `tstzrange`
// (`Unsupported`): Prisma no las escribe/lee — TODO acceso a ellas pasa por
// SQL crudo en `apps/api/src/agenda/store.ts` (INSERT con tstzrange, SELECT
// con lower()/upper()). El anti-solape NO vive en el código: son los
// EXCLUDE USING gist sobre `appointment_assignments.slot` (ver migración).
// Multi-tenant por fila; migración aditiva con backfill vacío.

// La reserva / el "visit": una visita del cliente que puede encadenar
// varios servicios. Se llama `appointment` para alinear con el contrato ya
// publicado de B1 (`GET /clients/:id/history` reserva `kind:"APPOINTMENT"`).
model Appointment {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @map("tenant_id") @db.Uuid
  // Idempotencia del alta offline/online por outbox (mismo patrón que
  // `Client.externalId` / `Ticket.externalId`).
  externalId    String?                  @unique @map("external_id") @db.Uuid
  mode          ReservationMode          @default(APPOINTMENT)
  // Nullable: walk-in / reserva anónima de teléfono.
  clientId      String?                  @map("client_id") @db.Uuid
  // Span [inicio, fin) de la visita (client-facing). El anti-solape real
  // (con buffers) vive en el assignment. tstzrange → SQL crudo.
  timeslot      Unsupported("tstzrange")
  status        AppointmentStatus        @default(PENDING)
  source        ReservationSource        @default(PRESENCIAL)
  // Sólo modo mesa (comensales). Nullable en cita.
  partySize     Int?                     @map("party_size")
  // B-reservas-8 · EL BONO de esta cita, y desde este bloque con CLAVE
  // AJENA de verdad (en B4 era «sólo la columna»). Puesto = esta cita
  // tiene una sesión APARTADA de ese bono; se consume al cobrarla y se
  // libera al anularla. **Un solo bono por cita** (S6).
  //
  // `SetNull`: si el bono desaparece —y el único caso real es el reseteo
  // del ensayo, que se lleva el bono con su ticket— la cita se queda como
  // una cita normal, que es la verdad. No se borra la cita.
  voucherId     String?                  @map("voucher_id") @db.Uuid
  // Señal cobrada (ADR-R5b; fuera de alcance en B4; sólo la columna).
  depositCents  Int?                     @map("deposit_cents")
  // TTL del hold PENDING (carrera de reserva). El job lo libera al vencer.
  pendingUntil  DateTime?                @map("pending_until") @db.Timestamptz()
  // Enlace al ticket cuando se cobra (el puente cita→caja). Al cerrar el
  // ticket la cita pasa a COMPLETED.
  ticketId      String?                  @unique @map("ticket_id") @db.Uuid
  notes         String?
  /// clinica-7 · la nota de la cita, cifrada **en los tenants con la
  /// clínica encendida**. En una clínica, «viene por lo del dedo
  /// infectado» acaba aquí, y eso es un dato de salud en una tabla que
  /// nadie trataba como clínica. En un bar la columna se queda vacía y la
  /// nota sigue en claro, como ayer.
  ///
  /// Y con el contrato de encargado NO VIGENTE, una cita NUEVA de un
  /// tenant clínico no admite nota (decisión 5): solo hora, paciente y
  /// servicio. Las que ya existen se siguen viendo.
  notesCifradas String?                  @map("notes_cifradas")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client              Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ticket              Ticket?                 @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  // B-reservas-8 · ver `voucherId` arriba.
  voucher             Voucher?                @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  items               AppointmentItem[]
  assignments         AppointmentAssignment[]
  // clinica-1 · las anotaciones escritas en esta cita. SET NULL al otro
  // lado: si la cita desapareciera, la anotación sigue en la historia y
  // pierde el enlace, no el contenido.
  clinicalEntries     ClinicalEntry[]
  // clinica-2 · la valoración que esta cita disparó, si era de primera
  // valoración. SET NULL al otro lado por la misma razón que las entradas.
  clinicalAssessments ClinicalAssessment[]
  // clinica-4 · las fotos hechas en esta cita. SET NULL al otro lado,
  // igual que las entradas.
  clinicalPhotos      ClinicalPhoto[]

  // El índice gist (tenant_id, timeslot) para consultas de rango se crea en
  // SQL (Prisma no expresa gist sobre Unsupported).
  @@index([tenantId, status])
  @@index([tenantId, clientId])
  // B-reservas-8 · «¿qué citas apartaron de este bono?», la traza de la ficha.
  @@index([tenantId, voucherId])
  @@map("appointments")
}

// Un servicio dentro del visit. Habilita multi-servicio encadenable
// (corte+tinte en una visita, cada uno con su profesional). Snapshot de
// duración/buffers/staffRequired al crear: editar el catálogo luego no
// mueve el histórico. Sólo modo cita. `serviceId` = product.id (kind=
// SERVICE); FK dura en SQL, sin relación Prisma para no inflar back-refs.
model AppointmentItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  appointmentId   String   @map("appointment_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  durationMin     Int      @map("duration_min")
  bufferBeforeMin Int      @default(0) @map("buffer_before_min")
  bufferAfterMin  Int      @default(0) @map("buffer_after_min")
  staffRequired   Int      @default(1) @map("staff_required")
  sortOrder       Int      @map("sort_order")
  // Offset desde el inicio del visit (encadenado secuencial). El span del
  // item = [start+offset, start+offset+duration).
  startOffsetMin  Int      @default(0) @map("start_offset_min")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, appointmentId])
  @@map("appointment_items")
}

// Ata la reserva a un recurso concreto. Donde vive el GiST (una Sinfonía a
// 8 manos = 1 cita con 4 assignments de staff + 1 cabina). `staffUserId` /
// `resourceId` son Uuid con FK sólo en SQL (sin relación Prisma para no
// inflar back-refs en User/Resource). `tableId` DIFERIDA al bloque de mesa.
model AppointmentAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  appointmentId     String                   @map("appointment_id") @db.Uuid
  // A qué servicio corresponde (nullable: una cabina puede ser del visit
  // entero; y modo mesa no usa items).
  appointmentItemId String?                  @map("appointment_item_id") @db.Uuid
  reservableType    ReservableType           @map("reservable_type")
  staffUserId       String?                  @map("staff_user_id") @db.Uuid
  resourceId        String?                  @map("resource_id") @db.Uuid
  // Intervalo ocupado por ESTE recurso (span del item + buffers para staff;
  // visita entera para una cabina). tstzrange → SQL crudo. Sobre esta
  // columna viven los EXCLUDE USING gist (no_staff_overlap /
  // no_resource_overlap), parciales por `active`.
  slot              Unsupported("tstzrange")
  // Se mantiene en sync con appointment.status en la misma tx:
  // active = status NOT IN (CANCELLED, NO_SHOW). Es la col del WHERE del
  // EXCLUDE — un hueco cancelado deja de bloquear.
  active            Boolean                  @default(true)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, appointmentId])
  @@map("appointment_assignments")
}

// Bloqueos estructurales: cierre VIP, formación, vacaciones, "sábado tarde
// sólo X". B4: bloqueos PUNTUALES (`slot`). El recurrente (`rrule`)
// reutiliza el expander rrule.js de B3 (lectura); su alta puede ser
// fast-follow. `tableId` DIFERIDA al bloque de mesa.
model BookingBlock {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  scope       BlockScope
  staffUserId String?                   @map("staff_user_id") @db.Uuid
  resourceId  String?                   @map("resource_id") @db.Uuid
  // Puntual: intervalo concreto (tstzrange → SQL crudo). Nullable porque un
  // bloqueo recurrente no lo usa.
  slot        Unsupported("tstzrange")?
  // Recurrente: plantilla rrule + hora de pared + ventana de validez
  // (mismo patrón que StaffShift). Nullable para bloqueos puntuales.
  rrule       String?
  startTime   String?                   @map("start_time")
  endTime     String?                   @map("end_time")
  validFrom   DateTime?                 @map("valid_from") @db.Date
  validUntil  DateTime?                 @map("valid_until") @db.Date
  reason      String?
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("booking_blocks")
}

// La consultoría hecha código: parámetros de política por centro,
// ajustables sin deploy. B4: subset (min/max lead, ventana de cancelación).
// El catálogo completo (cobertura mínima, rituales simultáneos, mesa) es
// fast-follow. Cada key = una función pura registrada en código; `value` la
// parametriza.
model BookingPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("booking_policies")
}

// ─── B-reservas-7a · El horario del centro ──────────────────────────────
//
// El TECHO de la agenda. Hasta este bloque la disponibilidad salía SÓLO de
// los turnos del personal (`staff_shifts` → `store.getTemplateSlots`): si
// nadie definía turno el centro no abría, y si alguien lo definía de par en
// par el centro abría de par en par. La ventana de un profesional en una
// fecha pasa a ser `turno ∩ horario_del_centro(fecha)`, y de ahí se siguen
// descontando los bloqueos y las citas como hasta ahora.
//
// Migración ADITIVA con backfill VACÍO: un tenant sin ninguna fila en
// `center_hours` NO tiene techo y se comporta exactamente como antes de
// este bloque. Ésa es la compatibilidad, y está testeada.
//
// NO se toca `StaffShift` (D-3 del cruce): es contrato vivo de B3.

// La semana tipo del centro. VARIAS filas por día = horario partido
// (10:00–14:00 y 17:00–20:30). `openTime`/`closeTime` son horas de PARED
// "HH:MM", igual que en `StaffShift`: la recurrencia la da `weekday` y la
// hora estos campos, sin conversión. `validFrom`/`validUntil` acotan la
// vigencia (una semana tipo cambia por temporada).
//
// `weekday` es ISO-8601: 1 = lunes … 7 = domingo. NO el `getUTCDay()` de
// JS (0 = domingo) porque la pantalla se lee de lunes a domingo y porque
// "cierra el domingo" tiene que poder escribirse sin pensar. El CHECK del
// rango vive en la base de datos.
model CenterHours {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  weekday    Int
  openTime   String    @map("open_time")
  closeTime  String    @map("close_time")
  validFrom  DateTime  @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, weekday])
  @@map("center_hours")
}

// Los días especiales del centro. Una fila es O BIEN un cierre con nombre
// (un festivo, "vacaciones de agosto") O BIEN un horario propio de ese día
// con nombre ("boda Marta").
//
// Un día especial SUSTITUYE al horario semanal de ese día; no se suma. Un
// solo rango por día basta: un festivo no tiene horario partido y un sábado
// de boda tampoco.
//
// POR QUÉ ES UNA TABLA Y NO UN `BookingBlock scope=CENTER`: un bloqueo sólo
// sabe CERRAR. El sábado de la boda hay que ABRIR a las 8:30, antes de la
// hora normal, y eso un bloqueo no lo puede decir. Y el festivo necesita un
// NOMBRE que la rejilla pueda leer en voz alta ("Cerrado · Virgen del
// Prado"); el `reason` de un bloqueo no viaja hoy hasta la pantalla.
//
// El CHECK de coherencia (cerrado ⇒ sin horas; abierto ⇒ con las dos y
// ordenadas) y el de nombre no vacío viven en la base de datos.
model CenterDay {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  date      DateTime @db.Date
  closed    Boolean  @default(true)
  name      String
  openTime  String?  @map("open_time")
  closeTime String?  @map("close_time")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("center_days")
}

// ─── B-reservas-8 · Bonos de sesiones ───────────────────────────────────
//
// El libro, la puerta de canje y la sesión apartada en la cita. Todo detrás
// de `Tenant.bonosEnabled` (404 con la columna apagada) y aislado por fila.
//
// ── Las tres decisiones de fondo, para que no se relean cuatro documentos
//
//   1. **Extiende `voucher`, NO se crea un `Program` paralelo** (D-2 del
//      cruce con B-reservas-4). Un modelo paralelo serían dos sitios donde
//      mirar el saldo de una clienta, dos caminos fiscales y dos formas de
//      canjear en caja.
//   2. **Dos pasos** (S6, 07-10): al DAR LA CITA se APARTA una sesión —no
//      descuenta, sólo impide dar más citas de bono que sesiones quedan—; al
//      COBRAR, lo apartado pasa a CONSUMIDO contra lo que se hizo. Nunca se
//      consume un bono contra un servicio que no cubre.
//   3. **Dinero y deuda van por separado** (`07` pieza 1): el bono congela
//      su VALOR DE CARTA (lo que el centro debe) y LO COBRADO (lo que entró,
//      que vive en el ticket). Un bono regalado vale lo de carta en
//      sesiones. El libro no duplica el cobro: lo enlaza.
//
// ── Y la que se nota en cada consulta ──────────────────────────────────
//
// **El saldo se DERIVA del libro.** `sessionsLeft` / `sessionsReserved` son
// columnas y no la verdad: existen porque el decremento condicionado («no
// aparto si no queda libre») se hace con un `UPDATE … WHERE sessions_left >
// 0` sobre la fila bloqueada, y porque la rejilla de la agenda las lee
// cincuenta veces por pantalla. Si discrepan del libro, **manda el libro**,
// y hay un test que recorre 200 operaciones aleatorias comprobando
//
//     total − consumidas − apartadas vivas = libres
//
// (`apps/api/test-e2e/bonos-libro.e2e.ts`).

// La PLANTILLA de bono de un producto del catálogo (1:1 con `Product`).
//
// Qué es un bono en el catálogo (decisión de Dirección, 18-10): un producto
// normal —precio, IVA, categoría, exención— con esta fila colgando. Venderlo
// es añadir ese producto al ticket, así que el precio y el IVA van por el
// camino de siempre y NO hay un segundo sitio donde se fije el precio de un
// bono.
//
// `coversServiceIds` / `coversTagSlugs`: vale por SERVICIO o por CATEGORÍA
// (S5 — la categoría es la familia, y en este TPV una categoría es un tag de
// `Product.tags`). Los dos pueden estar poblados a la vez: cubre la unión.
// Al vender, la cobertura se COPIA al bono y se congela, así que editar la
// plantilla —o ocultar un servicio, o cambiarle el precio— no invalida nada
// de lo ya vendido (`07` pieza 16, con test).
model VoucherTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  // 1:1 con el producto. `Cascade`: si el producto se borra, su plantilla
  // se va con él — los bonos YA VENDIDOS no, que llevan su propia copia.
  productId        String   @unique @map("product_id") @db.Uuid
  sessions         Int
  coversServiceIds String[] @default([]) @map("covers_service_ids") @db.Uuid
  coversTagSlugs   String[] @default([]) @map("covers_tag_slugs")
  // Caducidad en MESES DE CALENDARIO (no 183 días: `07` pieza 18).
  // NULL = sin caducidad. Manda sobre `Tenant.bonoCaducidadMeses`.
  expiresMonths    Int?     @map("expires_months")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vouchers Voucher[]

  @@index([tenantId])
  @@map("voucher_templates")
}

// EL BONO. Una deuda del centro con UNA ficha, medida en sesiones.
//
// `type` y `sessionsLeft` NO son invención de este bloque: son el contrato
// que `agenda/health.ts` publicó para la tarjeta 3 («saldo vivo sin cita»,
// `SQL_SALDO_VIVO_SIN_CITA`) y lo que el diseño cerrado ya modelaba
// (`reservas-modulo-kickoff.md` §4). Se respetan los nombres para que esa
// tarjeta se encienda con la migración y no haya que reescribirla.
//
// `amountTotalCents` / `amountLeftCents` quedan NULL y nadie los escribe en
// este bloque: son el hueco de **B-cheques** (cheques por importe, saldos
// `S-`), que se monta sobre este mismo libro. El CHECK
// `vouchers_tipo_coherente` garantiza que un `SESSIONS` no los lleve y que
// un `AMOUNT` no lleve sesiones, así que B-cheques es aditivo y no un
// rediseño. Las señales `R-` son B-13 y tampoco se construyen aquí.
model Voucher {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  // OBLIGATORIO: el bono es de una ficha. Sin bonos compartidos en esta
  // versión (S7, fuera de alcance). `Restrict`: la ficha no se borra.
  clientId         String    @map("client_id") @db.Uuid
  // `B<n>`, único por tenant. Es lo que se teclea en el mostrador y lo que
  // sale impreso. Se acepta el número suelto al buscar (`B87`, `b 87`,
  // `87`): la normalización vive en `vouchers/numero.ts`.
  code             String
  number           Int
  // NULL en un bono de PAPEL dado de alta a mano («alta inicial»).
  templateId       String?   @map("template_id") @db.Uuid
  // SESSIONS (todo lo de este bloque) | AMOUNT (B-cheques).
  type             String    @default("SESSIONS")
  // Lo que se vendió. No se edita: se corrige con una línea del libro.
  sessionsTotal    Int       @map("sessions_total")
  // DERIVADAS del libro, guardadas (ver la nota de la cabecera). `libres`
  // y `apartadas vivas`.
  sessionsLeft     Int       @map("sessions_left")
  sessionsReserved Int       @default(0) @map("sessions_reserved")
  // B-cheques. NULL en un bono de sesiones (CHECK).
  amountTotalCents Int?      @map("amount_total_cents")
  amountLeftCents  Int?      @map("amount_left_cents")
  // La COBERTURA CONGELADA: copia de la plantilla en el momento de vender.
  // Ocultar o cambiar de precio un servicio no invalida bonos vendidos.
  coversServiceIds String[]  @default([]) @map("covers_service_ids") @db.Uuid
  coversTagSlugs   String[]  @default([]) @map("covers_tag_slugs")
  // Cómo se llama de cara al mostrador («Bono 5 quiropodias»). Snapshot,
  // igual que `TicketLine.nameSnapshot`: renombrar el producto mañana no
  // reescribe lo que la clienta compró.
  nameSnapshot     String    @map("name_snapshot")
  // DINERO Y DEUDA, separados (`07` pieza 1):
  //   · `valorCartaCents` — lo que el centro DEBE. Es lo que vale el bono
  //     en sesiones aunque se vendiera con descuento o se regalara.
  //   · `cobradoCents`    — lo que ENTRÓ. Es un espejo del ticket, no una
  //     segunda contabilidad: el cobro es el ticket y aquí se enlaza.
  valorCartaCents  Int       @map("valor_carta_cents")
  cobradoCents     Int       @map("cobrado_cents")
  // La venta. NULL en un alta inicial (bono de papel, sin ticket).
  // `Cascade`: el bono de un ticket `TEST` se va con su ticket en el
  // reseteo del ensayo.
  soldTicketId     String?   @map("sold_ticket_id") @db.Uuid
  // La LÍNEA concreta de esa venta. FK dura en SQL, SIN relación Prisma
  // (mismo criterio que `appointment_items_service_id_fkey`: no inflar
  // back-refs en `TicketLine` por un puntero de auditoría).
  soldTicketLineId String?   @map("sold_ticket_line_id") @db.Uuid
  // El INSTANTE en que deja de valer, EXCLUSIVO: el arranque del día
  // siguiente al último día bueno, en hora del centro. Así «caduca el 28
  // de febrero» incluye el 28 entero (`07` pieza 18) sin guardar horas de
  // pared. Lo que se PINTA se deriva (`vouchers/caducidad.ts::diaDeCaducidad`).
  // NULL = sin caducidad, que es el default.
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz()
  // ACTIVO | AGOTADO | CADUCADO | ANULADO. Lo caducado NO se borra: queda
  // en el libro y en la ficha.
  status           String    @default("ACTIVO")
  // VENTA | ALTA_INICIAL (el bono de papel que se da de alta a mano).
  origen           String
  // `07` pieza 17 · lo de PRUEBA se marca, no se borra. Sale de la ficha y
  // de los informes de gestión. No se confunde con `Tenant.esDePruebas`
  // (cuenta entera) ni con el ensayo de puesta-en-marcha: un bono vendido
  // en un ticket `TEST` nace `esPrueba = true` y el reseteo se lo lleva.
  esPrueba         Boolean   @default(false) @map("es_prueba")
  createdAt        DateTime  @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template     VoucherTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  soldTicket   Ticket?           @relation(fields: [soldTicketId], references: [id], onDelete: Cascade)
  movements    VoucherMovement[]
  // Las citas que apartaron una sesión de este bono.
  appointments Appointment[]

  @@unique([tenantId, code])
  @@unique([tenantId, number])
  // La consulta de la ficha y la de «¿tiene esta clienta un bono que cubra
  // esto?», que es la que corre al dar cada cita.
  @@index([tenantId, clientId, status])
  @@index([tenantId, status])
  @@map("vouchers")
}

// EL LIBRO. Solo inserción: nada se edita ni se borra.
//
// Lo garantiza el trigger `voucher_movements_append_only` de la migración,
// con el mismo patrón que `fiscal_records` y `client_consents`. Se corrige
// con una línea CONTRARIA enlazada (`compensaA`) y su motivo.
//
// ── EL SIGNO de `sesiones`, que es la pieza que hay que entender ───────
//
// `sesiones` es el efecto de la línea sobre **las sesiones LIBRES**, así que
//
//     libres = SUM(sesiones)   -- sobre TODO el libro del bono
//
// es una sola suma y no se puede escribir mal. De ahí sale el resto:
//
//   · `VENDIDO` / `ALTA_INICIAL` → `+N` (entra el bono entero)
//   · `APARTADA`                → `-1` (deja de estar libre, no se gasta)
//   · `LIBERADA`                → `+1` (vuelve a estar libre)
//   · `CONSUMIDA` con cita      → ` 0` (la sesión salió de libres al
//                                  apartarse: aquí sólo pasa de APARTADA a
//                                  CONSUMIDA, y libres no lo ve)
//   · `CONSUMIDA` sin cita      → `-1` (el canje en caja sin agenda, que no
//                                  pasa por APARTADA)
//   · `CORRECCION`              → `±N`
//   · `ANULADO`                 → `-libres` (devolver la venta; sólo se
//                                  puede sin nada consumido ni apartado,
//                                  así que lleva el total a cero)
//   · `CADUCIDAD_CAMBIADA`      → ` 0`
//
// El CHECK `voucher_movements_signo_por_tipo` **obliga** a este convenio en
// la base, incluida la equivalencia «CONSUMIDA vale 0 ⟺ tiene cita». No es
// documentación: es la razón por la que el invariante no puede desalinearse
// sin que la base lo rechace.
//
// ── Por qué `appointmentId` y `ticketLineId` NO llevan clave ajena ─────
//
// Porque un libro de solo inserción tiene que sobrevivir a lo que apunta.
// Una FK `ON DELETE SET NULL` sería un UPDATE sobre la fila y el propio
// trigger lo rechazaría; una `RESTRICT` dejaría al borrado del tenant
// dependiendo del orden de las cascadas. Son punteros de auditoría, y el
// único que los escribe es la puerta (`vouchers/gate.ts`).
model VoucherMovement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  voucherId     String   @map("voucher_id") @db.Uuid
  // VENDIDO | ALTA_INICIAL | APARTADA | LIBERADA | CONSUMIDA | CORRECCION |
  // CADUCIDAD_CAMBIADA | ANULADO. Texto con CHECK y no enum: B-cheques y
  // B-13 añaden tipos, y un enum de Postgres parte la migración en dos.
  tipo          String
  sesiones      Int
  appointmentId String?  @map("appointment_id") @db.Uuid
  ticketLineId  String?  @map("ticket_line_id") @db.Uuid
  // La línea que ESTA compensa. Una línea ya compensada no se compensa dos
  // veces (lo comprueba la ruta, no la base: hace falta ver el libro).
  compensaA     String?  @map("compensa_a") @db.Uuid
  // La frase que LEE RECEPCIÓN («Apartada para la cita del 3-nov 10:30»).
  // Distinta del `motivo`, que es por qué se corrige. Nunca vacía.
  detalle       String
  // Lista cerrada: `error_venta | cortesia | ajuste_alta_inicial | otro`.
  // Obligatorio en `CORRECCION` y `CADUCIDAD_CAMBIADA` (CHECK). Con `otro`
  // la nota va en `detalle` y es obligatoria — **sin mínimo de caracteres
  // oculto**, que bloqueó una invitación real en el spa (`07` pieza 5).
  motivo        String?
  // tpv | panel | web | migracion.
  canal         String
  // Quién. `userId` para una persona del centro; `actor` para «Web» o
  // «Migración». Uno de los dos, siempre (CHECK).
  userId        String?  @map("user_id") @db.Uuid
  actor         String?
  esPrueba      Boolean  @default(false) @map("es_prueba")
  // UTC DESDE EL CÓDIGO, sin `now()` de Postgres: el negocio razona en hora
  // del centro y nada del dominio se fecha con el reloj del servidor de
  // base de datos (regla del bloque y de `05` §8.6).
  createdAt     DateTime @map("created_at") @db.Timestamptz()

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  // El libro de un bono, en orden. `id` desempata: dos líneas del mismo
  // milisegundo (apartar y consumir en la misma transacción) tienen que
  // salir siempre en el mismo orden.
  @@index([voucherId, createdAt, id])
  @@index([tenantId, createdAt])
  // La idempotencia de `consumir` / `liberar` se decide leyendo el libro
  // por cita, así que esta consulta corre en cada cobro.
  @@index([tenantId, appointmentId])
  @@map("voucher_movements")
}

// El CONTADOR de la numeración de bonos, uno por tenant.
//
// Tres reglas, y las tres salieron del spa (`07` pieza 8):
//
//   1. **Atómico y sin huecos**: `UPDATE … SET ultimo = ultimo + 1
//      RETURNING` dentro de la transacción de la venta. Un ticket que no se
//      cobra no gasta número porque el bono nace al pasar a `PAID`.
//   2. **Se SALTA un número que ya exista**: el spa se encontró un número
//      que había llegado desde dev. El bucle vive en
//      `vouchers/numero.ts::siguienteNumero`.
//   3. **Candado de primer uso**: con `arranque` a NULL no se emite ningún
//      bono. El encargado confirma en Ajustes por qué número empieza —los
//      centros con talonario de papel siguen su numeración— y eso pone el
//      candado a cero.
model VoucherSequence {
  tenantId             String    @id @map("tenant_id") @db.Uuid
  // Último número EMITIDO. 0 = ninguno todavía.
  ultimo               Int       @default(0)
  // NULL = CANDADO PUESTO: no se emite nada. Confirmado = el número por el
  // que empieza el talonario de este centro.
  arranque             Int?
  arranqueConfirmadoAt DateTime? @map("arranque_confirmado_at") @db.Timestamptz()
  arranqueConfirmadoBy String?   @map("arranque_confirmado_by") @db.Uuid
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("voucher_sequence")
}

// A3-distribución · código de un solo uso (bueno, de tres) para descargar la
// APK desde mipiacetpv.com/apk sin sesión. El binario NO vive en la BD ni en
// el repo: está en RELEASES_DIR del VPS, montado read-only en el contenedor.
// Aquí sólo vive el permiso para bajarlo.
//
// `createdBySuperAdminId` lleva FK dura en SQL pero SIN relación Prisma, para
// no añadir una back-relation a SuperAdminUser por una tabla periférica
// (mismo criterio que appointment_items_service_id_fkey). Es también a quién
// se atribuye la auditoría de cada descarga: la descarga no es anónima, es la
// consecuencia del acto del super-admin que emitió el código.
model ApkDownloadCode {
  id                    String    @id @default(uuid()) @db.Uuid
  code                  String    @unique
  versionCode           Int       @map("version_code")
  createdBySuperAdminId String    @map("created_by_super_admin_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz()
  // 60 min y 3 descargas: el WiFi del bar corta y el instalador reintenta.
  // Un solo uso obligaría a llamar al super-admin a mitad de instalación.
  maxDownloads          Int       @default(3) @map("max_downloads")
  downloadCount         Int       @default(0) @map("download_count")
  lastDownloadIp        String?   @map("last_download_ip")
  lastDownloadAt        DateTime? @map("last_download_at") @db.Timestamptz()
  // "Thalía, terminal barra" — para saber a quién se le dio.
  note                  String?

  @@index([expiresAt])
  @@index([versionCode])
  @@map("apk_download_codes")
}

// ── F1 · el registro de jornada (ADR-018) ─────────────────────────────
//
// Art. 34.9 del Estatuto de los Trabajadores: registro diario de jornada
// con la hora concreta de inicio y de fin de cada trabajador, conservado 4
// años y a disposición del trabajador, de sus representantes y de la
// Inspección de Trabajo.
//
// Lo que Prisma NO expresa y vive en `20260923010000_fichaje_1_registro`:
// los dos índices parciales únicos (un móvil activo por empleado, un tramo
// abierto por empleado), los CHECK de los motivos, los triggers que hacen
// inalterable el registro y `record_time_entry_correction()`.

/// Origen de un fichaje: lo tocó el empleado en su móvil, o lo metió la
/// empresa desde el panel (un olvido que se corrige, un día que falta).
enum TimeEntrySource {
  MOBILE
  PANEL
}

/// Quién firma una corrección. El CHECK de la migración exige que venga el
/// id que corresponde a cada uno.
enum TimeEntryCorrectionAuthor {
  EMPLOYEE
  PANEL
}

/// Motivo de una corrección. Cerrado a propósito: un desplegable de tres
/// opciones se contesta de un toque, y un texto libre obligatorio acaba
/// siendo "." El enum vive TAMBIÉN como CHECK en la base de datos.
enum TimeEntryCorrectionReason {
  OLVIDO
  ERROR_HORA
  /// El único que exige texto (CHECK en la migración).
  OTRO
}

/// personal-1 · tipo de contrato. Cerrado y de dos valores, que son los
/// dos que hay en el Estatuto. De esto cuelga «un temporal a 15 días de su
/// fecha de fin sale como aviso en el panel», y un valor inventado por un
/// centro no tendría esa semántica.
enum EmployeeContractKind {
  INDEFINIDO
  TEMPORAL
}

/// personal-1 (decisión 6) · el cuadrante nace en borrador y «Publicar» lo
/// fija. No hay vuelta: despublicar sería la forma elegante de borrar el
/// registro de cambios (bajas a borrador, mueves lo que quieras sin traza
/// y vuelves a publicar). Lo impide `staff_schedules_guard`.
enum StaffScheduleState {
  BORRADOR
  PUBLICADO
}

/// personal-1 (decisión 6) · de dónde salió el cuadrante.
///
/// `GENERADO` no lo escribe nada todavía: es **personal-2**, que generará
/// borradores con IA y los dejará para que una persona los publique igual.
/// La columna nace ahora porque añadir un valor a un enum después obliga a
/// repasar quién lo compara.
enum StaffScheduleOrigin {
  MANUAL
  GENERADO
}

/// personal-1 (decisión 5) · las cinco ausencias que puede tener una celda.
///
/// Cerrado, y es una decisión: cada una significa algo **distinto para las
/// reglas** —`LIBRE` cuenta como descanso semanal, `VACACIONES` e `IT` no
/// cuentan como horas planificadas— así que un tipo inventado por un
/// centro no tendría semántica en `comprobarCuadrante` y el aviso saldría
/// mal. Mismo criterio que `TimeEntryCorrectionReason`.
enum StaffAbsenceKind {
  /// Día libre. Es el que cuenta como descanso semanal.
  LIBRE
  VACACIONES
  /// Incapacidad temporal.
  IT
  ASUNTOS_PROPIOS
  PERMISO
}

/// Quien ficha. Deliberadamente NO es un `User`: un colegio tiene
/// profesores que no son ni cajeros ni propietarios y que no entran al
/// panel jamás. Y deliberadamente NO cuelga de `StaffProfile`: eso es la
/// agenda. Si alguien atiende citas y además ficha, las dos cosas cuelgan
/// del mismo `User` por separado.
model Employee {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// El nombre. **No se parte en un backfill**: las 21 fichas de Jardín de
  /// Gredos se crearon con el nombre completo aquí dentro, y separar
  /// «María del Carmen Fernández-Escalona» a ciegas no es fiable. La
  /// importación CSV casa por nombre completo normalizado y, al completar
  /// la ficha, deja el nombre aquí y los apellidos en `lastName`.
  name          String
  email         String?
  phone         String?
  /// Opcional. Sólo lo tiene quien además entra al panel.
  ///
  /// personal-1 (decisión 1) · es el VÍNCULO y nada más. Cuando lo hay, la
  /// ficha de personal ENSEÑA los roles de cuidado (`CareRoleAssignment`)
  /// y el perfil de agenda (`StaffProfile`) de ese usuario; no los mueve
  /// ni los copia. Nada se fusiona.
  userId        String?   @map("user_id") @db.Uuid
  /// La baja DESACTIVA; no borra. Sus fichajes se conservan 4 años, y el
  /// trigger de la migración impide borrarlos aunque alguien lo intente.
  active        Boolean   @default(true)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // ── personal-1 · la ficha ──────────────────────────────────────────
  //
  // Todo opcional salvo el nombre, que ya lo era. Es la lección de
  // alta-minima aplicada al personal: la auxiliar ya trabaja aquí y no
  // saber su nº de afiliación no hace que fiche menos. Lo que falta lo
  // enumera `datosQueFaltanDePersonal` (paquete puro) y lo cantan la lista
  // y el panel hasta que esté completo.

  /// Los apellidos. Separados del nombre porque el cuadrante y el PDF de
  /// la Inspección los ordenan por apellido, no por nombre de pila.
  lastName        String?   @map("last_name")
  /// residencia-1b / clinica-7 · **el DNI/NIE, CIFRADO**. No hay columna
  /// en claro y no la ha habido nunca: nace cifrada, así que aquí no hay
  /// EXPAND/CONTRACT ni respaldo que vaciar. Sitio:
  /// `sitioDniDeEmpleado(tenantId, employeeId)`.
  dniCifrado      String?   @map("dni_cifrado")
  /// Y el nº de afiliación a la Seguridad Social, ídem.
  /// `sitioAfiliacionDeEmpleado(tenantId, employeeId)`.
  nssCifrado      String?   @map("nss_cifrado")
  /// La categoría profesional, del catálogo del tenant. De ella cuelga
  /// `countsAsDirectCare`, que es lo que mira la ratio.
  categoryId      String?   @map("category_id") @db.Uuid
  /// La jornada contratada, **en MINUTOS a la semana**. 37,5 h = 2 250.
  /// Entero y no decimal por lo mismo que todo lo que compara jornadas en
  /// esta casa (`minutesWorked`, `totalMinutes`): el paquete puro del
  /// cuadrante compara enteros sin convertir nada. El panel pide y enseña
  /// horas.
  weeklyMinutes   Int?      @map("weekly_minutes")
  contractKind    EmployeeContractKind? @map("contract_kind")
  hiredOn         DateTime? @map("hired_on") @db.Date
  /// Sólo en los temporales, por CHECK en la base. Un temporal a 15 días
  /// de esta fecha sale como aviso en el panel: es lo que hoy se olvida.
  contractEndsOn  DateTime? @map("contract_ends_on") @db.Date
  /// personal-1 · hasta cuándo ha visto su cuadrante. Lo mueve sólo el
  /// acuse explícito del móvil (`POST /fichaje/v1/cuadrante/visto`): si lo
  /// moviera la propia lectura, los cambios marcados desaparecerían al
  /// recargar la pantalla, que es justo cuando la persona los está
  /// mirando.
  scheduleSeenAt  DateTime? @map("schedule_seen_at") @db.Timestamptz()

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// `Restrict`: una categoría con gente dentro no se borra; se desactiva.
  category      EmployeeCategory?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  devices       EmployeeDevice[]
  pairingTokens EmployeePairingToken[]
  timeEntries   TimeEntry[]
  /// personal-1 · sus celdas del cuadrante y los cambios que le afectaron.
  /// `Restrict` a los dos lados (ver los modelos): un cuadrante publicado
  /// dice quién tenía qué turno, y la baja de una persona DESACTIVA.
  scheduleCells   StaffScheduleCell[]
  scheduleChanges StaffScheduleChange[]

  /// Un `User` no puede ser dos empleados del mismo tenant. Postgres
  /// permite NULLs repetidos, así que los empleados sin usuario —la
  /// mayoría— no chocan entre sí.
  @@unique([tenantId, userId])
  @@index([tenantId, active])
  /// personal-1 · «¿a quién se le acaba el contrato este mes?» es la
  /// pregunta del aviso del panel, y la única consulta nueva de la ficha
  /// que recorre la tabla.
  @@index([categoryId])
  @@index([tenantId, contractEndsOn])
  @@map("employees")
}

/// personal-1 (decisión 2) · EL CATÁLOGO DE CATEGORÍAS PROFESIONALES.
///
/// **Dato, no código**, y por tenant con semilla de serie: mismo criterio
/// exacto que `CareRole` en residencia-1, y por la misma razón medida allí
/// (una residencia que invente «fisio de tarde» no puede costar un
/// despliegue, y «¿cuenta como atención directa?» corre en cada
/// comprobación del cuadrante y no puede ser una unión).
///
/// La columna que importa es `countsAsDirectCare`: es lo que mira la ratio
/// del Decreto 2/2022 y lo que mira la cobertura mínima de un turno.
///
/// Y a diferencia de la categoría de un `CareRole` —que un trigger
/// congela— ésta es **editable**: qué cuenta como atención directa lo dice
/// la acreditación de cada centro, no nosotros. Lo que un centro no puede
/// es borrar una categoría con gente dentro (`Restrict` desde
/// `Employee.categoryId`); se desactiva.
///
/// Los de serie dependen de los módulos encendidos: una residencia recibe
/// auxiliar/DUE/médico/TO/fisio/limpieza/cocina/dirección/administración;
/// un colegio recibe los cuatro que tiene un centro sin cuidados. Ver
/// `CATEGORIAS_DE_SERIE` en `@mipiacetpv/cuadrante`.
model EmployeeCategory {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  /// `AUXILIAR`, `DUE`, `PROFESOR`… Único por centro.
  code               String
  name               String
  /// **Lo que mira la ratio.** `false` de serie: una categoría nueva no
  /// cuenta como atención directa hasta que alguien lo diga. Al revés, una
  /// categoría recién inventada inflaría la ratio sin que nadie la hubiera
  /// marcado.
  countsAsDirectCare Boolean @default(false) @map("counts_as_direct_care")
  isStandard         Boolean @default(false) @map("is_standard")
  active             Boolean @default(true)
  sortOrder          Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("employee_categories")
}

/// El móvil personal del empleado, emparejado con un enlace de un solo
/// uso. Copia el patrón de `Device` (token de 32 bytes random, SHA-256,
/// columna `@unique` para lookup O(1), revocación por `revokedAt`) pero
/// NO cuelga de un `Register`: el colegio no tiene caja, y ésa es
/// exactamente la razón de que esta tabla exista en vez de reutilizar
/// aquélla.
///
/// Un empleado tiene UN móvil activo. Lo garantiza un índice parcial
/// único de la migración, no el código.
model EmployeeDevice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  deviceTokenHash String    @unique @map("device_token_hash")
  pairedAt        DateTime  @default(now()) @map("paired_at") @db.Timestamptz()
  lastSeenAt      DateTime? @map("last_seen_at") @db.Timestamptz()
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent       String?   @map("user_agent")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, revokedAt])
  @@map("employee_devices")
}

/// El enlace personal que la empresa genera y comparte. De un solo uso y
/// con caducidad de 7 días.
///
/// Token de ALTA ENTROPÍA, no un código de 6 dígitos como `PairingCode`:
/// aquél se teclea en un terminal y vive una hora; éste viaja en una URL
/// por WhatsApp y vive una semana. Seis dígitos serían enumerables.
model EmployeePairingToken {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz()
  /// El claim es atómico (`updateMany` con `consumedAt: null` en el
  /// WHERE), igual que en `/devices/pair`: dos aperturas simultáneas del
  /// mismo enlace no pueden emparejar dos móviles.
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz()
  consumedByDeviceId String?   @map("consumed_by_device_id") @db.Uuid
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, consumedAt])
  @@map("employee_pairing_tokens")
}

/// Un tramo trabajado. La unidad del registro de jornada.
///
/// `startedAt` / `endedAt` son LA HORA QUE CUENTA: la del toque. Sólo se
/// mueven a través de `record_time_entry_correction()`, y el trigger
/// `time_entries_registro_guard` rechaza cualquier otro camino — incluido
/// un UPDATE lanzado a mano en psql.
///
/// Las seis columnas de procedencia son INMUTABLES y el trigger las
/// congela: dicen de dónde salió cada hora y no se corrigen nunca.
model TimeEntry {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  /// Entrada. Se fija en el INSERT y ya no se mueve sin corrección.
  startedAt DateTime  @map("started_at") @db.Timestamptz()
  /// Salida. NULL mientras el tramo está en curso. Pasar de NULL a valor
  /// es el fichaje de salida (la segunda mitad del mismo hecho, sin
  /// corrección); cambiarlo después SÍ exige corrección, y volverlo a
  /// NULL está prohibido siempre.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz()

  /// Lo que marcó el reloj del MÓVIL al tocar. NULL cuando lo metió el
  /// panel, que es cuando nadie tocó nada.
  startedDeviceAt DateTime? @map("started_device_at") @db.Timestamptz()
  /// Cuándo llegó al SERVIDOR. Si difiere del anterior en más de 10
  /// minutos, el registro se marca "enviado sin conexión" — pero eso se
  /// DERIVA de estas dos columnas, no se guarda: un flag podría quedar
  /// desincronizado de lo que lo justifica.
  startedServerAt DateTime  @map("started_server_at") @db.Timestamptz()
  endedDeviceAt   DateTime? @map("ended_device_at") @db.Timestamptz()
  endedServerAt   DateTime? @map("ended_server_at") @db.Timestamptz()

  startSource TimeEntrySource  @map("start_source")
  endSource   TimeEntrySource? @map("end_source")

  /// Idempotencia de la cola offline del móvil, igual que
  /// `Ticket.checkoutExternalId`: el mismo toque reenviado no crea un
  /// segundo tramo.
  startExternalId String? @unique @map("start_external_id")
  endExternalId   String? @unique @map("end_external_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  corrections TimeEntryCorrection[]

  @@index([tenantId, startedAt])
  @@index([employeeId, startedAt])
  @@map("time_entries")
}

/// La traza de cada cambio. Append-only por trigger, copiando
/// `ticket_corrections` de S1 (ADR-015 §4.3).
///
/// Es lo que hace que el registro sea defendible ante la Inspección: el
/// valor anterior sigue ahí, con quién lo cambió, cuándo y por qué. Sin
/// esta tabla, "corregir" y "manipular" serían la misma operación.
model TimeEntryCorrection {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  timeEntryId String @map("time_entry_id") @db.Uuid

  /// `started_at` o `ended_at` — el nombre de COLUMNA, no el del campo
  /// Prisma: la función SQL trabaja con el catálogo de Postgres.
  field    String
  oldValue String? @map("old_value")
  newValue String? @map("new_value")

  reasonCode TimeEntryCorrectionReason @map("reason_code")
  /// Obligatorio sólo con `OTRO`, por CHECK en la migración.
  reasonText String?                   @map("reason_text")

  authorKind TimeEntryCorrectionAuthor @map("author_kind")
  /// Nombre legible de quien corrigió, congelado aquí. Un empleado que se
  /// da de baja o un usuario que se borra no pueden dejar la traza muda.
  author     String
  employeeId String?                   @map("employee_id") @db.Uuid
  userId     String?                   @map("user_id") @db.Uuid

  /// `txid_current()` del momento del cambio. Es lo que el trigger
  /// consulta para saber si la corrección y el UPDATE son la MISMA
  /// transacción. Mismo mecanismo exacto que S1.
  txid      BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId, createdAt])
  @@index([tenantId, createdAt])
  /// Lo consulta el trigger en CADA update de una columna de hora. El
  /// nombre es el que generaría Prisma para este `@@index`: si no, el
  /// siguiente `migrate dev` lo vería como sobrante y lo borraría.
  @@index([txid, timeEntryId, field])
  @@map("time_entry_corrections")
}

// ══ personal-1 · EL CUADRANTE ══════════════════════════════════════════
//
// El cuadrante dice lo que estaba PREVISTO; `time_entries` dice lo que
// PASÓ. La gracia del bloque es poder comparar los dos — y nada de lo que
// hay aquí toca ADR-018: ni un camino nuevo para mover una hora.
//
// Lo que Prisma NO expresa y vive en
// `20261027010000_personal_1_cuadrante`:
//
//   · `set_staff_schedule_day(...)` — la ÚNICA vía para pintar una celda.
//     Escribe la traza y después toca las celdas, en la misma transacción.
//   · `mipiacetpv_staff_schedule_change_exists(...)` — lo que el trigger
//     consulta (`txid_current()`).
//   · 4 triggers: append-only del registro de cambios, el guard de las
//     celdas (una celda no se edita: se sustituye; y en un cuadrante
//     publicado no se mueve sin motivo), «publicar fija» y «un cuadrante
//     publicado no se borra».
//   · los dos índices únicos de la celda, uno de ellos PARCIAL.

/// personal-1 (decisión 6) · LA CABECERA MENSUAL DEL CUADRANTE.
model StaffSchedule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// «YYYY-MM» de pared del centro. Texto y no `date` por lo mismo que
  /// `CenterShift.startsAt` es texto: un mes no es un instante, y
  /// guardarlo como el día 1 a las 00:00 obligaría a elegir un huso cada
  /// vez que se lee. CHECK de formato en la migración.
  month    String
  state    StaffScheduleState  @default(BORRADOR)
  origin   StaffScheduleOrigin @default(MANUAL)

  publishedAt       DateTime? @map("published_at") @db.Timestamptz()
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid
  /// El nombre congelado, como `TimeEntryCorrection.author`: un usuario que
  /// se borra no puede dejar muda la firma de un cuadrante.
  publishedBy       String?   @map("published_by")
  /// Cuántos avisos tenía al publicarse, y cuáles. «Publicar con avisos
  /// pide confirmarlo y los deja apuntados»: sin esto, a los seis meses
  /// «¿se publicó sabiendo que el sábado faltaba una auxiliar?» no se
  /// puede contestar.
  warningsAtPublish Int?      @map("warnings_at_publish")
  warningsSnapshot  Json?     @map("warnings_snapshot")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  publishedByUser User?             @relation("StaffSchedulePublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  createdByUser   User?             @relation("StaffScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cells       StaffScheduleCell[]
  changes     StaffScheduleChange[]

  @@unique([tenantId, month])
  @@index([tenantId, state])
  @@map("staff_schedules")
}

/// personal-1 (decisión 5) · LA CELDA: persona × día → turno o ausencia.
///
/// **Una fila por turno, no una por celda.** Una persona puede tener un
/// turno partido o dos turnos un día (raro, pero existe), y con una
/// columna `shiftId` por celda eso no cabe. La pantalla puede dejar el
/// partido para más adelante; el modelo no puede.
///
/// Un turno **o** una ausencia, nunca las dos ni ninguna (CHECK). Y una
/// celda **no se edita**: se sustituye entera, porque «la celda» no es una
/// fila cuando el día lleva dos turnos. El trigger rechaza cualquier
/// `UPDATE` sobre esta tabla, también en borrador.
model StaffScheduleCell {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  scheduleId    String    @map("schedule_id") @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  day           DateTime  @db.Date
  centerShiftId String?   @map("center_shift_id") @db.Uuid
  absenceKind   StaffAbsenceKind? @map("absence_kind")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule    StaffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// `Restrict`: un cuadrante publicado dice quién tenía qué turno, y la
  /// baja de una persona DESACTIVA (F1). Si se pudiera borrar al empleado,
  /// la cascada se llevaría su cuadrante.
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Y `Restrict` al turno, por lo mismo que `CareRecord`: borrar «la
  /// noche» dejaría un cuadrante publicado apuntando a nada.
  centerShift CenterShift?  @relation(fields: [centerShiftId], references: [id], onDelete: Restrict)

  /// El mismo turno dos veces el mismo día a la misma persona es un doble
  /// toque, no un turno partido. Las filas de ausencia tienen
  /// `centerShiftId` NULL y Postgres considera los NULL distintos, así que
  /// este único no las toca — de eso se encarga el PARCIAL de la
  /// migración (`staff_schedule_cells_una_ausencia_por_dia_key`), que es
  /// la mitad que éste no puede cubrir. Misma lección exacta que
  /// `care_zone_assignments_one_live_centro_key`.
  @@unique([scheduleId, employeeId, day, centerShiftId], map: "staff_schedule_cells_un_turno_por_dia_key")
  @@index([scheduleId, day])
  @@index([employeeId, day])
  @@index([tenantId, day])
  @@map("staff_schedule_cells")
}

/// personal-1 (decisión 6) · EL REGISTRO DE CAMBIOS TRAS PUBLICAR.
///
/// Append-only por trigger, copiando `TimeEntryCorrection` (ADR-018 §3).
/// Es lo que pide la Inspección cuando un trabajador dice que le cambiaron
/// el turno sin avisar: qué tenía, qué tiene, quién lo cambió, cuándo y
/// por qué.
model StaffScheduleChange {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  scheduleId String   @map("schedule_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  day        DateTime @db.Date

  /// Las ETIQUETAS, no los ids: «N», «VACACIONES», «M+T» cuando el día
  /// lleva dos turnos. `null` = no había nada / no queda nada. Un id de
  /// turno borrado deja la traza muda, y la traza es lo que se le enseña a
  /// quien reclama. Mismo criterio que `author` congelado.
  beforeLabel String? @map("before_label")
  afterLabel  String? @map("after_label")

  /// Obligatorio, y en la base. «Editar una celda publicada sin motivo» es
  /// el sabotaje que esta columna cierra.
  reason       String
  author       String
  authorUserId String? @map("author_user_id") @db.Uuid

  /// `txid_current()` del momento del cambio. Es lo que el trigger de las
  /// celdas consulta para saber si el cambio y la traza son la MISMA
  /// transacción. Mismo mecanismo exacto que ADR-018.
  txid      BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule   StaffSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  authorUser User?         @relation("StaffScheduleChangeAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([scheduleId, createdAt])
  @@index([tenantId, createdAt])
  /// Lo consulta el trigger en CADA escritura de celda de un cuadrante
  /// publicado. El nombre es el que generaría Prisma para este `@@index`:
  /// si no, el siguiente `migrate dev` lo vería como sobrante.
  @@index([txid, scheduleId, employeeId, day])
  @@map("staff_schedule_changes")
}

/// personal-1 (decisión 7) · LOS PARÁMETROS DE LAS REGLAS, POR TENANT.
///
/// **Parámetros, no constantes en el código**, y no por gusto: la ratio de
/// atención directa cambia por comunidad autónoma y por acreditación (0,20
/// es el Decreto 2/2022 de Castilla-La Mancha), y el cómputo del descanso
/// semanal lo permite el art. 37.1 del ET hasta 14 días.
///
/// Una fila por tenant, creada la primera vez que alguien abre el
/// cuadrante. **Si no existe, se leen los defaults**: mismo criterio que
/// `maxOpenHoursFor`, que falla hacia el default. Un centro sin fila se
/// comporta como todos los demás.
///
/// Y ésta SÍ la toca el cliente (Ajustes), a diferencia de
/// `Tenant.fichajeMaxOpenHours` y de `Tenant.fichajeShiftMarginHours`: la
/// ratio de su acreditación la sabe la dirección del centro.
///
/// El convenio colectivo **no** está aquí y no es un olvido: sus límites
/// entrarán como parámetros cuando Matías los confirme. Meterlos en código
/// sería fijar en el producto lo que cada centro negocia.
model StaffRuleSettings {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// La ratio en MILÉSIMAS: 0,20 → 200. Entero y no `Decimal` por dos
  /// razones: el paquete puro compara enteros sin que Prisma le meta un
  /// `Decimal` dentro, y el rango del CHECK se lee («entre 0 y 2 000
  /// milésimas») sin ir a buscar una escala decimal.
  ratioDirectCarePerMil  Int @default(200) @map("ratio_direct_care_per_mil")
  /// Art. 34.3 ET: 12 h entre el fin de una jornada y el inicio de la
  /// siguiente.
  minRestHours           Int @default(12)  @map("min_rest_hours")
  /// Art. 37.1 ET: día y medio ininterrumpido = 36 h.
  weeklyRestHours        Int @default(36)  @map("weekly_rest_hours")
  /// …computable «por períodos de hasta catorce días». 7 de serie.
  weeklyRestWindowDays   Int @default(7)   @map("weekly_rest_window_days")
  /// Cuántos minutos después del inicio de su turno se considera que
  /// alguien «no ha fichado» (punto 9).
  noShowToleranceMinutes Int @default(15)  @map("no_show_tolerance_minutes")
  /// Qué es «una jornada completa» a efectos de la RATIO, en minutos. La
  /// ratio se mide en jornadas completas equivalentes y no en personas:
  /// tres auxiliares de cuatro horas no son tres jornadas. 480 (8 h) de
  /// serie, y parámetro porque una jornada completa de convenio no es la
  /// misma en todas partes.
  fullDayMinutes         Int @default(480) @map("full_day_minutes")

  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz()
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedByUser User?  @relation("StaffRuleSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("staff_rule_settings")
}

// V1-verifactu (ADR-019) · EL REGISTRO DE FACTURACIÓN.
//
// Una fila por cada factura simplificada emitida (ALTA) y por cada una
// anulada (ANULACION), encadenadas por huella dentro de la caja que las
// emitió. Es el dato que exige el RD 1007/2023 y que V2 remitirá a la AEAT.
//
// Nace EN EL DISPOSITIVO, al cobrar, y viaja dentro de la venta por el
// outbox. Las dos cosas vienen de la misma FAQ de desarrolladores de la
// AEAT: el registro debe estar «íntegramente producido en el momento de
// generar la factura y el código QR y entregarla al cliente» (§5), y «no
// puede haber facturas expedidas sin sus RF generados, ni RF generados sin
// sus correspondientes facturas expedidas» (§5). Como el TPV cobra sin red,
// generarlo en el servidor obligaría a tener red para cobrar.
//
// APPEND-ONLY, sin vía de corrección, y esa ausencia es deliberada: S1
// tiene `record_ticket_correction` y F1 tiene `record_time_entry_correction`
// porque un importe mal tecleado y una hora olvidada son errores humanos
// que hay que poder arreglar dejando traza. Un registro de facturación no
// se arregla: se anula y se emite otro. Lo dice la norma, y es la razón de
// ser del registro de anulación.
//
// Los triggers y la función de verificación viven en la migración
// `20260924000000_verifactu_1_registro` (Prisma no los expresa).
model FiscalRecord {
  // `dbgenerated` y no `uuid()`: la columna tiene `DEFAULT gen_random_uuid()`
  // en la base, igual que `employees` y `time_entries` (F1). Con `uuid()`
  // Prisma vería la migración como sobrante y querría quitar el default.
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  registerId String @map("register_id") @db.Uuid
  // Idempotencia del outbox: el mismo cobro reenviado no crea dos
  // registros. Lo genera el dispositivo, igual que `Ticket.externalId`.
  externalId String @unique @map("external_id") @db.Uuid

  kind FiscalRecordKind

  // Posición en la cadena de ESTA caja, 1-based. No es el número de la
  // factura: una anulación ocupa posición y no gasta número.
  chainIndex Int @map("chain_index")

  serie           String
  numero          Int
  // El literal completo `C1/000123`. Se guarda entero porque es lo que
  // entró en la huella y lo que va en el QR: recomponerlo a trozos en otro
  // sitio es una forma de que deje de coincidir.
  numSerieFactura String   @map("num_serie_factura")
  fechaExpedicion DateTime @map("fecha_expedicion") @db.Date
  // Lista L2 del anexo. `F2` = factura simplificada.
  tipoFactura     String   @map("tipo_factura")

  cuotaTotal   Decimal @map("cuota_total") @db.Decimal(12, 2)
  importeTotal Decimal @map("importe_total") @db.Decimal(12, 2)

  // Hexadecimal en MAYÚSCULAS, 64 caracteres. El formato lo comprueba un
  // CHECK de la base: una huella en minúsculas se compara distinto y la
  // AEAT la devolvería como «Aceptado con errores».
  huella         String
  huellaAnterior String? @map("huella_anterior")
  primerRegistro Boolean @map("primer_registro")

  // La marca de tiempo que cuenta, como TEXTO y no como DateTime. El huso
  // forma parte del dato («el que está usando el sistema informático de
  // facturación en el momento de generar el registro», anexo) y un
  // timestamptz lo normaliza a UTC — con lo que la huella, calculada sobre
  // el texto con su huso, dejaría de poder recalcularse.
  fechaHoraHusoGen String @map("fecha_hora_huso_gen")

  // La cadena EXACTA sobre la que se aplicó SHA-256. Redundante a
  // propósito: es lo que permite verificar la huella sin volver a formatear
  // ni un importe, dentro del propio motor (`sha256()` de Postgres 16).
  huellaInput String @map("huella_input")

  // El registro completo tal y como lo generó el dispositivo. Es lo que V2
  // remitirá, SIN TOCARLO.
  payload Json

  ticketId      String? @map("ticket_id") @db.Uuid
  anulaRecordId String? @unique @map("anula_record_id") @db.Uuid
  deviceId      String? @map("device_id") @db.Uuid

  // Reloj del dispositivo y reloj del servidor. «Generado sin conexión» se
  // DERIVA de la distancia entre los dos y no se guarda como flag: un flag
  // puede quedar desincronizado de lo que lo justifica (lección de F1).
  generatedAt DateTime @map("generated_at") @db.Timestamptz()
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz()

  chainStatus FiscalChainStatus @map("chain_status")
  chainError  String?           @map("chain_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict y no Cascade: borrar una caja no se lleva por delante las
  // facturas que emitió.
  register Register      @relation(fields: [registerId], references: [id], onDelete: Restrict)
  ticket   Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  anula    FiscalRecord? @relation("FiscalRecordAnula", fields: [anulaRecordId], references: [id], onDelete: Restrict)
  anulado  FiscalRecord? @relation("FiscalRecordAnula")
  device   Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // LA CADENA. Dos registros no pueden ocupar la misma posición.
  @@unique([registerId, chainIndex])
  @@index([tenantId, receivedAt])
  @@index([ticketId])
  @@index([deviceId])
  // Los índices PARCIALES —la unicidad de (caja, serie, número) sólo entre
  // altas, la de `anula_record_id`, y el de los BROKEN— se crean vía SQL
  // manual en la migración: Prisma no los expresa. Misma nota que el índice
  // parcial de `v1_8_fiado`.
  @@map("fiscal_records")
}

// ─── La historia clínica (clinica-1) ──────────────────────────────────
//
// Ley 41/2002 (arts. 15-19) y art. 9 RGPD. Cuatro garantías, y las cuatro
// las hace cumplir EL MOTOR, no la aplicación (ADR-015 §1: la aplicación
// no es la única puerta a Postgres):
//
//   · no se borra          → FKs `Restrict` + triggers de DELETE
//   · sólo la ve quien debe→ `clinica/acceso.ts`, una sola función
//   · todo acceso se apunta→ `ClinicalAccessLog`, sólo inserciones
//   · autor y fecha        → `authorUserId` NOT NULL + inmutabilidad
//
// Los triggers y los índices parciales viven en la migración
// `20261005010000_clinica_1_historia`: Prisma no los expresa.

// Quién puede ver la historia de quién.
//
// NO SE BORRA NUNCA. Revocar rellena `revokedAt`; volver a dar acceso crea
// OTRA FILA. Así el histórico contesta siempre "quién pudo ver qué y
// cuándo", que es lo que se le enseña a un inspector o a un paciente.
//
// El «un acceso vigente por (sanitario, paciente)» lo garantiza el índice
// ÚNICO PARCIAL `clinical_access_one_live_key` (sólo donde `revoked_at IS
// NULL`), no un `if`. De ahí salen tres comportamientos a la vez: mover
// una cita conservando a su profesional no crea filas nuevas; dos
// terminales a la vez no crean dos accesos; y tras una revocación, una
// cita nueva SÍ inserta otra fila y el sanitario recupera el acceso.
model ClinicalAccess {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  clinicianUserId String               @map("clinician_user_id") @db.Uuid
  clientId        String               @map("client_id") @db.Uuid
  source          ClinicalAccessSource
  grantedAt       DateTime             @default(now()) @map("granted_at") @db.Timestamptz()
  // NULL cuando el acceso nace de la agenda: ahí no lo concede una
  // persona. El CHECK `clinical_access_source_grantor` ata las dos cosas.
  grantedByUserId String?              @map("granted_by_user_id") @db.Uuid
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz()
  revokedByUserId String?              @map("revoked_by_user_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clinician User   @relation("ClinicalAccessClinician", fields: [clinicianUserId], references: [id], onDelete: Restrict)
  grantedBy User?  @relation("ClinicalAccessGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy User?  @relation("ClinicalAccessRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([clinicianUserId, revokedAt])
  @@map("clinical_access")
}

// Quién ha abierto la historia. SÓLO INSERCIONES (trigger
// `clinical_access_log_append_only`): ni UPDATE ni DELETE, desde la
// aplicación ni desde psql.
//
// Lo escribe UN ÚNICO punto por el que pasan todas las rutas clínicas
// (`clinica/registro.ts`), no cada handler a mano.
//
// Y lo que NO lleva, a propósito: **nada de salud**. Quién, a qué
// paciente, cuándo, desde qué aparato, qué ruta y si se le dejó. Un
// registro que guardara el contenido sería una segunda copia de la
// historia sin ninguna de sus protecciones.
model ClinicalAccessLog {
  id       String                @id @default(uuid()) @db.Uuid
  tenantId String                @map("tenant_id") @db.Uuid
  userId   String                @map("user_id") @db.Uuid
  clientId String                @map("client_id") @db.Uuid
  action   ClinicalAccessAction
  // Los DENEGADOS también se apuntan: son justo los que interesa ver.
  outcome  ClinicalAccessOutcome
  at       DateTime              @default(now()) @db.Timestamptz()
  deviceId String?               @map("device_id") @db.Uuid
  // La ruta sin querystring. Trazabilidad, no contenido.
  route    String?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId, at])
  @@index([tenantId, userId, at])
  @@map("clinical_access_log")
}

// Una pieza de historia. INMUTABLE: no se edita y no se borra (trigger
// `clinical_entries_inmutable`). Se le añaden `ClinicalAddendum` con autor
// y fecha.
//
// Es el mismo principio del sello de la venta (ADR-015) y del registro de
// jornada (ADR-018), aplicado a lo que la ley protege con más fuerza.
model ClinicalEntry {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  clientId      String            @map("client_id") @db.Uuid
  // LA AUTORÍA. NOT NULL y Restrict: una línea de historia sin autor no es
  // historia clínica, es una nota anónima.
  authorUserId  String            @map("author_user_id") @db.Uuid
  // De qué cita salió, si salió de una. Opcional: una anotación puede
  // escribirse sin cita delante (una llamada del paciente).
  appointmentId String?           @map("appointment_id") @db.Uuid
  kind          ClinicalEntryKind @default(NOTE)
  // JSON y no texto: lo que viene (valoración, exploración con el mapa del
  // pie, sesión) es estructurado, y cambiar la forma del cuerpo dentro de
  // un JSON no exige migrar una tabla append-only. El CHECK
  // `clinical_entries_body_object` impide el objeto vacío.
  //
  // ESTE CAMPO NO SE ESCRIBE EN NINGÚN LOG. Ni en el de la aplicación, ni
  // en Sentry, ni en un mensaje de error.
  body          Json
  // ── clinica-7 · EL CUERPO, CIFRADO ──────────────────────────────────
  //
  // AES-256-GCM con la DEK de esta clínica y AAD
  // `tenant|clinical_entries|body|id`. Formato `c1:` + base64 — el CHECK
  // `clinical_entries_body_cifrado_formato` no admite otra cosa, así que
  // texto en claro NO CABE en esta columna.
  //
  // Se cifra el JSON SERIALIZADO y no campo a campo: cifrando campo a
  // campo las CLAVES del objeto quedarían en claro, y «alergias» como
  // clave de un objeto ya es un dato de salud.
  //
  // `body` (en claro) sigue aquí por el EXPAND: la columna cifrada nace
  // vacía, el script la rellena y verifica, y el claro se vacía al
  // centinela `{"cifrado": true}`. **El claro se borra en una migración
  // posterior**, no en ésta. Quien lee usa `bodyCifrado` cuando está y
  // cae a `body` cuando no — `clinica/cripto-campos.ts`.
  bodyCifrado   String?           @map("body_cifrado")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  author      User                @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  addenda     ClinicalAddendum[]
  // clinica-2 · la valoración de la que esta entrada son las respuestas, si
  // es de kind INITIAL_ASSESSMENT. Uno a uno (`entryId` es único allí).
  assessment  ClinicalAssessment?

  @@index([tenantId, clientId, createdAt])
  @@index([appointmentId])
  // clinica-3 · «la última sesión / la última exploración de este
  // paciente», que es la consulta que la pantalla de la sesión hace dos
  // veces al abrirse: lo de la visita anterior para pintarlo en naranja
  // suave y la última exploración para que la siguiente parta de ella.
  //
  // No sustituye al de arriba: aquél es el de la historia paginada.
  @@index([tenantId, clientId, kind, createdAt])
  // clinica-3 · **DE UNA CITA SALE UNA SOLA SESIÓN.** El índice parcial
  // (`WHERE kind = 'TREATMENT_SESSION' AND appointment_id IS NOT NULL`) se
  // crea en SQL — Prisma no expresa índices parciales. Es la garantía del
  // «cerrar dos veces = un cobro»: el cobro se construye desde la sesión,
  // y de una cita hay una. Ver `clinica_3_sesion/migration.sql` §1.
  @@map("clinical_entries")
}

// La anotación a una entrada. Lo ÚNICO que se puede añadir a algo ya
// escrito, y también inmutable: corregir una corrección es otra anotación.
model ClinicalAddendum {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entryId      String   @map("entry_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         Json
  /// clinica-7 · el cuerpo cifrado. AAD `tenant|clinical_addenda|body|id`.
  /// Ver `ClinicalEntry.bodyCifrado` para el por qué del formato y del
  /// expand.
  bodyCifrado  String?  @map("body_cifrado")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  // Restrict y no Cascade, aunque la entrada padre no se pueda borrar: si
  // mañana alguien le abriera una puerta a la entrada, esta FK impediría
  // que la puerta se llevara también las anotaciones.
  entry  ClinicalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  author User          @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([tenantId])
  @@map("clinical_addenda")
}

// ─── La valoración inicial (clinica-2) ────────────────────────────────
//
// «Nadie trata a un diabético anticoagulado sin saberlo.» El paciente
// contesta un test de enfermedades crónicas ANTES de su primera cita (por
// un enlace del email o en la tablet de la sala), el sanitario lo revisa
// con él delante, marca tres confirmaciones y lo valida. Sin valoración
// validada no se registra el primer tratamiento
// (`clinica/primer-tratamiento.ts`, que usará `clinica-3`).
//
// DOS TABLAS Y UNA ENTRADA DE HISTORIA, y el reparto es el eje del bloque:
//
//   · `clinical_entries` (kind = INITIAL_ASSESSMENT) · **lo que contestó el
//     paciente**. Inmutable por el motor, con autor (el actor «paciente por
//     enlace») y fecha. No se toca nunca más.
//   · `clinical_assessments` · **el estado**, que sí cambia: pendiente →
//     respondida → validada, el canal, el token del enlace, las tres
//     confirmaciones y la firma.
//   · `clinical_assessment_corrections` · **lo que corrigió el sanitario**,
//     append-only, con autor y hora, AL LADO de lo del paciente.
//
// Si todo viviera en una tabla habría que elegir entre «inmutable» (y
// entonces el estado no puede avanzar) y «mutable» (y entonces las
// respuestas del paciente son editables). Separarlo es lo que permite las
// dos cosas a la vez sin un segundo mecanismo de inmutabilidad por
// columnas.

// El estado de una valoración. Lo que cambia, y sólo hacia adelante.
//
// No se borra (trigger `clinical_assessments_guard`), el estado sólo
// avanza, lo ya contestado no se reescribe, y una vez VALIDADA la fila
// queda congelada: validar es firmar.
model ClinicalAssessment {
  id                   String                    @id @default(uuid()) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  clientId             String                    @map("client_id") @db.Uuid
  // De qué cita salió, si salió de una (la cita de primera valoración que
  // disparó el email). SET NULL: si la cita desapareciera, la valoración
  // sigue siendo parte de la historia.
  appointmentId        String?                   @map("appointment_id") @db.Uuid
  // CON QUÉ VERSIÓN del cuestionario se contestó. Sin esto, una valoración
  // de hace dos años se pintaría con las preguntas de hoy — que es decir
  // que el paciente contestó algo que no se le preguntó.
  questionnaireVersion Int                       @map("questionnaire_version")
  status               ClinicalAssessmentStatus  @default(PENDIENTE_PACIENTE)
  channel              ClinicalAssessmentChannel
  source               ClinicalAssessmentSource
  // Quién mandó el test o abrió la tablet. Puede ser la recepcionista, y
  // precisamente por eso queda escrito quién fue.
  //
  // NULL cuando `source = APPOINTMENT`: ahí no lo pide una persona. El
  // CHECK `clinical_assessments_source_pedida_por` ata las dos cosas.
  requestedByUserId    String?                   @map("requested_by_user_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz()

  // ── El enlace del email · OBSOLETO desde `enlaces-publicos` ─────────
  //
  // NADIE LEE ESTAS TRES COLUMNAS. El enlace de la valoración vive en
  // `PublicLink` con `purpose = VALORACION` y `targetType =
  // CLINICAL_ASSESSMENT`, y la única cosa que resuelve un token es la
  // puerta común (`apps/api/src/enlaces/puerta.ts`).
  //
  // Siguen aquí, y se siguen escribiendo, por una sola razón: la guardia
  // de regresión de clinica-2 (`clinica-valoracion.e2e.ts` y
  // `11-clinica-valoracion.spec.ts`) las mira, y el bloque que generaliza
  // el mecanismo no es el que cambia la guardia que lo vigilaba. Expand
  // ahora, contract después — borrarlas en la misma migración que las
  // sustituye deja la vuelta atrás sin red.
  //
  // **Se quitan en el bloque que mueva esa guardia a `public_links`.**
  // Hasta entonces: no se lee ninguna de las tres; escribirlas es un
  // espejo del enlace de verdad, no una segunda fuente de verdad.
  /// OBSOLETO (enlaces-publicos): la huella vive en `PublicLink.tokenHash`.
  linkTokenHash String?   @unique @map("link_token_hash")
  /// OBSOLETO (enlaces-publicos): la caducidad vive en `PublicLink.expiresAt`.
  linkExpiresAt DateTime? @map("link_expires_at") @db.Timestamptz()
  /// OBSOLETO (enlaces-publicos): el gasto vive en `PublicLink.usedCount`.
  linkUsedAt    DateTime? @map("link_used_at") @db.Timestamptz()

  // ── Lo que contestó el paciente, que vive en la historia ─────────────
  //
  // Único: una entrada de historia pertenece a una valoración y no a dos.
  entryId    String?             @unique @map("entry_id") @db.Uuid
  answeredAt DateTime?           @map("answered_at") @db.Timestamptz()
  answeredBy ClinicalAnsweredBy? @map("answered_by")

  // ── Las tres confirmaciones y la firma ───────────────────────────────
  //
  // Se escriben EN EL MISMO acto de validar, no una a una: la pantalla las
  // marca en memoria y las manda con la validación. Media validación
  // guardada (dos casillas y nadie que firme) no significa nada, y un
  // CHECK garantiza que una fila VALIDADA las tiene las tres.
  confirmedAllergies  Boolean   @default(false) @map("confirmed_allergies")
  confirmedMedication Boolean   @default(false) @map("confirmed_medication")
  confirmedAlerts     Boolean   @default(false) @map("confirmed_alerts")
  validatedAt         DateTime? @map("validated_at") @db.Timestamptz()
  validatedByUserId   String?   @map("validated_by_user_id") @db.Uuid

  tenant      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client                         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  appointment Appointment?                   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  entry       ClinicalEntry?                 @relation(fields: [entryId], references: [id], onDelete: Restrict)
  requestedBy User?                          @relation("AssessmentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  validatedBy User?                          @relation("AssessmentValidatedBy", fields: [validatedByUserId], references: [id], onDelete: Restrict)
  corrections ClinicalAssessmentCorrection[]

  @@index([tenantId, clientId, createdAt])
  @@index([appointmentId])
  @@map("clinical_assessments")
}

// Lo que el sanitario corrigió. APPEND-ONLY (trigger
// `clinical_assessment_corrections_append_only`).
//
// Corregir dos veces la misma pregunta deja DOS filas; manda la última por
// fecha y las dos se conservan. Es la misma decisión que
// `clinical_addenda`: corregir una corrección es otra corrección, no una
// edición. Y no toca la respuesta del paciente, que está en la entrada
// inmutable: en pantalla se ven las dos a la vez.
model ClinicalAssessmentCorrection {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  assessmentId      String          @map("assessment_id") @db.Uuid
  // El id de la pregunta del cuestionario (`diab`, `insul`, …). Texto y no
  // FK: el cuestionario es dato del módulo, no una tabla.
  questionId        String          @map("question_id")
  /// clinica-7 · admite NULL para que el claro se pueda VACIAR cuando la
  /// corrección ya está cifrada. El enum no tiene valor neutro, así que un
  /// centinela sería una respuesta clínica falsa dentro de la historia. Lo
  /// que sostiene la columna es el CHECK
  /// `clinical_assessment_corrections_dice_algo`: una corrección dice
  /// algo, en claro o cifrado.
  value             ClinicalAnswer?
  /// Y la corrección entera, cifrada: `{"preguntaId":"diab","valor":"SI"}`.
  /// Pregunta y valor juntos porque separados `question_id` en claro ya
  /// diría de qué habla la fila. AAD
  /// `tenant|clinical_assessment_corrections|correccion|id`.
  correccionCifrada String?         @map("correccion_cifrada")
  // LA FIRMA. NOT NULL y RESTRICT: una corrección anónima sobre una
  // historia clínica no existe.
  authorUserId      String          @map("author_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assessment ClinicalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  author     User               @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([assessmentId, createdAt])
  @@index([tenantId])
  @@map("clinical_assessment_corrections")
}

// ─── clinica-7 · EL BLINDAJE ──────────────────────────────────────────
//
// Dos tablas, y las dos contestan preguntas que un abogado hace:
//
//   `clinical_processor_agreements`  ¿quién aceptó qué texto y cuándo?
//   `clinical_tenant_keys`           ¿con qué clave se cifra esta clínica,
//                                    y se destruyó ya?

// EL CONTRATO DE ENCARGADO DEL TRATAMIENTO (art. 28 RGPD). SOLO
// INSERCIONES (trigger `clinical_processor_agreements_append_only`).
//
// **Aceptar es una fila; revocar es OTRA FILA** que apunta a la que
// revoca, igual que `ClientConsent.revokesConsentId` de clinica-4. Nunca
// un UPDATE: una aceptación editable no demuestra nada sobre qué se
// aceptó, y lo que esta tabla existe para demostrar es exactamente eso.
//
// Y de ahí sale que el estado del módulo clínico sea una CUENTA sobre
// estas filas y no una columna. La hace una sola función pura
// (`@mipiacetpv/contrato-encargado`), que usan la API, el TPV y el panel:
// con una copia por lado, la pantalla diría «puedes escribir» sobre algo
// que el servidor considera revocado.
//
// Lo que NO lleva: nada de salud. Quién, qué versión, qué huella, cuándo,
// desde qué aparato y desde qué IP.
model ClinicalProcessorAgreement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // La versión del contrato y la HUELLA de su texto canónico. No se
  // guarda el texto: el paquete versionado lo tiene, y la huella es lo que
  // demuestra que es EL MISMO.
  //
  // La revocación COPIA versión y huella de la fila que revoca, como la
  // revocación de un consentimiento: es lo que hace que la lista se lea
  // («v1 · revocado el 14 de octubre») sin cruzar dos filas para pintar
  // una.
  version    Int
  textSha256 String @map("text_sha256") @db.Char(64)

  // QUIÉN. NOT NULL y Restrict: una aceptación anónima de un contrato de
  // encargado no existe. Que ADEMÁS sea OWNER lo exige la API — cruza el
  // rol del usuario con el tenant y no cabe en un CHECK.
  userId String   @map("user_id") @db.Uuid
  at     DateTime @default(now()) @db.Timestamptz()

  // DESDE DÓNDE. `deviceId` es **Restrict y no SetNull**: la tabla no se
  // puede reescribir, así que un SET NULL sería una promesa que el trigger
  // rechazaría al ejecutarse. Un aparato con aceptaciones no se borra — se
  // revoca, que es lo que el producto hace con los aparatos.
  deviceId  String? @map("device_id") @db.Uuid
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(300)

  // La fila que esta revoca. Con esto puesto, la fila NO ACEPTA NADA.
  revokesAgreementId String? @map("revokes_agreement_id") @db.Uuid

  // contrato-lectura-completa · CUÁNDO EL FINAL DEL TEXTO LLEGÓ A LA
  // PANTALLA, antes de aceptar. Con esto puesto, la fila dice que el texto
  // completo se mostró y se recorrió hasta el final — que es lo que
  // contesta a «yo eso no lo leí».
  //
  // UNA columna y no dos (un booleano y un instante): son el MISMO hecho.
  // `IS NOT NULL` es el booleano, y dos columnas que siempre van juntas
  // son dos columnas que un día se contradicen.
  //
  // `null` en tres casos, y los tres son verdad:
  //
  //   · en una REVOCACIÓN, que no acepta nada;
  //   · en las aceptaciones ANTERIORES a esta regla, donde nadie midió
  //     nada (y un `false` ahí sería afirmar que no lo leyó, que no se
  //     sabe);
  //   · nunca más en una aceptación nueva: la API las rechaza con 400.
  //
  // El CHECK de la migración cierra las combinaciones imposibles.
  textoRecorridoEn DateTime? @map("texto_recorrido_en") @db.Timestamptz()

  tenant      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user        User                         @relation("ClinicalProcessorAgreementUser", fields: [userId], references: [id], onDelete: Restrict)
  device      Device?                      @relation("ClinicalProcessorAgreementDevice", fields: [deviceId], references: [id], onDelete: Restrict)
  revoca      ClinicalProcessorAgreement?  @relation("ClinicalProcessorAgreementRevocacion", fields: [revokesAgreementId], references: [id], onDelete: Restrict)
  revocadoPor ClinicalProcessorAgreement[] @relation("ClinicalProcessorAgreementRevocacion")

  @@index([tenantId, at])
  // El índice PARCIAL sobre `revokes_agreement_id` (WHERE NOT NULL) se
  // crea en SQL: Prisma no expresa índices parciales. Mismo caso que
  // `public_links_uno_vivo_key`.
  @@map("clinical_processor_agreements")
}

// LA CLAVE DE UNA CLÍNICA. Una fila por tenant.
//
// La DEK (32 bytes aleatorios) cifra TODO el texto clínico y TODOS los
// ficheros de esa clínica, y **nunca está en claro en la base**: se guarda
// envuelta con la KEK, que vive en `CLINICAL_KEK` y no está ni en la base
// ni en el repo.
//
// ── Por qué una clave por clínica y no una sola ──────────────────────
//
// Porque borrar la DEK de una clínica deja ilegibles sus datos **en todas
// las copias de seguridad pasadas**, también las de hace meses. Es la
// única forma real de «destruir» al terminar el contrato (art. 28.3.g): un
// DELETE no llega a las copias, y las copias son justo donde la historia
// sigue viva. Con una clave única para todos, destruir los datos de una
// clínica obligaría a re-cifrar los de las demás.
//
// La función de destrucción (`crypto-shredding`) está construida y
// probada. **La pantalla que la lanza, NO**: es una operación de
// superadmin con doble confirmación y queda para su bloque.
//
// ── Y el canario ─────────────────────────────────────────────────────
//
// Un texto conocido cifrado con esta DEK. Al arrancar, la API lo descifra
// para cada tenant clínico; si no cuadra, la KEK no es la que envolvió
// estas claves y **la API no arranca**. Fallar al arrancar es mejor que
// escribir algo que después no se puede leer.
model ClinicalTenantKey {
  tenantId String @id @map("tenant_id") @db.Uuid

  // Con QUÉ KEK está envuelta. Con id porque la KEK rota: re-envolver es
  // un script del repo, y mientras corre conviven filas de las dos. Sin el
  // id habría que probar las dos a ciegas, y «probar claves» es justo lo
  // que no se hace con claves.
  kekId      String  @map("kek_id") @db.VarChar(40)
  // La DEK envuelta, formato `v1:` de `crypto.ts` con AAD `tenant|kek`
  // (así una DEK envuelta no se puede mover a otro tenant). `null` =
  // destruida.
  dekWrapped String? @map("dek_wrapped")
  // El canario, cifrado con la DEK. `null` = destruida.
  canary     String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  // Cuándo se re-envolvió por última vez. La DEK NO cambia al rotar la
  // KEK: lo que cambia es con qué está envuelta, y por eso las filas no
  // hay que re-cifrarlas.
  rewrappedAt DateTime? @map("rewrapped_at") @db.Timestamptz()

  // CUÁNDO SE DESTRUYÓ. La fila se queda con la clave borrada en vez de
  // desaparecer: así el sistema puede decir «los datos de esta clínica se
  // destruyeron el 3 de marzo» en lugar de parecer una clave que falta por
  // un fallo. Un hueco no es una respuesta cuando la pregunta la hace un
  // abogado.
  destroyedAt     DateTime? @map("destroyed_at") @db.Timestamptz()
  destroyedReason String?   @map("destroyed_reason") @db.VarChar(200)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([kekId])
  @@map("clinical_tenant_keys")
}

// ── enlaces-publicos · UNA SOLA PUERTA ────────────────────────────────────
//
// Todo lo que se abre SIN CUENTA: el test de la valoración (clinica-2, el
// primer usuario), y los que vienen — leer un consentimiento antes de
// firmarlo, «mi cita» para cambiar o anular, la encuesta post-visita y el
// formulario del equipo.
//
// La fila guarda ESTADO. Lo que puede hacer el enlace (caducidad, usos,
// perfil, en qué estado del objeto admite enlace, si deja rastro clínico,
// si el límite va por IP o por token) lo declara el `purpose` EN CÓDIGO,
// en el registro tipado de `apps/api/src/enlaces/reglas.ts`. Decisión S1
// (07-10): si los topes vivieran en la fila, cada pantalla podría
// aflojarlos con un UPDATE.
//
// `Ticket.publicSlug` queda FUERA (decisión S1.5): es la dirección de un
// justificante que su dueño reabre las veces que haga falta, no un permiso
// de un uso. Mezclarlo obligaría a aflojar las reglas de los demás.
model PublicLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  // PARA QUÉ sirve, y A QUÉ APUNTA.
  //
  // Los dos son texto y no enums: un `purpose` nuevo nace en el bloque que
  // lo necesita, sin migración (con un enum, cada uno obligaría a un
  // `ALTER TYPE ... ADD VALUE`, que clinica-1 y clinica-2 ya pagaron dos
  // veces). No se pierde nada: un `purpose` que no esté en el registro de
  // la aplicación resuelve a la MISMA 404 que un token inventado.
  //
  // `targetId` SIN FK, a propósito: los objetivos son de tablas distintas
  // y una FK por tipo exigiría una columna nula por tipo. Que el objetivo
  // exista lo comprueba la puerta, y si no está contesta la misma 404.
  purpose    String @map("purpose")
  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid

  // LA HUELLA DEL TOKEN, nunca el token. El CHECK
  // `public_links_token_hash_es_sha256` sólo admite 64 hex: el token en
  // claro (43 caracteres base64url) NO CABE en esta columna. Es la
  // garantía número uno del bloque, puesta en el motor y no en una
  // revisión de código.
  tokenHash String @unique @map("token_hash")

  // Cuándo deja de abrir. NOT NULL: un token sin caducidad es un token que
  // no caduca.
  expiresAt DateTime @map("expires_at") @db.Timestamptz()

  // Cuántas veces se puede gastar y cuántas se ha gastado. El tope lo pone
  // el `purpose`; que no se pase lo garantiza un CHECK, y que no baje, el
  // trigger `public_links_guard`.
  maxUses   Int @map("max_uses")
  usedCount Int @default(0) @map("used_count")

  // ── clinica-7 · EL CÓDIGO DE 6 CIFRAS ──────────────────────────────
  //
  // Decisión 21: el enlace del informe clínico no abre con solo tener la
  // URL. Pide un código que se enseña UNA vez en pantalla a quien lo envía,
  // para darlo por otro canal (en mano o por teléfono). Así, un correo
  // reenviado o una URL en el historial de un móvil prestado no abren nada.
  //
  // **LA HUELLA, nunca el código.** El CHECK
  // `public_links_code_hash_es_sha256` solo admite 64 hex: un código de 6
  // cifras NO CABE en esta columna. Y es identidad para el trigger — el
  // código de un enlace no cambia; si hace falta otro, es otro enlace.
  //
  // `null` en los `purpose` que no piden código (la valoración).
  codeHash     String? @map("code_hash") @db.Char(64)
  // Cuántas veces se ha fallado el código. 5 fallos ANULAN el enlace. Solo
  // sube (lo garantiza el trigger): bajarlo es regalar intentos a quien
  // está probando códigos sobre la historia clínica de alguien.
  codeFailures Int     @default(0) @map("code_failures")

  // Recepción lo anuló. No se des-anula (trigger).
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  // Quién lo creó. NULL cuando lo crea el sistema (el alta de una cita de
  // primera valoración no la pide una persona). Mismo criterio que
  // `ClinicalAssessment.requestedByUserId` con `source = APPOINTMENT`.
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("PublicLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // «Los enlaces de este objeto» (revocar al mover o anular una cita) y
  // «los de este negocio» (la pantalla de recepción, que vendrá con «mi
  // cita»).
  //
  // NO está aquí, y está en la migración: el único PARCIAL
  // `public_links_uno_vivo_key` sobre (`purpose`, `target_id`) con
  // `WHERE revoked_at IS NULL AND used_count < max_uses`, que es lo que
  // hace de «reenviar revoca el anterior» una invariante. Prisma no sabe
  // declarar índices parciales — mismo caso que
  // `clinical_assessments_one_open_key` de clinica-2.
  @@index([targetType, targetId])
  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("public_links")
}

// ──────────────────────────────────────────────────────────────────────
// kds-1-cocina · LA PANTALLA DE COMANDAS EN COCINA
//
// Cinco tablas y una idea: **el servidor sabe siempre cuántas unidades de
// cada línea ha recibido la cocina, en qué envío y cuántas se anularon
// después**. Todo lo demás (el semáforo, el orden, el parpadeo, las
// capas de alergia) se deriva de eso.
//
// La forma, de arriba abajo:
//
//   KitchenDispatch   un «Enviar» del camarero. Idempotente por el id que
//                     genera el terminal. Es la unidad de reintento.
//   KitchenOrder      una TARJETA de la pantalla: un envío × una sección
//                     con destino pantalla. «2ª COMANDA · M5».
//   KitchenOrderLine  un plato de esa tarjeta, con su copia del nombre,
//                     sus modificadores, su tiempo, su silla y los
//                     alérgenos del producto EN ESE MOMENTO.
//   TicketCourse      si el tiempo 2 de esta mesa está retenido o marchado.
//   TicketAllergy     las alergias de la mesa de ESTE servicio, por silla.
//
// Por qué la comanda COPIA en vez de leer la venta: la pantalla tiene que
// seguir diciendo lo que dijo. Si el camarero cambia la línea, baja
// unidades o la anula, la tarjeta no puede reescribirse en silencio —
// cocina tiene que ver «ERAN 3 · −1» y tocar «Visto» (decisión 6). Una
// tarjeta que se recalculase de la venta haría desaparecer el plato
// anulado, que es justo el fallo que el bloque existe para no cometer.
// ──────────────────────────────────────────────────────────────────────

// Un «Enviar». La unidad de IDEMPOTENCIA.
//
// Un envío puede crear varias tarjetas (cocina y barra), imprimir en otra
// sección y marcar como enviada una tercera que no tiene destino. Si el
// terminal pierde la respuesta y reintenta, las tres cosas tienen que
// volver a pasar CERO veces y la respuesta tiene que ser la misma. Por eso
// la llave de idempotencia vive aquí y no en `KitchenOrder`: cubre el
// envío completo, impresión incluida, y no sólo las tarjetas.
//
// `result` guarda la respuesta que se dio, literal. Un reintento la
// reproduce sin volver a tocar nada. Es el mismo patrón que
// `Ticket.checkoutExternalId`, con la respuesta persistida porque aquí no
// hay un objeto final del que reconstruirla.
model KitchenDispatch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  /// UUID v4 generado EN EL TERMINAL antes de mandar. Único global.
  ///
  /// Se deja preparado aquí el camino directo por la wifi de kds-2
  /// (decisión 9): el mismo envío viajará a la nube y a la tablet, y el
  /// que llegue segundo se descarta por este id. Hoy sólo sirve para el
  /// reintento de red, pero el modelo ya es el que hará falta.
  clientSendId String @unique @map("client_send_id") @db.Uuid

  /// Nº de comanda de esta mesa: 1ª, 2ª, 3ª. Copia de
  /// `Ticket.lastSentRevision` tras incrementarlo.
  revision Int
  /// El camarero tocó «Urgente» junto a «Enviar» (decisión 3).
  urgent   Boolean @default(false)

  sentAt       DateTime @default(now()) @map("sent_at") @db.Timestamptz()
  sentByUserId String   @map("sent_by_user_id") @db.Uuid

  /// La respuesta que se devolvió, para reproducirla en un reintento.
  result Json

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sentBy User           @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)
  orders KitchenOrder[]

  @@index([ticketId, sentAt])
  @@index([tenantId, sentAt])
  @@map("kitchen_dispatches")
}

// Una TARJETA de la pantalla de cocina: un envío × una sección.
//
// Sólo nacen para las secciones cuyo destino es una PANTALLA. Las de
// impresora siguen saliendo por ESC/POS (ahora por diferencia) y las que
// no tienen destino se marcan como enviadas sin más: el envío no falla por
// falta de destino (decisión 2).
model KitchenOrder {
  id         String @id @default(uuid()) @db.Uuid
  dispatchId String @map("dispatch_id") @db.Uuid
  ticketId   String @map("ticket_id") @db.Uuid
  /// La tienda es la que manda en el GET de cocina: una pantalla ve las
  /// comandas de SU tienda y de SUS secciones, y nada más. Copiada aquí
  /// para que el filtro sea un índice y no un `join` por la caja.
  storeId    String @map("store_id") @db.Uuid

  tableId   String? @map("table_id") @db.Uuid
  /// «M5». Copia del nombre de la mesa al enviar: renombrar la mesa en el
  /// panel no puede reescribir lo que la cocina está leyendo. NULL en una
  /// venta rápida sin mesa —que en hostelería es la barra— y entonces la
  /// tarjeta se titula con el nº de comanda.
  tableName String? @map("table_name")

  section KitchenSection
  /// 1ª, 2ª, 3ª comanda de esta mesa. Lo que pinta «2ª COMANDA».
  number  Int

  /// Decisión 3: urgente es UNA sola cosa (no hay «prioridad» aparte).
  /// Lo marca el camarero al enviar o la cocina con un toque largo.
  urgent           Boolean   @default(false)
  urgentAt         DateTime? @map("urgent_at") @db.Timestamptz()
  urgentByDeviceId String?   @map("urgent_by_device_id") @db.Uuid

  /// Cuándo entró en la pantalla. El semáforo NO cuenta desde aquí: cuenta
  /// desde que el grupo MARCHA (`KitchenOrderLine.firedAt`), que es lo que
  /// decidió la decisión 3. Una comanda con el tiempo 2 retenido lleva
  /// media hora en pantalla y su bloque retenido marca 0 min al marchar.
  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz()

  /// Decisión 9 · llegó cuando la pantalla volvió de estar sin red. Se
  /// pinta «llegó tarde» para que el cocinero no lo lea como recién hecho.
  lateArrival Boolean @default(false) @map("late_arrival")

  /// kds-2-wifi · la tablet ya tenía este envío por la wifi del local.
  ///
  /// Lo pone la subida de la tablet al volver internet. Significa: esta
  /// tarjeta NO es nueva —el cocinero la lleva viendo veinte minutos— así
  /// que no se pinta como nueva y `lateArrival` no se enciende: llegó, sólo
  /// que por el otro camino.
  ///
  /// Y es el dato que contesta «cuántos servicios salieron sin internet».
  lanReceivedAt DateTime? @map("lan_received_at") @db.Timestamptz()

  /// Decisión 4 · la tarjeta pasó a «Lista»: todos los platos tachados, o
  /// el botón grande. Es lo que avisa al camarero (decisión 5).
  readyAt         DateTime? @map("ready_at") @db.Timestamptz()
  readyByDeviceId String?   @map("ready_by_device_id") @db.Uuid

  /// Decisión 5 · un toque del camarero en la banda o en la etiqueta verde.
  /// Hasta entonces la tarjeta vive en la columna «Listas».
  servedAt       DateTime? @map("served_at") @db.Timestamptz()
  servedByUserId String?   @map("served_by_user_id") @db.Uuid

  /// Decisión 7 · «Hoy» devolvió esta tarjeta a la pantalla (se tachó sin
  /// querer). No se borra `readyAt`/`servedAt` del histórico: se apunta
  /// que volvió, porque de estas marcas salen los tiempos del dueño y una
  /// recuperación es una anomalía que el informe tiene que poder ver.
  recoveredAt DateTime? @map("recovered_at") @db.Timestamptz()

  dispatch KitchenDispatch    @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  ticket   Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table    Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  urgentBy Device?            @relation("KitchenOrderUrgentBy", fields: [urgentByDeviceId], references: [id], onDelete: SetNull)
  readyBy  Device?            @relation("KitchenOrderReadyBy", fields: [readyByDeviceId], references: [id], onDelete: SetNull)
  servedBy User?              @relation("KitchenOrderServedBy", fields: [servedByUserId], references: [id], onDelete: Restrict)
  lines    KitchenOrderLine[]

  /// Un envío produce COMO MUCHO UNA tarjeta por sección. Es la mitad
  /// de la idempotencia que se puede expresar en la base; la otra —no
  /// reimprimir, no remarcar— la da `KitchenDispatch.clientSendId`.
  @@unique([dispatchId, section])
  /// El GET de cocina: «las comandas abiertas de mi tienda». El índice
  /// lleva `servedAt` porque lo que se pide es «las no servidas».
  @@index([storeId, section, servedAt])
  @@index([ticketId])
  @@map("kitchen_orders")
}

// Un plato de una tarjeta.
model KitchenOrderLine {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  /// De qué línea de la venta salió. `SetNull`: borrar la línea de la
  /// venta no borra lo que la cocina vio, y la tarjeta tiene que poder
  /// seguir diciendo «ANULADO» después.
  ticketLineId String? @map("ticket_line_id") @db.Uuid

  // ── La copia, hecha al enviar ───────────────────────────────────────
  /// El nombre tal como se mandó. Mismo criterio que
  /// `TicketLine.nameSnapshot`: editar el catálogo no reescribe lo que
  /// está en la plancha.
  nameSnapshot String     @map("name_snapshot")
  /// Unidades de ESTE envío (la diferencia), no las de la mesa.
  units        Decimal    @db.Decimal(10, 3)
  /// Copia de `TicketLine.modifiers` (los dos shapes históricos: `string[]`
  /// legacy y el estructurado de B-Bar-Modifiers). Son las notas y los
  /// modificadores que la decisión 3 manda pintar bien visibles bajo cada
  /// plato.
  modifiers    Json?
  course       Int        @default(1)
  seat         Int?
  /// Los alérgenos del producto EN ESE MOMENTO. Copiados y no leídos:
  /// un plato que salió marcado «lleva gluten» tiene que seguir
  /// marcándolo aunque alguien corrija la ficha a media mañana.
  allergens    Allergen[] @default([])

  // ── Lo que pasa después ─────────────────────────────────────────────
  /// Cuándo MARCHÓ este plato: el instante desde el que cuenta el
  /// semáforo. El tiempo 1 marcha al enviar (`= order.sentAt`); los demás
  /// quedan NULL —«EN ESPERA», gris, sin semáforo— hasta «Marchar 2º».
  /// Lo que va a la pantalla de BARRA no se retiene nunca: la bebida sale
  /// ya, así que su `firedAt` se pone siempre al enviar.
  firedAt        DateTime? @map("fired_at") @db.Timestamptz()
  /// Decisión 4 · un toque tacha el plato. Se destacha con otro toque
  /// (dedo gordo), y de aquí sale el tiempo por plato del informe.
  doneAt         DateTime? @map("done_at") @db.Timestamptz()
  doneByDeviceId String?   @map("done_by_device_id") @db.Uuid

  // ── Decisión 6 · el cambio después de enviar ────────────────────────
  /// Cuántas de las `units` de esta tarjeta se anularon después. No se
  /// descuenta de `units`: la tarjeta tiene que decir «2 Croquetas · ERAN
  /// 3 · −1», y para eso hace falta el antes y el después.
  voidedUnits    Decimal   @default(0) @map("voided_units") @db.Decimal(10, 3)
  voidedAt       DateTime? @map("voided_at") @db.Timestamptz()
  voidedByUserId String?   @map("voided_by_user_id") @db.Uuid
  /// La cocina tocó «Visto». Hasta entonces el «ANULADO» no desaparece y
  /// la línea parpadea (decisión 8).
  voidSeenAt     DateTime? @map("void_seen_at") @db.Timestamptz()
  /// **MERMA**: la cocina ya lo había tachado cuando se anuló. O sea,
  /// comida hecha y tirada. Se calcula en el momento de anular y se
  /// guarda, porque `doneAt` puede cambiar después (destachar) y entonces
  /// el informe del dueño mentiría.
  doneBeforeVoid Boolean   @default(false) @map("done_before_void")

  /// Decisión 6 · la nota o los modificadores cambiaron después de enviar:
  /// «CAMBIO» en ámbar sobre el plato hasta «Visto». Se guarda el texto
  /// nuevo porque la copia de arriba es la que se mandó.
  changedAt    DateTime? @map("changed_at") @db.Timestamptz()
  changeNote   String?   @map("change_note")
  changeSeenAt DateTime? @map("change_seen_at") @db.Timestamptz()

  order      KitchenOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketLine TicketLine?  @relation(fields: [ticketLineId], references: [id], onDelete: SetNull)
  doneBy     Device?      @relation("KitchenOrderLineDoneBy", fields: [doneByDeviceId], references: [id], onDelete: SetNull)
  voidedBy   User?        @relation("KitchenOrderLineVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketLineId])
  @@map("kitchen_order_lines")
}

/// kds-2-wifi · EL LIBRO DE MARCAS de la cocina sin internet.
///
/// Una fila por cada cosa que la tablet marcó mientras no había red: un
/// tachado (o un destachado), un «Lista» o un «Visto». Se suben todas al
/// volver y se aplican por `at`.
///
/// POR QUÉ UN LIBRO Y NO «SUBIR EL ESTADO FINAL»: la decisión 9 dice que
/// en estos tres estados manda la cocina y que gana **la marca de tiempo
/// del aparato que manda en ese estado**. Con el estado final no se puede
/// ordenar nada: dos pantallas que tachan y destachan el mismo plato
/// darían el resultado del que subiera último, no del que lo hiciera
/// último. Con el libro, el resultado es el mismo en cualquier orden de
/// llegada — y de aquí salen los tiempos por plato de kds-3.
///
/// LAS COORDENADAS SON LAS DEL CAMINO DIRECTO (`clientSendId` + `section`
/// + `ticketLineId`) y no los ids del servidor, porque la tablet marca
/// sobre una tarjeta que el servidor TODAVÍA NO CONOCE: el `KitchenOrder`
/// nace cuando el envío sube por la nube. Si la marca llega antes que su
/// envío, queda con `appliedAt` NULL y la aplica el propio envío al entrar.
model KitchenLanMark {
  /// UUID v4 generado EN LA TABLET. La llave de idempotencia: subir dos
  /// veces la misma marca no mueve nada.
  markId String @id @map("mark_id") @db.Uuid

  /// Qué pantalla marcó. De aquí sale el «quién» del informe del dueño.
  deviceId String @map("device_id") @db.Uuid
  storeId  String @map("store_id") @db.Uuid

  /// `HECHO` (tachar/destachar), `VISTO` (un anulado o un cambio) o
  /// `LISTA`. Texto con CHECK y no enum: son tres valores de NUESTRO
  /// protocolo, no de una norma, y un enum nuevo obliga a partir la
  /// migración en dos (Postgres prohíbe usar un valor de enum en la misma
  /// transacción en la que se añade).
  kind String

  clientSendId String         @map("client_send_id") @db.Uuid
  section      KitchenSection
  /// NULL en una marca de TARJETA (`LISTA`): no apunta a un plato.
  ticketLineId String?        @map("ticket_line_id") @db.Uuid
  /// Para `HECHO`: tachado o destachado. NULL en las demás.
  done         Boolean?

  /// **La hora de la TABLET.** Es la que gana en estos tres estados, nunca
  /// la del TPV (decisión 9).
  at         DateTime  @map("at") @db.Timestamptz()
  receivedAt DateTime  @default(now()) @map("received_at") @db.Timestamptz()
  /// NULL = llegó antes que su envío y está esperándolo.
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// `kitchen_lan_marks_pendientes_idx` es PARCIAL sobre
  /// `applied_at IS NULL` y vive sólo en el SQL de la migración: es lo que
  /// el envío consulta al entrar («¿hay marcas esperándome?») y Prisma no
  /// sabe declarar un índice parcial. NO SE PUEDE BORRAR; lo guarda
  /// `kds-2-migracion.test.ts`.
  @@index([storeId, at])
  @@map("kitchen_lan_marks")
}

// kds-1-cocina (decisión 3) · si un TIEMPO de esta mesa está retenido o
// marchado.
//
// Una fila por (ticket, tiempo) y sólo cuando el tiempo YA MARCHÓ: la
// ausencia de fila es «retenido». Se eligió así y no con un booleano
// porque lo que hace falta guardar es el INSTANTE del marchado —de ahí
// cuenta el semáforo— y un booleano no lo lleva.
//
// El tiempo 1 se inserta en el propio envío. Los demás los inserta
// «Marchar 2º», que además pone el `firedAt` de las líneas de ese tiempo
// que ya están en pantalla.
model TicketCourse {
  id       String @id @default(uuid()) @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid
  course   Int

  firedAt       DateTime @default(now()) @map("fired_at") @db.Timestamptz()
  firedByUserId String   @map("fired_by_user_id") @db.Uuid

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  firedBy User   @relation(fields: [firedByUserId], references: [id], onDelete: Restrict)

  @@unique([ticketId, course])
  @@map("ticket_courses")
}

// kds-1-cocina (decisión 3, capa 1) · las alergias de LA MESA DE ESTE
// SERVICIO, por silla.
//
// LO QUE ESTA TABLA GARANTIZA, y es la mitad de por qué existe: la alergia
// **no sale del ticket**. Cuelga del `Ticket` con `Cascade`, no tiene
// nombre de nadie y **no hay ninguna clave hacia `Client`**. Cobrar o
// anular la mesa se la lleva. No es un dato de salud de una persona
// identificada: es «en la silla 3 de la mesa 5 de esta comida no puede
// entrar gluten».
//
// `seat` NULL = «toda la mesa», que es lo que se marca cuando el camarero
// no sabe quién es. Vale igual: en cocina sale la franja «⚠ TODA LA MESA».
model TicketAllergy {
  id       String   @id @default(uuid()) @db.Uuid
  ticketId String   @map("ticket_id") @db.Uuid
  seat     Int?
  allergen Allergen

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Marcar dos veces el mismo alérgeno en la misma silla no crea dos
  /// filas. En Postgres los NULL son distintos entre sí, así que este
  /// `@@unique` NO cubre «toda la mesa» (`seat IS NULL`): eso lo hace el
  /// índice PARCIAL `ticket_allergies_mesa_key` de la migración, que
  /// Prisma no sabe declarar. Mismo caso que
  /// `products_tenant_id_sku_local_key`.
  @@unique([ticketId, seat, allergen])
  @@index([ticketId])
  @@map("ticket_allergies")
}

// ══ residencia-1 · los cimientos de la residencia ══════════════════════
//
// Lo que este bloque construye es el SUELO sobre el que va la pantalla de
// la puerta (residencia-3): quién vive en qué habitación, quién trabaja
// con qué rol y en qué zona, en qué turno estamos y qué tablet es qué
// puerta. Sin eso, cada registro posterior habría que escribirlo a mano.
//
// Todo cuelga de `Tenant.residenciaEnabled`. Con la columna apagada estas
// tablas están vacías y ninguna ruta las toca.
//
// Decisiones en `docs/residencia/00-decisiones.md` (D-01 a D-60) y el mapa
// en `docs/residencia/01-modelo-datos.md`.

/// residencia-1 (D-49) · EL RESIDENTE, como ampliación 1:1 de `Client`.
///
/// La PK es el propio `clientId`: no hay id propio porque el perfil ES el
/// cliente visto como residente. Mismo patrón exacto que `StaffProfile`
/// sobre `User`, y por la misma razón: no hay una tabla `Resident`
/// paralela que duplique nombre, teléfono, historia y consentimientos.
///
/// ── Un residente NO SE BORRA ─────────────────────────────────────────
///
/// Las dos FKs son `Restrict`, y es la diferencia de fondo con
/// `StaffProfile` (que es `Cascade` a las dos). Un residente que ha vivido
/// en el centro tiene historia clínica detrás, y la historia se conserva
/// cinco años (Ley 41/2002) — lo mismo que ya decidió clinica-1. Lo que se
/// hace con quien se va es **darle de alta**: `dischargeDate` y
/// `dischargeReason`, y su ficha se queda.
model ResidentProfile {
  clientId String @id @map("client_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Cuándo ingresó. `@db.Date` y no timestamp: nadie apunta la hora del
  /// ingreso y pedirla sería un campo que se rellena mal.
  ///
  /// alta-minima · **OPCIONAL desde el 23-10-2026.** El primer día de una
  /// residencia real lo que hay es un listado de nombres: la señora ya
  /// vive aquí y no saber su fecha de ingreso no hace que necesite menos
  /// cuidados. Lo que falta lo enumera `datosQueFaltan` y el programa no
  /// deja de recordarlo; lo que NO puede es dejarla fuera del programa.
  admissionDate          DateTime? @map("admission_date") @db.Date
  /// Cuándo se le dio de alta, y por qué. NULL en quien sigue viviendo
  /// aquí. El motivo es texto corto y libre a propósito: «se va con su
  /// hija», «traslado a hospital», «fallecimiento». Un enum habría
  /// obligado a elegir mal el día que no encaja ninguno, y esto no
  /// alimenta ninguna estadística en la v1.
  dischargeDate          DateTime? @map("discharge_date") @db.Date
  dischargeReason        String?   @map("discharge_reason")
  /// residencia-1b · «fallecimiento», «traslado al hospital por ictus»
  /// caben enteros en ese texto libre, así que desde este bloque va
  /// cifrado. El CHECK `resident_profiles_alta_coherente` mira LAS DOS
  /// columnas: un motivo, en claro o cifrado, sigue exigiendo fecha.
  dischargeReasonCifrado String?   @map("discharge_reason_cifrado")

  /// Cuánta ayuda necesita (lo decide el centro) y el grado reconocido de
  /// la Ley de Dependencia (lo reconoce la administración, y puede no
  /// tenerlo). Son dos cosas distintas: ver los enums.
  ///
  /// alta-minima · el NIVEL también es opcional, y arrastra una
  /// consecuencia: **sin nivel no se precarga plan de cuidados** (no hay
  /// plantilla que aplicar). El residente nace sin plan, el parte ya sabe
  /// enseñarlo sin ruido (residencia-6 §4) y «como siempre» y «algo no va
  /// bien» funcionan igual —las dimensiones OBS son del centro, no del
  /// plan—. «Plan de cuidados» entra en `datosQueFaltan` como
  /// imprescindible hasta que la dirección lo cargue.
  dependencyLevel DependencyLevel? @map("dependency_level")
  dependencyGrade DependencyGrade? @map("dependency_grade")
  /// Privada, concertada o temporal. Los pagadores y la vigencia de la
  /// plaza son Fase 3.
  ///
  /// alta-minima · opcional, y es el único de los tres que el listado del
  /// primer día suele traer (segunda columna del Excel). Si es
  /// `CONCERTADA`, el grado reconocido pasa a imprescindible: sin grado no
  /// se factura a la Junta.
  placeType       PlaceType?       @map("place_type")

  /// El FAMILIAR RESPONSABLE del PAI: a quién se llama. Las tres columnas
  /// son opcionales porque hay residentes sin familia localizable, y un
  /// campo obligatorio que no se puede rellenar se rellena con basura.
  responsibleName     String? @map("responsible_name")
  responsiblePhone    String? @map("responsible_phone")
  responsibleRelation String? @map("responsible_relation")

  /// Identificación. **Nunca en logs, ni en Sentry, ni en un mensaje de
  /// error** — la misma regla que los datos de salud, y la misma razón: un
  /// DNI y un número de la Seguridad Social identifican a una persona en
  /// un sistema que guarda su salud.
  dni String?
  nss String?

  /// residencia-1b (D-63) · DONDE VIVEN DE VERDAD desde este bloque.
  /// `dni` y `nss` se quedan para las filas que ya estaban escritas
  /// cuando llegó el cifrado (expand → migrar → contract, clinica-7 §3);
  /// las nuevas nacen con el claro a NULL. Su CHECK de formato
  /// (`resident_profiles_dni_cifrado_formato`) sólo admite `c1:…`: el
  /// claro NO CABE aquí.
  dniCifrado String? @map("dni_cifrado")
  nssCifrado String? @map("nss_cifrado")

  /// ── residencia-3 (D-64) · LA FOTO DEL RESIDENTE ───────────────────
  ///
  /// La pidió Matías para el mockup de la puerta: ayuda a la suplente y a
  /// quien no conoce a cada residente, que en una planta de 25 personas y
  /// con rotación de turnos es la mitad de la plantilla.
  ///
  /// El JPEG vive en el **volumen clínico**, cifrado con cabecera `MPC1` y
  /// con la huella del claro, igual que una foto clínica (clinica-4
  /// decisión 11, clinica-7 decisión 8): fuera de Postgres y fuera de todo
  /// lo que se sirve en estático. Una cara servida por Caddy con una URL
  /// difícil de adivinar es una cara pública.
  ///
  /// **Y sólo se sirve con consentimiento de imagen vigente**
  /// (`ClientConsentKind.IMAGE`). En un pasillo la foto la ve cualquiera
  /// que pase, de ahí el consentimiento; sin él, la puerta pinta las
  /// iniciales en el mismo hueco.
  ///
  /// Las seis columnas van juntas o ninguna (CHECK
  /// `resident_profiles_foto_completa`). Y **se reemplaza, no se
  /// versiona**: la cara de alguien es identidad (como `firstName`), no
  /// historia — nadie tiene que poder reconstruir qué foto tenía en marzo.
  photoFileName     String?   @map("photo_file_name") @db.VarChar(100)
  photoSha256       String?   @map("photo_sha256") @db.Char(64)
  photoBytes        Int?      @map("photo_bytes")
  photoMimeType     String?   @map("photo_mime_type") @db.VarChar(40)
  photoUploadedAt   DateTime? @map("photo_uploaded_at") @db.Timestamptz()
  photoUploadedById String?   @map("photo_uploaded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  client          Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// `SetNull`: dar de baja a quien subió la foto no borra la foto.
  photoUploadedBy User?  @relation("ResidentPhotoUploadedBy", fields: [photoUploadedById], references: [id], onDelete: SetNull)
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  /// «Los que viven aquí hoy», que es la lista por defecto de la pantalla
  /// de Residentes.
  @@index([tenantId, dischargeDate])
  @@map("resident_profiles")
}

/// residencia-1 · PLANTA (o zona) del centro. Es la unidad del ALCANCE:
/// una auxiliar cubre una o varias plantas (D-51), y de ahí sale qué
/// residentes puede ver.
///
/// `Cascade` al tenant, al revés que el residente: una planta es
/// configuración del edificio, no un registro que la ley obligue a
/// conservar. Lo que no se puede borrar con el tenant son los residentes,
/// y eso ya lo impide `ResidentProfile`.
model Floor {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  /// En qué orden se pinta. No se deduce del nombre: «Baja» va antes que
  /// «Primera» y alfabéticamente no.
  sortOrder Int    @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms                 Room[]
  zones                 CareZoneAssignment[]
  /// residencia-5 · esta planta nombrada en un parte de relevo: como zona
  /// con contenido, como zona que una confirmación abarcaba y como sitio
  /// de un añadido tardío. `Restrict` en las tres: una planta que sale en
  /// un parte congelado es vocabulario del histórico firmado.
  handoverZones         HandoverZone[]
  handoverAckZones      HandoverAckZone[]
  handoverLateAdditions HandoverLateAddition[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("floors")
}

/// residencia-1 · HABITACIÓN. Es lo que tiene puerta, y por tanto lo que
/// tiene tablet (D-52).
///
/// `number` es texto y no entero: en Jardín de Gredos hay «112» y hay
/// «112 bis». Único por centro, que es como lo nombra el personal («la
/// 112»), no por planta.
model Room {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  floorId  String  @map("floor_id") @db.Uuid
  number   String
  name     String?
  /// Fuera de servicio (obra, avería) sin borrarla: sus camas y su
  /// histórico de ocupación se quedan.
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Restrict)
  beds         Bed[]
  /// La tablet de esta puerta (como mucho una viva, por el índice parcial
  /// `devices_one_active_per_room_key`) y los códigos pendientes de
  /// emparejar.
  devices      Device[]
  pairingCodes PairingCode[]
  /// residencia-4 · las incidencias declaradas desde la puerta de esta
  /// habitación. `SetNull`: retirar una habitación no borra lo que pasó
  /// dentro, pero tampoco impide retirarla.
  incidents    Incident[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([tenantId, floorId])
  @@map("rooms")
}

/// residencia-1 · CAMA: la plaza física dentro de la habitación. 49 plazas
/// en Jardín de Gredos, repartidas en individuales y dobles.
///
/// `tenantId` es redundante con el de la habitación y está por la regla de
/// aislamiento por fila de la casa (misma decisión que `StaffSkill`).
model Bed {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  roomId   String  @map("room_id") @db.Uuid
  /// «A», «B». Único dentro de la habitación.
  label    String
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignments BedAssignment[]

  @@unique([roomId, label])
  @@index([tenantId])
  @@map("beds")
}

/// residencia-1 (decisión de producto 6) · QUIÉN OCUPA QUÉ CAMA, con
/// vigencia.
///
/// La regla, y son dos mitades: **una cama tiene como mucho un residente
/// vigente** y **un residente ocupa como mucho una cama vigente**. Las dos
/// las garantizan índices PARCIALES de la migración
/// (`bed_assignments_one_live_per_bed_key` y
/// `..._per_client_key`, `WHERE to_at IS NULL`), no un `if` de ninguna
/// ruta — igual que `clinical_access_one_live_key` en clinica-1.
///
/// Cambiar de habitación **cierra una ocupación y abre otra**: se rellena
/// `toAt` de la anterior y se inserta una fila nueva, en la misma
/// transacción. No se edita la fila vieja, porque «¿dónde dormía doña
/// Carmen en marzo?» es una pregunta que una residencia tiene que poder
/// contestar.
///
/// Y no se borra: `Restrict` al residente y a la cama.
model BedAssignment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  bedId    String @map("bed_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Desde cuándo y hasta cuándo. `toAt` NULL = ocupación VIGENTE, y es lo
  /// que miran los dos índices parciales. Los nombres de columna son
  /// `from_at`/`to_at` y no `from`/`to` porque las dos palabras son
  /// reservadas en SQL y quedarían entre comillas en cada consulta a mano.
  fromAt        DateTime  @map("from_at") @db.Timestamptz()
  toAt          DateTime? @map("to_at") @db.Timestamptz()
  /// Por qué se abrió o se cerró. Texto corto: «ingreso», «cambio a la
  /// 112», «alta». No alimenta nada automático.
  reason        String?
  /// residencia-1b (D-63) · y cifrado, porque ahí es donde se escribe
  /// «aislamiento por GEA» o «se cae de la cama». La ubicación en sí
  /// (planta, habitación, cama) sigue en claro: es del centro.
  reasonCifrado String?   @map("reason_cifrado")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bed       Bed    @relation(fields: [bedId], references: [id], onDelete: Restrict)
  client    Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// `SetNull`: dar de baja a la encargada que movió de habitación a doña
  /// Carmen no puede borrar el hecho de que se movió.
  createdBy User?  @relation("BedAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([bedId])
  @@index([clientId])
  @@map("bed_assignments")
}

/// residencia-1 (D-50) · CATÁLOGO de roles de cuidado. **Dato, no código.**
///
/// El rol de negocio (`UserRole`) no se toca: son dos cosas distintas y se
/// guardan separadas para no tener que pasar por las ~60 rutas de caja que
/// miran `UserRole` cada vez que una residencia invente un puesto.
///
/// ── Por tenant, con semilla de serie ─────────────────────────────────
///
/// `tenantId` es NOT NULL: al encender el interruptor se le siembran al
/// centro los diez roles de serie (`isStandard = true`). Así «desactivar
/// un rol de serie» y «añadir uno propio» son la misma operación sobre la
/// misma tabla, en vez de un catálogo global más una tabla de excepciones
/// por centro.
///
/// Lo que un centro NO puede hacer con un rol de serie es cambiarle la
/// CATEGORÍA ni los tres flags de abajo, y no es una costumbre: lo impide
/// el trigger `care_roles_de_serie_son_fijos` del motor. Si «dirección»
/// pudiera pasar a OPERATIVO, el cierre de incidencias N3/N4 de
/// residencia-4 dejaría de significar lo que la norma dice que significa.
model CareRole {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// `AUXILIAR`, `DUE`, `MEDICO`… Único por centro. En los de serie es el
  /// código de la semilla; en los propios lo normaliza la ruta.
  code     String
  name     String

  category CareRoleCategory

  /// ¿Es uno de los diez de serie? Los de serie no se borran y no cambian
  /// de categoría; sólo se pueden desactivar.
  isStandard Boolean @default(false) @map("is_standard")
  active     Boolean @default(true)
  sortOrder  Int     @default(0) @map("sort_order")

  /// ── Los tres flags de los que cuelga el acceso ────────────────────
  ///
  /// `recordsCare` · este rol REGISTRA cuidados. Todos salvo
  /// administración. Quien tiene uno vigente queda `User.isClinician = true`
  /// (D-51): en una residencia el acceso no se decide por cita, se decide
  /// por rol y zona.
  recordsCare     Boolean @default(true) @map("records_care")
  /// `requiresLicense` · este rol exige número de colegiado: DUE, médico,
  /// fisio y TO. La auxiliar y la limpiadora registran y no lo tienen, y
  /// pedírselo habría dejado media plantilla sin poder entrar.
  requiresLicense Boolean @default(false) @map("requires_license")
  /// `fullScope` · este rol ve TODO EL CENTRO sin necesidad de zona: DUE,
  /// médico, calidad y dirección (D-51). Lo mira la función de acceso.
  fullScope       Boolean @default(false) @map("full_scope")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// `Restrict` al otro lado: un rol con asignaciones —aunque estén
  /// revocadas— no se borra. La asignación revocada es el histórico de
  /// quién firmó qué y con qué capacidad (D-31), y un histórico que nombra
  /// un rol que ya no existe no se puede leer.
  assignments      CareRoleAssignment[]
  /// residencia-5 (D-42) · las obligaciones de dirección de las que este
  /// rol es responsable. `Restrict`: un rol con obligaciones a su nombre
  /// es vocabulario vivo del centro — primero se le cambia el
  /// responsable, después se retira el rol.
  managementDuties ManagementDuty[]
  /// calidad-1 (D-70) · los procesos de los que este rol es responsable y
  /// las acciones correctivas a su nombre. `Restrict` en las dos y por lo
  /// mismo: un rol que es dueño de un proceso del mapa es vocabulario
  /// vivo del centro.
  processes        Process[]
  correctiveActions CorrectiveAction[] @relation("CorrectiveActionResponsibleRole")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("care_roles")
}

/// residencia-1 (D-50, decisión de producto 3 y 4) · PERSONA ↔ ROL DE
/// CUIDADO, muchos a muchos con vigencia.
///
/// Muchos a muchos porque una persona puede ser TO y Calidad a la vez, y
/// las dos cosas a la vez significan cosas distintas: con la de Calidad ve
/// todo el centro, con la de TO firma una sesión de terapia.
///
/// **No se borra.** Revocar rellena `revokedAt`; volver a dar el rol crea
/// OTRA fila. Copia literal del criterio de `ClinicalAccess` en clinica-1,
/// incluido el índice parcial de la migración
/// (`care_role_assignments_one_live_key`, `WHERE revoked_at IS NULL`), que
/// es lo que permite que el histórico «se lo quitamos en marzo y se lo
/// devolvimos en junio» quepa en la tabla: con un índice total, Postgres no
/// lo admitiría.
model CareRoleAssignment {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  careRoleId String @map("care_role_id") @db.Uuid

  /// La VIGENCIA PREVISTA: desde cuándo rige y hasta cuándo (una suplencia
  /// de verano). `toAt` NULL = sin fecha de fin prevista.
  fromAt DateTime  @map("from_at") @db.Timestamptz()
  toAt   DateTime? @map("to_at") @db.Timestamptz()

  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz()
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  /// La REVOCACIÓN, que es otra cosa que `toAt`: una fecha de fin prevista
  /// la pone quien da el rol; una revocación la pone quien lo quita, el día
  /// que lo quita. Las dos quitan el rol; sólo una dice que alguien lo
  /// decidió.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// `Restrict` al usuario: la asignación es la CAPACIDAD con la que esa
  /// persona firmó lo que firmó. No se queda huérfana.
  user      User     @relation("CareRoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  careRole  CareRole @relation(fields: [careRoleId], references: [id], onDelete: Restrict)
  grantedBy User?    @relation("CareRoleAssignmentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  revokedBy User?    @relation("CareRoleAssignmentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  /// residencia-3 · lo que se firmó CON ESTA CAPACIDAD (D-31). `Restrict`
  /// al otro lado, que es la razón por la que una asignación no se borra
  /// nunca: es la mitad de la firma.
  careRecords              CareRecord[]
  /// residencia-4 · y lo que se abrió, cerró, hizo, comunicó, acusó y
  /// pautó con ella. Todo `Restrict`, por lo mismo: «lo cerró Ana Isabel»
  /// no es evidencia; «lo cerró Ana Isabel, como responsable de calidad»
  /// sí (rama de controles §8).
  incidentsOpened          Incident[]                  @relation("IncidentOpenedWith")
  incidentsClosed          Incident[]                  @relation("IncidentClosedWith")
  incidentActions          IncidentAction[]
  familyCommunications     FamilyCommunication[]
  guardAlertsAcked         GuardAlert[]                @relation("GuardAlertAckedWith")
  guardShiftSessions       GuardShiftSession[]
  thresholdOverridesSigned ResidentThresholdOverride[]
  /// residencia-5 · la CAPACIDAD con la que se confirmó un relevo y con
  /// la que se marcó hecha una obligación (D-31). `Restrict`, como todo lo
  /// demás de esta lista.
  handoverAcks             HandoverAck[]
  dutyOccurrencesDone      DutyOccurrence[]
  /// calidad-1 (D-31, D-73) · y la capacidad con la que se abrió y se
  /// cerró una NC, se escribió una acción, se adjuntó una evidencia y se
  /// firmó una verificación de eficacia.
  ncOpened                 NonConformity[]             @relation("NonConformityOpenedWith")
  ncClosed                 NonConformity[]             @relation("NonConformityClosedWith")
  actionsOpened            CorrectiveAction[]          @relation("CorrectiveActionOpenedWith")
  actionsClosed            CorrectiveAction[]          @relation("CorrectiveActionClosedWith")
  evidencesAdded           CorrectiveActionEvidence[]  @relation("EvidenceByWith")
  verificationsSigned      EffectivenessVerification[] @relation("VerificationByWith")

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([careRoleId])
  @@map("care_role_assignments")
}

/// residencia-1 (D-51) · EL ALCANCE DE UNA PERSONA, POR PLANTA.
///
/// En una residencia no hay citas: hay zonas y turnos. La selección por
/// paciente de la clínica (`ClinicalAccess`, que se llena sola al asignar
/// una cita) no tiene de dónde llenarse aquí, y por eso el alcance de la
/// residencia es éste y no aquél.
///
/// `floorId` NULL = **todo el centro**. Se usa para la gerente que no
/// lleva un rol de alcance total pero cubre el edificio entero; los roles
/// que ya ven todo (DUE, médico, calidad, dirección) no necesitan ni una
/// fila aquí, porque lo deciden por `CareRole.fullScope`.
///
/// La unicidad de lo vigente está en DOS índices parciales de la
/// migración, y hacen falta los dos: uno por `(user, floor)` y otro por
/// `(user)` con `floor_id IS NULL`, porque en Postgres los NULL son
/// distintos entre sí y el primero no cubriría «todo el centro».
model CareZoneAssignment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  floorId  String? @map("floor_id") @db.Uuid

  fromAt DateTime  @map("from_at") @db.Timestamptz()
  toAt   DateTime? @map("to_at") @db.Timestamptz()

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("CareZoneAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  floor     Floor? @relation(fields: [floorId], references: [id], onDelete: Restrict)
  grantedBy User?  @relation("CareZoneAssignmentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([floorId])
  @@map("care_zone_assignments")
}

/// residencia-1 (D-54) · LOS TURNOS DEL CENTRO.
///
/// Configurables, con tres de serie que se siembran al encender el
/// interruptor: mañana 08–15, tarde 15–22 y noche 22–08. El registro de
/// residencia-3 se adscribe al turno en que ocurre, y el turno es la
/// unidad del relevo (residencia-5).
///
/// `startsAt`/`endsAt` son HORAS DE PARED «HH:MM» y no timestamps, igual
/// que `StaffShift.startTime`: «la noche empieza a las diez» no cambia el
/// día del cambio de hora. La función que contesta «¿en qué turno cae este
/// instante?» (`residencia/turnos.ts`) convierte el instante a hora de
/// pared de `Europe/Madrid` y compara — y sabe que la noche CRUZA
/// MEDIANOCHE (`endsAt <= startsAt`).
model CenterShift {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// `M`, `T`, `N` en los de serie. Único por centro: es como lo nombra el
  /// cuadrante.
  code      String
  name      String
  /// «HH:MM», 24 h. CHECK de formato en la migración.
  startsAt  String @map("starts_at")
  endsAt    String @map("ends_at")
  sortOrder Int    @default(0) @map("sort_order")

  /// personal-1 (decisión 4) · **CUÁNTAS PERSONAS DE ATENCIÓN DIRECTA**
  /// tiene que haber en este turno. Es la primera de las ocho reglas que
  /// `comprobarCuadrante` mira.
  ///
  /// NULLABLE a propósito, y el NULL significa algo: «este centro no ha
  /// declarado un mínimo para este turno». Los tres turnos que residencia-1
  /// sembró en Jardín de Gredos no lo tienen, y ponerles un 0 haría que la
  /// regla dijera «cumple» de todos ellos — que es peor que no decir nada.
  /// Con NULL la regla no se evalúa y la pantalla lo pide.
  minCoverage Int? @map("min_coverage")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// residencia-3 · los registros adscritos a este turno. `Restrict` al
  /// otro lado: residencia-1 dejó dicho (decisión 8 de su done) que un
  /// turno se podía borrar «porque nada apunta todavía a un turno». Ya
  /// apunta algo, y es el histórico firmado.
  careRecords        CareRecord[]
  /// residencia-4 · y las incidencias y los turnos de guardia adscritos.
  /// `Restrict` por lo mismo.
  incidents          Incident[]
  guardShiftSessions GuardShiftSession[]
  /// residencia-5 · y el parte de relevo de este turno. `Restrict` por lo
  /// mismo: el turno es la unidad del relevo (D-54, D-58).
  handovers          Handover[]
  /// personal-1 · y las celdas del cuadrante que lo usan. `Restrict`:
  /// borrar «la noche» dejaría un cuadrante publicado apuntando a nada.
  scheduleCells      StaffScheduleCell[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("center_shifts")
}

// ══ residencia-2 · el catálogo de controles y el plan de cuidados ══════
//
// Lo que este bloque construye es **qué se registra, a quién y cuándo**.
// No registra nada: eso es la pantalla de la puerta (residencia-3), que
// sólo tendrá que llamar a `queToca`.
//
// Hoy esto vive en prosa dentro del PAI («hidratación cutánea diaria»,
// «toma de peso según protocolo») y en la cabeza del personal. Nadie puede
// sacar de ahí un plan del día sin releerlo, y nadie puede contar un
// indicador de AENOR sin repasar 49 carpetas. Por eso el catálogo es DATO
// (D-11) y por eso cada control sabe a qué indicador alimenta.
//
// ── Las cinco piezas y en qué orden se leen ──────────────────────────
//
//   1. `ControlType`           — el catálogo. Global y versionado para lo
//      de serie; por tenant para lo que el centro se invente.
//   2. `ControlTypeOption`     — las opciones de un control ordinal, con
//      cuál es su «como siempre» (D-16, D-59).
//   3. `CenterControlSetting`  — qué decide el centro de cada control,
//      SIEMPRE dentro de lo que el producto permite.
//   4. `CenterMoment`          — los momentos del día del centro, con su
//      hora. El desayuno de Jardín de Gredos es a las nueve.
//   5. `CarePlanTemplateItem` + `CarePlanItem` — qué le toca a un nivel de
//      dependencia y qué le toca a una persona.
//
// Decisiones en `docs/residencia/00-decisiones.md` (D-11, D-16, D-21,
// D-53, D-57, D-59, D-60) y el mapa en `01-modelo-datos.md`.

/// residencia-2 (D-11, rama de controles §1) · EL CATÁLOGO DE CONTROLES.
///
/// Una fila = «una cosa que se registra de un residente», con todo lo que
/// hace falta para pintarla, validarla, agendarla y contarla. Dar de alta
/// un control nuevo es un INSERT, no un despliegue: ésa es la decisión
/// entera (D-11).
///
/// ── GLOBAL Y VERSIONADO, no una copia por tenant ─────────────────────
///
/// Lo de serie (`scope = STANDARD`) tiene `tenantId` NULL y **lo ven todos
/// los centros**. Cuando cambia una guía clínica se actualiza en el
/// producto y baja a todos a la vez (D-21, D-57). Es justo lo contrario
/// que `CareRole`, que residencia-1 sembró por tenant, y la diferencia es
/// quién tiene que poder cambiarlo: que un centro llame «gerocultora» a la
/// auxiliar no le interesa a nadie más; que la prevención de úlceras pase
/// de tres horas a dos tiene que llegar a los cinco centros sin backfill.
///
/// ── UNA VERSIÓN USADA NO SE EDITA ────────────────────────────────────
///
/// Se crea la siguiente con su `validFrom` y se le pone `supersededAt` a
/// la anterior. Lo que ya se registró sigue apuntando a la versión con la
/// que se registró (residencia-3 guardará `controlTypeId`, no el código),
/// así que «¿qué rango de referencia tenía la temperatura cuando se apuntó
/// esto?» se puede contestar tres años después — que es lo que una
/// auditoría pregunta.
///
/// **Una sola versión vigente por código**, y hacen falta DOS índices
/// parciales para decirlo (ver la migración): en Postgres los NULL son
/// distintos entre sí, así que un único índice sobre
/// `(scope, tenant_id, code) WHERE superseded_at IS NULL` dejaría entrar
/// dos versiones vigentes de un control de serie. Misma lección exacta que
/// `care_zone_assignments_one_live_centro_key` en residencia-1.
///
/// ── LO QUE EL CENTRO NO PUEDE TOCAR ──────────────────────────────────
///
/// Todas las columnas de esta tabla, en los de serie. La capa, la
/// naturaleza, el dominio, la unidad, los rangos, las opciones ordinales,
/// el indicador ISO y **la lista de frecuencias permitidas** son del
/// producto (rama de controles §10). Lo que el centro decide vive en
/// `CenterControlSetting`, y lo que decide es un subconjunto de lo que
/// aquí se permite.
///
/// Los **umbrales** que disparan eventos NO están aquí: son residencia-4
/// (`ClinicalThreshold`, versionado aparte, con excepción por residente
/// por prescripción médica, D-21/D-22). `refMin`/`refMax` es «lo normal»
/// para pintarlo en gris o en ámbar, no «avisa a la DUE».
model ControlType {
  id String @id @default(uuid()) @db.Uuid

  /// De quién es este control y de qué centro. `tenantId` es NULL si y
  /// sólo si `scope = STANDARD`, por el CHECK
  /// `control_types_scope_exige_tenant`.
  scope    ControlScope
  tenantId String?      @map("tenant_id") @db.Uuid

  /// El código estable del control: `HIGIENE_PERSONAL`, `TEMPERATURA`,
  /// `ANIMO`. **Es la identidad del control a través de las versiones**, y
  /// por eso es lo que referencian `CenterControlSetting`,
  /// `CarePlanTemplateItem` y `CarePlanItem`: un ajuste del centro y una
  /// línea de plan sobreviven a una versión nueva del catálogo.
  code    String
  /// La versión de ESTE código, desde 1. Lo que sube la versión es un
  /// cambio del producto (una guía nueva), no un cambio del centro.
  version Int    @default(1)

  /// Cómo lo llama el producto. El centro puede ponerle un alias en su
  /// glosario local (`CenterControlSetting.alias`) sin tocar esto.
  name String

  layer       ControlLayer
  nature      ControlNature
  valueDomain ControlValueDomain @map("value_domain")

  /// ── Sólo `MEASURE` / `NUMERIC` ────────────────────────────────────
  ///
  /// `unit` es el texto que se pinta junto al número («°C», «mmHg»).
  ///
  /// `inputMin`/`inputMax` es **lo que la pantalla deja teclear**: una
  /// temperatura de 3,65 °C es un dedo que se saltó una tecla, y atajarlo
  /// en el teclado cuesta cero y evita un evento falso en residencia-4.
  ///
  /// `refMin`/`refMax` es **lo normal**, para pintar el valor en gris o en
  /// ámbar. NO es un umbral de aviso: los umbrales son residencia-4 y van
  /// en su propia tabla versionada, porque admiten excepción por residente
  /// con prescripción médica firmada (D-21, D-22) y un rango de referencia
  /// no.
  unit     String?
  inputMin Decimal? @map("input_min") @db.Decimal(10, 2)
  inputMax Decimal? @map("input_max") @db.Decimal(10, 2)
  refMin   Decimal? @map("ref_min") @db.Decimal(10, 2)
  refMax   Decimal? @map("ref_max") @db.Decimal(10, 2)

  /// residencia-2 · controles que se TOMAN JUNTOS y se pintan juntos.
  ///
  /// Hoy sólo la tensión: `TA_SISTOLICA` y `TA_DIASTOLICA` llevan los dos
  /// `groupCode = "TA"`. Son dos controles y no uno compuesto —la decisión
  /// está explicada en el done del bloque— porque un umbral de
  /// residencia-4 es por valor («sistólica ≥ 180», plantilla de gravedad
  /// de D-56) y un dominio `NUMERIC` tiene una unidad y un rango, no dos.
  /// Lo que la agrupación compra es que la pantalla pida «120 / 80» de una
  /// vez en vez de abrir dos veces el teclado.
  groupCode String? @map("group_code")

  /// ── La frontera, en dos listas ────────────────────────────────────
  ///
  /// `allowedFrequencies` · las frecuencias que el producto admite para
  /// este control. El centro elige **dentro** de ésta y no puede
  /// ensancharla: una analítica no se hace «cada turno» por mucho que la
  /// pantalla lo dejara teclear.
  ///
  /// `allowedCareRoleCodes` · los roles de cuidado que pueden registrarlo.
  /// El centro puede ESTRECHARLO (que la medicación la dé sólo la DUE) y
  /// no ensancharlo (que la dé la limpiadora). Son CÓDIGOS de `CareRole` y
  /// no FKs a propósito: `CareRole` es por tenant (residencia-1 §4) y este
  /// catálogo es global, así que una FK sería imposible de escribir para
  /// una fila `STANDARD`. La validación cruzada vive en la ruta, como el
  /// requisito de colegiado de residencia-1.
  allowedFrequencies   CareFrequencyKind[] @default([]) @map("allowed_frequencies")
  allowedCareRoleCodes String[]            @default([]) @map("allowed_care_role_codes")

  /// ── La frecuencia DE SERIE ────────────────────────────────────────
  ///
  /// La que el centro se encuentra puesta al encender el módulo, y que
  /// puede cambiar por otra de `allowedFrequencies`. Qué parámetros exige
  /// cada `kind` lo garantiza el CHECK `control_types_frecuencia_coherente`
  /// y no la ruta que escribe.
  ///
  /// Columnas explícitas y no un `Json`, por la misma razón que el
  /// semáforo de cocina (`Store.kitchenGreenMaxMin`): esto tiene que poder
  /// llevar CHECK en la base, y un JSON no puede. Y porque `queToca` lo
  /// recorre en bucle por residente y por línea: un parse por línea sería
  /// trabajo por nada, y una forma que la base no garantiza obliga a la
  /// función pura a defenderse de datos imposibles.
  defaultFrequencyKind CareFrequencyKind @map("default_frequency_kind")
  defaultEveryNHours   Int?              @map("default_every_n_hours")
  defaultEveryNDays    Int?              @map("default_every_n_days")
  defaultWeekdays      Int[]             @default([]) @map("default_weekdays")
  defaultMonthDay      Int?              @map("default_month_day")
  defaultShiftCodes    String[]          @default([]) @map("default_shift_codes")
  defaultMomentCodes   String[]          @default([]) @map("default_moment_codes")

  /// A qué indicador de calidad alimenta este control (ISO 9001 / AENOR).
  /// Texto y no enum: los indicadores cambian con la revisión de la norma
  /// y con lo que la auditoría pida, y eso no puede ser una migración.
  /// residencia-5 los cuenta.
  isoIndicatorCode String? @map("iso_indicator_code")

  /// Visibilidad para la familia **por defecto**: interno (D-60). El
  /// centro la cambia en su ajuste. No hay portal en la v1; la columna
  /// está desde ya porque es una columna hoy y un bloque mañana.
  familyVisibleDefault Boolean @default(false) @map("family_visible_default")

  /// En qué orden se pinta dentro de su capa. No se deduce del nombre: el
  /// desayuno va antes que la comida y alfabéticamente no.
  sortOrder Int @default(0) @map("sort_order")

  /// Desde cuándo rige esta versión, y desde cuándo la sustituyó la
  /// siguiente. `supersededAt` NULL = **versión vigente**, y es lo que
  /// miran los dos índices parciales.
  validFrom    DateTime  @map("valid_from") @db.Timestamptz()
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  /// `Cascade` al tenant y sólo alcanza a los `CENTER`: los `STANDARD` no
  /// tienen tenant y no los borra nadie. Un control propio de un centro
  /// que se da de baja se va con él, igual que sus plantas.
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  options     ControlTypeOption[]
  /// residencia-3 · lo registrado CON ESTA VERSIÓN (decisión 2).
  /// `Restrict` al otro lado: una versión con registros no se borra,
  /// porque es lo que contesta «¿qué decía el catálogo cuando se apuntó
  /// esto?».
  careRecords CareRecord[]

  @@index([scope, code])
  @@index([tenantId])
  @@index([layer, sortOrder])
  @@map("control_types")
}

/// residencia-2 (D-16, D-59) · LAS OPCIONES DE UN CONTROL ORDINAL.
///
/// «Todo / la mitad / poco / nada» para una comida; «bien / apagado /
/// triste / inquieto / agresivo» para el ánimo. Ordenadas de mejor a peor,
/// que es como se pintan y como las lee un indicador.
///
/// ── `isAsUsual`, que es la mitad del producto ────────────────────────
///
/// D-16: el coste de registrar es proporcional a la anomalía. La
/// observación diaria se pregunta POR RESIDENTE y no por dimensión: un
/// solo toque en «como siempre» da por buenas **todas** las dimensiones
/// `OBS` activas, y sólo se despliega lo que se desvía. Para que ese toque
/// sepa qué guardar en cada dimensión, cada dimensión tiene que declarar
/// cuál es su valor «como siempre» — y eso es esta columna.
///
/// **Como mucho una por control**, por índice parcial
/// (`control_type_options_un_como_siempre_key`): con dos, el toque de
/// «como siempre» tendría que elegir y acabaría eligiendo el orden de la
/// lista. Con ninguna, la dimensión simplemente no entra en el atajo y se
/// pregunta siempre — que es correcto para una comida («todo» no es «como
/// siempre», es «se lo comió todo hoy»).
///
/// Tabla y no un `Json` en `ControlType` por eso mismo: la unicidad del
/// «como siempre» es un invariante del motor, y un JSON no lleva índice
/// parcial.
model ControlTypeOption {
  id            String @id @default(uuid()) @db.Uuid
  controlTypeId String @map("control_type_id") @db.Uuid

  /// El código estable de la opción (`MITAD`, `APAGADO`). Es lo que
  /// guardará el registro de residencia-3, para que cambiarle el texto no
  /// reescriba el histórico.
  code  String
  /// Lo que lee el personal. Es el vocabulario del cliente y es editable
  /// (D-59): cambiarlo no es un desarrollo.
  label String

  /// El orden: de mejor a peor. Lo pinta la pantalla y lo usa el
  /// indicador.
  sortOrder Int @default(0) @map("sort_order")

  /// ¿Es ésta la opción que da por buena el toque de «como siempre»?
  /// Como mucho una por control.
  isAsUsual Boolean @default(false) @map("is_as_usual")

  controlType ControlType @relation(fields: [controlTypeId], references: [id], onDelete: Cascade)

  @@unique([controlTypeId, code])
  @@index([controlTypeId, sortOrder])
  @@map("control_type_options")
}

/// residencia-2 (alcance §2, rama de controles §10) · LO QUE EL CENTRO
/// DECIDE DE CADA CONTROL.
///
/// La otra mitad de la frontera. Aquí vive **todo** lo que un centro puede
/// tocar, y nada más: si lo activa, cómo lo llama en su glosario, cada
/// cuánto lo quiere de serie, quién lo registra y si lo ve la familia.
///
/// ── La clave es el CÓDIGO, no el id de la versión ────────────────────
///
/// `(tenantId, controlCode)`. Y es la decisión del fichero: una versión
/// nueva de un control de serie **conserva** el ajuste del centro. Si la
/// clave fuera `controlTypeId`, cada actualización del catálogo clínico
/// dejaría a los cinco centros con sus ajustes huérfanos y la DUE tendría
/// que volver a decir que la medicación la da ella.
///
/// Cuando una versión nueva deja el ajuste inválido —p. ej. retira la
/// frecuencia que el centro había elegido— el ajuste se **reconduce** a la
/// de serie y queda anotado (`reconductedAt` y las dos columnas que lo
/// acompañan) para que el panel lo diga. Reconducir en silencio es cambiar
/// el plan de 49 personas sin decírselo a nadie.
///
/// Y de ahí sale una regla que la ruta tiene que vigilar: **un control
/// propio del centro no puede llevar el código de uno de serie**. Si
/// pudiera, `(tenantId, code)` ya no sabría de cuál de los dos es el
/// ajuste. La ruta de crear un control propio contesta 409; tiene su test.
model CenterControlSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// El código del control, de serie o propio. No es una FK por lo dicho
  /// arriba: apunta a la IDENTIDAD del control, no a una de sus versiones.
  controlCode String @map("control_code")

  /// ¿Lo usa este centro? Un control desactivado **no «toca» nunca**
  /// —`queToca` no devuelve ocurrencias suyas— y su botón no sale en la
  /// puerta. Desactivar no borra las líneas de plan que lo nombran: el
  /// centro puede volver a activarlo y el plan sigue ahí.
  active Boolean @default(true)

  /// El glosario local. `NULL` = se usa el nombre del producto. Que un
  /// centro llame «aseo» a la higiene personal es suyo, igual que llamar
  /// «gerocultora» a la auxiliar.
  alias String?

  /// La frecuencia POR DEFECTO de este centro, que tiene que estar en
  /// `ControlType.allowedFrequencies` de la versión vigente. Lo valida la
  /// ruta (es una regla que cruza dos tablas, así que no cabe en un CHECK,
  /// igual que el colegiado de residencia-1); el CHECK de la base garantiza
  /// la coherencia entre el `kind` y sus parámetros.
  frequencyKind CareFrequencyKind @map("frequency_kind")
  everyNHours   Int?              @map("every_n_hours")
  everyNDays    Int?              @map("every_n_days")
  weekdays      Int[]             @default([])
  monthDay      Int?              @map("month_day")
  shiftCodes    String[]          @default([]) @map("shift_codes")
  momentCodes   String[]          @default([]) @map("moment_codes")

  /// Quién lo registra en ESTE centro. Subconjunto de
  /// `ControlType.allowedCareRoleCodes`: se puede estrechar, no ensanchar.
  /// Vacío = los que el producto permite.
  careRoleCodes String[] @default([]) @map("care_role_codes")

  /// ¿Lo ve la familia? Nace en `ControlType.familyVisibleDefault`, que es
  /// `false` (D-60: todo interno por defecto). No hay portal en la v1.
  familyVisible Boolean @default(false) @map("family_visible")

  /// ── La reconducción, anotada ──────────────────────────────────────
  ///
  /// Se rellenan cuando una versión nueva del control deja este ajuste
  /// inválido y el sistema lo lleva a la frecuencia de serie. El panel lo
  /// pinta; nadie lo borra salvo el centro al volver a elegir.
  reconductedAt          DateTime? @map("reconducted_at") @db.Timestamptz()
  reconductedFromVersion Int?      @map("reconducted_from_version")
  reconductedReason      String?   @map("reconducted_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, controlCode])
  @@index([tenantId])
  @@index([tenantId, active])
  @@map("center_control_settings")
}

/// residencia-2 (alcance §4) · LOS MOMENTOS DEL DÍA DEL CENTRO.
///
/// Desayuno, comida, merienda, cena y noche, **con su hora**. El desayuno
/// de Jardín de Gredos es a las nueve y el de otro centro a las ocho y
/// media, y eso cambia a qué hora «toca» la medicación del desayuno.
///
/// Se llama `CenterMoment` y no `MealMoment` (que es como lo nombraba el
/// prompt) porque la noche no es una comida y la medicación nocturna
/// cuelga de ella.
///
/// Por tenant, con los cinco de serie sembrados al encender el módulo —la
/// misma decisión que `CenterShift`, y por la misma razón: una pantalla
/// con «añade tu primer momento» es una pantalla que no sabe lo que hace
/// una residencia.
///
/// La hora es de PARED «HH:MM», como `CenterShift.startsAt` y por lo
/// mismo: «el desayuno es a las nueve» no cambia el día del cambio de
/// hora, y guardarlo como instante obligaría a reescribir filas dos veces
/// al año.
model CenterMoment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// `DESAYUNO`, `COMIDA`, `MERIENDA`, `CENA`, `NOCHE` en los de serie.
  /// Es lo que referencian `momentCodes`.
  code String
  name String

  /// «HH:MM», 24 h. CHECK de formato en la migración, el mismo que
  /// `center_shifts`.
  atTime String @map("at_time")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("center_moments")
}

/// residencia-2 (alcance §5, D-53) · LA PLANTILLA DE UN NIVEL DE
/// DEPENDENCIA: qué lleva un válido, un semiasistido y un dependiente.
///
/// Una fila = un control dentro de la plantilla de un nivel, con la
/// frecuencia que ese nivel le pone. Al dar de alta a un residente se le
/// aplican las filas de su nivel; al cambiarle el nivel se recalcula (y
/// las líneas manuales no se tocan).
///
/// ── La de serie vive en el PRODUCTO, no en esta tabla ────────────────
///
/// Esta tabla es **la copia del centro**, editable, con `tenantId` NOT
/// NULL. La plantilla de serie vive en un fichero de datos del repo
/// (`residencia/catalogo/plantillas-de-serie.ts`) y de ahí se copia al
/// encender el módulo.
///
/// Es una decisión y está en el done: los únicos dos que leen la plantilla
/// de serie son la semilla y el botón de «volver a la de serie», y los dos
/// leen el fichero. Meterla también en la base habría obligado a un
/// `scope`/`tenantId?` con sus dos índices parciales —la misma factura que
/// paga `ControlType`— para una tabla que nadie consulta en caliente.
///
/// Sin tabla padre: la plantilla ES su lista de filas. Un nivel sin
/// ninguna fila es un nivel sin plan por defecto, que es un estado
/// legítimo (el válido lleva poco) y no hace falta una fila para decirlo.
model CarePlanTemplateItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// A qué nivel de dependencia pertenece esta línea de plantilla.
  dependencyLevel DependencyLevel @map("dependency_level")
  /// El código del control. Como en `CenterControlSetting`, no es una FK:
  /// apunta a la identidad del control y sobrevive a sus versiones.
  controlCode     String          @map("control_code")

  /// La frecuencia que este NIVEL le pone al control, que puede no ser la
  /// del centro: el dependiente lleva cambios posturales cada 3 h y el
  /// válido no los lleva en absoluto. Mismo CHECK de coherencia.
  frequencyKind CareFrequencyKind @map("frequency_kind")
  everyNHours   Int?              @map("every_n_hours")
  everyNDays    Int?              @map("every_n_days")
  weekdays      Int[]             @default([])
  monthDay      Int?              @map("month_day")
  shiftCodes    String[]          @default([]) @map("shift_codes")
  momentCodes   String[]          @default([]) @map("moment_codes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dependencyLevel, controlCode])
  @@index([tenantId, dependencyLevel])
  @@map("care_plan_template_items")
}

/// residencia-2 (alcance §5, D-53) · EL PLAN DE CUIDADOS DE UN RESIDENTE,
/// como dato.
///
/// Una fila = «a esta persona le toca este control con esta frecuencia,
/// desde este día». Es lo que `queToca` lee y lo que la puerta pedirá en
/// residencia-3. Nada se lee del PAI en prosa.
///
/// ── UNA LÍNEA NO SE BORRA NI SE EDITA: se CIERRA ─────────────────────
///
/// `toAt` con fecha, y la fila se queda. Dos razones, y la segunda es la
/// que manda:
///
///   1. «¿Qué le tocaba a doña Carmen el 3 de marzo?» es una pregunta que
///      una residencia tiene que poder contestar a una familia, a la
///      Consejería o a un juzgado. Con líneas editables, la respuesta
///      sería siempre la de hoy.
///   2. Por eso la frecuencia está **materializada aquí** y no se hereda
///      del ajuste del centro: si se heredara, cambiar hoy el defecto del
///      centro reescribiría el plan de los últimos tres años. La línea se
///      crea copiando la frecuencia que el centro tenía puesta en ese
///      momento, y cambiarle la frecuencia es **cerrar una y abrir otra**,
///      en la misma transacción y en ese orden — exactamente como cambiar
///      de habitación en `BedAssignment`.
///
/// Lo único mutable de una fila es `toAt` y su motivo de cierre.
///
/// **Una línea viva por (residente, control)**, por índice parcial
/// (`care_plan_items_one_live_key`, `WHERE to_at IS NULL`): dos líneas
/// vivas del mismo control con frecuencias distintas son dos respuestas a
/// «¿cada cuánto se le cambia de postura?», y la puerta tendría que elegir.
/// El histórico cabe porque el índice es parcial — misma lección que
/// `bed_assignments_one_live_per_client_key`.
model CarePlanItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  controlCode String @map("control_code")

  frequencyKind CareFrequencyKind @map("frequency_kind")
  everyNHours   Int?              @map("every_n_hours")
  everyNDays    Int?              @map("every_n_days")
  weekdays      Int[]             @default([])
  monthDay      Int?              @map("month_day")
  shiftCodes    String[]          @default([]) @map("shift_codes")
  momentCodes   String[]          @default([]) @map("moment_codes")

  /// Desde cuándo rige y hasta cuándo. `toAt` NULL = **línea viva**, y es
  /// lo que mira el índice parcial. `fromAt` es lo que hace que un
  /// residente dado de alta a mitad del periodo no tenga ocurrencias
  /// antes de ingresar: tiene su caso en la tabla de `queToca`.
  fromAt DateTime  @map("from_at") @db.Timestamptz()
  toAt   DateTime? @map("to_at") @db.Timestamptz()

  /// De dónde salió. De esto depende el cambio de nivel: se cierran las de
  /// plantilla del nivel anterior que no estén en la nueva y **las
  /// manuales no se tocan**.
  source CarePlanItemSource

  /// De QUÉ nivel era la plantilla que la puso. NULL en las manuales. Sin
  /// esta columna, al cambiar de nivel no se podría distinguir «esto lo
  /// puso la plantilla de semiasistido» de «esto lo puso la plantilla de
  /// dependiente», y el recálculo cerraría líneas que siguen vigentes.
  sourceLevel DependencyLevel? @map("source_level")

  /// Por qué se abrió y por qué se cerró. Texto corto: «alta»,
  /// «cambio a dependiente», «lo pide la DUE». No alimenta nada
  /// automático.
  reason      String?
  closeReason String? @map("close_reason")

  /// residencia-1b (D-63) · los DOS textos libres de esta tabla, cifrados.
  /// «úlcera sacra grado II», «se le retiró la sonda». `controlCode` y la
  /// frecuencia se quedan EN CLARO y está declarado: sostienen
  /// `care_plan_items_one_live_key` y el cifrado es no determinista.
  reasonCifrado      String? @map("reason_cifrado")
  closeReasonCifrado String? @map("close_reason_cifrado")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  closedByUserId  String?  @map("closed_by_user_id") @db.Uuid

  /// `Restrict` al tenant y al residente, igual que `BedAssignment`: el
  /// plan de una persona es parte de lo que se conserva cinco años, y un
  /// residente con plan no se borra.
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// `SetNull` en las dos personas: dar de baja a la DUE que ajustó el
  /// plan no puede borrar el hecho de que lo ajustó.
  createdBy   User?        @relation("CarePlanItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  closedBy    User?        @relation("CarePlanItemClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  /// residencia-3 · los registros que esta línea pidió. `Restrict`: una
  /// línea con registros tampoco se borra — y de todas formas una línea
  /// nunca se borra, se cierra (residencia-2 §6).
  careRecords CareRecord[]

  @@index([tenantId])
  @@index([tenantId, clientId])
  @@index([clientId, controlCode])
  @@map("care_plan_items")
}

/// residencia-3 (decisión de producto 1) · **EL REGISTRO DE CUIDADOS. LA
/// EVIDENCIA.**
///
/// Una fila = **una cosa registrada** de un residente: un «hecho», un
/// valor ordinal, el «como siempre» de una dimensión, un «a demanda» que
/// sólo se cuenta, o una nota de «algo no va bien». Es lo que sostiene la
/// hoja de cambios posturales que hoy se reconstruye a mano para AENOR, y
/// es historia clínica a todos los efectos (D-45, D-51).
///
/// ── INMUTABLE, y lo dice el motor ───────────────────────────────────
///
/// No se edita y no se borra: el trigger `care_records_inmutable` deja
/// pasar **una sola** transición en un `UPDATE` —la anulación, de NULL a
/// puesta— y nada más. Es la misma regla que `clinical_entries` en
/// clinica-1, con la escapatoria legítima que aquella no necesitaba.
///
///   · **Corregir** crea OTRA fila que apunta a la corregida
///     (`correctsRecordId`). La corregida se queda donde está.
///   · **Deshacer el último** rellena `voidedAt` / `voidedByUserId`: anula
///     sin borrar, y se sigue viendo quién lo apuntó y quién lo deshizo.
///
/// ── EL ID LO GENERA LA TABLET, y eso es dos cosas a la vez ──────────
///
///   1. La **idempotencia** del envío por lotes (decisión 5): el mismo
///      uuid dos veces es la misma fila, y una tablet que reintenta un
///      lote con el wifi a medias no duplica un cuidado.
///   2. El **AAD** del valor cifrado (decisión 6, clinica-7 §3): el sitio
///      es `tenant|care_records|value|<id>`, así que el valor de una fila
///      no se puede mover a otra. Y el id hay que saberlo antes de
///      insertar, que es justo lo que la tablet ya sabe.
///
/// De ahí que NO lleve `@default(uuid())`: lo pone quien escribe, y en la
/// puerta quien escribe es la tablet.
///
/// ── QUÉ VA EN CLARO Y QUÉ VA CIFRADO (decisión 6, D-63) ─────────────
///
/// Cifrado: **el valor** y **el texto de la nota**, en dos columnas
/// lógicas distintas con su `sitio*` (un texto de nota copiado a la
/// columna del valor no descifra). La nota de VOZ va cifrada como fichero
/// en el volumen clínico, con cabecera `MPC1` como las fotos.
///
/// En claro, y declarado: `controlTypeId`, `controlCode`, el residente, los
/// dos instantes, el turno, el día, la firma y el estado de anulación.
/// Sostienen «qué falta por hacer», el relevo y los indicadores — igual
/// que `care_plan_items.control_code` (residencia-1b §2). Y la
/// consecuencia también es la misma: un `SELECT` sigue diciendo QUÉ se le
/// registra a un residente y cuándo, no CUÁNTO ni CÓMO está.
model CareRecord {
  /// Generado en la TABLET. Ver la cabecera.
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// La **versión** del `ControlType` con la que se registró (decisión 2,
  /// residencia-2 §1). «¿Qué rango de referencia tenía esto cuando se
  /// apuntó?» se contesta tres años después, que es lo que pregunta una
  /// auditoría.
  controlTypeId String @map("control_type_id") @db.Uuid
  /// Y su código, EN CLARO. Es la identidad del control a través de las
  /// versiones, y es con lo que la puerta cruza «lo que toca» con «lo que
  /// ya está hecho» sin descifrar nada.
  controlCode   String @map("control_code")

  /// La línea del plan que lo pidió. NULL en lo `ON_DEMAND` (el botón «+
  /// Deposición» no cuelga de una ocurrencia) y en la nota de «algo no va
  /// bien», que no está en el plan de nadie.
  planItemId String? @map("plan_item_id") @db.Uuid

  /// **A QUÉ MOMENTO DEL PLAN responde.** Es lo que hace que tres cambios
  /// posturales de un mismo turno sean tres cosas y no una repetida.
  ///
  ///   · lo que «toca» → el instante que devolvió `queToca`;
  ///   · la observación diaria («¿cómo está hoy?») → **NULL**, porque se
  ///     pregunta una vez por residente y turno, no por ocurrencia. De ahí
  ///     sale «una vez por residente y turno» de la decisión 4;
  ///   · lo `ON_DEMAND` → el instante del propio registro, porque no
  ///     cuelga de ninguna agenda y su momento es cuando ocurrió. Así dos
  ///     deposiciones del mismo turno son dos.
  ///
  /// Sostiene el índice único PARCIAL `care_records_una_por_ocurrencia_key`
  /// de la migración, que Prisma no sabe declarar: la clave es
  /// `(residente, control, día, turno, ocurrencia)` sólo sobre las filas
  /// que NO son correcciones, con `COALESCE` en las dos nullable porque en
  /// Postgres los NULL son distintos entre sí.
  occurrenceAt DateTime? @map("occurrence_at") @db.Timestamptz()

  /// **EL VALOR, CIFRADO.** JSON serializado:
  /// `{"tipo":"BOOL","hecho":true}`, `{"tipo":"ORDINAL","opcion":"MITAD"}`,
  /// `{"tipo":"ORDINAL","opcion":"COMO_SIEMPRE","comoSiempre":true}`,
  /// `{"tipo":"CONTEO"}`, `{"tipo":"NOTA"}`.
  ///
  /// NOT NULL: todo registro tiene valor, también el «a demanda» (su valor
  /// es que ocurrió) y la nota sin texto (D-13: «algo no va bien» a secas
  /// es un registro completo). Su CHECK de formato sólo admite `c1:…`: el
  /// claro NO CABE.
  valueCifrado String  @map("value_cifrado")
  /// El texto corto de «algo no va bien», cifrado. Columna lógica propia.
  noteCifrado  String? @map("note_cifrado")

  /// ── La nota de VOZ (decisión 10) ──────────────────────────────────
  ///
  /// Fichero en el volumen clínico, cifrado con cabecera `MPC1` y con la
  /// huella **del claro**, igual que una foto clínica. Las cuatro columnas
  /// van juntas o ninguna (CHECK `care_records_voz_completa`): media nota
  /// de voz es una fila que dice que hay un audio que no se puede servir.
  ///
  /// Transcribirla y descartar el audio es ia-1 (ADR-02).
  voiceFileName String? @map("voice_file_name") @db.VarChar(100)
  voiceSha256   String? @map("voice_sha256") @db.Char(64)
  voiceBytes    Int?    @map("voice_bytes")
  voiceMimeType String? @map("voice_mime_type") @db.VarChar(40)

  /// ── LA FIRMA: persona + CAPACIDAD (decisión 2, D-31) ──────────────
  ///
  /// No basta con quién: hace falta **con qué rol de cuidado entró**. Una
  /// misma persona puede ser TO y Calidad (residencia-1 §4), y lo que
  /// firma no es la persona a secas sino la persona en una capacidad.
  recordedByUserId     String @map("recorded_by_user_id") @db.Uuid
  careRoleAssignmentId String @map("care_role_assignment_id") @db.Uuid
  /// Y desde qué tablet. NOT NULL: en este bloque todo lo que escribe aquí
  /// entra por una puerta.
  deviceId             String @map("device_id") @db.Uuid

  /// ── LOS DOS INSTANTES (decisión 5) ────────────────────────────────
  ///
  /// `recordedAt` es el de la TABLET: cuándo ocurrió el cuidado. Es el que
  /// manda para el turno y para el histórico, y el servidor lo acepta
  /// dentro de límites (`residencia/registro.ts`).
  /// `receivedAt` es cuándo llegó al servidor. Con la red caída los dos se
  /// separan horas, y las dos preguntas —«¿cuándo se le giró?» y «¿cuándo
  /// lo supimos?»— tienen respuesta.
  recordedAt DateTime @map("recorded_at") @db.Timestamptz()
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()

  /// ── EL TURNO (decisión 3, D-54) ───────────────────────────────────
  ///
  /// Calculado EN LA TABLET con `turnoDe` y los turnos que trajo el
  /// arranque, porque sin red el servidor no puede contestarlo.
  ///
  /// **NULL es legítimo**: los turnos del centro pueden no cubrir la hora,
  /// y entonces el registro se guarda SIN turno y se pinta como aviso.
  /// Rechazarlo sería perder un cuidado que se hizo — residencia-1 §11.5,
  /// que es el «cobrar siempre se puede» de este módulo.
  centerShiftId String? @map("center_shift_id") @db.Uuid
  /// El día del CENTRO al que se adscribe, «YYYY-MM-DD». NOT NULL.
  ///
  /// No es la fecha de `recordedAt`: es la del **día del turno**. El turno
  /// de noche cruza medianoche, así que lo registrado a las 02:00 del
  /// martes pertenece a la noche del lunes — y sin esta columna, «lo que
  /// se hizo en este turno» partiría la ronda de la madrugada en dos días.
  /// Lo calcula `diaDelTurno` del paquete puro, en la tablet.
  careDay       String  @map("care_day") @db.VarChar(10)

  /// ── Corrección y anulación (decisión 1) ───────────────────────────
  ///
  /// `correctsRecordId` apunta a la fila que esta corrige. **Único**: dos
  /// filas corrigiendo a la misma dejarían «cuál es el valor de ahora» sin
  /// respuesta, y la puerta tendría que elegir.
  correctsRecordId String?   @map("corrects_record_id") @db.Uuid
  /// Anulada: con autor y hora, sin borrarse. Las dos juntas o ninguna
  /// (CHECK `care_records_anulacion_completa`).
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz()
  voidedByUserId   String?   @map("voided_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// `Restrict` en todo lo que dice QUÉ se registró y QUIÉN lo firmó: es
  /// la evidencia, y se conserva cinco años (Ley 41/2002, D-45).
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client             Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  controlType        ControlType            @relation(fields: [controlTypeId], references: [id], onDelete: Restrict)
  planItem           CarePlanItem?          @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  recordedBy         User                   @relation("CareRecordRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  careRoleAssignment CareRoleAssignment     @relation(fields: [careRoleAssignmentId], references: [id], onDelete: Restrict)
  device             Device                 @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// residencia-1 (decisión 8 de su done) dejó dicho que el `CareRecord`
  /// pondría su FK `Restrict` al turno. Aquí está: un turno con registros
  /// adscritos ya no se puede borrar, porque es el vocabulario con el que
  /// está firmado el histórico.
  centerShift        CenterShift?           @relation(fields: [centerShiftId], references: [id], onDelete: Restrict)
  corrige            CareRecord?            @relation("CareRecordCorrige", fields: [correctsRecordId], references: [id], onDelete: Restrict)
  corregidaPor       CareRecord[]           @relation("CareRecordCorrige")
  voidedBy           User?                  @relation("CareRecordVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  /// residencia-4 · la incidencia que esta medida ABRIÓ (si cruzó umbral)
  /// y las veces que se adjuntó como EVIDENCIA a una que ya estaba
  /// abierta. `Restrict` a los dos lados: la medida es la prueba de por
  /// qué se abrió, y sin ella la incidencia no se puede leer.
  incidentsOpened    Incident[]             @relation("IncidentSourceRecord")
  incidentActions    IncidentAction[]
  /// residencia-5 (decisión de producto 2) · las veces que este registro
  /// se añadió a un parte ya congelado porque llegó tarde. `Restrict`: el
  /// añadido es la prueba de que llegó después.
  lateAdditions      HandoverLateAddition[]

  @@unique([correctsRecordId])
  @@index([tenantId])
  /// «Lo registrado hoy de este residente», que es lo que la puerta pide
  /// al abrirse y lo que la ficha del admin enseña.
  @@index([tenantId, clientId, careDay])
  /// «Lo registrado hoy en el centro»: el relevo y el panel (residencia-5).
  @@index([tenantId, careDay])
  /// Y el cruce con «lo que toca», que es por control.
  @@index([clientId, controlCode, careDay])
  @@map("care_records")
}

/// residencia-3 (decisión de producto 8) · **EL PIN DE LA PUERTA.**
///
/// La credencial con la que alguien entra en la tablet de una habitación.
/// Es **otra** que el PIN del TPV (`User.pinHash`) y eso es a propósito:
///
///   · el PIN del TPV abre el cajón y cobra; éste **firma registros de
///     salud**. Dos cosas distintas no comparten secreto.
///   · una auxiliar de Jardín de Gredos no es `CASHIER` ni entra al TPV, y
///     el login de cajero exige `role IN (OWNER, MANAGER, CASHIER,
///     CLINICIAN)`. Colgar la puerta de aquél habría dejado fuera a media
///     plantilla o habría obligado a tocar `UserRole`, que es justo lo que
///     D-50 saca de en medio.
///   · en un centro sin caja —el cliente cero— éste es el ÚNICO PIN, así
///     que no hay dos que recordar.
///
/// ── Por qué hay DOS columnas y no una ───────────────────────────────
///
/// El mockup validado (D-64) pide **sólo el PIN**: ni email, ni elegir
/// nombre de una lista. Así que con el PIN hay que ENCONTRAR a la persona,
/// y buscarla probando argon2id contra los veinte de la plantilla son
/// cinco segundos y 1,3 GB de memoria por intento. No se puede.
///
///   · `pinLookup` — la **huella de búsqueda**: HMAC-SHA256 de
///     `puerta-pin|<tenant>|<pin>` con una subclave derivada de la DEK del
///     centro (`huellaDePinDePuerta`, `clinica/cripto.ts`). Es única por
///     centro, así que la encuentra UNA consulta indexada y de paso el
///     motor impide que dos personas del mismo centro tengan el mismo PIN
///     — sin eso, «sólo el PIN» no identificaría a nadie.
///   · `pinHash` — argon2id, la credencial de verdad, verificada sólo
///     contra la fila que la huella encontró. Una huella falsificada en la
///     base no abre nada.
///
/// La huella **se deriva de la DEK**, que vive envuelta por la
/// `CLINICAL_KEK` del entorno: con una copia de la base y sin la KEK no se
/// puede calcular ni invertir. Si estuviera salada con un valor de la
/// propia base, cuatro cifras son diez mil pruebas instantáneas. Y
/// destruir la DEK del centro (art. 28.3.g) apaga también el PIN de sus
/// puertas, que es lo correcto: la relación terminó.
model CarePin {
  userId   String @id @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// argon2id del PIN. **Nunca sale de la API**, ni a la tablet.
  pinHash   String @map("pin_hash")
  /// La huella de búsqueda. Ver la cabecera. Esta SÍ viaja a la tablet en
  /// el paquete de arranque, que es lo que le permite resolver el PIN SIN
  /// RED (igual que el roster de `offlineAuth` en el TPV).
  pinLookup String @map("pin_lookup")

  /// residencia-6 (D-68) · **CUÁNTAS CIFRAS TIENE.** 4 para alcance por
  /// zona, 6 para quien tiene algún rol de alcance total.
  ///
  /// Es lo ÚNICO que se guarda del largo, y es lo que permite saber que
  /// un PIN «se quedó corto» cuando a su dueña le dan un rol que lo ve
  /// todo — sin poder leer el PIN, que es el punto.
  ///
  /// **No es un dato que acerque a nadie al PIN**: quien tiene la base ya
  /// ve en claro los roles de cada persona, y la regla rol → largo está
  /// escrita en `packages/residencia-plan/src/pin-por-alcance.ts`, a la
  /// vista. Lo que NO hay —y es la mitad de D-68— es nada derivado de los
  /// cuatro PRIMEROS dígitos de un PIN de seis: con una huella de prefijo,
  /// el ataque bajaría a 10 000 + 100 combinaciones.
  ///
  /// Las filas de antes de este bloque se quedan en 4, que es con lo que
  /// se pusieron.
  pinLength Int @default(4) @map("pin_length")

  setAt       DateTime @default(now()) @map("set_at") @db.Timestamptz()
  /// Quién se lo puso. `SetNull`: dar de baja a la dirección no borra el
  /// hecho de que lo puso.
  setByUserId String?  @map("set_by_user_id") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  /// `Cascade` al usuario y al tenant: es una CREDENCIAL, no evidencia. Lo
  /// que no se borra es lo que esa persona firmó, y eso lo impide
  /// `care_records_recorded_by_user_id_fkey`.
  user   User   @relation("CarePinUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setBy  User?  @relation("CarePinSetBy", fields: [setByUserId], references: [id], onDelete: SetNull)

  /// «Un PIN, una persona» DENTRO del centro. Es lo que hace que teclear
  /// cuatro cifras identifique a alguien.
  @@unique([tenantId, pinLookup])
  @@index([tenantId])
  @@map("care_pins")
}

// ══ residencia-4 · gravedad, incidencias y el aviso que sí llega ══════
//
// Lo que este bloque construye es la CONSECUENCIA de lo que residencia-3
// dejó apuntado: una constante que cruza un umbral declara una incidencia
// sola, le pone nivel y hace sonar un móvil. Y un libro —uno solo, con el
// sujeto como atributo (D-35)— donde eso queda con su cierre, sus
// acciones y lo que se le dijo a la familia.
//
// ── Las seis familias y en qué orden se leen ─────────────────────────
//
//   1. `SeverityRule`               — LA PLANTILLA (D-65). Dato del
//      producto, versionado. Un centro no la toca.
//   2. `ResidentThresholdOverride`  — la excepción por residente (D-22),
//      + `ResidentThresholdRule`: lo único que puede cambiar un umbral, y
//      sólo un `MEDICO`, firmado y con vigencia.
//   3. `Incident` + `IncidentLink`  — el libro único (D-35, D-38).
//   4. `IncidentAction`             — qué se hizo. Append-only.
//   5. `FamilyCommunication`        — comunicado / no comunicado (D-32 a
//      D-34). Dimensión aparte del nivel.
//   6. `GuardAlert` + `GuardShiftSession` + `CenterGuardSetting` — el
//      aviso (D-19, D-66): a quién suena, quién lleva el móvil y en
//      cuántos minutos escala.
//
// ── LO QUE VA CIFRADO Y LO QUE NO (D-63) ─────────────────────────────
//
// Nacen cifrados: la DESCRIPCIÓN de la incidencia, el TEXTO de cada
// acción, el CONTENIDO de la comunicación a familia (y la respuesta) y el
// MOTIVO de la excepción de umbral. Cinco columnas lógicas más; son
// veintidós en la casa.
//
// Y en claro, DECLARADO: sujeto, tipo, origen, nivel, estado, instantes,
// residente, firmantes, canal y acuses. **No es dejadez: es lo que
// sostiene el producto.** La lista de abiertas, el escalado a los cinco
// minutos y los indicadores de AENOR son consultas SQL sobre esas
// columnas, y cifrarlas obligaría a descifrar el libro entero para pintar
// «qué hay abierto hoy». La consecuencia, dicha como en residencia-1b §2:
// **un `SELECT` sigue diciendo que a doña Carmen se le abrió una
// incidencia de tipo `FIEBRE` el martes**. Lo que no dice es a cuánto
// tenía la fiebre, qué se hizo ni qué se le contó a su hija.

/// residencia-4 · las dos mitades de la plantilla del §3. Ver
/// `SeverityRule`.
enum SeverityRuleKind {
  /// Gradúa un NÚMERO: «temperatura ≥ 38 → N2».
  THRESHOLD
  /// Gradúa algo que PASÓ: «caída con golpe → N3».
  EVENT
}

/// residencia-4 (D-65, D-21) · **LA PLANTILLA DE GRAVEDAD, COMO DATO.**
///
/// La tabla del §3 de `00-decisiones.md`, fila por fila. Se siembra desde
/// `residencia/catalogo/plantilla-de-gravedad.ts` al arrancar la API,
/// igual que el catálogo de controles y por las mismas razones (D-11):
/// una versión nueva es una fila, no un desarrollo.
///
/// ── GLOBAL, VERSIONADA Y SIN `tenant_id` ─────────────────────────────
///
/// No hay columna de tenant. No es un descuido: es D-21 escrito en el
/// esquema. Los umbrales clínicos son estándar médico y **no se
/// configuran por centro**; lo único que los cambia es una excepción por
/// residente con prescripción médica (`ResidentThresholdOverride`). El
/// `scope` existe y el CHECK `severity_rules_solo_estandar` lo clava en
/// `STANDARD`: la columna está para que la frontera se lea en la tabla y
/// para que el día que algo justifique una regla de centro, lo que haya
/// que discutir sea un CHECK y no un modelo entero.
///
/// ── LA VERSIÓN ES DE LA PLANTILLA ENTERA, NO DE LA FILA ──────────────
///
/// Todas las filas de una publicación comparten `version` y `validFrom`.
/// «¿Qué decía la plantilla el 14 de marzo?» tiene que contestarse con un
/// número, y con versiones por fila la respuesta sería una lista de
/// diecisiete. Cada incidencia guarda `templateVersion`, y con eso una
/// auditoría reconstruye por qué aquel 38,2 fue N2.
///
/// Publicar la versión N+1 inserta sus filas y pone `supersededAt` a las
/// de la N. **Las viejas no se editan ni se borran**, igual que una
/// versión de `ControlType`.
model SeverityRule {
  id String @id @default(uuid()) @db.Uuid

  /// Siempre `STANDARD`. Ver la cabecera.
  scope   ControlScope     @default(STANDARD)
  version Int
  kind    SeverityRuleKind

  /// ── Sólo `THRESHOLD` ──────────────────────────────────────────────
  ///
  /// El control cuya medida se compara (`TEMPERATURA`, `GLUCEMIA`). Es el
  /// CÓDIGO y no el id de una versión de `ControlType`: la plantilla
  /// gradúa la temperatura, no «la versión 1 de la temperatura», y atarla
  /// a una versión obligaría a republicarla cada vez que el catálogo
  /// cambie un texto. Mismo criterio que `CenterControlSetting`.
  controlCode String?             @map("control_code")
  comparator  SeverityComparator?
  /// El umbral. `Decimal(10,2)` como `inputMin`/`refMin`: 37,5 tiene que
  /// ser 37,5 y no 37,499999, porque la diferencia entre 37,49 y 37,5 es
  /// la diferencia entre no avisar y avisar.
  value       Decimal?            @db.Decimal(10, 2)

  /// ── Sólo `EVENT` ──────────────────────────────────────────────────
  ///
  /// Qué pasó (`CAIDA`, `VOMITO`, `AVERIA`) y el matiz que la pantalla
  /// pregunta con UNA pregunta (`CON_GOLPE`, `SIN_RIESGO`). `qualifier`
  /// NULL = la regla base del evento, la que vale cuando no se pregunta
  /// nada o cuando la respuesta no se conoce (D-13: declarar sin matizar
  /// sigue siendo un registro completo).
  eventType String? @map("event_type")
  qualifier String?

  severity SeverityLevel

  /// El tipo de incidencia que abre. **Es la clave de la idempotencia**:
  /// tres tomas de fiebre en un turno se adjuntan a la incidencia
  /// `FIEBRE` abierta del residente en vez de abrir tres (alcance §5).
  /// Por eso `TEMPERATURA` y `FIEBRE` son dos cosas: el control es lo que
  /// se mide, el tipo es lo que pasa.
  incidentType String @map("incident_type")

  /// Para PINTAR la plantilla en la pantalla de solo lectura del admin.
  /// **No para evaluarla**: `gravedadDe` mira todas las que casan y se
  /// queda con la más grave, precisamente para que el orden de estas
  /// filas no pueda cambiar un nivel.
  sortOrder Int @default(0) @map("sort_order")

  validFrom    DateTime  @map("valid_from") @db.Timestamptz()
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([scope, version])
  /// «Las reglas vigentes de este control», que es lo que la derivación
  /// pregunta por cada medida que entra.
  @@index([controlCode, supersededAt])
  @@index([eventType, supersededAt])
  @@map("severity_rules")
}

/// residencia-4 (D-22) · **LA EXCEPCIÓN DE UMBRAL DE UN RESIDENTE.**
///
/// Lo único que puede cambiar un umbral, y **sólo la pauta un rol
/// `MEDICO`**. Un hipertenso crónico, un paliativo o alguien con
/// hipotermia habitual tienen rangos propios: el mecanismo es genérico, el
/// valor distinto es un DATO CLÍNICO DEL RESIDENTE y no una configuración
/// local (rama de controles §5).
///
/// ── SUSTITUYE, NO SE SUMA ────────────────────────────────────────────
///
/// Mientras está vigente, las reglas de serie de ESE control **no se
/// aplican** a ese residente: las suyas son las de `rules`. Sumarlas
/// dejaría la de serie disparando por debajo de la excepción, que es
/// exactamente lo que la excepción existe para evitar. Y `rules` VACÍO es
/// legítimo y pautable: «a doña Carmen no le abráis incidencia por la
/// tensión, la tiene así desde 2019».
///
/// Caducada (`toAt` pasado), **vuelve la de serie sin que nadie haga
/// nada**. No hay job que la cierre: la vigencia se mira al derivar.
///
/// ── UNA VIGENTE POR RESIDENTE Y CONTROL, Y LO DICE EL MOTOR ──────────
///
/// No un índice parcial: un **EXCLUDE USING gist** sobre
/// `(client_id, control_code, tstzrange(from_at, to_at)) WHERE revoked_at
/// IS NULL`, el mismo mecanismo que el anti-solape de la agenda
/// (`b_koibox_4`). Con un índice parcial `WHERE revoked_at IS NULL` una
/// excepción caducada en marzo bloquearía otra en junio; con el EXCLUDE,
/// lo que no se puede es que dos se SOLAPEN — que es la regla de verdad.
///
/// ── LA FIRMA ES PERSONA + CAPACIDAD (D-31) ───────────────────────────
///
/// Y la capacidad tiene que ser un rol `MEDICO` vigente en el momento de
/// firmar. Lo comprueba la ruta (es una regla que cruza dos tablas, igual
/// que el colegiado de residencia-1) y tiene su fila en la tabla de
/// sabotajes: una auxiliar no pauta un umbral.
model ResidentThresholdOverride {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid

  /// Qué constante. CÓDIGO, no id de versión, por lo mismo que en
  /// `SeverityRule`.
  controlCode String @map("control_code")

  /// **Por qué.** Cifrado (D-63): «paliativo, febrícula basal 37,8» es
  /// un diagnóstico con todas las letras. Su CHECK de formato sólo admite
  /// `c1:…`, así que el claro NO CABE.
  ///
  /// NOT NULL: una excepción sin motivo es un umbral cambiado sin que
  /// nadie sepa por qué, y eso es justo lo que una auditoría pregunta.
  reasonCifrado String @map("reason_cifrado")

  /// La vigencia. `toAt` NULL = sin fecha de fin prevista.
  fromAt DateTime  @map("from_at") @db.Timestamptz()
  toAt   DateTime? @map("to_at") @db.Timestamptz()

  /// La firma: quién y CON QUÉ CAPACIDAD.
  signedByUserId               String   @map("signed_by_user_id") @db.Uuid
  signedByCareRoleAssignmentId String   @map("signed_by_care_role_assignment_id") @db.Uuid
  signedAt                     DateTime @default(now()) @map("signed_at") @db.Timestamptz()

  /// Retirarla antes de tiempo. No se borra: se revoca, con autor y
  /// fecha, igual que un `CareRoleAssignment`.
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client     Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  signedBy   User                    @relation("ThresholdOverrideSignedBy", fields: [signedByUserId], references: [id], onDelete: Restrict)
  signedWith CareRoleAssignment      @relation(fields: [signedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  revokedBy  User?                   @relation("ThresholdOverrideRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  rules      ResidentThresholdRule[]

  @@index([tenantId])
  @@index([clientId, controlCode])
  @@map("resident_threshold_overrides")
}

/// residencia-4 · UNA REGLA DE UNA EXCEPCIÓN. Misma forma que
/// `SeverityRule` de tipo `THRESHOLD`, y a propósito: lo que la médica
/// pauta es «para esta persona, estas bandas», no un formato distinto.
///
/// Tabla y no tres columnas (`warnMin`, `alertMax`…) por lo mismo que las
/// opciones de un control son tabla y no un JSON: el número de bandas lo
/// decide la pauta, no el esquema, y un paliativo puede llevar dos y un
/// diabético cuatro.
///
/// `Cascade` a la excepción: una regla no significa nada sin su cabecera,
/// que es donde viven el motivo, la vigencia y la firma.
model ResidentThresholdRule {
  id         String @id @default(uuid()) @db.Uuid
  overrideId String @map("override_id") @db.Uuid

  comparator   SeverityComparator
  value        Decimal            @db.Decimal(10, 2)
  severity     SeverityLevel
  /// El tipo de incidencia que abre. Normalmente el mismo que el de
  /// serie (`FIEBRE`), para que la idempotencia siga agrupando bien.
  incidentType String             @map("incident_type")

  sortOrder Int @default(0) @map("sort_order")

  override ResidentThresholdOverride @relation(fields: [overrideId], references: [id], onDelete: Cascade)

  @@index([overrideId])
  @@map("resident_threshold_rules")
}

/// residencia-4 (D-35, D-38) · **EL LIBRO ÚNICO DE INCIDENCIAS.**
///
/// Una entidad con el SUJETO como atributo, no cuatro entidades separadas
/// (rama de controles §6.3). Los campos son idénticos para una caída, una
/// queja y una avería: qué ha pasado, cuándo, quién lo vio, gravedad, a
/// quién avisar, qué se hizo, quién cierra. Lo único que cambia es el
/// sujeto — y por eso cada sujeto tiene su pantalla y su formulario, pero
/// el mismo libro por detrás.
///
/// Y de ahí sale lo que de verdad lo justifica: **los casos cruzados**. Un
/// residente se cae porque el asidero estaba suelto → incidencia + avería
/// ENLAZADAS (`IncidentLink`). Con libros separados, la relación
/// causa-efecto se pierde, que es justo lo que AENOR busca en las acciones
/// correctoras.
///
/// ── INMUTABLE, COMO `CareRecord`, CON TRES TRANSICIONES ──────────────
///
/// El trigger `incidents_inmutable` deja pasar exactamente tres cosas y
/// nada más:
///
///   1. **subir o bajar el nivel** (`severity`), que escribe su
///      `IncidentAction` de tipo `SEVERITY`;
///   2. **cerrarla** (`closedAt`, `closedBy*`, `selfClosed`, `status`);
///   3. **apuntar que ya se avisó** (`alertedAt`), que es contabilidad
///      del aviso y no contenido.
///
/// Todo lo demás —el residente, el tipo, el origen, quién la abrió, la
/// descripción— es lo que pasó, y lo que pasó no se edita. Corregir una
/// descripción es escribir una acción, que es lo mismo que corregir un
/// `CareRecord` es escribir otra fila.
///
/// ── N0 NO ABRE NADA ──────────────────────────────────────────────────
///
/// Por D-27, una avería sin riesgo (N0) es CONSTANCIA: se escribe la fila
/// con `status = CLOSED` y `closedAt` puesto en el momento, sin pedirle a
/// nadie que la cierre. No es una incidencia abierta que nadie mira — es
/// una línea del libro para el de mantenimiento.
model Incident {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  subject  IncidentSubject
  /// El residente, cuando el sujeto es `RESIDENT`. NULL en una queja de
  /// familia sin residente identificado y en una avería (CHECK
  /// `incidents_sujeto_coherente`: un `RESIDENT` exige residente).
  clientId String?         @map("client_id") @db.Uuid

  origin          IncidentOrigin
  /// El tipo, en CÓDIGO: `FIEBRE`, `CAIDA`, `AVERIA`. No es un enum (ver
  /// la cabecera de `plantilla-de-gravedad.ts`): un tipo nuevo en 2028 es
  /// una fila del fichero de datos, no una migración.
  incidentType    String         @map("incident_type")
  severity        SeverityLevel
  /// La versión de la plantilla con la que se graduó. Es el equivalente
  /// de `CareRecord.controlTypeId`: «¿por qué esto fue N2?» se contesta
  /// tres años después.
  templateVersion Int?           @map("template_version")

  /// `true` mientras esté abierta. Columna y no derivada de `closedAt`
  /// porque es lo que filtra la lista de «qué hay abierto hoy» —la
  /// métrica de éxito de dirección— y un índice parcial sobre ella es lo
  /// que la hace instantánea.
  open Boolean @default(true)

  /// **Qué ha pasado, cifrado** (D-63). Opcional: una incidencia derivada
  /// por umbral no la escribe nadie, y la evidencia es la medida.
  descriptionCifrado String? @map("description_cifrado")

  /// ── DE DÓNDE SALIÓ ────────────────────────────────────────────────
  ///
  /// La medida que la abrió, cuando el origen es `DERIVED_THRESHOLD`. Es
  /// la prueba: sin ella, «se abrió una incidencia de fiebre» no dice a
  /// cuánto estaba.
  sourceRecordId String? @map("source_record_id") @db.Uuid
  /// Y desde qué puerta y qué habitación se declaró, cuando se declaró en
  /// una. NULL en lo declarado desde el admin y en lo derivado por la
  /// pasada de ausencias, que no tiene aparato detrás.
  deviceId       String? @map("device_id") @db.Uuid
  roomId         String? @map("room_id") @db.Uuid

  /// ── CUÁNDO Y QUIÉN (D-31) ─────────────────────────────────────────
  openedAt                     DateTime @map("opened_at") @db.Timestamptz()
  openedByUserId               String   @map("opened_by_user_id") @db.Uuid
  openedByCareRoleAssignmentId String   @map("opened_by_care_role_assignment_id") @db.Uuid

  /// El turno y el día del CENTRO, calculados como en `CareRecord` y por
  /// lo mismo: el turno de noche cruza medianoche, y «las incidencias de
  /// este turno» del relevo (residencia-5) se parte en dos sin esto.
  centerShiftId String? @map("center_shift_id") @db.Uuid
  careDay       String  @map("care_day") @db.VarChar(10)

  /// ── EL CIERRE (D-27, D-28) ────────────────────────────────────────
  ///
  /// Lo cierra un rol de **categoría directiva**. N1 y N2 admiten
  /// autocierre por quien la abrió, **marcado como tal**; N3 y N4 exigen
  /// persona distinta, y si no la hay la incidencia QUEDA ABIERTA y sube
  /// al panel de dirección.
  ///
  /// Las cuatro van juntas o ninguna (CHECK `incidents_cierre_completo`),
  /// y `open` es su negación (CHECK `incidents_abierta_coherente`): una
  /// incidencia cerrada sin saber quién la cerró es media evidencia.
  closedAt                     DateTime? @map("closed_at") @db.Timestamptz()
  closedByUserId               String?   @map("closed_by_user_id") @db.Uuid
  closedByCareRoleAssignmentId String?   @map("closed_by_care_role_assignment_id") @db.Uuid
  /// `true` cuando la cerró la misma persona que la abrió. **Se marca, no
  /// se prohíbe** en N1 y N2 (D-28): en el turno de noche hay una
  /// auxiliar y nadie más, y exigir una segunda persona dejaría el libro
  /// lleno de abiertas que nadie puede cerrar.
  selfClosed                   Boolean   @default(false) @map("self_closed")

  /// Cuándo salió el primer aviso. NULL = no tocaba avisar (N0, N1) o
  /// todavía no ha salido. Es contabilidad del aviso y por eso el trigger
  /// de inmutabilidad la deja cambiar.
  alertedAt DateTime? @map("alerted_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  client       Client?             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sourceRecord CareRecord?         @relation("IncidentSourceRecord", fields: [sourceRecordId], references: [id], onDelete: Restrict)
  device       Device?             @relation("IncidentDevice", fields: [deviceId], references: [id], onDelete: Restrict)
  room         Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  openedBy     User                @relation("IncidentOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  openedWith   CareRoleAssignment  @relation("IncidentOpenedWith", fields: [openedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  closedBy     User?               @relation("IncidentClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  closedWith   CareRoleAssignment? @relation("IncidentClosedWith", fields: [closedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  centerShift  CenterShift?        @relation(fields: [centerShiftId], references: [id], onDelete: Restrict)

  actions              IncidentAction[]
  familyCommunications FamilyCommunication[]
  alerts               GuardAlert[]
  /// Los enlaces, en los dos sentidos. Ver `IncidentLink`: el par se
  /// guarda UNA vez y las dos relaciones son la misma fila leída desde
  /// cada lado.
  linksFrom            IncidentLink[]         @relation("IncidentLinkFrom")
  linksTo              IncidentLink[]         @relation("IncidentLinkTo")
  /// residencia-5 · las veces que esta incidencia se añadió a un parte ya
  /// congelado.
  lateAdditions        HandoverLateAddition[]
  /// calidad-1 (D-38, D-73) · **EN QUÉ NO CONFORMIDAD ACABÓ.** El enlace
  /// de «elevar a NC», leído desde este lado: es la MISMA fila que
  /// `NonConformity.sourceIncidentId`, como los `incident_links` del
  /// libro. Una lista y no una sola porque una avería que se repite puede
  /// estar detrás de dos hallazgos de auditorías distintas.
  nonConformities      NonConformity[]        @relation("NonConformityFromIncident")

  @@index([tenantId])
  /// **«Qué hay abierto hoy»**, que es literalmente la métrica de éxito
  /// de dirección (rama §6.3). El índice parcial `WHERE open` vive en la
  /// migración; éste sostiene el filtro por sujeto y nivel.
  @@index([tenantId, open, severity])
  @@index([tenantId, subject, openedAt])
  @@index([tenantId, careDay])
  /// Y la IDEMPOTENCIA de la derivación: «¿tiene este residente una
  /// incidencia abierta de este tipo?» se pregunta por cada medida que
  /// entra, y tiene que costar un índice.
  @@index([clientId, incidentType, open])
  @@map("incidents")
}

/// residencia-4 (D-35) · **DOS INCIDENCIAS ENLAZADAS.**
///
/// La caída de la 112 y el asidero suelto de la 112. Es el caso que
/// justifica el libro único: con libros separados la relación causa-efecto
/// se pierde, y es justo lo que AENOR busca en las acciones correctoras.
///
/// ── EL PAR SE GUARDA UNA VEZ, Y ORDENADO ─────────────────────────────
///
/// Una fila por pareja, con `aId < bId` como texto (CHECK
/// `incident_links_ordenado`) y único por `(aId, bId)`. La alternativa
/// —dos filas simétricas— deja la puerta abierta a que una se borre y la
/// otra no, y entonces la caída enlaza con la avería y la avería no enlaza
/// con nada.
///
/// Un enlace SÍ se puede borrar, al revés que todo lo demás de este
/// bloque: enlazar mal dos incidencias es un error de dedo del admin y
/// deshacerlo no borra ninguna evidencia — las dos incidencias siguen
/// enteras.
model IncidentLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  aId String @map("a_id") @db.Uuid
  bId String @map("b_id") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  a      Incident @relation("IncidentLinkFrom", fields: [aId], references: [id], onDelete: Cascade)
  b      Incident @relation("IncidentLinkTo", fields: [bId], references: [id], onDelete: Cascade)

  @@unique([aId, bId])
  @@index([tenantId])
  @@index([bId])
  @@map("incident_links")
}

/// residencia-4 · **QUÉ SE HIZO.** Append-only, como las anotaciones
/// clínicas (`ClinicalAddendum`) y por la misma razón: el histórico de una
/// incidencia es la evidencia de la acción correctora, y una evidencia que
/// se edita no es evidencia.
///
/// El trigger `incident_actions_append_only` no deja ni `UPDATE` ni
/// `DELETE`. Ni una escapatoria: no hay «anular» aquí, porque una acción
/// mal escrita se corrige escribiendo otra que lo diga — que es lo mismo
/// que hace un `CareRecord`.
///
/// ── Y ES DONDE SE ADJUNTA LA EVIDENCIA ───────────────────────────────
///
/// Cuando una segunda toma de fiebre llega y el residente ya tiene una
/// incidencia `FIEBRE` abierta, no se abre otra: se escribe una acción de
/// tipo `EVIDENCE` apuntando a ese `CareRecord` (alcance §5). Tres tomas
/// en un turno son UNA incidencia con tres líneas, no tres incidencias.
model IncidentAction {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  incidentId String @map("incident_id") @db.Uuid

  kind IncidentActionKind

  /// El texto, cifrado (D-63). Opcional: una acción de tipo `EVIDENCE` o
  /// `SEVERITY` no necesita que nadie escriba nada — lo dicen sus
  /// columnas.
  textCifrado String? @map("text_cifrado")

  /// Sólo `SEVERITY`: de qué nivel a qué nivel. Las dos juntas o ninguna
  /// (CHECK `incident_actions_nivel_completo`).
  severityFrom SeverityLevel? @map("severity_from")
  severityTo   SeverityLevel? @map("severity_to")

  /// Sólo `EVIDENCE`: qué medida se adjuntó.
  careRecordId String? @map("care_record_id") @db.Uuid

  /// Sólo `CALL` (D-33) · **si se llamó o no al servicio sanitario de
  /// guardia**. El sistema no llama a nadie: muestra a quién llamar y la
  /// llamada la hace la persona. Lo que se apunta aquí es qué decidió.
  called Boolean? @map("called")

  at                     DateTime @default(now()) @db.Timestamptz()
  byUserId               String   @map("by_user_id") @db.Uuid
  byCareRoleAssignmentId String   @map("by_care_role_assignment_id") @db.Uuid

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident   Incident           @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  careRecord CareRecord?        @relation(fields: [careRecordId], references: [id], onDelete: Restrict)
  by         User               @relation("IncidentActionBy", fields: [byUserId], references: [id], onDelete: Restrict)
  byWith     CareRoleAssignment @relation(fields: [byCareRoleAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([incidentId, at])
  @@map("incident_actions")
}

/// residencia-4 (D-32 a D-34) · **LO QUE SE LE DIJO A LA FAMILIA, O POR
/// QUÉ NO.**
///
/// Dimensión APARTE del nivel (rama de controles §9): una caída sin
/// consecuencias es N1 y la familia quiere saberlo el mismo día; un
/// hallazgo N3 puede convenir no comunicarlo hasta tener diagnóstico. Por
/// eso no es una columna de `Incident` con una fecha: es una tabla con las
/// dos constancias.
///
/// ── LAS DOS SON CONSTANCIA ───────────────────────────────────────────
///
/// `COMUNICADO` (quién, cuándo, por qué vía, qué se dijo, qué contestaron)
/// y `NO_COMUNICADO` (quién lo decidió y por qué). Misma lógica de
/// denominador que el «como siempre» (D-15): sin la segunda no se
/// distingue «se decidió no llamar» de «nadie se acordó».
///
/// Y **una incidencia de residente no se cierra sin una de las dos**. Lo
/// comprueba la ruta de cierre, tiene su fila en la tabla de sabotajes, y
/// es lo que cierra la observación 10 de AENOR.
///
/// ── EL SISTEMA NO ENVÍA NADA (D-33) ──────────────────────────────────
///
/// Esta tabla registra una conversación que tuvo una persona. No hay
/// correo, ni SMS, ni portal: el portal de familias es `familias-1` y el
/// principio general es que **el sistema no habla con el exterior por su
/// cuenta**.
model FamilyCommunication {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  incidentId String @map("incident_id") @db.Uuid

  kind    FamilyCommunicationKind
  /// Sólo en `COMUNICADO`: por qué vía (CHECK
  /// `family_communications_via_coherente`). Un «no comunicado» con vía
  /// es una contradicción.
  channel FamilyCommunicationChannel?

  /// A quién. Texto y no una FK: el familiar responsable vive en
  /// `resident_profiles` como tres columnas (nombre, teléfono,
  /// parentesco) y puede no ser con quien se habló — se llamó a la hija y
  /// contestó el yerno. Se guarda lo que pasó.
  ///
  /// En claro, como el resto de la identidad (residencia-1b §2): es a
  /// quién se llamó, no qué se le dijo.
  contactName     String? @map("contact_name")
  contactRelation String? @map("contact_relation")

  /// **Qué se dijo y qué contestaron, cifrados** (D-63). En un
  /// `NO_COMUNICADO`, `contentCifrado` es el MOTIVO. NOT NULL: los dos
  /// casos exigen texto, porque una constancia sin contenido no es
  /// constancia.
  contentCifrado  String  @map("content_cifrado")
  responseCifrado String? @map("response_cifrado")

  at                     DateTime @map("at") @db.Timestamptz()
  byUserId               String   @map("by_user_id") @db.Uuid
  byCareRoleAssignmentId String   @map("by_care_role_assignment_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident Incident           @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  by       User               @relation("FamilyCommunicationBy", fields: [byUserId], references: [id], onDelete: Restrict)
  byWith   CareRoleAssignment @relation(fields: [byCareRoleAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([incidentId, at])
  @@map("family_communications")
}

/// residencia-4 (D-19, D-66) · **UN AVISO QUE TIENE QUE SONAR.**
///
/// Una fila por (incidencia, canal). N2 abre una de `ENFERMERIA`; N3 y N4
/// abren las dos a la vez; y si la de enfermería se agota sin acuse, se
/// abre la de `RESPONSABLE` **sin cancelar la primera** — el aviso no se
/// mueve de sitio, se suma uno.
///
/// ── «SIN RED NO SE FINGE» ────────────────────────────────────────────
///
/// Es el peor fallo posible de este bloque y por eso tiene una columna:
/// `queuedAt` es cuándo lo apuntó la TABLET y `createdAt` cuándo llegó al
/// servidor, exactamente igual que los dos instantes de `CareRecord`. Un
/// aviso que sale con dos horas de retraso **suena igual, con su hora
/// original y su retraso a la vista**, y la puerta que lo originó nunca
/// dice «avisado» hasta que el servidor lo confirma.
///
/// ── EL ESCALADO NO LO DECIDE UN `setTimeout` ─────────────────────────
///
/// `escalateAt` es una columna con su índice. La pasada que escala
/// pregunta «¿qué avisos pendientes tienen `escalate_at` pasado?» — un
/// temporizador en memoria se pierde al reiniciar la API, y un aviso que
/// no escala porque alguien desplegó es exactamente lo que este bloque
/// existe para evitar.
///
/// ── EL ACUSE ES UNA FIRMA ────────────────────────────────────────────
///
/// «Voy» se pulsa con PIN: persona + capacidad + hora (D-31). No es un
/// botón de «leído»: es quien se hace cargo, y es lo que la puerta pinta
/// («Aviso recibido por Lucía · 10:43»).
model GuardAlert {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  incidentId String @map("incident_id") @db.Uuid

  channel  GuardChannel
  severity SeverityLevel
  state    GuardAlertState @default(PENDING)

  /// Cuándo lo apuntó la tablet y cuándo llegó aquí. Ver la cabecera.
  queuedAt  DateTime @map("queued_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  /// Cuándo hay que escalar si nadie acusa. NULL = este aviso no escala
  /// (el de `RESPONSABLE`, que es el último eslabón, y los de N3/N4 que
  /// ya salieron a los dos canales).
  escalateAt      DateTime? @map("escalate_at") @db.Timestamptz()
  /// El aviso que lo originó al escalar. Deja la cadena leída de un
  /// vistazo: «éste salió porque el de enfermería no se acusó».
  escalatedFromId String?   @map("escalated_from_id") @db.Uuid

  /// Cuándo un móvil de ese canal lo tuvo delante. No es el acuse: es que
  /// llegó. Sirve para contestar «¿sonó?» cuando nadie lo acusó.
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()

  /// ── EL ACUSE ──────────────────────────────────────────────────────
  ///
  /// Las cuatro juntas o ninguna (CHECK `guard_alerts_acuse_completo`).
  ackedAt                     DateTime? @map("acked_at") @db.Timestamptz()
  ackedByUserId               String?   @map("acked_by_user_id") @db.Uuid
  ackedByCareRoleAssignmentId String?   @map("acked_by_care_role_assignment_id") @db.Uuid
  ackedByDeviceId             String?   @map("acked_by_device_id") @db.Uuid

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  incident      Incident            @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  escalatedFrom GuardAlert?         @relation("GuardAlertEscalation", fields: [escalatedFromId], references: [id], onDelete: Restrict)
  escalatedTo   GuardAlert[]        @relation("GuardAlertEscalation")
  ackedBy       User?               @relation("GuardAlertAckedBy", fields: [ackedByUserId], references: [id], onDelete: Restrict)
  ackedWith     CareRoleAssignment? @relation("GuardAlertAckedWith", fields: [ackedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  ackedByDevice Device?             @relation("GuardAlertAckedByDevice", fields: [ackedByDeviceId], references: [id], onDelete: Restrict)

  /// residencia-5 · las veces que este aviso se añadió a un parte ya
  /// congelado porque **no salió a tiempo**. Es una de las seis cosas que
  /// el parte tiene que contar (decisión de producto 1).
  lateAdditions HandoverLateAddition[]

  /// Un aviso por (incidencia, canal). Reenviar el mismo lote o derivar
  /// dos veces la misma medida **no hace sonar dos veces** — es la
  /// idempotencia del aviso, y vive en el motor y no en un `if`.
  @@unique([incidentId, channel])
  @@index([tenantId])
  /// La pasada del escalado: «pendientes con la hora pasada». El índice
  /// parcial de verdad (`WHERE state IN ('PENDING','DELIVERED')`) vive en
  /// la migración.
  @@index([escalateAt])
  @@index([tenantId, channel, state])
  @@map("guard_alerts")
}

/// residencia-4 (D-66) · **QUIÉN LLEVA EL MÓVIL ESTE TURNO.**
///
/// «Al empezar el turno, quien coge el móvil entra con su PIN». Eso hace
/// tres cosas de una vez, y por eso no hace falta cuadrante:
///
///   1. deja la línea en el registro de accesos (es una identificación);
///   2. le dice al sistema **si hay enfermera de guardia en este turno**,
///      que es lo que decide si un N2 escala al momento o a los 5 min;
///   3. pone el nombre en la pantalla en reposo del móvil («De guardia:
///      Lucía · enfermería · turno de tarde»), que es lo que hace que
///      quien lo coja sepa que está cogido.
///
/// `endedAt` NULL = **de guardia ahora**. Una sola viva por dispositivo
/// (índice parcial `guard_shift_sessions_una_viva_key`): coger el móvil
/// cierra la guardia anterior de ESE móvil, en la misma transacción. No
/// una por canal — un centro puede tener dos enfermeras de guardia con
/// dos móviles, y las dos están de guardia.
model GuardShiftSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  deviceId String @map("device_id") @db.Uuid

  /// Copiado del dispositivo al empezar. Redundante a propósito: el canal
  /// de un móvil se puede cambiar en el admin, y «quién estaba de guardia
  /// en enfermería el martes» tiene que seguir contestándose.
  channel GuardChannel

  userId               String @map("user_id") @db.Uuid
  careRoleAssignmentId String @map("care_role_assignment_id") @db.Uuid

  startedAt     DateTime  @map("started_at") @db.Timestamptz()
  endedAt       DateTime? @map("ended_at") @db.Timestamptz()
  /// Quién la cerró. NULL cuando la cerró el relevo (otra persona cogió
  /// el móvil) o la cerró la propia persona.
  endedByUserId String?   @map("ended_by_user_id") @db.Uuid

  /// El turno y el día del centro en que empezó, para el histórico y para
  /// el relevo de residencia-5.
  centerShiftId String? @map("center_shift_id") @db.Uuid
  careDay       String  @map("care_day") @db.VarChar(10)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device      Device             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  user        User               @relation("GuardShiftSessionUser", fields: [userId], references: [id], onDelete: Restrict)
  careRole    CareRoleAssignment @relation(fields: [careRoleAssignmentId], references: [id], onDelete: Restrict)
  endedBy     User?              @relation("GuardShiftSessionEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)
  centerShift CenterShift?       @relation(fields: [centerShiftId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  /// «¿Hay alguien de guardia en este canal ahora?», que es la pregunta
  /// que decide el escalado inmediato.
  @@index([tenantId, channel, endedAt])
  @@index([deviceId, startedAt])
  @@map("guard_shift_sessions")
}

/// residencia-4 (D-66, rama de controles §10) · **LO QUE EL CENTRO
/// CONFIGURA DEL AVISO.**
///
/// La frontera, otra vez: el MOTOR de gravedad y de escalado es del
/// producto y no se toca; los **destinatarios de cada nivel** y los
/// minutos de espera son del centro. Y el servicio sanitario de guardia
/// —a quién se recomienda llamar— es suyo por definición: el centro de
/// salud de Buenaventura no es el de nadie más.
///
/// Una fila por tenant, con los valores de serie si no existe. No se
/// siembra al encender el módulo a propósito: «no configurado» y
/// «configurado con los valores de serie» son lo mismo para el motor, y
/// sembrar una fila habría hecho que la pantalla no pudiera distinguir
/// «lo dejaron como estaba» de «lo revisaron y lo dejaron igual» —que
/// tampoco importa— a cambio de una fila por centro que mantener.
model CenterGuardSetting {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Cuántos minutos se espera un acuse antes de escalar al canal
  /// siguiente. 5 por defecto (D-66). CHECK 1..60: menos de un minuto no
  /// da tiempo a sacar el móvil del bolsillo, y más de una hora no es un
  /// escalado.
  escalationMinutes Int @default(5) @map("escalation_minutes")

  /// A qué canales suena cada nivel. Arrays y no columnas booleanas
  /// porque la pregunta es «¿quiénes?» y la respuesta es una lista.
  /// Vacío = **ese nivel no suena**, que es una decisión legítima del
  /// centro y se pinta como tal; NULL no existe aquí.
  ///
  /// N0 y N1 no tienen columna: N0 no abre nada (D-27) y N1 va al relevo
  /// (D-19, la velocidad lenta). Dárselas al centro sería dejarle
  /// convertir el móvil de guardia en un aparato que suena ochenta veces
  /// por turno.
  levelN2Channels GuardChannel[] @default([ENFERMERIA]) @map("level_n2_channels")
  levelN3Channels GuardChannel[] @default([ENFERMERIA, RESPONSABLE]) @map("level_n3_channels")
  levelN4Channels GuardChannel[] @default([ENFERMERIA, RESPONSABLE]) @map("level_n4_channels")

  /// ── EL SERVICIO SANITARIO DE GUARDIA, COMO RECOMENDACIÓN (D-33) ───
  ///
  /// En N3 y N4 el móvil muestra «Recomendado: llamar a …» con un botón
  /// que abre el marcador. **La llamada la hace la persona**: el sistema
  /// no llama ni escribe a nadie de fuera por su cuenta. Si se llamó o no
  /// se apunta como `IncidentAction` de tipo `CALL`.
  ///
  /// Las dos juntas o ninguna (CHECK `center_guard_settings_servicio`):
  /// un nombre sin teléfono es un botón que no marca.
  healthServiceName  String? @map("health_service_name")
  healthServicePhone String? @map("health_service_phone")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("center_guard_settings")
}

// ══ residencia-5 · EL PARTE DE RELEVO (D-18, D-19, D-58, D-67) ═════════
//
// Hoy el cambio de turno se hace de palabra y con una hoja en la sala. Lo
// que estas cuatro tablas guardan es **que la información pasó de un
// turno a otro**, que es una evidencia que en papel no existe.
//
// ── LA DECISIÓN DE FONDO: SÓLO EXISTE LA FILA CONGELADA ─────────────
//
// `handovers` no tiene estado «en vivo». Mientras el turno está en curso
// el parte **se calcula** (`residencia/relevo.ts`, la misma función) y no
// hay fila; la fila nace al cerrar el turno, con `frozen_at` NOT NULL, y
// a partir de ahí no se edita ni se borra (trigger `handovers_inmutable`).
//
// La alternativa era una fila que naciera al abrirse el turno y se fuera
// rellenando. Se descartó por una razón concre: lo que esta tabla es es
// **la evidencia de lo que se supo**, y una fila que se edita durante
// ocho horas no se puede distinguir de una que alguien editó después. Con
// el cálculo en vivo, lo que se ve antes de congelar es una consulta —que
// no miente porque no guarda nada— y lo que queda escrito es el parte.
//
// Lo que llega tarde no reescribe lo congelado: va a
// `handover_late_additions`, a la vista y con su hora (decisión 2).

/// residencia-5 (D-18, D-58) · **EL PARTE DE UN TURNO, CONGELADO.**
///
/// Uno por centro y turno (D-58). Lo genera el sistema con lo que ya está
/// registrado en las puertas: **nadie lo escribe**. Un turno sin nada que
/// contar dice «Turno sin novedades» y se confirma igual, porque el
/// denominador cuenta tanto como lo que pasa — la misma lógica del «como
/// siempre» (D-16).
///
/// ── QUÉ VA CIFRADO Y QUÉ EN CLARO (D-63) ─────────────────────────────
///
/// El contenido lleva salud con todas las letras —qué le pasó a quién, el
/// texto de «algo no va bien», las constantes fuera de rango— y va en
/// `content_cifrado`, una columna y no un fichero: ver la decisión en la
/// cabecera de la migración.
///
/// **En claro, declarado**: el centro, el turno, el `care_day`, el
/// instante de congelado, los recuentos por zona (`handover_zones`) y las
/// confirmaciones con su firma y sus zonas. Es lo que sostiene el panel
/// («¿está confirmado el relevo de esta mañana?») sin descifrar nada, y
/// es lo mismo que una hoja de firmas en la pared dice ya hoy.
model Handover {
  /// **Generado en la aplicación**, no por la base: el AAD de
  /// `content_cifrado` ata el valor a `tenant|handovers|content|<id>`, y
  /// el id de una fila que todavía no existe no se puede leer (ver la
  /// cabecera de `clinica/cripto-campos.ts`). Misma razón exacta por la
  /// que `care_records.id` no tiene `DEFAULT`, y un `DEFAULT` aquí sería
  /// un valor que nadie usa y que taparía un olvido.
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// El turno del que es el parte. `Restrict`: un turno con parte
  /// congelado es vocabulario del histórico firmado, igual que en
  /// `CareRecord`.
  centerShiftId String @map("center_shift_id") @db.Uuid
  /// El día del CENTRO, «YYYY-MM-DD», calculado con `diaDelTurno` y no
  /// con la fecha del reloj: la noche del lunes acaba a las 08:00 del
  /// martes y su parte es **del lunes**.
  careDay       String @map("care_day") @db.VarChar(10)

  /// Cuándo se calculó y cuándo se congeló. Los dos NOT NULL: una fila de
  /// esta tabla **es** un parte congelado (ver la cabecera del bloque).
  /// Se separan porque la tarea programada puede correr unos segundos
  /// después del final del turno y «a las 15:00:04» es la verdad.
  generatedAt DateTime @map("generated_at") @db.Timestamptz()
  frozenAt    DateTime @map("frozen_at") @db.Timestamptz()

  /// **EL CONTENIDO, CIFRADO.** El JSON entero del parte: por planta y
  /// residente, las incidencias abiertas y las nuevas, «algo no va bien»,
  /// las constantes fuera de rango, lo que no se hizo, los cambios de
  /// plan, las excepciones nuevas, los registros sin turno y los avisos
  /// que no salieron a tiempo. Su CHECK de formato sólo admite `c1:…`: el
  /// claro NO CABE.
  contentCifrado String @map("content_cifrado")

  /// Cuántas líneas lleva en total y si es un parte **sin novedades**.
  /// Las dos en claro y a propósito: son lo que la tablet en reposo pinta
  /// («Relevo de la mañana · 3 por confirmar») y lo que el panel cuenta,
  /// y ninguna de las dos dice nada de nadie.
  lineas       Int     @default(0)
  sinNovedades Boolean @default(false) @map("sin_novedades")

  /// Cuándo quedó **confirmado**: cuando cada zona con contenido tiene al
  /// menos una confirmación de alguien del turno entrante que la cubre, o
  /// una de alcance total (decisión de producto 3). Columna y no derivada
  /// porque es lo que el panel filtra («los no confirmados de la
  /// semana») y porque el instante en que se completó es la evidencia.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  centerShift CenterShift @relation(fields: [centerShiftId], references: [id], onDelete: Restrict)

  zones         HandoverZone[]
  acks          HandoverAck[]
  lateAdditions HandoverLateAddition[]

  /// Uno por centro, turno y día (D-58). Es lo que hace idempotente la
  /// tarea programada: correrla dos veces no congela dos partes.
  @@unique([tenantId, centerShiftId, careDay])
  @@index([tenantId])
  /// «El del último cambio de turno» y «los no confirmados de la semana»,
  /// que son las dos preguntas del panel.
  @@index([tenantId, careDay])
  @@map("handovers")
}

/// residencia-5 (decisión de producto 3) · **UNA ZONA CON CONTENIDO.**
///
/// Una fila por planta que tiene algo que contar en este parte, con
/// cuántas líneas. `floor_id` NULL es **la zona del centro**: lo que no
/// es de ninguna planta (una avería del office, una queja sin residente),
/// y sólo la cubre una confirmación de alcance total.
///
/// ── POR QUÉ ES UNA TABLA Y NO UN JSON ───────────────────────────────
///
/// Porque «¿está confirmado este parte?» es una consulta que compara
/// zonas con contenido contra zonas confirmadas, y el panel la hace para
/// toda una semana de partes. Con el recuento dentro del JSON cifrado
/// habría que descifrar los veintiún partes de la semana para pintar una
/// cifra — y de paso dejar un acceso a datos de salud por cada carga del
/// panel.
///
/// **Sólo se escriben las zonas CON contenido.** Una planta sin nada que
/// contar no tiene fila, y por tanto no necesita confirmación: exigirla
/// sería dejar un parte «sin confirmar» por una planta vacía.
model HandoverZone {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  handoverId String  @map("handover_id") @db.Uuid
  /// La planta, o NULL = «del centro». `Restrict`: una planta nombrada en
  /// un parte congelado no se borra.
  floorId    String? @map("floor_id") @db.Uuid

  lineas Int @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Restrict)
  floor    Floor?   @relation(fields: [floorId], references: [id], onDelete: Restrict)

  /// La unicidad por zona necesita DOS índices parciales en la migración,
  /// que Prisma no sabe declarar: en Postgres los NULL son distintos
  /// entre sí, así que un único `@@unique([handoverId, floorId])` dejaría
  /// entrar dos filas «del centro» en el mismo parte. **Quinta vez** que
  /// esta lección se paga en este repo (`ticket_allergies_mesa_key`,
  /// `care_zone_assignments_one_live_centro_key`,
  /// `control_types_una_vigente_*`, `care_records_una_por_ocurrencia_key`).
  @@index([tenantId])
  @@index([handoverId])
  @@index([floorId])
  @@map("handover_zones")
}

/// residencia-5 (D-19, D-67) · **«LEÍDO Y RECIBIDO».**
///
/// Quien recoge el turno confirma el parte con su PIN en la tablet de la
/// sala. Cierra el bucle de «la información debe fluir entre roles»: no
/// *debería* fluir — **queda demostrado que fluyó** (rama de controles
/// §7).
///
/// Firma **persona + capacidad + hora** (D-31): «lo recibió Ana Isabel»
/// no es evidencia; «lo recibió Ana Isabel, como auxiliar, a las 15:04 y
/// abarcaba la primera planta» sí lo es. De ahí `careRoleAssignmentId` y
/// `HandoverAckZone`.
///
/// ── APPEND-ONLY, y una sola por persona y parte ─────────────────────
///
/// El trigger `handover_acks_append_only` no deja `UPDATE` ni `DELETE`:
/// una confirmación que se puede borrar no demuestra nada. Y el índice
/// único `(handover_id, user_id)` es lo que hace que **confirmar dos
/// veces no duplique** — la ruta lo detecta antes y contesta la que ya
/// había, pero quien lo garantiza es el motor.
model HandoverAck {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  handoverId String @map("handover_id") @db.Uuid

  /// Quién, y **con qué capacidad** (D-31).
  userId               String @map("user_id") @db.Uuid
  careRoleAssignmentId String @map("care_role_assignment_id") @db.Uuid
  /// Y desde qué tablet de sala. NOT NULL: en este bloque una
  /// confirmación entra siempre por una sala. El admin las **enseña**; no
  /// las da (ver la decisión en el done).
  deviceId             String @map("device_id") @db.Uuid

  /// Cuándo se tecleó, y cuándo llegó al servidor. Dos instantes por lo
  /// mismo que en `CareRecord`: sin red la confirmación se encola y los
  /// dos se separan. **El que manda es `at`**, que es cuando la persona
  /// dijo que lo había leído.
  at         DateTime @db.Timestamptz()
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz()

  /// `true` si quien confirma ve el centro entero (DUE, médico, calidad,
  /// dirección — D-51). Una confirmación de alcance total cubre **todas**
  /// las zonas del parte, incluida la del centro.
  alcanceTotal Boolean @default(false) @map("alcance_total")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  handover           Handover           @relation(fields: [handoverId], references: [id], onDelete: Restrict)
  user               User               @relation("HandoverAckUser", fields: [userId], references: [id], onDelete: Restrict)
  careRoleAssignment CareRoleAssignment @relation(fields: [careRoleAssignmentId], references: [id], onDelete: Restrict)
  device             Device             @relation("HandoverAckDevice", fields: [deviceId], references: [id], onDelete: Restrict)

  zones HandoverAckZone[]

  @@unique([handoverId, userId])
  @@index([tenantId])
  @@index([handoverId])
  @@map("handover_acks")
}

/// residencia-5 · **QUÉ ZONAS ABARCABA LO QUE VIO.**
///
/// Una fila por planta que la confirmación cubre. Vacío cuando
/// `alcanceTotal` es `true`: enumerar las ocho plantas de un centro en
/// cada confirmación de la DUE sería guardar ocho veces lo que una
/// columna booleana ya dice, y el día que el centro añada una novena
/// planta las confirmaciones viejas dirían que cubrían ocho de nueve.
model HandoverAckZone {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ackId    String @map("ack_id") @db.Uuid
  floorId  String @map("floor_id") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ack    HandoverAck @relation(fields: [ackId], references: [id], onDelete: Restrict)
  floor  Floor       @relation(fields: [floorId], references: [id], onDelete: Restrict)

  @@unique([ackId, floorId])
  @@index([tenantId])
  @@index([floorId])
  @@map("handover_ack_zones")
}

/// residencia-5 (decisión de producto 2) · **«LLEGÓ DESPUÉS DEL RELEVO».**
///
/// Una puerta sin red sube a las 15:20 algo que pasó a las 14:50, y el
/// parte de la mañana ya está congelado. No se reescribe lo congelado
/// —eso es la evidencia de lo que se supo— y tampoco se esconde: se añade
/// aquí, y la tablet y el panel lo pintan aparte, con su hora.
///
/// Es lo que hace que un registro tardío **deshaga el «no hecho»** sin
/// tocar el parte: el cálculo de «no hecho» mira los registros de ahora
/// (decisión de producto 4), y en el parte congelado la línea sigue
/// diciendo «no se hizo» con un añadido debajo que dice que llegó a las
/// 15:20. Las dos cosas son verdad y las dos hacen falta.
///
/// Append-only (`handover_late_additions_append_only`), igual que las
/// confirmaciones.
model HandoverLateAddition {
  /// Generado en la aplicación, por lo mismo que el del parte: el AAD de
  /// `resumen_cifrado` lo necesita antes de insertar.
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  handoverId String @map("handover_id") @db.Uuid

  kind HandoverLateKind

  /// De qué es. Exactamente UNA de las tres, según `kind` (CHECK
  /// `handover_late_additions_fuente_coherente`): un añadido que no
  /// apunta a nada no se puede abrir, y uno que apunta a dos no se sabe
  /// qué es.
  careRecordId String? @map("care_record_id") @db.Uuid
  incidentId   String? @map("incident_id") @db.Uuid
  guardAlertId String? @map("guard_alert_id") @db.Uuid

  /// El residente y la planta, para pintarlo en su sitio sin descifrar
  /// nada. Los dos nullable: una avería del office no es de nadie ni de
  /// ninguna planta.
  clientId String? @map("client_id") @db.Uuid
  floorId  String? @map("floor_id") @db.Uuid

  /// **Cuándo PASÓ y cuándo LLEGÓ.** Los dos, y es el bloque entero en
  /// dos columnas: «pasó a las 14:50, lo supimos a las 15:20» es
  /// exactamente lo que el turno entrante tiene que leer.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz()
  arrivedAt  DateTime @map("arrived_at") @db.Timestamptz()

  /// Una línea de resumen, **cifrada**: lleva salud igual que el parte.
  resumenCifrado String @map("resumen_cifrado")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  handover   Handover    @relation(fields: [handoverId], references: [id], onDelete: Restrict)
  careRecord CareRecord? @relation(fields: [careRecordId], references: [id], onDelete: Restrict)
  incident   Incident?   @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  guardAlert GuardAlert? @relation(fields: [guardAlertId], references: [id], onDelete: Restrict)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  floor      Floor?      @relation(fields: [floorId], references: [id], onDelete: Restrict)

  /// Un registro tardío se añade UNA vez a UN parte. Es la idempotencia
  /// de la pasada que los detecta: correrla dos veces no duplica el
  /// añadido. Los tres índices son parciales en la migración, por lo
  /// mismo que los de `handover_zones`.
  @@index([tenantId])
  @@index([handoverId])
  @@map("handover_late_additions")
}

// ══ residencia-5 · LAS OBLIGACIONES DE DIRECCIÓN (D-42) ════════════════
//
// «¿Qué toca este día del mes?» es la mitad de la métrica de éxito de
// dirección (bloque C §2), y hoy la respuesta vive en la cabeza de
// Carmen: las nóminas el 25, los extintores cada trimestre, el
// certificado del mantenedor de PCI que falta desde 2026.
//
// ── LAS OBLIGACIONES SON DEL CENTRO, NO DEL PRODUCTO ───────────────
//
// Al revés que la plantilla de gravedad (D-65) y que el catálogo de
// controles de serie (D-21): `management_duties` **tiene `tenant_id`** y
// cada centro ajusta las suyas. El catálogo del bloque C §3 es una
// PLANTILLA que el centro carga de una vez y luego toca; no baja a todos
// los centros cuando el producto la cambie, porque las nóminas de un
// centro no son asunto de otro.
//
// ── Y NO ABREN INCIDENCIA ──────────────────────────────────────────
//
// Una ocurrencia vencida sale **en rojo en el panel** y nada más. El
// libro de incidencias tiene tres sujetos (residente, queja, avería,
// D-38) y el sujeto «proceso» es de calidad-1: meter aquí una incidencia
// de proceso sería adelantar un bloque entero por la puerta de atrás.

/// residencia-5 (D-42) · **UNA OBLIGACIÓN DE DIRECCIÓN.**
///
/// Nombre, familia, periodicidad, responsable, consecuencia y la marca
/// «periodicidad por verificar». Sus ocurrencias las genera la pasada
/// programada (`DutyOccurrence`).
///
/// ── EL RESPONSABLE: UNA DE TRES, Y NO DOS ─────────────────────────
///
/// Un **rol de cuidado** («Dirección», «Calidad»), una **persona** o una
/// **etiqueta libre**. Las tres existen porque el catálogo del bloque C
/// las usa las tres: «Dirección» es un rol, «Carmen» puede ser una
/// persona concreta, y «Gestoría» y «Mi Piace» no son ni lo uno ni lo
/// otro — son de fuera del centro y no tienen usuario.
///
/// El CHECK `management_duties_responsable` exige **exactamente una**. Con
/// dos, «¿a quién le toca?» tendría dos respuestas y la pantalla elegiría
/// una; con ninguna, la obligación no es de nadie y nadie la hace.
model ManagementDuty {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Como lo llama el centro. Único por centro entre las vivas (índice
  /// parcial `management_duties_nombre_key`): dos «Nóminas» en la lista
  /// son dos sitios donde marcarlo hecho y uno se queda sin marcar.
  name   String
  family DutyFamily
  /// Una nota del centro. **En claro**: una obligación de dirección no es
  /// un dato de salud (D-63), y de aquí sale «falta el de 2026 (obs. 02)».
  notes  String?

  periodicity DutyPeriodicity

  /// ── LAS COLUMNAS DE LA PERIODICIDAD ───────────────────────────────
  ///
  /// Cada periodicidad lleva las suyas y **ninguna más** (CHECK
  /// `management_duties_periodicidad_coherente`). Son enteros y no una
  /// fecha porque lo que se repite es «el 25» o «el primer lunes», no un
  /// instante: igual que `CenterShift.startsAt` es «HH:MM» y no un
  /// timestamp.
  ///
  /// `weekday` 1–7 ISO (1 = lunes). Sólo en `WEEKLY`.
  weekday    Int?
  /// `monthDay` 1–31. En `MONTHLY`, `QUARTERLY`, `ANNUAL` y
  /// `FIVE_YEARLY`.
  ///
  /// **31 significa «el último día del mes»**, y es una decisión: un
  /// centro que paga las nóminas el último día de cada mes no puede tener
  /// una obligación que en febrero no exista. Lo resuelve el generador
  /// (`packages/residencia-plan`, con su tabla de verdad para febrero de
  /// 2027 y el 29 de febrero de 2028), no la base.
  monthDay   Int?    @map("month_day")
  /// `month` 1–12. En `ANNUAL` y `FIVE_YEARLY` es el mes; en `QUARTERLY`
  /// es el **primer mes del ciclo** (1–3), y de ahí salen los otros tres
  /// sumando.
  month      Int?
  /// El año de anclaje de una quinquenal: desde él se cuentan los cinco.
  anchorYear Int?    @map("anchor_year")
  /// La fecha de caducidad de una `VALIDITY`, «YYYY-MM-DD». Es su única
  /// ocurrencia, y el panel la avisa a 60 días (bloque C §2).
  validUntil String? @map("valid_until") @db.VarChar(10)

  /// **«Periodicidad por verificar»** (D-42). Lo marcado *(verificar)* en
  /// el catálogo del bloque C entra con esta marca puesta: la
  /// periodicidad es la que alguien supuso en agosto y nadie ha
  /// confirmado. El panel lo pinta y la pantalla deja quitarlo; lo que no
  /// hace es **bloquear** la obligación, porque una obligación sin
  /// periodicidad confirmada sigue tocando.
  periodicityToVerify Boolean @default(false) @map("periodicity_to_verify")

  consequence DutyConsequence

  /// El responsable: una de las tres (ver la cabecera). **`Restrict` en
  /// las dos**, y la segunda tiene su razón: un `SetNull` en la persona
  /// dejaría la fila sin ningún responsable y el CHECK
  /// `management_duties_responsable` —que exige exactamente uno— lo
  /// rechazaría al ejecutarse. Es la clase de promesa que un `SetNull` no
  /// puede cumplir cuando hay un CHECK encima (lección de
  /// `clinical_processor_agreements` en clinica-7). La pantalla obliga a
  /// reasignar antes de dar de baja a nadie.
  responsibleCareRoleId String? @map("responsible_care_role_id") @db.Uuid
  responsibleUserId     String? @map("responsible_user_id") @db.Uuid
  responsibleLabel      String? @map("responsible_label")

  /// Desde cuándo se generan ocurrencias. No es `createdAt`: cargar la
  /// plantilla en octubre no debe inventar las nóminas de enero.
  startsOn String  @map("starts_on") @db.VarChar(10)
  /// Y hasta cuándo, si el centro la retira. `active = false` deja de
  /// generar ocurrencias **sin borrar las que hay**: lo hecho se
  /// conserva.
  active   Boolean @default(true)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsibleCareRole CareRole? @relation(fields: [responsibleCareRoleId], references: [id], onDelete: Restrict)
  responsibleUser     User?     @relation("ManagementDutyResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdBy           User?     @relation("ManagementDutyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  occurrences DutyOccurrence[]

  @@index([tenantId])
  @@index([tenantId, family])
  @@map("management_duties")
}

/// residencia-5 (D-42) · **UNA VEZ QUE TOCA.**
///
/// Las genera la pasada programada desde la periodicidad de su
/// obligación, con una ventana por delante: el panel enseña «lo que vence
/// en 60 días» y para eso las ocurrencias tienen que existir antes de
/// vencer.
///
/// Se marca **hecha** con persona + capacidad + hora (D-31) y, si se
/// quiere, una evidencia adjunta: el certificado, el informe. Una
/// vencida sale en rojo en el panel y **no abre incidencia** (ver la
/// cabecera del bloque).
///
/// ── UNA HECHA NO VUELVE A PENDIENTE, SALVO CORRECCIÓN FIRMADA ──────
///
/// El trigger `duty_occurrences_hecha_no_vuelve` deja poner `done_at` a
/// NULL **sólo** si la fila trae a la vez la corrección firmada:
/// `corrected_at`, quién y por qué. Un «se me fue el dedo» se arregla
/// diciendo quién lo arregla, que es la misma regla que la anulación de
/// un `CareRecord`.
model DutyOccurrence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  dutyId   String @map("duty_id") @db.Uuid

  /// Qué día toca, «YYYY-MM-DD». Única por obligación (índice
  /// `duty_occurrences_una_por_dia_key`): es lo que hace **idempotente**
  /// la pasada que las genera.
  dueOn String @map("due_on") @db.VarChar(10)

  /// ── HECHA, con firma (D-31) ───────────────────────────────────────
  ///
  /// Las tres juntas o ninguna (CHECK `duty_occurrences_hecha_completa`):
  /// una ocurrencia hecha sin saber quién la hizo es media evidencia, y
  /// la evidencia es el punto entero.
  doneAt                     DateTime? @map("done_at") @db.Timestamptz()
  doneByUserId               String?   @map("done_by_user_id") @db.Uuid
  doneByCareRoleAssignmentId String?   @map("done_by_care_role_assignment_id") @db.Uuid
  /// Una nota del que la marcó. **En claro**: no es salud.
  doneNote                   String?   @map("done_note")

  /// ── LA EVIDENCIA ADJUNTA ──────────────────────────────────────────
  ///
  /// El certificado del mantenedor, el informe de extintores. Fichero del
  /// volumen clínico con cabecera `MPC1` y la huella del claro, **igual
  /// que los demás ficheros** (clinica-4, clinica-7, la nota de voz de
  /// residencia-3): no se inventa un segundo almacén para esto.
  ///
  /// Las cuatro van juntas o ninguna (CHECK
  /// `duty_occurrences_evidencia_completa`): media evidencia es una fila
  /// que dice que hay un PDF que no se puede servir.
  evidenceFileName String? @map("evidence_file_name") @db.VarChar(100)
  evidenceSha256   String? @map("evidence_sha256") @db.Char(64)
  evidenceBytes    Int?    @map("evidence_bytes")
  evidenceMimeType String? @map("evidence_mime_type") @db.VarChar(80)

  /// ── LA CORRECCIÓN FIRMADA (ver la cabecera) ───────────────────────
  ///
  /// Las tres juntas o ninguna (CHECK
  /// `duty_occurrences_correccion_completa`), y son la ÚNICA forma de que
  /// una hecha vuelva a pendiente.
  correctedAt       DateTime? @map("corrected_at") @db.Timestamptz()
  correctedByUserId String?   @map("corrected_by_user_id") @db.Uuid
  correctionReason  String?   @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  duty        ManagementDuty      @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  doneBy      User?               @relation("DutyOccurrenceDoneBy", fields: [doneByUserId], references: [id], onDelete: Restrict)
  doneWith    CareRoleAssignment? @relation(fields: [doneByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  correctedBy User?               @relation("DutyOccurrenceCorrectedBy", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@unique([dutyId, dueOn])
  @@index([tenantId])
  /// «¿Qué toca hoy y qué está vencido?», que es la pregunta del panel.
  /// El índice parcial `WHERE done_at IS NULL` vive en la migración.
  @@index([tenantId, dueOn])
  @@map("duty_occurrences")
}

/// residencia-5 (rama de controles §10) · **EL UMBRAL OBJETIVO DE UN
/// INDICADOR, que es del CENTRO.**
///
/// La frontera estándar/centro, escrita en una tabla: la **fórmula** de
/// cada indicador es del producto y vive en
/// `packages/residencia-plan/src/indicadores.ts`; el **umbral** es del
/// centro y vive aquí. El 73,5 % de la gimnasia es el objetivo 2026 de
/// Jardín de Gredos, no una constante del producto.
///
/// Sin fila, el panel usa el umbral de serie del fichero y lo dice. No se
/// siembra una fila por centro: un umbral sembrado y nunca revisado es
/// indistinguible de uno que la dirección eligió.
model IndicatorTarget {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// El código del indicador, **en claro y sin FK**: los indicadores son
  /// un fichero de datos del producto (la misma decisión que
  /// `incident_type`, D-11 llevado al panel), y un indicador nuevo en
  /// 2028 es una fila del fichero, no una migración.
  code String

  /// El valor objetivo y para qué lado se mide.
  target     Float
  comparison IndicatorComparison

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("indicator_targets")
}

// ════════════════════════════════════════════════════════════════════
//  calidad-1 (D-70 a D-76) · EL MAPA ÚNICO, LOS RIESGOS Y LAS NC
// ════════════════════════════════════════════════════════════════════
//
// AENOR puso en 2026 una **NC 01** (apartado 4.4.1) porque el centro no
// presenta evidencia de «una única determinación de sus procesos»: hay 8
// procesos en la pantalla de indicadores y 4 en la de riesgos. Lo que
// este bloque añade al modelo es la entidad que hace imposible repetir
// ese fallo: **un solo `Process` por centro, y todo lo de calidad con FK
// `NOT NULL` y `Restrict` hacia él.**
//
// No hay ninguna otra lista de procesos en ninguna pantalla. La NC queda
// cerrada por construcción, que es distinto de cerrarla por disciplina.

/// calidad-1 (D-70) · de qué fila del mapa es un proceso.
///
/// Los tres de un mapa de procesos de ISO 9001: arriba los que deciden,
/// en medio la cadena de valor que recorre un residente, abajo los que la
/// sostienen. No es decorativo: es cómo se lee el mapa en la auditoría y
/// cómo se pinta la pantalla.
enum ProcessType {
  /// Dirección y planificación · Calidad y mejora.
  STRATEGIC
  /// Admisión, valoración, atención sanitaria, cuidados, vida social,
  /// alojamiento. **Seis y no uno**: la observación 07 de AENOR dice que
  /// «el proceso único de PRESTACIÓN DEL SERVICIO junta actividades muy
  /// diversas».
  OPERATIONAL
  /// Personas · Mantenimiento e instalaciones · Documentación, registros
  /// y protección de datos.
  SUPPORT
}

/// calidad-1 (D-71) · un riesgo o una oportunidad. Misma tabla porque es
/// el mismo trabajo (identificar, valorar, planificar, revisar) y porque
/// la ISO 9001 los pide juntos en el 6.1.
enum RiskKind {
  RISK
  OPPORTUNITY
}

/// calidad-1 (D-73) · **LA CLASE DE UN HALLAZGO.** No se cambia nunca
/// (trigger `non_conformities_inmutable`): subir una NC menor a mayor
/// después de cerrarla sería reescribir lo que el auditor dijo.
enum NonConformityKind {
  /// Incumplimiento que pone en cuestión la capacidad del sistema.
  MAJOR
  /// Incumplimiento puntual. La NC 01 de 2026 es de ésta.
  MINOR
  /// No es incumplimiento: es un aviso. Las diez de 2026 son de ésta.
  OBSERVATION
  /// Oportunidad de mejora. Entra en el mismo ciclo, más ligero: no
  /// exige análisis de causa.
  IMPROVEMENT
}

/// calidad-1 (D-73) · **DE DÓNDE SALIÓ.** Enum y no texto porque el PAC
/// se filtra por esto («todas las NC de la auditoría externa de julio»),
/// y un filtro sobre texto libre no encuentra «AENOR» cuando alguien
/// escribió «Aenor 2026».
enum NonConformityOrigin {
  INTERNAL_AUDIT
  /// AENOR y cualquier certificadora.
  EXTERNAL_AUDIT
  /// Bienestar Social, Sanidad, Trabajo.
  INSPECTION
  /// Una incidencia del libro único, elevada a NC (D-38). Conserva el
  /// enlace en `sourceIncidentId`.
  INCIDENT
  /// Una queja del libro, elevada igual.
  COMPLAINT
  /// Un indicador fuera de umbral dos meses seguidos (D-74).
  INDICATOR
  MANAGEMENT_REVIEW
  OTHER
}

/// calidad-1 (D-73) · **EL CICLO**, y el orden importa.
///
/// `OPEN` → `CAUSE_ANALYSED` → `ACTIONS` → `ACTIONS_CLOSED` → `CLOSED`.
///
/// Dos puertas que no las guarda una ruta sino el motor:
///
///   · una NC (mayor o menor) **no sale de `OPEN` sin causa** — CHECK
///     `non_conformities_causa_antes_de_acciones`; una observación o una
///     oportunidad sí;
///   · **no llega a `CLOSED` sin una verificación de eficacia con
///     resultado `EFFECTIVE`** — trigger `non_conformities_inmutable`.
///
/// Y un `NOT_EFFECTIVE` la devuelve a `ACTIONS`: el rastro de los dos
/// intentos queda, porque las verificaciones son append-only.
enum NonConformityState {
  OPEN
  CAUSE_ANALYSED
  ACTIONS
  ACTIONS_CLOSED
  CLOSED
}

/// calidad-1 (D-73) · ¿funcionó la acción?
enum VerificationResult {
  EFFECTIVE
  NOT_EFFECTIVE
}

/// calidad-1 · en qué quedó un objetivo de calidad del año.
enum QualityObjectiveStatus {
  OPEN
  MET
  NOT_MET
  CANCELLED
}

/// calidad-1 (D-70) · **EL PROCESO. UNO SOLO POR CENTRO, Y TODO CUELGA
/// DE AQUÍ.**
///
/// Indicadores, riesgos y oportunidades, objetivos de calidad y no
/// conformidades: las cuatro FKs son `NOT NULL` y `Restrict`. No hay
/// ninguna otra lista de procesos en el producto, así que **no existe el
/// sitio donde escribir el segundo mapa** — que es lo que la NC 01 de
/// AENOR 2026 reprocha.
///
/// ── DE REFERENCIA, Y LUEGO DEL CENTRO ───────────────────────────────
///
/// El producto trae un mapa de once procesos
/// (`catalogo/procesos-de-serie.ts`). El centro lo carga una vez y lo
/// adapta: renombra, añade los suyos y **desactiva** los que no usa.
/// `referenceCode` guarda de qué proceso de referencia salió cada uno
/// aunque le cambien el nombre, y es lo que ata cada indicador del
/// producto a su proceso (D-72).
///
/// Es una PLANTILLA y no un catálogo de serie: no baja a todos los
/// centros al arrancar la API y no se versiona. Misma distinción —y por
/// lo mismo— que las obligaciones de dirección de residencia-5.
///
/// ── NI SE BORRA CON ALGO COLGANDO, NI SE DESACTIVA ──────────────────
///
/// Borrarlo lo para el motor (los `Restrict` de los cuatro hijos).
/// **Desactivarlo lo para la ruta**, y es deliberado: un proceso inactivo
/// con una NC abierta dentro es una NC que desaparece de la pantalla sin
/// que nadie la haya cerrado. La ruta obliga a reasignar primero
/// (`POST /residencia/procesos/:id/reasignar`), y entonces desactiva.
model Process {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Único por centro. En los del mapa de referencia es su código; en los
  /// que añade el centro lo normaliza la ruta a partir del nombre.
  code String
  name String
  type ProcessType

  /// Qué hace este proceso, en una línea. **En claro**: es la ficha del
  /// proceso, no un dato de nadie, y es lo primero que un auditor lee.
  purpose String?

  /// De qué proceso del mapa de referencia salió. NULL en los que el
  /// centro añade. Único por centro cuando no es NULL (Postgres admite
  /// NULLs repetidos), así que **cargar el mapa dos veces no lo
  /// duplica**.
  referenceCode String? @map("reference_code")

  /// El responsable es un **ROL de cuidado, no una persona** (D-29,
  /// D-50): en una residencia el dueño de un proceso es «la DUE» o
  /// «calidad», y quien ocupa ese rol cambia en agosto. `Restrict`: un
  /// rol que es responsable de un proceso no se retira sin pasarle el
  /// proceso a otro.
  responsibleCareRoleId String @map("responsible_care_role_id") @db.Uuid

  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsibleCareRole CareRole @relation(fields: [responsibleCareRoleId], references: [id], onDelete: Restrict)
  createdBy         User?    @relation("ProcessCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  risks             RiskOpportunity[]
  objectives        QualityObjective[]
  nonConformities   NonConformity[]
  indicators        IndicatorProcess[]

  @@unique([tenantId, code])
  @@unique([tenantId, referenceCode])
  @@index([tenantId])
  @@index([tenantId, active, sortOrder])
  @@map("processes")
}

/// calidad-1 (D-72) · **DE QUÉ PROCESO CUELGA UN INDICADOR EN ESTE
/// CENTRO.**
///
/// Una fila por indicador del producto, creada al cargar el mapa: el
/// cargador la pone apuntando al proceso que salió del
/// `procesoDeReferencia` de ese indicador. Después el centro puede
/// colgarlo de otro proceso suyo, y eso es un `UPDATE` de esta fila.
///
/// ── POR QUÉ NO ES UNA COLUMNA DE `indicator_targets` ────────────────
///
/// Porque son dos cosas con dos vidas. `indicator_targets` existe
/// **sólo cuando el centro cambia el umbral** —sin fila, manda el de
/// serie, y residencia-5 decidió a propósito no sembrarla para que «un
/// umbral sembrado y nunca revisado» no se confunda con uno que la
/// dirección eligió—. El proceso, al contrario, **tiene que estar
/// siempre**: un indicador sin proceso es el agujero de la NC 01. Meter
/// las dos en la misma fila habría obligado a sembrar un umbral para
/// poder colgar un proceso.
///
/// `code` es texto y sin FK, como en `indicator_targets` y por lo mismo
/// (D-11 llevado al panel): los indicadores son un fichero de datos del
/// producto, y uno nuevo en 2028 es una fila del fichero, no una
/// migración.
model IndicatorProcess {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  code      String
  processId String @map("process_id") @db.Uuid

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process   Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("IndicatorProcessUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([processId])
  @@map("indicator_processes")
}

/// calidad-1 (D-71) · **UN RIESGO O UNA OPORTUNIDAD, COLGADO DE SU
/// PROCESO.**
///
/// La NC 01 de AENOR 2026 nombra cuatro riesgos intrínsecos de una
/// residencia que «siguen sin asociarse a proceso»: errores en el
/// tratamiento médico, intoxicaciones alimentarias, datos confidenciales
/// y salidas no controladas. Los cuatro vienen de serie y **ya colgados**
/// (`catalogo/procesos-de-serie.ts`).
///
/// ── EL NIVEL ES UNA COLUMNA CON UN CHECK, NO UN CÁLCULO ─────────────
///
/// `level = probability * impact`, y lo garantiza el CHECK
/// `risk_opportunities_nivel_coherente`. Es columna porque el panel
/// ordena por ella y porque un nivel que se calcula en dos sitios acaba
/// dando dos números; y es un CHECK y no un `GENERATED` porque Prisma no
/// sabe leer columnas generadas sin ignorarlas, y una columna que el
/// cliente ignora es una columna que nadie comprueba.
///
/// Las bandas (bajo 1-2 · medio 3-4 · alto 6-9) son del producto y viven
/// en `packages/residencia-plan/src/calidad.ts`: un centro que quiera
/// otras bandas no cambia la base.
///
/// ── LA DESCRIPCIÓN VA EN CLARO, Y ESTÁ DECLARADO ────────────────────
///
/// Al revés que la de una NC (D-73). Un riesgo describe **algo que puede
/// pasar en el centro**, no algo que le pasó a doña Carmen: «intoxicación
/// alimentaria por rotura de la cadena de frío» no nombra a nadie. Y en
/// claro es consultable, que es lo que permite que el mapa de riesgos se
/// pinte y se exporte sin descifrar nada. Si alguien escribe un nombre
/// ahí, está escribiéndolo en el sitio equivocado: eso es una incidencia
/// del libro o una NC.
model RiskOpportunity {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  processId String @map("process_id") @db.Uuid

  kind RiskKind

  /// El código del riesgo de serie del que salió, para que cargar el mapa
  /// dos veces no lo duplique. NULL en los que añade el centro.
  code        String?
  description String

  /// 1-3 cada uno (CHECK). Ver la cabecera para el nivel.
  probability Int
  impact      Int
  level       Int

  plannedAction String? @map("planned_action")

  /// **CUÁNDO TOCA REVISARLO**, «YYYY-MM-DD». Fecha de pared y no
  /// `Timestamptz`, como `ManagementDuty.validUntil` y por lo mismo: lo
  /// que se revisa es un día del calendario del centro, no un instante.
  /// Una revisión vencida sale en el panel de dirección.
  reviewAt String @map("review_at") @db.VarChar(10)

  /// Cuándo se revisó por última vez y quién, para que «revisado» no sea
  /// sólo haber movido la fecha.
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid

  /// La cláusula de la ISO 9001:2015 (D-75). De serie, 6.1.
  isoClause String? @map("iso_clause")

  active Boolean @default(true)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process    Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("RiskReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdBy  User?   @relation("RiskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([processId])
  @@index([tenantId, reviewAt])
  @@map("risk_opportunities")
}

/// calidad-1 · **UN OBJETIVO DE CALIDAD DEL AÑO, COLGADO DE SU PROCESO.**
///
/// Los cuatro de 2026 de Jardín de Gredos (informe de AENOR §6) son de
/// ésta. Entra en este bloque porque **cabe sin pantalla nueva**: es una
/// sección más de la ficha del proceso, igual que sus riesgos. El
/// seguimiento anual con su borrador de revisión por la dirección es
/// calidad-2.
///
/// `indicatorCode` ata el objetivo al indicador que lo mide cuando lo
/// mide uno —«el 54 % de válidos acuda a actividades fuera» lo mide
/// `ACTIVIDADES_SOCIOCULTURALES`— y es texto sin FK por lo mismo que en
/// `indicator_targets`.
model QualityObjective {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  processId String @map("process_id") @db.Uuid

  year Int
  name String
  /// La meta, en palabras: «que el 25 % mantenga o mejore la puntuación
  /// en las escalas». En claro, como la del riesgo.
  target String

  status QualityObjectiveStatus @default(OPEN)

  indicatorCode String? @map("indicator_code")
  progressNote  String? @map("progress_note")
  isoClause     String? @map("iso_clause")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  process   Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  createdBy User?   @relation("ObjectiveCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([processId])
  @@index([tenantId, year])
  @@map("quality_objectives")
}

/// calidad-1 (D-73) · **UNA NO CONFORMIDAD, CON SU CICLO COMPLETO.**
///
/// Entidad propia y **no una fila más de `incidents`** (que es lo que
/// D-38 dejó abierto para «cuando se acerque la auditoría»). La razón es
/// la forma: una incidencia del libro es un hecho con nivel, cierre y
/// comunicación a la familia; una NC es un **expediente** con causa,
/// acciones con responsable y plazo, evidencias y verificación de
/// eficacia. Metida en `incidents` habría necesitado seis columnas que
/// están NULL en el 99 % de las filas y un trigger que las exigiera
/// según el tipo.
///
/// Lo que SÍ comparte con el libro es el régimen: **append-only, y la
/// clase, el origen y quién la abrió no se cambian ni por SQL** (trigger
/// `non_conformities_inmutable`). Lo que se hizo después se escribe como
/// acción o como verificación, con su autor y su hora.
///
/// ── `id` SIN `DEFAULT` ──────────────────────────────────────────────
///
/// El AAD de `description_cifrado` ata el valor a
/// `tenant|non_conformities|description|<id>`, y el id hay que saberlo
/// antes de insertar. Misma decisión exacta que `care_records.id` y
/// `handovers.id`.
///
/// ── LOS TEXTOS LIBRES NACEN CIFRADOS (D-63) ─────────────────────────
///
/// Al revés que los de un riesgo: **una NC puede nombrar a un
/// residente**. «Falta la hoja de cambios posturales de la 112 del
/// martes» y «la causa fue que la auxiliar de refuerzo no conocía el
/// plan de doña Carmen» son salud con todas las letras. Misma maquinaria
/// y mismo CHECK de formato que residencia-1b.
///
/// En claro, declarado: la clase, el origen, el estado, el proceso, la
/// referencia, las fechas y los firmantes. Es lo que sostiene el PAC y
/// los filtros sin descifrar nada, y es lo mismo que la carpeta de
/// calidad dice ya hoy en el lomo.
model NonConformity {
  id        String @id @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// `Restrict` y `NOT NULL`: es la FK que cierra la NC 01.
  processId String @map("process_id") @db.Uuid

  /// Como la nombra el centro y como la nombra el auditor: «NC-2026-01».
  /// Única por centro. La pone la ruta al abrir, con el año y el
  /// siguiente número libre.
  reference String

  kind   NonConformityKind
  origin NonConformityOrigin
  state  NonConformityState  @default(OPEN)

  /// La cláusula de la ISO 9001:2015 (D-75). La NC 01 de 2026 es del
  /// 4.4.1.
  isoClause String? @map("iso_clause")

  /// Qué día se detectó, «YYYY-MM-DD»: la fecha del informe de auditoría
  /// o del acta de inspección, que es la que cuenta para el plazo del
  /// PAC. No es `createdAt`: una NC de julio se puede meter en agosto.
  detectedOn String @map("detected_on") @db.VarChar(10)

  /// **Qué pasa**, cifrado y obligatorio: una NC sin descripción no es
  /// una NC.
  descriptionCifrado String  @map("description_cifrado")
  /// **Por qué pasa**, cifrado. Obligatorio para salir de `OPEN` si es
  /// mayor o menor (CHECK `non_conformities_causa_antes_de_acciones`);
  /// opcional en una observación o una oportunidad de mejora.
  causeCifrado       String? @map("cause_cifrado")

  /// ── DE DÓNDE SALIÓ ────────────────────────────────────────────────
  ///
  /// La incidencia del libro cuando se **elevó** una (D-38). Es UNA fila
  /// leída desde los dos lados: desde la NC dice de qué incidencia salió
  /// y desde la incidencia dice en qué NC acabó. `Restrict`: la
  /// incidencia que originó una NC no se borra — en el libro ya no se
  /// borraba nada, y esto lo vuelve a decir desde este lado.
  sourceIncidentId     String? @map("source_incident_id") @db.Uuid
  /// O el indicador y el mes, cuando la propuso el panel (D-74). Los dos
  /// juntos o ninguno: un indicador sin mes no se puede volver a mirar.
  sourceIndicatorCode  String? @map("source_indicator_code")
  sourceIndicatorMonth String? @map("source_indicator_month") @db.VarChar(7)
  /// O un texto: «AENOR, informe nº 24, 1er seguimiento, 21-07-2026».
  /// En claro: es la referencia del documento, no su contenido.
  sourceNote           String? @map("source_note")

  /// ── EL INFORME ADJUNTO ────────────────────────────────────────────
  ///
  /// El PDF del auditor o el acta de la inspección. Fichero del volumen
  /// clínico con cabecera `MPC1` y la huella del claro, **igual que la
  /// evidencia de una obligación** (residencia-5): no se inventa un
  /// segundo almacén. Las cuatro van juntas o ninguna (CHECK).
  ///
  /// La auditoría como ENTIDAD —con su plan anual y sus hallazgos— es
  /// calidad-2. Aquí basta el origen y el documento.
  reportFileName String? @map("report_file_name") @db.VarChar(100)
  reportSha256   String? @map("report_sha256") @db.Char(64)
  reportBytes    Int?    @map("report_bytes")
  reportMimeType String? @map("report_mime_type") @db.VarChar(80)

  /// ── QUIÉN LA ABRIÓ (D-31) ─────────────────────────────────────────
  ///
  /// Persona + capacidad, como todo lo que se firma en la residencia.
  /// Abre quien tenga un rol de categoría `DIRECTIVO` o el rol
  /// `CALIDAD` (D-73), y lo comprueba la ruta: es una regla sobre la
  /// vigencia de una asignación, que cambia con el tiempo, y un CHECK no
  /// sabe mirar otra tabla.
  openedAt                     DateTime @map("opened_at") @db.Timestamptz()
  openedByUserId               String   @map("opened_by_user_id") @db.Uuid
  openedByCareRoleAssignmentId String   @map("opened_by_care_role_assignment_id") @db.Uuid

  /// ── EL CIERRE ─────────────────────────────────────────────────────
  ///
  /// Las tres juntas o ninguna (CHECK `non_conformities_cierre_completo`)
  /// y coherentes con el estado (CHECK
  /// `non_conformities_cerrada_coherente`). Y **no se llega aquí sin una
  /// verificación de eficacia `EFFECTIVE`**: lo para el trigger, no la
  /// ruta.
  closedAt                     DateTime? @map("closed_at") @db.Timestamptz()
  closedByUserId               String?   @map("closed_by_user_id") @db.Uuid
  closedByCareRoleAssignmentId String?   @map("closed_by_care_role_assignment_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  process        Process             @relation(fields: [processId], references: [id], onDelete: Restrict)
  sourceIncident Incident?           @relation("NonConformityFromIncident", fields: [sourceIncidentId], references: [id], onDelete: Restrict)
  openedBy       User                @relation("NonConformityOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  openedWith     CareRoleAssignment  @relation("NonConformityOpenedWith", fields: [openedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  closedBy       User?               @relation("NonConformityClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  closedWith     CareRoleAssignment? @relation("NonConformityClosedWith", fields: [closedByCareRoleAssignmentId], references: [id], onDelete: Restrict)

  actions       CorrectiveAction[]
  verifications EffectivenessVerification[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([processId])
  @@index([tenantId, state])
  @@index([tenantId, origin, detectedOn])
  @@index([sourceIncidentId])
  @@map("non_conformities")
}

/// calidad-1 (D-73) · **UNA ACCIÓN CORRECTIVA: QUÉ, QUIÉN Y PARA
/// CUÁNDO.**
///
/// Es la fila que el PAC a AENOR enseña, y la que hace que «se resolvió
/// de palabra» deje de ser posible: con responsable y plazo, una acción
/// vencida sale en el panel de dirección con su nombre.
///
/// **Append-only** (trigger `corrective_actions_append_only`): lo único
/// que se puede cambiar de una acción escrita es cerrarla, y una vez
/// cerrada ya no se toca. Una acción mal escrita se corrige escribiendo
/// otra que lo diga — lo mismo que hace una `IncidentAction`.
///
/// `id` sin `DEFAULT` por el AAD de `what_cifrado`, como la NC.
model CorrectiveAction {
  id              String @id @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  nonConformityId String @map("non_conformity_id") @db.Uuid

  /// **Qué se va a hacer**, cifrado: puede nombrar al residente o al
  /// profesional de los que habla la NC.
  whatCifrado String @map("what_cifrado")

  /// El responsable: un rol de cuidado, una persona o una etiqueta libre
  /// («Gestoría», «CINSA»). **Exactamente una** (CHECK
  /// `corrective_actions_responsable`), y las dos FKs con `Restrict` por
  /// lo mismo que en `ManagementDuty`: un `SetNull` dejaría la fila sin
  /// responsable y el CHECK la rechazaría al ejecutarse.
  responsibleCareRoleId String? @map("responsible_care_role_id") @db.Uuid
  responsibleUserId     String? @map("responsible_user_id") @db.Uuid
  responsibleLabel      String? @map("responsible_label")

  /// El plazo, «YYYY-MM-DD». Fecha de pared, como el de una obligación.
  dueOn String @map("due_on") @db.VarChar(10)

  openedAt                     DateTime @map("opened_at") @db.Timestamptz()
  openedByUserId               String   @map("opened_by_user_id") @db.Uuid
  openedByCareRoleAssignmentId String   @map("opened_by_care_role_assignment_id") @db.Uuid

  /// Cerrarla es decir que se hizo, con firma. Las tres juntas o ninguna
  /// (CHECK `corrective_actions_cierre_completo`).
  closedAt                     DateTime? @map("closed_at") @db.Timestamptz()
  closedByUserId               String?   @map("closed_by_user_id") @db.Uuid
  closedByCareRoleAssignmentId String?   @map("closed_by_care_role_assignment_id") @db.Uuid
  /// Y qué se hizo exactamente, cifrado. Columna lógica propia: con el
  /// mismo nombre que `what`, el texto de cierre se podría copiar al de
  /// apertura y descifraría.
  closingNoteCifrado           String?   @map("closing_note_cifrado")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nonConformity       NonConformity       @relation(fields: [nonConformityId], references: [id], onDelete: Restrict)
  responsibleCareRole CareRole?           @relation("CorrectiveActionResponsibleRole", fields: [responsibleCareRoleId], references: [id], onDelete: Restrict)
  responsibleUser     User?               @relation("CorrectiveActionResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  openedBy            User                @relation("CorrectiveActionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  openedWith          CareRoleAssignment  @relation("CorrectiveActionOpenedWith", fields: [openedByCareRoleAssignmentId], references: [id], onDelete: Restrict)
  closedBy            User?               @relation("CorrectiveActionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  closedWith          CareRoleAssignment? @relation("CorrectiveActionClosedWith", fields: [closedByCareRoleAssignmentId], references: [id], onDelete: Restrict)

  evidences CorrectiveActionEvidence[]

  @@index([tenantId])
  @@index([nonConformityId])
  @@index([tenantId, dueOn])
  @@map("corrective_actions")
}

/// calidad-1 (D-73) · **LA EVIDENCIA DE QUE LA ACCIÓN SE HIZO.**
///
/// Un fichero, una nota, o las dos (CHECK
/// `corrective_action_evidences_dice_algo`): el acta de la formación, la
/// foto del asidero cambiado, el albarán de la grúa nueva. Sin esto, el
/// PAC dice que se hizo algo y no lo demuestra, que es la mitad de lo
/// que AENOR mira.
///
/// Append-only sin escapatoria: ni `UPDATE` ni `DELETE`.
///
/// **El fichero va al volumen de siempre con la clase `EVIDENCIA`**, la
/// misma que la de una obligación de dirección: no se inventa una
/// carpeta. Y por eso el barrido de huérfanos de residencia-6 tiene que
/// contar también estas filas — si no, borraría los adjuntos del PAC por
/// no encontrarlos referenciados.
model CorrectiveActionEvidence {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  actionId String @map("action_id") @db.Uuid

  /// Las cuatro juntas o ninguna (CHECK
  /// `corrective_action_evidences_fichero_completo`): media evidencia es
  /// una fila que dice que hay un PDF que no se puede servir.
  fileName String? @map("file_name") @db.VarChar(100)
  sha256   String? @map("sha256") @db.Char(64)
  bytes    Int?
  mimeType String? @map("mime_type") @db.VarChar(80)

  /// La nota, cifrada: puede decir «lo comprobó la DUE con doña Carmen
  /// delante».
  noteCifrado String? @map("note_cifrado")

  at                     DateTime @default(now()) @db.Timestamptz()
  byUserId               String   @map("by_user_id") @db.Uuid
  byCareRoleAssignmentId String   @map("by_care_role_assignment_id") @db.Uuid

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  action CorrectiveAction   @relation(fields: [actionId], references: [id], onDelete: Restrict)
  by     User               @relation("EvidenceBy", fields: [byUserId], references: [id], onDelete: Restrict)
  byWith CareRoleAssignment @relation("EvidenceByWith", fields: [byCareRoleAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([actionId, at])
  @@map("corrective_action_evidences")
}

/// calidad-1 (D-73) · **LA VERIFICACIÓN DE EFICACIA.** La pieza que
/// separa un sistema de calidad de una carpeta de buenas intenciones.
///
/// «Se formó al personal» no es que el problema esté resuelto: lo es que
/// tres meses después el registro ya no tenga huecos. Esta tabla guarda
/// quién lo comprobó, cuándo y qué salió.
///
/// ── DOS REGLAS QUE ESTÁN EN EL MOTOR ────────────────────────────────
///
///   1. **No la firma quien cerró la última acción** (misma idea que
///      D-27/D-28 para N3/N4). Lo mira el trigger
///      `effectiveness_verifications_otra_persona`, que además exige que
///      haya al menos una acción cerrada: no se verifica la eficacia de
///      lo que no se ha hecho.
///   2. **Append-only.** Un `NOT_EFFECTIVE` no se corrige: se escribe
///      otra acción, se cierra y se vuelve a verificar. Las dos
///      verificaciones quedan, y ese rastro es lo que enseña que el
///      primer intento no funcionó — que es justo lo que un auditor
///      quiere ver y lo que una carpeta de Word borra.
model EffectivenessVerification {
  id              String @id @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  nonConformityId String @map("non_conformity_id") @db.Uuid

  result VerificationResult

  /// Qué se comprobó y cómo. Cifrado y **obligatorio**: una verificación
  /// que sólo dice «sí» no verifica nada.
  noteCifrado String @map("note_cifrado")

  at                     DateTime @map("at") @db.Timestamptz()
  byUserId               String   @map("by_user_id") @db.Uuid
  byCareRoleAssignmentId String   @map("by_care_role_assignment_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  nonConformity NonConformity      @relation(fields: [nonConformityId], references: [id], onDelete: Restrict)
  by            User               @relation("VerificationBy", fields: [byUserId], references: [id], onDelete: Restrict)
  byWith        CareRoleAssignment @relation("VerificationByWith", fields: [byCareRoleAssignmentId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([nonConformityId, at])
  @@map("effectiveness_verifications")
}
