// Schema Prisma para mipiacetpv.
// Fuente: docs/06-modelo-datos.md.
//
// El bloque "multi-tenant raíz" incluye register/device/pairing_code
// desde el día 1 porque el flujo de emparejamiento es parte del MVP
// (docs/01-spec-funcional.md §3.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  // clinica-1 · el sanitario SIN CAJA. Pasa consulta, ve su agenda y las
  // historias de sus pacientes, y no toca la caja: ni venta, ni turno, ni
  // cajón, ni informes.
  //
  // Es el único rol de negocio que el bloque añade, y el rol de negocio es
  // sólo la mitad: la marca sanitaria vive aparte en `User.isClinician`
  // (decisión de producto del 05-10-2026). Un `CLINICIAN` SIEMPRE lleva la
  // marca puesta — lo hace cumplir el CHECK `users_clinician_implies_flag`
  // de la migración `clinica_1_historia`, no un `if` de la aplicación.
  //
  // Los tres nombres que se ven en pantalla salen de cruzar las dos
  // columnas: cajero (CASHIER, sin marca), cajero-sanitario (CASHIER, con
  // marca) y sanitario (CLINICIAN). La dueña y el encargado conservan su
  // rol y se marcan o no.
  //
  // La negativa al cobro vive en la API —`ensureCajaEnabled` rechaza a un
  // CLINICIAN en las ~60 rutas de caja de un golpe— y no sólo en los
  // botones que el TPV esconde.
  CLINICIAN
}

// clinica-1 · a cuántos pacientes alcanza un sanitario.
//
//   ALL       · ve la historia de cualquier paciente del tenant. Es lo que
//               quiere la podóloga que trabaja sola.
//   SELECTION · ve sólo las de los pacientes a los que tiene acceso
//               vigente (`ClinicalAccess`).
//
// `SELECTION` es el default y es deliberado: lo seguro es lo restrictivo.
enum ClinicalScope {
  ALL
  SELECTION
}

// clinica-1 · de dónde salió un acceso a la historia de un paciente.
enum ClinicalAccessSource {
  // Lo creó la agenda sola al asignarle una cita de ese paciente. No lo
  // concede una persona: lo concede el hecho de atenderlo.
  APPOINTMENT
  // Lo dio a mano la dueña o el encargado.
  MANUAL
}

// clinica-1 · qué se hizo con la historia. `EXPORT` no lo usa ninguna ruta
// todavía (el informe PDF es un bloque posterior) y entra ya para que el
// registro no cambie de forma cuando llegue.
enum ClinicalAccessAction {
  READ
  WRITE
  EXPORT
}

// clinica-1 · y cómo acabó. Los intentos DENEGADOS también se apuntan: un
// acceso que se niega es justo el que interesa ver en el registro.
enum ClinicalAccessOutcome {
  ALLOWED
  DENIED
}

// clinica-1 · qué clase de pieza de historia es. La exploración, la sesión y
// las fotos son bloques siguientes y entrarán como valores nuevos de este
// enum.
enum ClinicalEntryKind {
  NOTE
  // clinica-2 · lo que contestó el paciente en la valoración inicial. Vive
  // aquí y no en `clinical_assessments` por una razón de fondo: las
  // respuestas del paciente son INMUTABLES, y la inmutabilidad ya la hace
  // cumplir el motor sobre esta tabla (trigger `clinical_entries_inmutable`).
  // Guardarlas en la tabla de la valoración —que SÍ cambia de estado— habría
  // exigido un segundo mecanismo de inmutabilidad por columnas, que es la
  // forma de fallo que este enum evita.
  INITIAL_ASSESSMENT
  // clinica-3 · la EXPLORACIÓN del pie: pulso de cada pie, puntos sin
  // sensibilidad al monofilamento sobre el mapa, y tipo de pie. Se hace en
  // la primera visita y cuando la podóloga lo vea necesario (en diabéticos,
  // una vez al año), y la siguiente parte de la última.
  //
  // Separada de la sesión por dos razones: van a ritmos distintos (la
  // sesión es cada dos semanas), y **la exploración se puede registrar sin
  // valoración validada** porque es parte de la primera visita — justo la
  // que puede no tenerla todavía. Metida dentro de la sesión, no habría
  // forma de registrarla el día que más falta hace.
  FOOT_EXAM
  // clinica-3 · la SESIÓN: tratamientos, dolor 0–10, evolución, consejos
  // para casa, próxima cita propuesta, nota y lo marcado hoy en el mapa.
  //
  // Se escribe UNA VEZ, al cerrar, y desde ese instante está firmada y no
  // se edita (sólo anotaciones) — el trigger `clinical_entries_inmutable`
  // de clinica-1 lo hace cumplir, así que no hace falta nada nuevo.
  //
  // Y de una CITA sale UNA sola: el índice parcial
  // `clinical_entries_una_sesion_por_cita` lo impone, y de ahí sale sin un
  // solo `if` que cerrar dos veces no cree dos cobros.
  TREATMENT_SESSION
}

// clinica-2 · en qué punto está una valoración inicial.
//
//   PENDIENTE_PACIENTE · se le mandó el test (o se le abrió la tablet) y
//                        todavía no ha contestado.
//   RESPONDIDA         · contestó. Las alertas ya se enseñan, marcadas
//                        «por validar»: esconderlas hasta el visto bueno
//                        dejaría a la podóloga sin el dato que ya existe.
//   VALIDADA           · el sanitario la revisó con el paciente delante,
//                        marcó las tres confirmaciones y firmó. **Desde
//                        aquí no se edita**: si algo cambia, se repasa con
//                        una valoración nueva (decisión de producto 7).
//
// El estado sólo avanza, y lo hace cumplir el trigger
// `clinical_assessments_guard`.
enum ClinicalAssessmentStatus {
  PENDIENTE_PACIENTE
  RESPONDIDA
  VALIDADA
}

// clinica-2 · de dónde salió la valoración. MISMO vocabulario y misma
// forma que `ClinicalAccessSource`, y por la misma razón: hay un camino que
// lo hace una persona y otro que lo hace un hecho.
//
//   APPOINTMENT · la creó el alta de una cita de un servicio marcado
//                 «primera valoración». No la pide nadie: la pide el hecho
//                 de que se le ha dado esa cita. El alta pasa por
//                 `agenda/store.ts`, donde no hay sesión de la que sacar un
//                 usuario — y el motor (`engine.ts`) no se toca.
//   MANUAL      · la pidió alguien, con «Enviar el test» o abriendo la
//                 tablet, y queda su nombre.
enum ClinicalAssessmentSource {
  APPOINTMENT
  MANUAL
}

// clinica-2 · por dónde contesta el paciente. Dos canales y no tres:
// WhatsApp y SMS están fuera de alcance (no hay proveedor).
enum ClinicalAssessmentChannel {
  // Enlace en un email, al dar la cita de primera valoración.
  EMAIL
  // La tablet de la sala, bloqueada en el test.
  TABLET
}

// clinica-2 · quién tecleó las respuestas. Decisión de producto: puede
// responder un familiar, y queda dicho quién — una respuesta de segunda
// mano se lee distinto, y la pantalla del sanitario lo dice en cada fila.
enum ClinicalAnsweredBy {
  PACIENTE
  FAMILIAR
}

// clinica-2 · lo que puede contestar una persona. «No lo sé» ES una
// respuesta y está siempre disponible (decisión de producto 4): un mayor
// que no sabe si toma anticoagulantes tiene que poder decirlo en vez de
// adivinar, y es justo lo que la validación obliga a resolver después.
enum ClinicalAnswer {
  SI
  NO
  NO_SE
}

enum HoldedAuthMode {
  API_KEY
  OAUTH
}

enum TicketStatus {
  DRAFT
  PAID
  PENDING_SYNC
  SYNCED
  SYNC_FAILED
  VOIDED
  // B-OnboardingV2: ticket creado por un cajero técnico interno (modo
  // prueba). El worker `ticket-upload-worker` lo identifica y NO sube a
  // Holded (skip silencioso). Al activar el tenant los tickets TEST se
  // purgan junto con el cajero técnico.
  TEST
  // v1.8-Fiado (variante B) · venta a crédito entregada pero NO cobrada.
  // Deuda viva (Ticket.creditPending > 0) que NO se sincroniza con
  // Holded — el gate `shouldEnqueueHoldedUpload` la excluye del encolado.
  // Transiciones: DRAFT → ON_CREDIT (checkout fiado) y ON_CREDIT → PAID
  // (al saldarse; desde ahí el ciclo normal → SYNCED lo hace el worker).
  // Anular un fiado no saldado lo lleva a VOIDED (credit-void).
  ON_CREDIT
}

// V1-verifactu (ADR-019, addendum 1b) · qué es cada fila de `devices`.
//
// No todo lo que hay en esa tabla es un terminal de caja. El «modo prueba»
// del super-admin (B-OnboardingV2) crea un dispositivo TÉCNICO en la caja del
// cliente para validar el flujo del TPV antes de activarlo: no cobra, no
// imprime y sus tickets se purgan al activar.
//
// La distinción va EN EL DATO y no en el nombre ni en el `user_agent`. Un
// invariante que se decide comparando cadenas de texto se rompe el día que
// alguien traduce el nombre, y lo que se rompía aquí era el terminal del
// cliente: el trigger `devices_revoke_previous` lo revocaba al activar el
// modo prueba, y el comercio se quedaba sin poder cobrar.
enum DeviceKind {
  // Un aparato del cliente emparejado con un código. Compite por la cadena
  // de la caja: uno activo por caja, garantizado por el índice parcial
  // `devices_one_active_per_register_key`.
  TERMINAL
  // El dispositivo del modo prueba. Ni releva a nadie al crearse o
  // reactivarse, ni lo releva nadie al emparejar, ni cuenta para la
  // precondición de la migración, ni genera registro de facturación.
  TEST
  // kds-1-cocina (decisión 1) · la tablet de la cocina. La MISMA APK en
  // «modo cocina»: ve comandas y marca platos, y nada más. No abre turno,
  // no cobra, no emite registro de facturación y —esto es lo que hay que
  // probar, no suponer— NO releva al terminal de la caja: ni el trigger
  // `devices_revoke_previous` ni el índice parcial
  // `devices_one_active_per_register_key` la miran, porque los dos filtran
  // `kind = 'TERMINAL'` desde `verifactu-1`. Un bar con una caja y dos
  // pantallas (cocina y barra) tiene tres dispositivos vivos en la misma
  // caja y sólo uno de ellos factura.
  KITCHEN
  // residencia-1 (D-52) · LA PUERTA DE UNA HABITACIÓN. La MISMA APK en
  // «modo puerta», emparejada a una `Room` en vez de a una caja: hoy
  // enseña el número de habitación y quién la ocupa, y en residencia-3
  // pasará a ser la pantalla donde el personal registra a pulsaciones.
  //
  // **No abre turno, no cobra, no emite registro de facturación y no
  // releva a nadie.** Lo primero lo corta `requireDeviceToken` —la puerta
  // de TODAS las rutas del TPV— con un 403 antes del PIN, igual que a una
  // `KITCHEN`. Lo último sale gratis del motor: el trigger
  // `devices_revoke_previous` y el índice parcial
  // `devices_one_active_per_register_key` filtran los dos
  // `kind = 'TERMINAL'`, así que un valor nuevo cae fuera por
  // construcción. Se prueba, no se supone: tiene su fila en la tabla de
  // sabotajes del bloque.
  //
  // Y es el primer `DeviceKind` que NO cuelga de una caja: su
  // `register_id` es NULL y su `room_id` no (CHECK
  // `devices_register_o_habitacion`). Un tenant de residencia tiene la
  // caja APAGADA y puede no tener ni una `Register` en la base —el alta de
  // tenant no crea ninguna—, así que colgar la puerta de una caja técnica
  // habría sido inventarse una caja para un centro que no cobra.
  ROOM
  // residencia-4 (D-66) · EL MÓVIL DE GUARDIA. La MISMA APK en «modo
  // guardia», emparejada a un canal (`ENFERMERIA` o `RESPONSABLE`) en vez
  // de a una caja o a una habitación.
  //
  // Es el segundo `DeviceKind` que no cuelga de una caja, y el primero
  // que no cuelga de NADA físico: una puerta es de una habitación, pero
  // un móvil de guardia es de quien lo lleve ese turno — y quién lo lleva
  // lo dice el PIN al empezar (`guard_shift_sessions`), no el
  // emparejamiento. Puede ser el teléfono personal de quien dirige.
  //
  // **No vende, no abre turno, no factura y no releva a nadie**, igual
  // que `KITCHEN` y `ROOM`: lo corta `requireDeviceToken` con un 403
  // antes del PIN, y el trigger `devices_revoke_previous` y el índice
  // `devices_one_active_per_register_key` filtran `kind = 'TERMINAL'`.
  //
  // Y **no releva al móvil anterior de su canal**, al revés que una
  // puerta releva a la de su habitación: un centro puede tener tres
  // móviles de enfermería a la vez y los tres tienen que sonar.
  GUARD
  // residencia-5 (D-67) · LA TABLET DE LA SALA. La MISMA APK en «modo
  // relevo», emparejada **al centro** y no a una habitación ni a un
  // canal: está donde el turno ya se reúne, y lo que enseña es el parte
  // del turno que sale.
  //
  // Es el tercer `DeviceKind` que no cuelga de una caja y el segundo que
  // no cuelga de nada físico (`register_id` y `room_id` los dos NULL, por
  // el CHECK `devices_register_o_habitacion`). La diferencia con el móvil
  // de guardia es de qué es: el móvil es de quien lo lleve ese turno; la
  // tablet de la sala es del CENTRO, y el centro es el tenant — así que
  // no hace falta ninguna columna que lo diga.
  //
  // **No vende, no abre turno, no factura y no releva a nadie**, igual
  // que `KITCHEN`, `ROOM` y `GUARD`: lo corta `requireDeviceToken` con un
  // 403 antes del PIN, y el trigger `devices_revoke_previous` y el índice
  // `devices_one_active_per_register_key` filtran `kind = 'TERMINAL'`.
  //
  // Y **un centro puede tener más de una**: una sala por planta es un
  // caso real y las dos enseñan el mismo parte. No hay índice de
  // unicidad, al revés que la puerta de una habitación.
  HANDOVER
}

// V1-verifactu (ADR-019) · por qué se revocó un dispositivo.
enum DeviceRevokedReason {
  // Se emparejó otro a la misma caja. La caja tiene UN dispositivo activo:
  // el nuevo entra y el anterior sale, en la misma transacción.
  PAIRED_NEW
  // Alguien lo revocó a mano desde el admin.
  ADMIN
}

// V1-verifactu (ADR-019) · los dos tipos de registro de facturación de la
// Orden HAC/1177/2024. No hay un tercero: una devolución NO es una
// anulación —la venta existió— y va como rectificativa, que es V3.
enum FiscalRecordKind {
  ALTA
  ANULACION
}

// V1-verifactu · ¿este registro encadena con el anterior de su caja?
//
// Lo decide el SERVIDOR al insertar y no se toca después: si fuera
// actualizable, el trigger append-only tendría una puerta, y una puerta en
// una tabla cuyo valor entero es no tener puertas no se paga. La
// verificación (`mipiacetpv_verify_fiscal_chain`) sólo consulta.
enum FiscalChainStatus {
  OK
  // Llegó y se guardó igual, marcado y visible en el super-admin. NUNCA se
  // descarta en silencio y NUNCA se recompone: la FAQ de desarrolladores
  // de la AEAT (§5) prohíbe expresamente que el servidor reprocese un
  // registro producido por el terminal.
  BROKEN
}

enum PaymentMethod {
  CASH
  CARD
  BIZUM
  VOUCHER
  OTHER
}

enum ProductKind {
  PRODUCT
  SERVICE
}

// catalogo-local · de quién es la AUTORIDAD sobre esta ficha de producto.
// Escalón 2 de la independencia de Holded: hasta aquí el catálogo era
// siempre "cache local de Holded" y `holded_product_id` era NOT NULL, así
// que un cliente con caja no podía vender nada que no estuviera en Holded.
//
//   HOLDED · la ficha viene del sync y Holded manda. Editarla en el panel
//            no sirve de nada: el incremental la pisa a los 15 minutos.
//   LOCAL  · la ficha nació en mipiacetpv y no existe en Holded. El sync
//            no la toca, la conciliación no la archiva y NUNCA entra en
//            el payload de un salesreceipt.
//
// `@default(HOLDED)` es lo que hace la migración aditiva: todo lo que ya
// existe nace HOLDED y se comporta exactamente igual que antes del
// bloque. Mismo criterio que `caja_enabled` en H1 (ADR-016).
//
// Es `source` y no `externalSource`, y convive con `holdedProductId` sin
// renombrarlo: el renombrado a `ErpAdapter` / `externalProductId` es el
// escalón 1 y va en su propio bloque.
enum ProductSource {
  HOLDED
  LOCAL
}

// B-reservas-2 · tipo de recurso reservable (cabina de spa, box/sala de
// clínica, aparato). Vocabulario neutro (ADR-R6): un `resource` sirve
// igual a belleza que a una clínica; el enum evita clavar el módulo a un
// vertical concreto.
enum ResourceKind {
  CABIN
  ROOM
  DEVICE
}

enum SyncOutboxKind {
  UPLOAD_TICKET
  UPLOAD_REFUND
  CATALOG_SYNC
}

enum SyncOutboxStatus {
  PENDING
  DONE
  DEAD
}

enum HoldedUploadKind {
  TICKET
  REFUND
}

enum HoldedUploadStatus {
  PENDING
  DONE
  FAILED
  // v1.5-consistencia-B §3.a · terminal para uploads que NUNCA deben
  // subirse (tickets TEST del cajero técnico). Sin estado terminal
  // quedaban PENDING para siempre y el sweeper los re-rescataba cada
  // 5 min en bucle (visto en prod 2026-06-11: `rescued: 26` constante).
  SKIPPED
}

enum TableZone {
  SALON
  TERRAZA
  BARRA
  RESERVADO
}

// v1.4-Bar-Operativa-MVP Lote 2 · sección destino de una comanda
// (kitchen ticket). Cada tag de producto se mapea a una sección — los
// no mapeados caen a SALON (camarero). El endpoint
// `POST /tickets/:id/send-to-kitchen` agrupa las líneas por sección y
// genera un PDF por cada sección con líneas.
enum KitchenSection {
  BARRA
  COCINA
  SALON
}

// kds-1-cocina (decisión 3, capa 3) · los 14 alérgenos de declaración
// obligatoria del Reglamento (UE) 1169/2011, anexo II.
//
// Catorce y no más: la lista la fija la norma. Por eso aquí SÍ es un enum
// de Postgres —el argumento contra el enum que `Product.exemptionCause`
// documenta (un enum sólo crece y cada valor nuevo parte la migración en
// dos) no aplica a una lista cerrada por ley desde 2011.
//
// El comentario de cada valor es el código corto del generador de cartas de
// La Maestranza (`docs/implantaciones/maestranza/generador/maestranza_carta.py`),
// para que importar sus alérgenos sea una tabla de equivalencias y no una
// traducción a ojo.
enum Allergen {
  GLUTEN // GL
  CRUSTACEOS // CR
  HUEVOS // HU
  PESCADO // PE
  CACAHUETES // CA
  SOJA // SO
  LACTEOS // LA
  FRUTOS_CASCARA // FC
  APIO // AP
  MOSTAZA // MO
  SESAMO // SE
  SULFITOS // SU
  ALTRAMUCES // AL
  MOLUSCOS // MC
}

// kds-1-cocina (decisión 3, órdenes de salida) · cómo enseña el TPV los
// tiempos de salida. **Los dos modos son la misma estructura por debajo**
// (`TicketLine.course` + `TicketCourse.firedAt`): esto sólo decide qué
// botones se pintan, así que cambiar de modo no migra nada.
//
//   ESPERA  — bares (La Maestranza): un botón «Espera» en la línea, que
//             por debajo es «tiempo 2». Cero toques más en el caso normal.
//   TIEMPOS — a la carta: fila 1º · 2º · 3º · Postre que SE QUEDA PUESTA;
//             lo que se pulse después cae en ese tiempo.
enum KitchenCourseMode {
  ESPERA
  TIEMPOS
}

// kds-1-cocina (decisión 3, capa 2) · cuándo se ve el botón «→ Silla n» en
// la línea de la comanda.
//
//   ALERGIA — sólo si la mesa tiene alguna alergia declarada (bares).
//   SIEMPRE — siempre visible (restaurante a la carta: cocina y camarero
//             saben de quién es cada plato, y mañana se parte la cuenta por
//             silla con el mismo dato).
enum KitchenSeatMode {
  ALERGIA
  SIEMPRE
}

// v1.4-Impresoras-Fase-1 Lote 1 · modo físico de la impresora térmica.
// USB la enchufa el cajero a la tablet vía OTG → WebUSB API.
// WIFI vive en la LAN y el backend abre TCP a ip:port (9100 ESC/POS raw).
enum PrinterMode {
  USB
  WIFI
}

enum InitialSyncStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  // H1 (la caja es un modulo) · el tenant que NUNCA va a sincronizar
  // porque no tiene Holded. No es DONE (mentiria: el cron incremental
  // barre `initialSyncStatus = DONE` y se lo llevaria por delante) ni
  // PENDING (el panel lo pintaria como un sync a medias y el super-admin
  // esperaria a que terminase algo que no ha empezado). Se sale de
  // NOT_APPLICABLE en un solo sentido: al guardar una API key de Holded,
  // que lo pasa a PENDING y encola el sync inicial.
  NOT_APPLICABLE
}

// B-OnboardingV2: ciclo de vida del onboarding supervisado del tenant.
//
//   DRAFT  → tenant creado con API key Holded, sync inicial corriendo
//            o terminada. Sin OWNER. El equipo mipiacetpv prueba el TPV
//            con un cajero técnico. Los tickets generados no suben a
//            Holded ni se envían por email.
//   ACTIVE → el equipo ha validado salud, el super-admin ha introducido
//            email + nombre del propietario. Se ha creado el OWNER user,
//            enviado el email de bienvenida y purgado los datos de
//            prueba. A partir de aquí operación productiva real.
//
// READY se calcula on-the-fly desde `onboardingHealth.ready` (Frente 3
// del prompt): es un check de heurística sobre el sync inicial,
// productos sellable, taxes, etc. No es un valor persistido — el
// listado super-admin lo pinta cuando `state=DRAFT` y `ready=true`.
enum OnboardingState {
  DRAFT
  ACTIVE
}

// B-Multi-Vertical: vertical de negocio del tenant. Define
// comportamientos del TPV:
//   - HOSPITALITY: mapa de mesas activo, modificadores tipo bar, placeholder
//                  icono café (vertical original — Thalia, bares).
//   - RETAIL:      sin mapa de mesas, modificadores opcionales (variantes
//                  de producto), placeholder icono paquete (librería,
//                  ropa, etc.).
//   - SERVICES:    sin mapa de mesas, sin modificadores, placeholder
//                  icono maletín (consultorías, talleres, peluquerías).
// Default RETAIL porque al introducir el campo el piloto inicial
// (Librería Thalia) ya es retail; los tenants futuros lo eligen al alta.
enum BusinessType {
  HOSPITALITY
  RETAIL
  SERVICES
}

// v1.4-Buscador-Contactos · clasificación de contactos heredada de
// Holded. Persistida localmente para que el buscador del TPV pueda
// filtrar sin abrir el `raw` JSON. UNKNOWN cubre el caso edge en el
// que Holded devuelve un valor que no conocemos o el campo viene
// vacío — el filtro por defecto incluye UNKNOWN para no esconder
// contactos legítimos preexistentes a la migración b29.
enum ContactType {
  CLIENT
  SUPPLIER
  LEAD
  DEBTOR
  CREDITOR
  UNKNOWN
}

// v1.3-Thalia Lote 4 · arqueo de caja. El cajero cuenta efectivo por
// denominaciones (no un total libre como antes). X = control intermedio
// sin cerrar turno; Z = control de cierre — generamos sólo uno Z por
// shift, X puede haber varios.
enum ShiftCashCountKind {
  X
  Z
}

// v1.11-cierre-de-dia · por qué se cerró un turno. MANUAL = lo cerró una
// persona desde el TPV (comportamiento histórico, y el default del
// backfill). AUTO_DAY_CUT = lo cerró el job de corte de día a la hora
// local de `Tenant.dayCutHour` porque nadie lo cerró. El resumen del día
// necesita distinguirlos para decir la verdad ("lo cerramos nosotros a
// las 05:00") y para que el reporting no confunda un cierre real con uno
// automático.
enum ShiftCloseReason {
  MANUAL
  AUTO_DAY_CUT
}

// v1.12-mesas-abandonadas · por qué se anuló un ticket DRAFT. NULL en un
// ticket que no está VOIDED. Mismo criterio que `ShiftCloseReason`:
// `voidedByUserId` dice QUIÉN (NULL = lo hizo el sistema), esto dice POR QUÉ.
//   MANUAL                — "vaciar mesa" desde el TPV, con una persona delante.
//   AUTO_ABANDONED_EMPTY  — barrido del corte de día: draft SIN líneas y de
//                           antes del corte. Cero consumo, cero decisión.
//   MANAGER_VOID          — anulado desde el admin con PIN de encargado. Es el
//                           único camino por el que se anula un draft CON líneas
//                           sin estar en la caja.
enum TicketVoidReason {
  MANUAL
  AUTO_ABANDONED_EMPTY
  MANAGER_VOID
}

/// auditoria-sirope (#18) · POR QUÉ SE VACIÓ UNA MESA CON CONSUMO.
///
/// `TicketVoidReason` dice por qué CAMINO se anuló (el TPV, el barrido,
/// el panel); esto dice qué pasó en la sala, que es otra pregunta y la
/// única que el dueño puede usar.
///
/// El 18-10 se vaciaron cinco mesas con consumo y no quedó nada: ni
/// motivo, ni importe en el Z, ni línea en el informe. Vaciar una mesa
/// con platos dentro es comida que sale de la cocina y no se cobra —una
/// invitación, un error de comanda o alguien que se fue sin pagar—, y
/// las tres se gestionan de forma distinta.
///
/// Sólo se exige con consumo. Una mesa que se abrió por error y está
/// vacía se libera de un toque, como siempre.
enum MotivoVaciado {
  INVITACION
  ERROR_DE_COMANDA
  SE_FUERON_SIN_PAGAR
  OTRO
}

// B-reservas-1 (CRM) · tipo de consentimiento RGPD registrado en la ficha
// del cliente. DATA = tratamiento de datos personales; TREATMENT =
// consentimiento del tratamiento/servicio (fórmulas de color, parámetros
// de clínica…). Sólo campos + alta manual en B1; la firma digital es
// fase 2 (fuera de alcance).
enum ClientConsentKind {
  DATA
  TREATMENT
  /// residencia-3 (D-64) · **CONSENTIMIENTO DE IMAGEN.** Sin él, la puerta
  /// no pinta la foto del residente: pinta sus iniciales.
  ///
  /// Es un `ClientConsentKind` y no una columna en `resident_profiles`
  /// porque lo que hay que guardar es exactamente lo que esta tabla ya
  /// guarda: quién lo dio (`signer` = PACIENTE o REPRESENTANTE, con su
  /// nombre y su parentesco), cuándo (`grantedAt`), quién lo anotó
  /// (`createdByUserId`) y —la mitad que una columna no da— **que se puede
  /// REVOCAR** con su fila de revocación, su motivo y su fecha. Una
  /// familia que llama para decir «quiten la foto de mi madre» no puede
  /// resolverse con un booleano que se pone a false y no deja rastro.
  ///
  /// `clinical` va en `false`: la cara de alguien no es un dato de salud,
  /// es su imagen. Por eso tampoco exige sanitario que informe.
  IMAGE
}

// v1.3-Thalia Lote 3 · intent de impresión persistido. Hasta este
// lote el TPV sólo tenía `Ticket.printIntent: Boolean` (intención del
