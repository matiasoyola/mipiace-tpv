# Firma de release de mipiacetpv — PLANTILLA.
#
# Copia este fichero a `keystore.properties` (mismo directorio, gitignored) y
# rellena los valores. El keystore .jks NUNCA va al repo: vive en el Mac de
# Matías y con backup en 1Password.
#
# Crear el keystore una sola vez (guardar la contraseña en 1Password):
#   keytool -genkeypair -v \
#     -keystore ~/keys/mipiacetpv-release.jks \
#     -alias mipiacetpv \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -dname "CN=mipiace, O=mipiace, L=..., C=ES"
#
# storeFile se resuelve relativo a apps/tpv-android/android/. Usa ruta
# absoluta para apuntar fuera del repo (recomendado).

storeFile=/Users/matiasoyolasanchez/keys/mipiacetpv-release.jks
storePassword=CAMBIAR_ME
keyAlias=mipiacetpv
keyPassword=CAMBIAR_ME
