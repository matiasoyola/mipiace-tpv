<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- n1-vertical · AQUÍ NO HAY android:screenOrientation A PROPÓSITO.
             La orientación la fija MainActivity.onCreate() según el TAMAÑO del
             aparato (OrientacionPorTamano): sw<600dp = móvil = vertical;
             sw>=600dp = tablet = horizontal, que es lo que han hecho siempre
             los AP11/AP12/AP13/D8. Con el atributo puesto habría DOS fuentes
             de verdad: el manifiesto gana al arrancar y el código corrige
             después, y eso se ve como un giro en la cara del cajero.

             `configChanges` se queda tal cual: el WebView NO se recrea al
             girar, que es lo que evita que la pantalla de venta se reinicie
             con líneas dentro. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- residencia-4 (D-66) · EL SERVICIO DEL MÓVIL DE GUARDIA.
             Mantiene el sondeo con la pantalla apagada y levanta la
             notificación de alarma. `dataSync` es el tipo que le
             corresponde: lo que hace es sincronizar con el servidor.
             Ver la cabecera de GuardiaService.java para por qué esto y
             no FCM (y para la respuesta a «¿depende de servicios de
             Google?»: no). -->
        <service
            android:name=".GuardiaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- INTERNET cubre también el camino directo de kds-2: el socket que la
         tablet de cocina abre en la wifi del local y el POST que el terminal
         le hace por el puente nativo.

         kds-2 · POR QUÉ NO HAY PERMISO NUEVO:
           · NsdManager (el redescubrimiento cuando el router le cambia la IP
             a la tablet) no pide ninguno;
           · la IP local se lee enumerando interfaces, que es información del
             propio proceso (mismo criterio que A5).

         kds-2 · SOBRE `usesCleartextTraffic` Y LA LECCIÓN A5: el WebView
         sigue cargando SÓLO https, y en la APK no hay ningún origen http.
         Lo que viaja en claro por TCP es el sobre de `kitchen-lan`, y el
         sobre va CIFRADO con la clave de la tienda (AES-256-GCM): dentro de
         él no hay nada legible, ni la comanda ni la alergia. La bandera ya
         estaba puesta antes de este bloque. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A5 · acceso remoto · el heartbeat del canal de soporte dice en qué red
         está el terminal (wifi del bar / datos compartidos de un móvil). Es
         permiso de instalación, no de runtime: no hay diálogo que nadie tenga
         que aceptar en la barra. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A2-Android · Frente 1 · escáner de código de barras con la cámara
         (zxing sobre getUserMedia dentro del WebView). CAMERA es permiso
         en runtime; lo pide CameraPermissionPlugin. La cámara NO es
         obligatoria (hay escáner USB-HID como alternativa) → required=false
         para no excluir de Play Store terminales sin cámara. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- residencia-4 (D-66) · EL MÓVIL DE GUARDIA.

         FOREGROUND_SERVICE + su tipo: el servicio que mantiene el sondeo
         con la pantalla apagada. POST_NOTIFICATIONS es de runtime desde
         Android 13 y lo pide GuardiaAlarmPlugin al ponerse de guardia —
         no al arrancar la app, porque un permiso que se pide en una
         pantalla donde no se entiende para qué es, se deniega.

         WAKE_LOCK mantiene la CPU entre sondeos (sin él, Doze alarga los
         intervalos y el aviso de las cuatro de la mañana llega tarde).
         VIBRATE y USE_FULL_SCREEN_INTENT son lo que hace que un N4
         encienda la pantalla en vez de quedarse en la barra.

         NINGUNO de estos es un permiso de Google Play Services: la APK
         sigue funcionando en una tablet sin GMS. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- A1-Android · Frente 2 · impresión USB Host (impresora térmica ESC/POS
         del terminal todo-en-uno). No requiere permiso en runtime: el
         permiso USB es un diálogo del sistema por device. `required=false`
         para no excluir de Play Store tablets sin puerto USB Host. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
</manifest>
